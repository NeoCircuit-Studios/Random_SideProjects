const DOELEN = {"08.01":"Historisch referentiekader","08.02":"Verbanden tussen domeinen","08.03":"Interculturele contacten","08.04":"Samenlevingen vergelijken & actualiseren","08.05":"Periodisering vergelijken","08.06":"Bronnen kritisch analyseren","08.07":"Historische vraag beantwoorden (redeneren)","08.08":"Standplaatsgebondenheid","08.09":"Betekenisgeving & herinnering","07.01":"Democratische rechtsstaat & ideologieën","07.02":"Identiteit & wij-zij-denken","07.03":"Diversiteit & discriminatie","07.04":"Constructief in dialoog gaan"};
const REEKSEN = [{"id":"BB","label":"Lessenreeks 0","titel":"De Bronbox: historisch onderzoek","sub":"Methodische startmodule — de basis voor alle volgende hoofdstukken","icon":"🧰","hId":null},{"id":"H1","label":"Hoofdstuk 1","titel":"Van de vroegmoderne naar de moderne tijd","sub":"Ancien Régime, Verlichting en de Franse Revolutie","icon":"⚜️","hId":"H1"},{"id":"H2","label":"Hoofdstuk 2","titel":"Napoleon & het Congres van Wenen","sub":"Tussen macht en mythe","icon":"👑","hId":"H2"},{"id":"H3","label":"Hoofdstuk 3","titel":"Liberalisme en nationalisme","sub":"Ideologieën die de 19e eeuw vormgeven — en de politiek van vandaag","icon":"🗽","hId":"H3"}];
const LESSEN = [{"id":"BB-1","r":"BB","nr":1,"titel":"Een onderzoeksvraag stellen en bronnen kennen","vraag":"Wat maakt een historische bron bruikbaar, betrouwbaar en representatief?","niveau":"analyseren","cursus":"p. 9–21","cornell":"Cornell-pagina Bronbox les 1","extra":["hand-out De Bronbox"],"doelen":["08.06","08.07"],"k":[["Je kan de vier stappen van historisch onderzoek in de juiste volgorde uitleggen.","08.07"],["Je kan zelf een goede historische vraag bedenken en zeggen waarom ze goed is.","08.07"],["Je herkent vier soorten bronnen (geschreven, mondeling, materieel, audiovisueel).","08.06"],["Je kan bij een bron beoordelen: kan ik ze gebruiken, klopt ze, en is ze typisch of net een uitzondering?","08.06"]],"c":[["Welke vier stappen zet je om van het verleden tot een historisch beeld te komen?","1) Een historische vraag stellen. 2) Het historisch referentiekader uitbouwen. 3) Met en over historische bronnen werken. 4) De historische vraag beantwoorden, onderbouwd met informatie uit de bronnen. (Vergelijk met het stroomschema op p. 9.)"],["Wanneer is een historische vraag specifiek, onderzoekbaar en relevant?","Specifiek: voldoende afgebakend in tijd, ruimte en/of maatschappelijk domein. Onderzoekbaar: er zijn voldoende bruikbare, betrouwbare en/of representatieve bronnen. Relevant: de vraag vraagt niet naar een feitje, maar gebruikt een of meer historische redeneerwijzen."],["Noem de vijf historische redeneerwijzen.","Oorzaak en gevolg · toeval · continuïteit en verandering · evolutie en revolutie · gelijktijdigheid en ongelijktijdigheid."],["Wat is het verschil tussen een hoofdvraag en een deelvraag?","Een deelvraag gaat over de basisfeiten die je nodig hebt om de hoofdvraag te beantwoorden — vaak wie-, wat-, waar- of hoeveel-vragen. Ze is geen goede hoofdonderzoeksvraag, maar wel een goede deelvraag."],["Wat is het verschil tussen een bruikbare en een betrouwbare bron?","Bruikbaar: de inhoud bevat informatie die helpt om de historische vraag te beantwoorden (ook wat een bron verzwijgt, kan bruikbaar zijn). Betrouwbaar: de informatie is correct en nauwkeurig; je onderzoekt ook de motieven van de maker. Een bruikbare bron is niet noodzakelijk betrouwbaar — en je beoordeelt altijd in functie van de historische vraag."],["Waarom zijn betrouwbaar en objectief geen synoniemen?","Een egodocument (dagboek, memoires) is niet objectief, maar kan wel betrouwbare informatie geven over hoe de auteur iets ervaarde of wilde voorstellen. Of een bron betrouwbaar is, hangt af van de vraag die je stelt."]],"g":[["bruikbaar","De bron bevat informatie die je helpt om de historische vraag te beantwoorden."],["betrouwbaar","De informatie in de bron is correct en nauwkeurig; je houdt rekening met de motieven van de maker."],["representatief","De bron is typisch voor een grotere groep of situatie, en geen uitzondering."],["deelvraag","Vraag naar de basisfeiten (wie, wat, waar, hoeveel) die je nodig hebt om de hoofdvraag te beantwoorden."],["retorische strategieën","Strategieën om een bepaald effect te bereiken: overdrijving, slachtofferrol, zondebok aanduiden, herhalingen, zaken verzwijgen, drogredenen gebruiken, …"]],"bronnen":["h2b2","h1b11","h1b3"],"go":[],"oef":[]},{"id":"BB-2","r":"BB","nr":2,"titel":"Historisch redeneren en beeldvorming","vraag":"Hoe vermijd je dat je eigen beeld van het verleden vertekend wordt door stereotypering?","niveau":"toepassen","cursus":"p. 22–30","cornell":"Cornell-pagina Bronbox les 2","extra":["hand-out De Bronbox","propaganda-affiches WOI/WOII"],"doelen":["08.07","08.08","08.09","07.02","07.03"],"k":[["Je kan drie manieren van historisch redeneren toepassen: iets in tijd en ruimte plaatsen, oorzaken en gevolgen onderscheiden, en zien wat veranderde en wat hetzelfde bleef.","08.07"],["Je kan uitleggen hoe stereotypen en wij-zij-denken een vertekend beeld van het verleden geven.","08.08"],["Je kent het verschil tussen herinnering 'van bovenaf' (monumenten, feestdagen) en 'van onderaf' (familieverhalen), met een voorbeeld.","08.09"]],"c":[["Wat is het verschil tussen historische kennis en historisch redeneren?","Historische kennis = feiten opsommen. Historisch redeneren = die feiten met elkaar verbinden via redeneerwijzen en correcte begrippen. Bv. de moord op Franz Ferdinand was de directe aanleiding van WO I, maar nationalisme en imperialisme verklaren waarom een lokaal conflict een Europese oorlog werd."],["Welke drie perspectieven gebruik je om tot multiperspectiviteit te komen?","1) De vier maatschappelijke domeinen (politiek, economisch, sociaal, cultureel). 2) Standplaatsgebondenheid: hoe verschillende (groepen) mensen dezelfde gebeurtenis ervaren. 3) Tijdsperspectief: de mentaliteit van toen begrijpen."],["Wat is presentisme?","Het verleden beoordelen met de normen en de kennis van vandaag. Je vermijdt het door te kijken hoe men in die tijd dacht."],["Hoe leidt stereotypering tot een vertekend beeld? Geef een voorbeeld.","Je schrijft kenmerken toe aan een hele groep zonder nuance en scheert iedereen over dezelfde kam. Bv. \"Alle jongemannen meldden zich in 1914 enthousiast als vrijwilliger\" — dat gold maar voor een deel van de bevolking."],["Wat is een collectieve herinnering, en welk doel heeft ze vaak?","De betekenis die een grote groep aan een gebeurtenis geeft — niet noodzakelijk wat er echt gebeurde. Van bovenaf via de overheid (standbeeld, feestdag) of van onderaf via familieverhalen. Doel: een collectieve identiteit opbouwen, samenhorigheid of uitsluiting aanwakkeren, waarden doorgeven — vaak eenzijdig en selectief. Bv. 14 juli werd in 1880 de Franse nationale feestdag."],["Welke drie stappen volg je bij het lezen van een geschreven bron? En bij een visuele bron?","Geschreven: oriënterend lezen → intensief lezen → kritisch lezen. Visueel: oriënterend kijken → gedetailleerd kijken → kritisch kijken."]],"g":[["multiperspectiviteit","Een gebeurtenis vanuit verschillende perspectieven bekijken: de maatschappelijke domeinen, standplaatsgebondenheid en het tijdsperspectief."],["standplaatsgebondenheid","Hoe iemands positie (tijd, plaats, groep, belangen) bepaalt hoe hij een gebeurtenis ervaart en beoordeelt."],["presentisme","Het verleden beoordelen met de normen en de kennis van vandaag."],["stereotypering","Kenmerken toeschrijven aan een volledige groep zonder nuance."],["collectieve herinnering","De betekenis die een grote groep mensen aan een gebeurtenis uit het verleden geeft."]],"bronnen":["h2b5","h6b7"],"go":[],"oef":[]},{"id":"1.1","r":"H1","nr":"1.1","titel":"De wereld van het ancien régime","vraag":"Waarom groeide de onvrede in Frankrijk vlak vóór 1789 uit tot een revolutie?","niveau":"analyseren","cursus":"Lees in je cursus p. 31-35. Noteer wat je niet begrijpt.","cornell":"Cornell-pagina H1 les 1","extra":["spotprent standenmaatschappij"],"doelen":["08.01","08.02","08.04","08.04.01"],"k":[["Je kan drie kenmerken van het ancien régime uitleggen en er één terugvinden in een bron.","08.01"],["Je kan de drie standen ordenen met hun aandeel, voorrechten en plichten.","08.04"],["Je kan uitleggen hoe geldproblemen, ongelijkheid en nieuwe ideeën samen voor onvrede zorgden.","08.02"]],"c":[["Noem de vijf typische kenmerken van het Ancien Régime.","Absolute monarchie (de koning heeft alle macht) · talrijke privileges voor adel en clerus · standenmaatschappij met drie rigide groepen · bevoorrechte staatskerk (katholieke kerk) · territoriale versnippering met lokale verschillen."],["Welke drie standen waren er? Hoe groot waren ze, en wat waren hun privileges en verplichtingen?","Clerus (1%): geen belastingen, vrij van krijgsdienst — bidden en geestelijke zorg. Adel (2%): geen belastingen, ontvangt herendiensten, jachtrecht — vechten voor de koning, helpen besturen. Derde stand (97%): geen privileges — alle belastingen betalen en herendiensten werken."],["Waarom was vooral de bourgeoisie ontevreden?","Rijke handelaars, bankiers en advocaten waren geletterd en welvarend: ze hadden geld, maar geen politieke macht."],["Geef de drie soorten oorzaken van de Franse Revolutie, met telkens een voorbeeld.","Economisch: staatsschuld van 4,5 miljard livres, brood kost 80% van een dagloon, mislukte oogsten. Sociaal: adel en clerus (3%) betalen geen belastingen, de derde stand draagt alle lasten zonder rechten. Ideeën (Verlichting): \"Waarom heeft de koning alle macht?\", \"Zijn we niet allemaal gelijk?\", \"Moet het volk niet meebeslissen?\""],["Waarom was de executie van Lodewijk XVI (21 januari 1793) zo revolutionair?","Een koning die zijn macht van God zou hebben gekregen, werd door zijn eigen volk ter dood gebracht — ondenkbaar in de vroegmoderne tijd. Het betekende het definitieve einde van het Ancien Régime."]],"g":[["absolutisme","Staatsvorm geleid door een onbeperkte alleenheerschappij."],["monarchie","Staatsvorm waarbij de vorst door erfopvolging wordt aangeduid."],["staatsschuld","Geheel van de schuld die de centrale overheid heeft gemaakt door leningen aan te gaan om financiële tekorten op te vangen."],["elite","Meestal kleine groep in de samenleving die op basis van buitengewone kenmerken privileges heeft."],["oorzaak","De factoren die leiden tot een historische gebeurtenis."]],"bronnen":["h1b1","h1b2","h1b3","h1b11","h1b8"],"go":[],"oef":["S1-1-1","1-1-1"]},{"id":"1.2","r":"H1","nr":"1.2","titel":"1789: breuk of continuïteit?","vraag":"In welke mate was 1789 een breuk tussen de vroegmoderne en de moderne tijd?","niveau":"analyseren","cursus":"Lees in je cursus p. 36-38. Noteer wat je niet begrijpt.","cornell":"Cornell-pagina H1 les 2","extra":[],"doelen":["08.01","08.02","08.04.02","08.05"],"k":[["Je kan uitleggen waarom 1789 een scharniermoment is — en dat historici die datum zelf kiezen.","08.01"],["Je kan per domein zeggen of er veel veranderde (breuk) of veel hetzelfde bleef (continuïteit), met een argument.","08.04"],["Je kan twee ideeën van verlichtingsdenkers koppelen aan iets wat na 1789 echt veranderde.","08.02"],["Je kan onze tijdlijn vergelijken met een andere manier om de tijd in te delen.","08.05"]],"c":[["Waarom zien historici 1789 als een breuk?","Van onderdanen naar burgers, van privileges naar rechten. De volkssoevereiniteit vervangt de absolute monarchie en het goddelijk recht van koningen."],["Koppel Montesquieu, Rousseau, Locke en Voltaire elk aan een concrete verandering na 1789.","Montesquieu: scheiding der machten → grondwet van 1791. Rousseau: volkssoevereiniteit → \"het volk is de baas\", democratie. Locke: natuurrechten (leven, vrijheid, eigendom) → Verklaring van de Rechten van de Mens (1789). Voltaire: vrijheid van denken en spreken → einde van de censuur, godsdienstvrijheid."],["Hoe veranderde het politieke domein door 1789?","Absolute monarchie → volkssoevereiniteit. Goddelijk recht → grondwet en rechtsstaat. Geen volksvertegenwoordiging → gekozen parlement. Willekeurige rechtspraak → onafhankelijke rechters."],["Hoe veranderde het sociale domein door 1789?","Geboorte bepaalt je positie → verdienste telt. Standenmaatschappij → burgerschap. Privileges voor adel en clerus → gelijkheid voor de wet. Horigheid en herendiensten → persoonlijke vrijheid. \"Onderdanen\" → \"burgers\" met rechten."],["Geef twee artikels uit de Verklaring van de Rechten van de Mens en de Burger (26 augustus 1789).","Art. 1: alle mensen worden vrij en gelijk in rechten geboren en blijven dat. Art. 2: het doel van elke politieke vereniging is het behoud van de natuurlijke rechten: vrijheid, eigendom, veiligheid en weerstand tegen onderdrukking. Art. 6: de wet is de uitdrukking van de algemene wil. Art. 11: het vrije verkeer van gedachten en meningen is een van de kostbaarste rechten."]],"g":[["verlichting","Filosofische stroming in Europa in de 18e eeuw, waarin het gebruik van de rede en het geloof in het individu centraal stonden."],["volkssoevereiniteit","Principe waarbij het hoogste politieke gezag bij het volk ligt, het basisprincipe van een democratie."],["scheiding der machten","De politieke macht opsplitsen in de uitvoerende, de wetgevende en de rechterlijke macht."],["grondwet (constitutie)","Document waarin de rechten en plichten van elke burger en de werking van de staatsorganen staan beschreven."],["breuk","Plotselinge en fundamentele verandering waarbij oude structuren volledig worden vervangen door nieuwe."]],"bronnen":["h1b4","h1b5","h1b6","h1b7","h1b9"],"go":[],"oef":["S1-2-1","S1-2-2","1-2-1","1-2-2"]},{"id":"1.3","r":"H1","nr":"1.3","titel":"Gevolgen van 1789 en de Terreur","vraag":"Waarom sloeg een revolutie voor vrijheid en gelijkheid om in Terreur?","niveau":"analyseren","cursus":"Lees in je cursus p. 38-39. Noteer wat je niet begrijpt.","cornell":"Cornell-pagina H1 les 3","extra":[],"doelen":["08.07","08.04.01","08.02"],"k":[["Je kan met het domino-schema uitleggen hoe 1789 nog decennia doorwerkte.","08.07"],["Je kan twee redenen geven waarom de revolutie gewelddadig werd.","08.07"],["Je kan in een toespraak twee trucs herkennen waarmee iemand geweld goedpraat.","08.06"],["Je kan met een bron tonen dat ‘gelijkheid’ toen niet voor iedereen gold.","08.06"]],"c":[["Schets het domino-effect van 1789.","1789 Franse Revolutie → monarchen vrezen voor hun troon → 1792-1815 Napoleontische oorlogen verspreiden de Franse ideeën → 1830 revoluties in Frankrijk, België en Polen (1831 ook in Italië) → 1848 \"jaar van de revoluties\" → industrialisatie en democratisering → 20e eeuw: wereldoorlogen en moderne democratieën."],["Geef een gevolg op het vlak van technologie, economie én cultuur.","Technologie: stoommachine, spoorwegen, de wetenschappelijke methode wordt standaard. Economie: kapitalisme, vrije handel vervangt het gildesysteem, industrialisatie. Cultuur: secularisering, democratisering van kennis, romantiek, nationale literatuur in de volkstaal."],["Wat gebeurde er tijdens de Terreur (1793-1794)?","Robespierre en de revolutionaire comités nemen de macht. Met de wet van de verdachten kan iedereen op verdenking gearresteerd worden. Zo'n 17.000 mensen worden na een proces geëxecuteerd, de meesten met de guillotine; nog duizenden sterven in de gevangenis of zonder proces; \"vijanden van het volk\" worden systematisch opgejaagd."],["Waarom sloeg de revolutie om in Terreur?","Revolutionairen geloofden dat geweld nodig was om de oude orde definitief te vernietigen (\"Terreur is snelle, strenge, onbuigzame gerechtigheid\" — Robespierre). Paranoia: overal zag men samenzweerders."],["Hoe eindigde de Terreur?","Op 27 juli 1794 werd Robespierre zelf gearresteerd en kort daarna geëxecuteerd. Het geweld had zijn eigen leiders opgegeten."]],"g":[["revolutionair","Iemand die een omwenteling of radicale verandering van de samenleving wil realiseren."],["gevolg","Het resultaat van een historische gebeurtenis."],["proces","Geleidelijke ontwikkeling over een langere periode."],["verandering","Elke wijziging in bestaande situaties, structuren of ideeën."]],"bronnen":["h1b12","h1b10"],"go":[],"oef":["1-3-1"]},{"id":"1.4","r":"H1","nr":"1.4","titel":"1789 vandaag, en synthese","vraag":"In welke mate is 1789 vandaag nog relevant?","niveau":"toepassen","cursus":"Lees in je cursus p. 40-41. Bronbox p. 25: 14 juli als collectieve herinnering. Noteer wat je niet begrijpt.","cornell":"Cornell-pagina H1 les 4","extra":["actuele nieuwsberichten"],"doelen":["08.04.03","08.09","07.04"],"k":[["Ik kan uitleggen waarom Frankrijk de Marseillaise uit 1792 vandaag nog zingt.","08.09"],["Ik kan een gebeurtenis van vandaag vergelijken met 1789 — en zeggen waar de vergelijking niet klopt.","08.04"],["Ik kan uitleggen wat presentisme is en het vermijden.","08.04"]],"c":[["Geef drie parallellen tussen 1789 en vandaag.","Financiële crisis en staatsschuld ↔ inflatie en koopkrachtcrisis. Privileges voor adel en clerus ↔ belastingvoordelen voor multinationals. Geen politieke inspraak ↔ gevoel van politieke machteloosheid. Pamfletten ↔ social media. \"Het volk\" vs. \"de koning\" ↔ \"het volk\" vs. \"de elite\"."],["Waar loopt zo'n vergelijking mank?","Vandaag hebben we stemrecht, een grondwet en een rechtsstaat, en bepaalt je geboorte je rechten niet meer. Vergelijken mag, gelijkstellen niet: wie 1789 en vandaag als hetzelfde voorstelt, valt in presentisme."],["Welke rechten heb jij vandaag dankzij 1789?","Stemrecht (volkssoevereiniteit), vrijheid van meningsuiting, gelijkheid voor de wet, recht op onderwijs (democratisering van kennis)."],["Vat de overgang naar de moderne tijd samen in vier kernpunten.","1789 = breekpunt: van onderdanen naar burgers. Verlichtingsideeën worden praktijk. Volkssoevereiniteit: het volk wordt de bron van politieke macht. Gewelddadige transformatie en Europese verspreiding — democratische waarden blijven kwetsbaar."],["Welke betekenis kreeg 1789 later voor Frankrijk zelf?","In 1880 koos de republikeinse overheid 14 juli als nationale feestdag. Ze gaf een gebeurtenis uit 1789 een nieuwe betekenis om de Republiek van haar eigen tijd te legitimeren en te versterken (collectieve herinnering)."]],"g":[["continuïteit","Aspecten die doorlopen ondanks grote veranderingen."],["gelijkheid","Individuen en groepen een gelijke behandeling en evenveel kansen geven."],["vrijheid","Recht om te kunnen handelen, denken en spreken zonder dwang, binnen grenzen zodat de rechten van anderen niet geschaad worden."]],"bronnen":["h1b9","h1b10"],"go":["go-h1-1"],"oef":["1-4-1","1-4-2"]},{"id":"2.1","r":"H2","nr":"2.1","titel":"Van Corsicaan tot keizer","vraag":"Hoe slaagde Napoleon erin om in 1799 de macht te grijpen en zich in 1804 tot keizer te kronen?","niveau":"begrijpen","cursus":"Lees in je cursus p. 42. Noteer wat je niet begrijpt.","cornell":"Cornell-pagina H2 les 1","extra":["hand-out Napoleon"],"doelen":["08.01","08.02","08.04.01"],"k":[["Je kan in de juiste volgorde vertellen hoe Napoleon generaal, consul en keizer werd.","08.01"],["Je kan twee redenen geven waarom hij de macht kón grijpen.","08.02"],["Je kan een schilderij aan een moment uit zijn leven koppelen en uitleggen waarom je de context nodig hebt.","08.06"]],"c":[["Zet de machtsgreep van Napoleon in de juiste volgorde.","Militaire successen in Italië → 1799 staatsgreep van 18 Brumaire: Eerste Consul → Consul voor het leven → 1804 kroning tot keizer in de Notre-Dame."],["Waarom kon Napoleon de macht grijpen?","De samenleving was na jaren revolutie in beroering: onrust en economische ontwrichting. Napoleon had als outsider het vertrouwen gewonnen met zijn militaire successen in Italië en beloofde orde en stabiliteit."],["Geef twee positieve kanten van zijn bestuur.","Rust, bloeiende economie en werk · Concordaat met de Kerk (religieuze vrede) · aanvankelijk vrede met het buitenland · de adel mag terugkeren uit ballingschap."],["Geef twee negatieve kanten van zijn bestuur.","Onderdrukking van binnenlandse vijanden (koningsgezinden én revolutionairen) · censuur op pers en publicaties · geheime politie en spionagenetwerk · geen vrije meningsuiting."],["Waarom breekt de kroning van 1804 met het republikeinse ideaal?","De revolutie had de koning afgeschaft; nu vestigt Napoleon een persoonlijk, erfelijk keizerschap. Hij brengt orde, maar breekt symbolisch én feitelijk met de Republiek."]],"g":[["autoritair","Beknotting van rechten en vrijheden van burgers door de machthebber."],["constitutionele monarchie","Staatsvorm waarbij de macht van de erfelijke koning beperkt is en omschreven wordt in de grondwet."]],"bronnen":["h2b4","h2b5","h2b6"],"go":[],"oef":["S2-1-1","2-1-1"]},{"id":"2.2","r":"H2","nr":"2.2","titel":"Hervormer of dictator?","vraag":"Was Napoleon vooral een hervormer of vooral een dictator?","niveau":"analyseren","cursus":"Lees in je cursus p. 43-44. Noteer wat je niet begrijpt.","cornell":"Cornell-pagina H2 les 2","extra":["teksten Cobban, Broers, Gordley"],"doelen":["08.06","08.08","08.07"],"k":[["Ik kan met de Code Civil tonen wat er modern was aan Napoleons bestuur, en voor wie niet.","08.06"],["Ik kan uitleggen waarom ik moet opletten met wat Napoleon zelf over zijn plannen vertelde.","08.06"],["Ik kan een standpunt innemen met twee argumenten én bewijs uit bronnen.","08.07"]],"c":[["Wat bracht de Code Civil (1804)?","Juridische gelijkheid (voor mannen!), bescherming van eigendom, uniforme procedures, regels voor de burgerlijke stand (geboorte, huwelijk, overlijden)."],["Hoe verschillen Cobban en Broers in hun oordeel over Napoleon?","Cobban (jaren 1940) zag Napoleon als een vroege vorm van moderne dictatuur, vergelijkbaar met 20e-eeuwse regimes. Broers (2014) nuanceert: zijn regime combineerde verlicht despotisme met autoritair bestuur."],["Hoe nuanceert Gordley de Code Civil?","Veel \"revolutionaire\" principes waren al eerder geformuleerd door Franse juristen en gebaseerd op Romeins recht. De echte vernieuwing zat in de systematische codificatie en de uniforme toepassing, niet in de inhoud zelf."],["Waar kan het verschil tussen historici vandaan komen?","Standplaatsgebondenheid: Cobban schreef in een tijd van opkomende dictaturen en keek met die bril naar Napoleon. Latere historici beschikken over meer onderzoek en stellen andere vragen."],["Noem drie dingen van Napoleons erfenis die je vandaag nog ziet.","Provincies, kantons en gemeenten · kadaster · Code Civil en rechtssysteem · burgerlijke stand · metriek stelsel."],["Geef twee argumenten voor \"verlichter\" en twee voor \"dictator\", telkens met bewijs.","Verlichter: Code Civil (gelijkheid voor de wet), vrijheid van beroep, technologie bevorderen, religieuze tolerantie (Concordaat). Dictator: censuur en geheime politie, herstel van de slavernij in de kolonies, vrouwen blijven ondergeschikt, politieke oppositie verboden."],["Waarom moet je voorzichtig zijn met Napoleons memoires van Sint-Helena?","Hij schreef ze in ballingschap, vol propaganda over zijn eigen erfenis: ze tonen vooral hoe hij herinnerd wilde worden."]],"g":[["burgerlijk wetboek","Wetboek waarin de regels tussen burgers onderling en tussen burgers en goederen zijn opgetekend, zoals eigendomsrecht, erfrecht en familierecht."],["burgerlijke stand","Gemeentelijke dienst die officiële akten opmaakt van geboorte, huwelijk, scheiding en overlijden."],["innovatie","Proces van vernieuwing als gevolg van nieuwe inzichten en wetenschappelijk onderzoek."]],"bronnen":["h2b1","h2b6","h2b2"],"go":["go-h2-1"],"oef":["S2-2-1","S2-2-2","S2-2-3","2-2-1","2-2-2"]},{"id":"2.3","r":"H2","nr":"2.3","titel":"De val van Napoleon en Waterloo in onze herinnering","vraag":"Maakt de slag bij Waterloo terecht deel uit van onze collectieve herinnering?","niveau":"analyseren","cursus":"Lees in je cursus p. 45 en p. 50: ABBA en Waterloo. Noteer wat je niet begrijpt.","cornell":"Cornell-pagina H2 les 2","extra":["teksten Cobban, Broers, Gordley"],"doelen":["08.07","08.06","08.09"],"k":[["Je kan drie redenen geven waarom Napoleon uiteindelijk verloor.","08.07"],["Je kan met cijfers en teksten beargumenteren welke nederlaag het belangrijkst was — en zeggen welk criterium je gebruikt.","08.07"],["Je kan uitleggen waarom we Waterloo nog herdenken (monument, metrostation, lied).","08.09"]],"c":[["Waarom viel Napoleon?","Trafalgar (1805): Nelson vernietigt de Franse vloot. Mislukte Russische veldtocht (1812). De Continentale Blokkade tegen Engeland mislukt. Coalities van o.a. Groot-Brittannië, Rusland, Pruisen en Oostenrijk; zijn populariteit daalt door de constante oorlogen. 1814 Elba → 1815 honderd dagen → Waterloo (18 juni 1815)."],["Wat gebeurde er tussen 1814 en 1815?","1814: de coalitie valt Frankrijk aan en Napoleon wordt verbannen naar Elba. 1815: hij ontsnapt en herovert Frankrijk in \"honderd dagen\". 18 juni 1815: definitieve nederlaag bij Waterloo tegen het Brits-geallieerde leger van Wellington (met Britse, Nederlandse, Belgische en Duitse troepen) en het Pruisische leger van Blücher. Daarna ballingschap op Sint-Helena, waar hij zijn memoires schrijft."],["Waarom is Waterloo een voorbeeld van collectieve herinnering?","Het gaat niet alleen om wat er gebeurde, maar om de betekenis die we er later aan geven. Waterloo leeft voort in materieel erfgoed (monumenten op het slagveld, een station in Londen) en in immaterieel erfgoed (herdenkingen, re-enactments, het lied \"Waterloo\" van ABBA, 1974), en is zelfs een woord geworden voor een definitieve nederlaag."]],"g":[["collectieve herinnering","De betekenis die een grote groep mensen aan een gebeurtenis uit het verleden geeft."],["grootmacht","Staat die door haar economische, politieke en militaire macht invloed kan uitoefenen op de internationale politiek."]],"bronnen":["h2b7","h2b8"],"go":[],"oef":["S2-3-1","S2-3-2","S2-3-3","S2-3-4","S2-3-5"]},{"id":"2.4","r":"H2","nr":"2.4","titel":"Het Congres van Wenen hertekent Europa","vraag":"Welke doelen wilden de grootmachten op het Congres van Wenen bereiken, en met welke middelen?","niveau":"begrijpen","cursus":"Lees in je cursus p. 46-48. Cursus p. 50-51: spotprent op het Congres (opdracht 3). Noteer wat je niet begrijpt.","cornell":"Cornell-pagina H2 les 3","extra":["hand-out Napoleon","kaart Europa 1815"],"doelen":["08.01","08.02","08.04.01"],"k":[["Je kan met twee kaarten tonen wat Frankrijk verloor en wie er groter werd.","08.01"],["Je kan bij elk middel van het Congres een voorbeeld geven — ook uit onze eigen streken.","08.02"],["Je kan uitleggen welke kritiek een spotprent op het Congres geeft.","08.06"]],"c":[["Wat waren de vijf hoofddoelen van het Congres van Wenen?","Restauratie van het Ancien Régime (oude monarchieën terug) · rust en orde, geen nieuwe revoluties · Franse expansie voorkomen (Frankrijk inkapselen) · machtsevenwicht herstellen · Frankrijk straffen."],["Welke vier middelen gebruikte het Congres? Geef bij elk een voorbeeld.","Legitimiteitsprincipe: \"rechtmatige\" vorsten krijgen hun troon terug (geformuleerd door Talleyrand). Grote Alliantie: militaire alliantie van grootmachten tegen revolutionaire opstanden. Bufferstaten rond Frankrijk: Verenigd Koninkrijk der Nederlanden, Piemont-Sardinië. Territoriale wijzigingen: Frankrijk geeft veroveringen terug, Oostenrijk, Pruisen en Rusland breiden uit."],["Wie drukte zijn stempel op het Congres?","Metternich, minister van Buitenlandse Zaken van Oostenrijk."],["Hoe zag de kaart van Europa er na 1815 uit?","Polen wordt opnieuw verdeeld: het grootste deel wordt een koninkrijk onder de Russische tsar, de rest gaat naar Pruisen en Oostenrijk · de Duitse Bond vervangt het Heilige Roomse Rijk · het VKN ontstaat · Zwitserland wordt neutraal · Italië blijft versnipperd."],["Wat bedoelde men met \"Le congrès danse\"?","Overdag werd er politiek onderhandeld, 's avonds gefeest op bals — diplomatiek entertainment."]],"g":[["restauratie","Herstel, bijvoorbeeld van de oude politieke en territoriale macht."],["legitimiteitsbeginsel","Heersers erkennen op basis van historische traditie (wie had voorheen de macht) en internationale erkenning."],["machtsevenwicht","Politiek en meestal ook militair evenwicht tussen machtige staten die samenwerken om spanningen te voorkomen en stabiliteit te garanderen."],["bufferstaat","Meestal kleinere staat die tussen twee vijandige staten ligt."],["grootmacht","Staat die door haar economische, politieke en militaire macht invloed kan uitoefenen op de internationale politiek."],["territoriale wijzigingen","Wijze waarop het grondgebied en de grenzen veranderen doorheen de tijd."]],"bronnen":["h2b3"],"go":[],"oef":["S2-4-1"]},{"id":"2.5","r":"H2","nr":"2.5","titel":"Slaagde het Congres? Een voorlopig oordeel","vraag":"Slaagde het Congres van Wenen erin om Europa duurzaam te stabiliseren?","niveau":"evalueren","cursus":"Bekijk in je cursus p. 48-49: evaluatieschema ‘slaagde het Congres?’. Noteer wat je niet begrijpt.","cornell":"Cornell-pagina H2 les 4","extra":["argumentatie- en evaluatieschema"],"doelen":["08.07","08.08","07.04"],"k":[["Je kan argumenten geven voor en tegen het succes van het Congres.","08.07"],["Je kan een voorlopig oordeel schrijven — dat je later nog mag bijstellen.","08.07"],["Je hebt één keer geoefend hoe een bronvraag op de toets eruitziet.","08.06"]],"c":[["Waarom kun je zeggen dat het Congres op korte termijn slaagde?","Frankrijk werd ingekapseld, de bufferstaten werkten en Europa kende zo'n 40 jaar relatieve vrede."],["Waarom mislukte het Congres op lange termijn?","Nationalisme en liberalisme groeiden en de moderne ideeën lieten zich niet uitwissen. Bewijs: het VKN valt uiteen in 1830, revoluties in 1830 en 1848, de industrialisatie verandert alles."],["Hoe verschillen Jarrett en Zamoyski over het Congres?","Jarrett (2013): geen pure restauratie, maar een pragmatische poging tot internationale samenwerking voor vrede en stabiliteit. Zamoyski (2014): benadrukt het repressieve karakter en de angst voor revolutie."]],"g":[["conservatief","Behoudsgezind, gericht op het bewaren van tradities of de bestaande maatschappelijke orde."],["burgerij","Socio-economische klasse die haar vermogen niet met grondbezit opbouwde, maar via handel, industrie of andere zakelijke activiteiten."],["alliantie","Bondgenootschap."]],"bronnen":[],"go":[],"oef":["S2-5-1","2-5-1"]},{"id":"3.1","r":"H3","nr":"3.1","titel":"Liberalisme: vrijheid voor wie?","vraag":"Voor wie gold de vrijheid van het 19e-eeuwse liberalisme eigenlijk?","niveau":"analyseren","cursus":"Lees in je cursus p. 54-58. Noteer wat je niet begrijpt.","cornell":"Cornell-pagina H3 les 1 en 2","extra":["hand-out Hoofdstuk 3"],"doelen":["08.07","08.02","07.01.02","08.04.01"],"k":[["Ik kan uitleggen waarom de restauratie na 1815 niet kon standhouden.","08.07"],["Ik kan uitleggen wat politiek en economisch liberalisme inhouden.","07.01"],["Ik kan met bronnen tonen wat de revolutionairen van 1848 wilden en wat ze bereikten.","08.06"],["Ik kan met bronnen tonen dat ‘vrijheid voor iedereen’ toen niet voor iedereen gold.","08.02"]],"c":[["Welke nieuwe sociale realiteiten maakten een terugkeer onmogelijk?","De burgerij had economische macht verworven · de industrialisering creëerde nieuwe behoeften · ideeën verspreidden zich via drukpers en transport · bij verschillende volkeren was een nationale identiteit ontwaakt."],["Noem de vier kernprincipes van het liberalisme.","Negatieve vrijheid (afwezigheid van dwang) · natuurrechten (leven, vrijheid, eigendom) · beperkte overheidsmacht · individuele autonomie."],["Wat zijn de kernideeën van John Locke?","Natuurrechten gaan vooraf aan elke regering. Sociaal contract: de regering dient het volk, niet omgekeerd. Schendt de regering die rechten, dan heeft het volk recht op verzet."],["Wat zijn de kernideeën van Adam Smith?","\"Onzichtbare hand\": eigenbelang leidt tot algemeen welzijn (de bakker bakt voor winst, maar zo heeft iedereen brood). Laissez-faire, vrije concurrentie, afschaffing van gilden en monopolies. De overheid is een nachtwakersstaat: veiligheid, eigendom beschermen, publieke werken."],["Wat is cijnskiesrecht, en waarom waren 19e-eeuwse liberalen niet automatisch democratisch?","Alleen wie genoeg belasting betaalt, mag stemmen (\"wie betaalt, heeft belang bij goed bestuur\"). Zo bepaalt een kleine elite de politiek: in België mocht in 1830 ongeveer 1% van de bevolking stemmen."],["Wat is de sociale contradictie van het liberalisme? Geef een voorbeeld.","Liberalen spreken over vrijheid en gelijkheid, maar creëren nieuwe ongelijkheid. Wet-Le Chapelier (1791): vrije toegang tot beroepen, maar een verbod op vakbonden. Zonder sociale wetgeving: lange werkdagen en kinderarbeid — een hongerige arbeider is niet echt vrij."]],"g":[["industrialisering","Proces van veranderingen in de productie door mechanisering en automatisering, en de veranderingen in de organisatie van de arbeid die daarop volgden."],["burgerij","Socio-economische klasse die haar vermogen opbouwde via handel, industrie of andere zakelijke activiteiten."],["liberaal","Belang hechten aan een zo ruim mogelijke individuele vrijheid en minimale inmenging van de overheid."],["cijnskiesrecht","Kiessysteem waarbij enkel burgers die in een hogere belastingcategorie zitten, kunnen stemmen."],["algemeen stemrecht","Kiessysteem waarbij elke volwassen burger stemrecht mag uitoefenen."],["democratie","Bestuursvorm waarbij het volk rechtstreeks of via vertegenwoordiging de wetten stemt en waarin de vrijheden van burgers en minderheden door een grondwet worden beschermd."]],"bronnen":["h3b1","h3b2","h3b3","h3b4"],"go":[],"oef":["S3-1-1","S3-1-2","S3-1-3","S3-1-4","3-1-1"]},{"id":"3.2","r":"H3","nr":"3.2","titel":"Nationalisme: wat maakt een volk tot een natie?","vraag":"Wat maakt een volk tot een natie, en hoe bouwde de 19e-eeuwse elite een sterke natie uit?","niveau":"analyseren","cursus":"Lees in je cursus p. 58-61. Noteer wat je niet begrijpt.","cornell":"Cornell-pagina H3 les 3","extra":["hand-out Hoofdstuk 3","schilderij Guldensporenslag (De Keyser)"],"doelen":["07.02","08.09","08.04.02"],"k":[["Ik kan drie oorzaken geven waarom het nationalisme in de 19e eeuw opkwam.","08.07"],["Ik kan het verschil uitleggen tussen staatsnationalisme en volksnationalisme, met twee bronnen.","07.02"],["Ik kan uitleggen hoe kunst en monumenten helpen om een natie te ‘maken’.","08.09"]],"c":[["Welke kenmerken kunnen een volk tot een natie maken — en waarom is dat geen sluitende lijst?","Taal, grondgebied, geschiedenis, afkomst, godsdienst, cultuur. Bij elk kenmerk zijn er problemen (zelfde taal ≠ zelfde natie, betwist grondgebied, afstamming vaak fictief…): nationale identiteit is grotendeels een constructie."],["Wat zijn de drie katalysatoren van het moderne nationalisme?","Franse Revolutie (van onderdanen naar burgers, levée en masse, symbolen zoals Marseillaise en driekleur) · Napoleontische overheersing (weerstand, Duitse theorie van de \"volksgeest\") · Congres van Wenen (legitimiteitsprincipe negeert de volkssoevereiniteit, volkeren behandeld als bezit van dynastieën)."],["Wat is het verschil tussen staatsnationalisme en volksnationalisme?","Staatsnationalisme: burgerschap van de staat is het criterium — inclusief, iedereen kan lid worden (Frans model). Volksnationalisme: etnische of culturele kenmerken — exclusief, geboorte bepaalt het lidmaatschap (Duits model)."],["Wat is het verschil tussen middelpuntzoekend en middelpuntvliedend nationalisme?","Middelpuntzoekend: een verdeelde natie verenigen (Duitse en Italiaanse eenmaking). Middelpuntvliedend: een natie losmaken uit een multinationale staat (Belgische onafhankelijkheid 1830; vandaag Catalaans en Schots nationalisme)."],["Welke drie verhoudingen tussen natie en staat bestaan er?","Een staat met meerdere naties (België) · een verdeelde natie over meerdere staten (Koerden) · een natiestaat (staat = natie)."]],"g":[["natie","Gemeenschap van mensen die zich verbonden voelen door gedeelde kenmerken, zoals taal, geschiedenis en culturele tradities."],["nationalisme","Politieke ideologie die stelt dat elk volk met een historisch gegroeide culturele eenheid het recht heeft om een staat of politieke eenheid te vormen."],["nationale identiteit","Gemeenschapsgevoel binnen een natiestaat dat vaak voortkomt uit gemeenschappelijke waarden, geschiedenis of tradities."],["zelfbeschikking","Recht van een individu of van burgers in een land om zelfstandig eigen keuzes te maken."],["voertaal","Taal die door de meeste mensen in een gebied wordt gesproken."]],"bronnen":["h3b5","h3b6"],"go":["go-h3-1"],"oef":["S3-2-1","S3-2-2","S3-2-3","S3-2-4","3-2-1"]},{"id":"3.3","r":"H3","nr":"3.3","titel":"Wij-zij-denken: van trots tot uitsluiting","vraag":"Hoe kan trots op de eigen cultuur escaleren tot wij-zij-denken en uitsluiting?","niveau":"toepassen","cursus":"Lees in je cursus p. 62-63: het escalatieproces van wij-zij-denken. Noteer wat je niet begrijpt.","cornell":"Cornell-pagina H3 les 4","extra":["hand-out Hoofdstuk 3","actuele voorbeelden"],"doelen":["07.02","07.03","08.04.03","08.09"],"k":[["Ik kan de vier fases van wij-zij-denken herkennen in een bron.","07.02"],["Ik kan uitleggen hoe taal en beelden een vijandbeeld opbouwen.","08.06"],["Ik kan neutraal beschrijven wat ik zie, zonder zelf partij te kiezen.","07.03"]],"c":[["Wat zijn de vier fasen van het escalatieproces van wij-zij-denken?","1) Positieve identiteit: trots, gemeenschapsgevoel — nog geen bedreiging. 2) Vergelijking: \"wij zijn anders dan zij\", competitie. 3) Superioriteit: \"wij zijn beter\", discriminatie, tweederangsburgers. 4) Uitsluiting en geweld: de ander als bedreiging, etnische zuiveringen, oorlog."],["Hoe werd nationale identiteit in de 19e eeuw \"gemaakt\"?","Romantiek als basis (emotie, traditie, volksgeest). Schrijvers (Conscience, De Leeuw van Vlaanderen, 1838), historici die het verleden herschrijven, taalkundigen die dialecten standaardiseren, kunstenaars met nationale symbolen."],["Wat bedoelt men met een \"ingebeelde gemeenschap\"?","Mensen voelen zich met elkaar verbonden zonder elkaar te kennen."],["Hoe bespreek je wij-zij-denken in een actueel voorbeeld zonder zelf partij te kiezen?","Je beschrijft met feiten en bronnen welke fase je herkent, je laat verschillende perspectieven aan bod komen, je vermijdt veralgemeningen en je geeft geen eigen politiek oordeel."]],"g":[["wij-zij-denken","Denken in groepen en tegenstellingen, zwart-witdenken over groepen in de samenleving."],["discriminatie","Mensen of groepen ongelijk behandelen omwille van persoonlijke of uiterlijke kenmerken."],["romantiek","Kunststroming van de 19e eeuw die reageerde op de rationele verlichting en waarin persoonlijke emoties, dramatiek en heimwee naar het verleden centraal stonden."]],"bronnen":["h3b6","h6b1"],"go":[],"oef":["3-3-1"]},{"id":"3.4","r":"H3","nr":"3.4","titel":"Liberalisme en nationalisme: vroeger en vandaag","vraag":"Hoe verhouden liberalisme en nationalisme zich tot elkaar — vroeger en vandaag?","niveau":"toepassen","cursus":"Lees in je cursus p. 63-66. Noteer wat je niet begrijpt.","cornell":"Cornell-pagina H3 les 5","extra":["hand-out Hoofdstuk 3","partijprogramma's"],"doelen":["07.01","07.01.02","08.04.03","07.04"],"k":[["Ik kan zeggen wat liberalisme en nationalisme gemeen hebben en waar ze botsen.","07.01"],["Ik kan uitleggen wat mijn eigen kijk kleurt, en luisteren naar die van een ander.","08.08"],["Ik kan mijn oordeel over het Congres van Wenen onderbouwen met wat ik in hoofdstuk 3 leerde.","08.07"]],"c":[["Geef twee gemeenschappelijke wortels van liberalisme en nationalisme.","Beide zijn kinderen van de Verlichting en de Franse Revolutie: anti-absolutistisch, volkssoevereiniteit, tegen privileges en standenmaatschappij, voor een rationele staatsstructuur."],["Wanneer werkten ze in de 19e eeuw samen?","Belgische Revolutie (1830): liberale rechten + nationale onafhankelijkheid. Duitse en Italiaanse eenmaking: nationale eenheid + constitutionele monarchie."],["Geef twee fundamentele spanningen tussen beide.","Individuele rechten vs. collectieve identiteit · universele rechten vs. rechten voor leden van de natie · inclusief vs. mogelijk exclusief · vrije handel vs. mogelijk protectionisme."],["Hoe herken je 19e-eeuws liberalisme in België vandaag?","Partijen die zich erfgenaam van het liberalisme noemen, verdedigen o.a. de rechtsstaat, Europese integratie, individuele autonomie in ethische kwesties en een vrije markt met sociale vangnetten."],["Waarom heeft een democratie volgens de cursus een balans tussen beide nodig?","Zonder liberalisme dreigt uitsluiting; zonder nationalisme ontbreekt een volksbasis."]],"g":[["inspraak","Belanghebbenden betrekken bij beslissingen."],["bestuurlijke organisatie","Wijze waarop een samenleving ingericht en bestuurd wordt."],["democratie","Bestuursvorm waarbij het volk rechtstreeks of via vertegenwoordiging de wetten stemt en waarin de vrijheden van de burgers en minderheden door een grondwet worden beschermd."]],"bronnen":["h3b7","h3b5"],"go":[],"oef":["S3-4-1","3-4-1"]}];

const LP_CUE_MINW = 4;     // woorden voor het antwoord op een herhalingsvraag opengaat
const LP_SAM_MINW = 30;    // woorden voor de samenvatting
const XP_LP_CUE   = 2;     // per herhalingsvraag (eerste poging)
const XP_LP_SAM   = 5;     // samenvatting ingediend (eerste keer)
const XP_LP_CHECK = 5;     // zelfcheck volledig ingevuld (eerste keer)

const V3 = { opd: [], fb: [], fbReadQ: {}, fbReplyQ: {}, lastSync: 0, curLes: null, hidden: new Set() };
// Zichtbaarheid (ingesteld door de leerkracht in het dashboard): 'H1'…'H6', 'H4IR', 'BB', 'les:H1-2'
const _VIS_LS = 'bronnenlab_verborgen';
try{ V3.hidden = new Set(JSON.parse(localStorage.getItem(_VIS_LS)||'[]')); }catch(e){}
function _vis(id){ return !V3.hidden.has(id); }
function _lesVis(l){ return _vis(l.r) && _vis('les:'+l.id); }
function _visStats(){
  const H=HOOFDSTUKKEN.filter(h=>_vis(h.id)); const nb=H.reduce((a,h)=>a+h.bronnen.length,0); const nv=H.reduce((a,h)=>a+h.bronnen.reduce((x,b)=>x+b.vragen.length,0),0);
  document.querySelectorAll('.js-nbronnen').forEach(e=>e.textContent=nb);
  if($('stat-bronnen')) $('stat-bronnen').textContent=nb; if($('stat-vragen')) $('stat-vragen').textContent=nv;
  const g=$('chapters-grid'); if(g){ g.style.display = H.length?'':'none'; const hd=g.previousElementSibling; if(hd&&hd.classList.contains('section-header')) hd.style.display = H.length?'':'none'; }
}

function _esc(s){ return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
function _lesById(id){ return LESSEN.find(l=>l.id===id); }
function _reeksById(id){ return REEKSEN.find(r=>r.id===id); }
function _lpKey(id, suf){ return 'lp:'+id+'#'+suf; }
function _lpGet(id, suf){ return ST.open[_lpKey(id,suf)] || null; }
function _goObj(id){ return GROTE_OEFENINGEN.find(g=>g.id===id); }
function _goDone(id){ const g=_goObj(id); return !!g && g.stappen.every((_,i)=>ST.goAssessments[id+'_'+i]); }
function _chapterOfBron(id){ const h=HOOFDSTUKKEN.find(h=>h.bronnen.some(b=>b.id===id)); return h?h.id:null; }
function _plain(s){ const d=document.createElement('div'); d.innerHTML=String(s||''); return d.textContent||''; }

// Debounced opslaan (vermijdt een serveroproep per klik)
let _lpSaveT = null;
function _lpSave(now, delay){
  clearTimeout(_lpSaveT);
  if(now){ _lpSaveT=null; saveProgress(); return; }
  _lpSaveT = setTimeout(()=>{ _lpSaveT=null; saveProgress(); }, delay||900);
}
window.addEventListener('pagehide', ()=>{ if(_lpSaveT){ clearTimeout(_lpSaveT); saveProgress(); } });

function _lpState(les){
  const cues = les.c.map((_,i)=>(_lpGet(les.id,'c'+i)||{}).a||'');
  const zc   = les.k.map((_,i)=>(_lpGet(les.id,'d'+i)||{}).a||'');
  const sam  = _lpGet(les.id,'sam');
  const sw   = String((_lpGet(les.id,'s')||{}).t||'').split(',');
  const bronDone = les.bronnen.filter(b=>ST.scores[b]).length;
  const goDone = les.go.filter(_goDone).length;
  const cuesDone = cues.filter(Boolean).length;
  const zcDone = zc.filter(Boolean).length;
  const samDone = !!(sam && sam.t);
  const oefNu = (les.oef||[]).map(id=>OEF[id]).filter(o=>o&&_isNu(o));
  const oefNuDone = oefNu.filter(o=>_oefState(o).done).length;
  const oefAll = (les.oef||[]).length, oefDone = (les.oef||[]).filter(id=>OEF[id]&&_oefState(OEF[id]).done).length;
  const complete = cuesDone===les.c.length && zcDone===les.k.length && samDone && oefNuDone===oefNu.length;
  const started = complete || cuesDone>0 || zcDone>0 || samDone || sw.includes('1') || oefDone>0 || (les.oef||[]).some(id=>Object.keys(ST.open).some(k=>k.startsWith('oef:'+id+'#')));
  return {cues, zc, cuesDone, cuesKnown: cues.filter(a=>a==='groen').length, zcDone, samDone,
          read: sw[0]==='1', cornell: sw[1]==='1', bronDone, goDone, complete, started, oefNu:oefNu.length, oefNuDone, oefAll, oefDone};
}
function _dot(a){ return a==='groen'?'🟢':a==='oranje'?'🟡':a==='rood'?'🔴':'⚪'; }

// ── HOME: leerpaden + opdrachten ──
function renderLeerpadenHome(){
  const grid = $('lp-grid'); if(!grid) return;
  const R = REEKSEN.filter(r=>_vis(r.id) && LESSEN.some(l=>l.r===r.id && _lesVis(l)));
  const sec=$('lp-section'); if(sec) sec.style.display = R.length?'':'none';
  grid.innerHTML = R.map(r=>{
    const L = LESSEN.filter(l=>l.r===r.id && _lesVis(l));
    const st = L.map(_lpState);
    const done = st.filter(s=>s.complete).length;
    const col = CH_COLORS[r.hId] || {c1:'#4f9cf9',c2:'#7ab8ff',border:'#1e3a6a'};
    return `<div class="chapter-card lp-card" onclick="showReeks('${r.id}')" style="--ch-c1:${col.c1};--ch-c2:${col.c2};--ch-border:${col.border}">
      <div class="ch-icon">${r.icon}</div>
      <span class="ch-period-badge">${_esc(r.label)} · ${L.length} lessen</span>
      <div class="ch-title">${_esc(r.titel)}</div>
      <div class="lp-dots">${st.map((s,i)=>`<span class="lp-dot ${s.complete?'ok':s.started?'busy':''}" title="Les ${i+1}: ${s.complete?'afgerond':s.started?'bezig':'nog niet gestart'}"></span>`).join('')}</div>
      <div class="ch-bron-count"><span>${done}/${L.length} lessen afgerond</span></div>
    </div>`;
  }).join('');
}

function _opdItemLabel(it){
  if(it.t==='bron'){ const b=getBron(it.id); return b?'🔍 Bron: '+_plain(b.titel):it.id; }
  if(it.t==='go'){ const g=_goObj(it.id); return g?'★ Grote oefening: '+_plain(g.titel):it.id; }
  if(it.t==='les'){ const l=_lesById(it.id); const r=l&&_reeksById(l.r); return l?'🧭 Leerpad '+(r?r.label+' · ':'')+'les '+l.nr+': '+l.titel:it.id; }
  if(it.t==='oef'){ const o=OEF[it.id]; return o?'✏️ '+o.chip.replace(/^(Extra|Klasopdracht) /,'')+' '+o.titel:it.id; }
  return it.id;
}
function _opdItemDone(op, it){
  const m = ST.open['opd:'+op.id+'#'+it.t+':'+it.id];
  if(m && m.a==='klaar') return true;
  if(it.t==='les'){ const l=_lesById(it.id); return !!(l && _lpState(l).complete); }
  if(it.t==='oef'){ const o=OEF[it.id]; return !!(o && _oefState(o).done); }
  return false;
}
function _opdMark(t, id, info){
  let changed=false;
  V3.opd.forEach(op=>{
    if(!op.items.some(it=>it.t===t && it.id===id)) return;
    const key='opd:'+op.id+'#'+t+':'+id;
    if(ST.open[key] && ST.open[key].a==='klaar') return;
    _openSet(key, {a:'klaar', t: info||''}); changed=true;
  });
  return changed;
}
function _opdOpen(t, id){
  ST.backTo = {type:'home'};
  if(t==='bron'){ ST.curChapter=_chapterOfBron(id); showExercise(id); }
  else if(t==='go'){ showGroteOefening(id); }
  else if(t==='les'){ showLes(id); }
  else if(t==='oef'){ _openItem('oef:'+id); ST.backTo={type:'home'}; }
}
function renderOpdrachtenHome(){
  const el = $('v3-opd-home'); if(!el) return;
  // leerpaden die al afgerond zijn ook als 'klaar' doorgeven
  let ch=false; V3.opd.forEach(op=>op.items.forEach(it=>{ if(it.t==='les' && _opdItemDone(op,it) && _opdMark('les',it.id,'')) ch=true; })); if(ch) _lpSave();
  if(!V3.opd.length){ el.innerHTML=''; return; }
  el.innerHTML = `<div class="opd-box">
    <div class="opd-head">📌 Opdrachten van je leerkracht</div>
    ${V3.opd.map(op=>{
      const n=op.items.length, d=op.items.filter(it=>_opdItemDone(op,it)).length;
      const dl=op.deadline?_daysTo(op.deadline):null, max=op.items.reduce((a,it)=>a+(it.max||0),0);
      const pt=_opdPunten(op);
      return `<div class="opd-card ${d===n?'done':''}">
        <div class="opd-top"><div class="opd-ring" style="--p:${n?Math.round(d/n*100):0}"><span>${d}/${n}</span></div>
          <div class="opd-ti"><div class="opd-titel">${_esc(op.titel||'Opdracht van '+new Date(op.ts).toLocaleDateString('nl-BE',{day:'numeric',month:'long'}))}</div>
          <div class="opd-meta">${op.deadline?`<span class="opd-dl ${dl!=null&&dl<=3?'warn':''}">⏰ ${_dmy(op.deadline)} · ${dl>1?'nog '+dl+' dagen':dl===1?'morgen!':dl===0?'vandaag!':'deadline voorbij'}</span>`:''}${max?`<span>🏅 ${pt?pt.s+'/'+pt.m+' punten':max+' punten te verdienen'}</span>`:''}</div></div></div>
        ${op.boodschap?`<div class="opd-msg">${_esc(op.boodschap)}</div>`:''}
        <details class="opd-det" ${n<=6?'open':''}><summary>${d===n?'✓ Alles ingevuld — bekijk de lijst':'Bekijk wat je nog moet doen ('+(n-d)+')'}</summary>
        <div class="opd-items">${op.items.map(it=>{
          const ok=_opdItemDone(op,it); const sc=it.t==='bron'?ST.scores[it.id]:null; const p=it.t==='oef'&&V3.punten&&V3.punten[it.id];
          return `<button class="opd-item ${ok?'ok':''}" onclick="_opdOpen('${it.t}','${it.id}')"><span class="opd-check">${ok?'✓':'○'}</span><span class="opd-lbl">${_esc(_opdItemLabel(it))}</span>${p?`<span class="opd-pt">${p.s}/${p.m}</span>`:it.max?`<span class="opd-pt off">${it.max} ptn</span>`:''}${!ok&&sc?`<span class="opd-hint">al gemaakt (${sc.stars}★) — maak opnieuw</span>`:''}</button>`;}).join('')}</div></details>
      </div>`;}).join('')}
  </div>`;
}

// ── TERUGNAVIGATIE ──
function _backTarget(){
  const b = ST.backTo;
  if(b && b.type==='les') return showLes(b.id);
  if(b && b.type==='home') return showHome();
  if(b && b.type==='inbox') return showInbox();
  if(b && b.type==='voortgang'){ ST.backTo=null; return showVoortgang(); }
  if(b && b.type==='begrippen'){ ST.backTo=null; return showBegrippen(); }
  return showChapter(ST.curChapter);
}
function _backLabel(){
  const b = ST.backTo;
  if(b && b.type==='les') return '← Terug naar de les';
  if(b && b.type==='home') return '← Terug naar home';
  if(b && b.type==='inbox') return '← Terug naar berichten';
  if(b && b.type==='voortgang') return '← Terug naar je voortgang';
  if(b && b.type==='begrippen') return '← Terug naar de begrippen';
  return '← Terug naar hoofdstuk';
}

// ── REEKS ──
function showReeks(rId){
  const r = _reeksById(rId); if(!r) return;
  ST.backTo = null;
  const L = LESSEN.filter(l=>l.r===rId && _lesVis(l));
  const col = CH_COLORS[r.hId] || {c1:'#4f9cf9'};
  $('reeks-content').innerHTML = `
    <button class="back-btn" onclick="showHome()">← Terug naar overzicht</button>
    <div class="chapter-header"><div class="lp-kicker" style="color:${col.c1}">${_esc(r.label)} · leerpad</div>
      <div class="chapter-title">${_esc(r.titel)}</div><div class="chapter-subtitle">${_esc(r.sub)}</div></div>
    <div class="bronnen-list">${L.map(l=>{ const s=_lpState(l); return `
      <div class="bron-item lp-les ${s.complete?'done':''}" onclick="showLes('${l.id}')">
        <div class="bron-left">
          <div class="bron-nr">Les ${l.nr}${s.complete?' · ✓ afgerond':s.started?' · bezig':''}</div>
          <div class="bron-titel">${_esc(l.titel)}</div>
          <div class="lp-hq-small">🔍 ${_esc(l.vraag)}</div>
          <div class="lp-chips"><span class="lp-chip">🧠 ${s.cuesKnown}/${l.c.length} gekend</span><span class="lp-chip">✅ ${s.zc.map(_dot).join('')}</span>${l.bronnen.length?`<span class="lp-chip">🔍 ${s.bronDone}/${l.bronnen.length} bronnen</span>`:''}</div>
        </div><span class="bron-arrow">›</span></div>`;}).join('')}</div>`;
  showView('view-reeks');
}

// ── LES ──
function showLes(id){
  const les = _lesById(id); if(!les) return;
  V3.curLes = id; ST.backTo = {type:'les', id};
  renderLes(les);
  showView('view-les');
}

function _swItems(les, s){
  return [
    {k:0, manual:true, done:s.read, html: /^(Lees|Bekijk)/.test(les.cursus) ? `📖 ${_esc(les.cursus.replace(/\s*Noteer wat je niet begrijpt\.?/,''))}` : `📖 Lees in je cursus <b>${_esc(les.cursus)}</b>`},
    {k:1, manual:true, done:s.cornell, html:`📝 Werk je <b>${_esc(les.cornell)}</b> af: notities rechts, sleutelvragen links, samenvatting onderaan`},
    {done:s.cuesDone===les.c.length, html:`🧠 Maak de Cornell-herhaling <span class="sw-n">${s.cuesDone}/${les.c.length}</span>`, href:'les-cues'},
    ...(les.oef&&les.oef.length?[{done: s.oefNu? s.oefNuDone===s.oefNu : s.oefDone===s.oefAll, html:`📝 Maak de oefeningen <span class="sw-n">${s.oefNu? s.oefNuDone+'/'+s.oefNu+' 📌' : s.oefDone+'/'+s.oefAll}</span>`, href:'les-oef'}]:[]),
    {done:s.samDone, html:`✍️ Beantwoord de historische vraag in je eigen woorden`, href:'les-sam'},
    ...(les.bronnen.length||les.go.length?[{done:s.bronDone===les.bronnen.length && s.goDone===les.go.length, html:`🔍 Oefen met de bronnen <span class="sw-n">${s.bronDone}/${les.bronnen.length}${les.go.length?' + grote oefening':''}</span>`, href:'les-bronnen'}]:[]),
    {done:s.zcDone===les.k.length, html:`✅ Doe de zelfcheck`, href:'les-check'},
  ];
}
function _swHTML(les, s){
  const swItems=_swItems(les,s);
  return `<ol class="sw-list">${swItems.map(x=>`<li class="sw-item ${x.done?'done':''}">
      ${x.manual?`<label><input type="checkbox" class="sw-cb" data-k="${x.k}" ${x.done?'checked':''}><span>${x.html}</span></label>`
                :`<span class="sw-auto">${x.done?'✓':'○'}</span><a href="#" onclick="document.getElementById('${x.href}').scrollIntoView({behavior:'smooth'});return false">${x.html}</a>`}
    </li>`).join('')}</ol>`;
}
function _progHTML(les, s){
  const swItems=_swItems(les,s); const d=swItems.filter(x=>x.done).length;
  return `<div class="les-progress"><div class="les-progress-bar" style="width:${Math.round(d/swItems.length*100)}%"></div></div>
    <div class="les-progress-lbl">${d}/${swItems.length} stappen van je studiewijzer${s.complete?' · <b>les afgerond ✓</b>':''}</div>`;
}
function renderLes(les){
  const r = _reeksById(les.r);
  const col = CH_COLORS[r.hId] || {c1:'#4f9cf9',c2:'#7ab8ff',border:'#1e3a6a'};
  const s = _lpState(les);
  const L = LESSEN.filter(l=>l.r===les.r && (_lesVis(l) || l===les)); const idx = L.indexOf(les);
  const prev = L[idx-1], next = L[idx+1];
  const doelChip = c=>{ const base=c.split('.').slice(0,2).join('.'); return `<span class="doel-chip" title="BV3_${c} — ${_esc(DOELEN[base]||'')}">${c}</span>`; };
  const swItems = _swItems(les, s);
  const fbFor = k=>V3.fb.find(f=>f.key===k);

  $('les-content').innerHTML = `
  <button class="back-btn" onclick="showReeks('${les.r}')">← ${_esc(r.label)} · ${_esc(r.titel)}</button>
  <div class="les-hero" style="--ch-c1:${col.c1};--ch-c2:${col.c2};--ch-border:${col.border}">
    <div class="lp-kicker">${_esc(r.label)} · les ${les.nr} · niveau: ${_esc(les.niveau)}</div>
    <h1 class="les-title">${_esc(les.titel)}</h1>
    <div class="les-hq"><div class="les-hq-lbl">🔍 Historische vraag</div><div class="les-hq-q">${_esc(les.vraag)}</div></div>
    <div id="les-prog">${_progHTML(les,s)}</div>
    <div class="les-tools">${_cuLesBtn(les)}<button class="les-cu-btn" onclick="ST.backTo={type:'les',id:'${les.id}'};showBegrippen('kaart','${r.hId&&r.hId.startsWith('H')?r.hId:''}')">🔤 Oefen de begrippen</button></div>
  </div>

  <section class="les-sec">
    <h2>🎯 Wat moet je kunnen?</h2>
    <ul class="les-kunnen">${les.k.map(([t,c])=>`<li><span>${_esc(t)}</span>${doelChip(c)}</li>`).join('')}</ul>
    <div class="les-doelen">Leerplandoelen: ${les.doelen.map(doelChip).join(' ')}</div>
  </section>

  <section class="les-sec">
    <h2>🗺️ Studiewijzer</h2>
    <div id="les-sw">${_swHTML(les,s)}</div>
    ${les.extra.length?`<div class="sw-extra">In de klas gebruiken we ook: ${les.extra.map(_esc).join(' · ')}</div>`:''}
  </section>

  <section class="les-sec">
    <h2>📌 Kernbegrippen</h2>
    <div class="begrip-grid">${les.g.map(([b,d])=>`<details class="begrip"><summary>${_esc(b)}</summary><div>${_esc(d)}</div></details>`).join('')}</div>
    <div class="les-tip">Probeer eerst zelf de betekenis te zeggen voor je een begrip openklikt.</div>
  </section>

  <section class="les-sec" id="les-cues">
    <h2>🧠 Cornell-herhaling <span class="sec-n" id="les-cues-n">${s.cuesKnown}/${les.c.length} gekend</span></h2>
    <p class="les-tip">Dek je notities af. Beantwoord elke sleutelvraag uit je hoofd (minstens ${LP_CUE_MINW} woorden). Open daarna het antwoord en beoordeel jezelf eerlijk — zo weet je wat je nog moet herhalen.</p>
    ${les.c.map(([q,a],i)=>`<div class="cue" id="cue-${i}">
      <div class="cue-q"><span class="cue-nr">${i+1}</span><span>${_esc(q)}</span></div>
      <textarea class="cue-ta" id="cue-ta-${i}" rows="2" placeholder="Jouw antwoord, uit je hoofd…"></textarea>
      <div class="cue-row"><span class="cue-st" id="cue-st-${i}"></span><button class="cue-btn locked" id="cue-btn-${i}">🔒 Toon antwoord</button></div>
      <div class="cue-ans" id="cue-ans-${i}">
        <div class="cue-ans-lbl">Antwoord uit je cursus</div><div class="cue-ans-t">${_esc(a)}</div>
        <div class="cue-judge"><span>Hoe goed wist je dit?</span>
          <button class="go-sa-btn" data-k="rood">✗ Niet gekend</button><button class="go-sa-btn" data-k="oranje">± Deels</button><button class="go-sa-btn" data-k="groen">✓ Gekend</button></div>
        <button class="ov-rewrite cue-retry" id="cue-retry-${i}">↻ Later opnieuw proberen</button>
      </div>
      ${fbFor(_lpKey(les.id,'c'+i))?`<div class="les-fb">💬 Je leerkracht reageerde op dit antwoord — <a href="#" onclick="showInbox();return false">bekijk bericht</a></div>`:''}
    </div>`).join('')}
  </section>

  ${_oefSectionHTML(les)}

  <section class="les-sec" id="les-sam">
    <h2>✍️ Cornell-samenvatting: beantwoord de historische vraag</h2>
    <p class="les-tip">Schrijf in je eigen woorden een antwoord op <i>${_esc(les.vraag)}</i> Bouw het zo op: <b>standpunt</b>, <b>twee argumenten met bewijs</b> uit minstens twee bronnen, een <b>tegenargument</b> en een <b>afweging</b> (Bronbox p. 22 en p. 27). Minstens ${LP_SAM_MINW} woorden. Je leerkracht kan je antwoord lezen en erop reageren.</p>
    ${_kaderHTML('sam', _lpKey(les.id,'sam'))}
    <textarea class="open-vraag-area" id="lp-sam" placeholder="Schrijf hier je antwoord in volzinnen…"></textarea>
    <div class="ov-footer"><span class="go-wordcount" id="lp-sam-wc">0 woorden</span><div class="go-wc-bar-wrap"><div class="go-wc-bar" id="lp-sam-bar"></div></div><span class="go-wc-hint" id="lp-sam-hint"></span></div>
    <div id="lp-sam-model"></div>
    <div class="go-selfassess crit" id="lp-sam-crit" style="display:none">${_critInner('sam','📊 Lees je antwoord nog eens. Vink eerlijk aan wat erin staat:')}</div>
    <div class="ov-actions"><button class="ov-rewrite" id="lp-sam-rw" style="display:none">↻ Herschrijven</button><button class="next-btn visible" id="lp-sam-btn">Indienen</button></div>
    ${fbFor(_lpKey(les.id,'sam'))?`<div class="les-fb">💬 Je leerkracht reageerde op je samenvatting — <a href="#" onclick="showInbox();return false">bekijk bericht</a></div>`:''}
  </section>

  ${(les.bronnen.length||les.go.length)?`<section class="les-sec" id="les-bronnen">
    <h2>🔍 Oefen met bronnen</h2>
    <p class="les-tip">Pas toe wat je in deze les leerde op echte historische bronnen.</p>
    <div class="bronnen-list">${les.bronnen.map(id=>{ const b=getBron(id); if(!b) return ''; const sc=ST.scores[id]; const h=HOOFDSTUKKEN.find(h=>h.bronnen.includes(b));
      return `<div class="bron-item ${sc?'done':''}" onclick="ST.backTo={type:'les',id:'${les.id}'};ST.curChapter='${h?h.id:''}';showExercise('${id}')">
        <div class="bron-left"><div class="bron-nr">${_esc(h?h.label:'')}</div><div class="bron-titel">${b.titel}</div><div class="bron-meta">${b.type} · ${b.datum}</div></div>
        ${sc?`<span class="bron-stars">${starsHTML(sc.stars||0,'.95rem')}</span>`:''}<span class="bron-arrow">›</span></div>`;}).join('')}
      ${les.go.map(gid=>{ const g=_goObj(gid); if(!g) return ''; const ok=_goDone(gid);
      return `<div class="bron-item-go ${ok?'done':''}" onclick="ST.backTo={type:'les',id:'${les.id}'};showGroteOefening('${gid}')">
        <div class="bron-left"><div class="bron-nr" style="color:var(--purple)">★ Grote oefening${ok?' · ✓':''}</div><div class="bron-titel">${g.titel}</div><div class="bron-meta">Synthese · 3 bronnen · BronBox stappenplan</div></div>
        <span class="go-badge-list">Synthese</span><span class="bron-arrow">›</span></div>`;}).join('')}
    </div></section>`:''}

  <section class="les-sec" id="les-check">
    <h2>✅ Zelfcheck</h2>
    <p class="les-tip">Lees elk doel. Kun je dit echt — zonder in je cursus te kijken?</p>
    ${les.k.map(([t,c],i)=>`<div class="zc-item" id="zc-${i}">
      <div class="zc-t">${_esc(t)}</div>
      <div class="go-sa-btns"><button class="go-sa-btn" data-k="rood">🔴 Nog niet</button><button class="go-sa-btn" data-k="oranje">🟡 Een beetje</button><button class="go-sa-btn" data-k="groen">🟢 Ik kan het</button></div>
    </div>`).join('')}
    <div class="zc-advice" id="zc-advice"></div>
  </section>

  <div class="les-nav">
    ${prev?`<button class="btn-sec" onclick="showLes('${prev.id}')">← Les ${prev.nr}</button>`:'<span></span>'}
    ${next?`<button class="btn-primary" onclick="showLes('${next.id}')">Les ${next.nr}: ${_esc(next.titel)} →</button>`:`<button class="btn-primary" onclick="showReeks('${les.r}')">Terug naar het leerpad</button>`}
  </div>`;

  _bindLes(les);
}

function _bindLes(les){
  _bindSw(les);

  // Cornell-herhaling
  les.c.forEach((_,i)=>{
    const key = _lpKey(les.id,'c'+i);
    const ta=$('cue-ta-'+i), btn=$('cue-btn-'+i), ans=$('cue-ans-'+i), st=$('cue-st-'+i), retry=$('cue-retry-'+i);
    const judge = ans.querySelectorAll('.go-sa-btn');
    let firstEver = !(ST.open[key] && ST.open[key].t);
    let cycleBase; // basis voor de herhaalplanning, enkel na een nieuwe poging
    const mark = k=>judge.forEach(b=>{ b.classList.remove('sel-rood','sel-oranje','sel-groen'); if(b.dataset.k===k) b.classList.add('sel-'+k); });
    const upd = ()=>{
      const w=_wordCount(ta.value);
      if(ta.readOnly){ st.textContent=''; return; }
      if(w>=LP_CUE_MINW){ btn.classList.remove('locked'); btn.textContent='▼ Toon antwoord'; st.textContent=''; }
      else { btn.classList.add('locked'); btn.textContent='🔒 Toon antwoord'; st.textContent = w? 'nog '+(LP_CUE_MINW-w)+' woord'+(LP_CUE_MINW-w===1?'':'en') : ''; }
    };
    ta.addEventListener('input', upd);
    btn.onclick = ()=>{
      if(btn.classList.contains('locked')) return;
      if(!ta.readOnly){
        firstEver = !(ST.open[key] && ST.open[key].t);
        cycleBase = _revBase(les.id, i);
        _openSet(key, {t: ta.value.trim().slice(0,800), w:_wordCount(ta.value), a:''});
        ta.readOnly=true; ta.classList.add('locked'); mark('');
        _lpSave();
      }
      ans.classList.add('visible'); btn.style.display='none';
    };
    judge.forEach(b=>b.onclick = ()=>{
      const had = !!(ST.open[key]||{}).a;
      _openSet(key, {a: b.dataset.k}); mark(b.dataset.k);
      if(cycleBase!==undefined){ _revSchedule(les.id, i, b.dataset.k, cycleBase); cycleBase=undefined; }
      if(firstEver && !had){ const r=b.getBoundingClientRect(); addXP(XP_LP_CUE, r.left+r.width/2, r.top); firstEver=false; }
      _lpAfterChange(les);
    });
    retry.onclick = ()=>{
      ta.readOnly=false; ta.classList.remove('locked'); ta.value=''; ans.classList.remove('visible');
      btn.style.display=''; upd(); ta.focus();
    };
    const prev = ST.open[key];
    if(prev && prev.t){ ta.value=prev.t; ta.readOnly=true; ta.classList.add('locked'); ans.classList.add('visible'); btn.style.display='none'; mark(prev.a||''); if(!prev.a) cycleBase=_revBase(les.id, i); }
    upd();
  });

  // samenvatting
  const sk=_lpKey(les.id,'sam'), sta=$('lp-sam'), sbtn=$('lp-sam-btn'), srw=$('lp-sam-rw');
  let pasted=false;
  sta.addEventListener('paste', e=>{ const t=(e.clipboardData||window.clipboardData)?.getData('text')||''; if(t.length>40) pasted=true; });
  const supd=()=>{
    const w=_wordCount(sta.value);
    $('lp-sam-wc').textContent = w+(w===1?' woord':' woorden');
    const bar=$('lp-sam-bar'); bar.style.width=Math.min(100,Math.round(w/LP_SAM_MINW*100))+'%'; bar.style.background=w>=LP_SAM_MINW?'var(--green)':'var(--blue)';
    const h=$('lp-sam-hint');
    if(sta.readOnly){ h.textContent='✓ Ingediend'; h.style.color='var(--green)'; sbtn.style.display='none'; srw.style.display='inline-block'; $('lp-sam-crit').style.display=''; return; }
    sbtn.style.display=''; srw.style.display='none'; $('lp-sam-crit').style.display='none';
    if(w>=LP_SAM_MINW){ sbtn.disabled=false; sbtn.style.opacity=1; h.textContent='✓ Je kunt indienen'; h.style.color='var(--green)'; }
    else { sbtn.disabled=true; sbtn.style.opacity=.45; h.textContent='nog '+(LP_SAM_MINW-w)+' woorden'; h.style.color=''; }
  };
  sta.addEventListener('input', supd);
  sbtn.onclick=()=>{
    if(_wordCount(sta.value)<LP_SAM_MINW) return;
    const first = !(ST.open[sk] && ST.open[sk].t);
    _openSet(sk, {t: sta.value.trim().slice(0,3000), w:_wordCount(sta.value), p: pasted?1:0, a:''});
    sta.readOnly=true; sta.classList.add('locked'); supd();
    if(first){ const r=sbtn.getBoundingClientRect(); addXP(XP_LP_SAM, r.left+r.width/2, r.top); }
    _lpAfterChange(les, true);
  };
  const samCrit=_critBind($('lp-sam-crit'), sk, color=>{ _openSet(sk,{a:color}); _lpAfterChange(les); });
  srw.onclick=()=>{ sta.readOnly=false; sta.classList.remove('locked'); pasted=false; samCrit.reset(); supd(); sta.focus(); };
  _kaderBind($('les-sam'));
  const ps=ST.open[sk]; if(ps && ps.t){ sta.value=ps.t; sta.readOnly=true; sta.classList.add('locked'); }
  supd();

  // zelfcheck
  les.k.forEach((_,i)=>{
    const key=_lpKey(les.id,'d'+i); const box=$('zc-'+i);
    const btns=box.querySelectorAll('.go-sa-btn');
    const mark=k=>btns.forEach(b=>{ b.classList.remove('sel-rood','sel-oranje','sel-groen'); if(b.dataset.k===k) b.classList.add('sel-'+k); });
    btns.forEach(b=>b.onclick=()=>{
      const before=_lpState(les).zcDone===les.k.length;
      _openSet(key,{a:b.dataset.k}); mark(b.dataset.k);
      const after=_lpState(les).zcDone===les.k.length;
      if(!before && after){ const r=b.getBoundingClientRect(); addXP(XP_LP_CHECK, r.left+r.width/2, r.top); }
      _zcAdvice(les); _lpAfterChange(les);
    });
    mark((ST.open[key]||{}).a||'');
  });
  _zcAdvice(les);
  _oefBind(les);
}

function _bindSw(les){
  document.querySelectorAll('#les-content .sw-cb').forEach(cb=>{
    cb.onchange = ()=>{
      const cur = String((_lpGet(les.id,'s')||{}).t||'0,0').split(',');
      cur[+cb.dataset.k] = cb.checked?'1':'0';
      _openSet(_lpKey(les.id,'s'), {t: cur.slice(0,2).map(x=>x==='1'?'1':'0').join(',')});
      _lpAfterChange(les);
    };
  });

}

function _lesPages(les){ const m=String(les.cursus).match(/p\. ?\d+(?:[-–]\d+)?(?: en p\. ?\d+(?:[-–]\d+)?)?/); return m?m[0]:les.cursus; }
function _zcAdvice(les){
  const el=$('zc-advice'); if(!el) return;
  const s=_lpState(les);
  if(s.zcDone<les.k.length){ el.innerHTML=''; return; }
  const weak = les.k.filter((_,i)=>s.zc[i]!=='groen');
  if(!weak.length){ el.innerHTML='<div class="zc-ok">💪 Top! Je geeft aan dat je alles kunt. Test het: kun je de historische vraag ook mondeling uitleggen aan iemand anders?</div>'; return; }
  el.innerHTML = `<div class="zc-tip"><b>Zo werk je verder aan:</b><ul>${weak.map(([t])=>`<li>${_esc(t)}</li>`).join('')}</ul>
    Herlees je cursus (<b>${_esc(_lesPages(les))}</b>) en je Cornell-pagina, doe de herhalingsvragen die je nog niet kende opnieuw, en vraag het gerust aan je leerkracht.</div>`;
}

function _lpAfterChange(les, now, delay){
  const s=_lpState(les);
  if(s.complete) _opdMark('les', les.id, '');
  _lpSave(now, delay);
  const on=$('les-oef-n'); if(on) on.textContent=s.oefNuDone+'/'+s.oefNu+' 📌-oefeningen klaar';
  const p=$('les-prog'), w=$('les-sw'), n=$('les-cues-n');
  if(p) p.innerHTML=_progHTML(les,s);
  if(w){ w.innerHTML=_swHTML(les,s); _bindSw(les); }
  if(n) n.textContent=s.cuesKnown+'/'+les.c.length+' gekend';
}

// ── BERICHTEN (feedback van de leerkracht) ──
function _v3Load(data){
  if(!data) return;
  if(Array.isArray(data.opdrachten)) V3.opd = data.opdrachten;
  if(Array.isArray(data.feedback)) V3.fb = data.feedback;
  if(Array.isArray(data.verborgen)){ V3.hidden = new Set(data.verborgen); try{ localStorage.setItem(_VIS_LS, JSON.stringify(data.verborgen)); }catch(e){} }
  V3.lastSync = Date.now();
  _inboxBadge();
}
function _v3SavePayload(){
  const p = {};
  const r = Object.keys(V3.fbReadQ); if(r.length) p.fbRead = r;
  if(Object.keys(V3.fbReplyQ).length) p.fbReply = Object.assign({}, V3.fbReplyQ);
  return p;
}
function _v3AfterSave(res){
  V3.fbReadQ = {}; V3.fbReplyQ = {};
  _v3Load(res);
}
async function _v3Sync(force){
  if(!force && Date.now()-V3.lastSync < 60000) return;
  const student=_gsStudent(); if(!student) return;
  V3.lastSync = Date.now();
  try{
    const res = await _gsPost({action:'inbox', student, code:_gsCode(), pin:_gsPin()});
    if(res && res.ok){ _v3Load(res); if($('view-home').classList.contains('active')) renderHome(); }
  }catch(e){}
}
function _inboxBadge(){
  const btn=$('btn-inbox'); if(!btn) return;
  const unread = V3.fb.filter(f=>f.unread).length;
  btn.style.display = (V3.fb.length||V3.opd.length) ? 'inline-block' : 'none';
  const b=$('inbox-badge'); if(b){ b.textContent = unread||''; b.style.display = unread?'inline-block':'none'; }
}
function _keyLabel(k){
  k=String(k);
  if(k==='vraag:algemeen') return '✉️ Jouw vraag aan meneer Kestelyn';
  if(k.startsWith('vraag:')) return '✉️ Jouw vraag over '+_keyLabel(k.slice(6)).replace(/^Oefening /,'oefening ');
  if(k.startsWith('oef:')){ const o=OEF[k.slice(4).split('#')[0]]; return o ? 'Oefening '+o.chip+': '+o.titel : k; }
  if(k.startsWith('lp:')){
    const [id,suf]=k.slice(3).split('#'); const l=_lesById(id); const r=l&&_reeksById(l.r);
    const base = l ? (r?r.label+' · ':'')+'les '+l.nr+': '+l.titel : id;
    if(suf==='sam') return base+' — samenvatting';
    if(suf && suf[0]==='c') return base+' — herhalingsvraag '+(+suf.slice(1)+1);
    return base;
  }
  const b=getBron(k); if(b) return 'Bron: '+_plain(b.titel);
  const [g,s]=k.split('#'); const go=_goObj(g); if(go) return 'Grote oefening: '+_plain(go.titel)+' — stap '+(+s+1);
  return k;
}
function _keyQuestion(k){
  k=String(k); if(k.startsWith('vraag:')) return '';
  if(k.startsWith('oef:')){ const o=OEF[k.slice(4).split('#')[0]]; return o ? 'Les '+o.les+(o.taak[0]?' · '+o.taak[0]:'') : ''; }
  if(k.startsWith('lp:')){ const [id,suf]=k.slice(3).split('#'); const l=_lesById(id); if(!l) return '';
    if(suf==='sam') return l.vraag; if(suf&&suf[0]==='c') return (l.c[+suf.slice(1)]||[''])[0]; return ''; }
  const b=getBron(k); if(b) return _plain(b.open&&b.open.vraag);
  const [g,s]=k.split('#'); const go=_goObj(g); if(go&&go.stappen[+s]) return _plain(go.stappen[+s].taak);
  return '';
}
function _openItem(k){
  k=String(k).replace(/^vraag:/,''); ST.backTo={type:'inbox'};
  if(k==='algemeen') return;
  if(k.startsWith('oef:')){ const o=OEF[k.slice(4).split('#')[0]]; if(!o) return; showLes(o.les);
    setTimeout(()=>{ const a=$('oef-'+o.id); if(a){ const d=a.closest('details'); if(d) d.open=true; a.scrollIntoView({behavior:'smooth',block:'start'}); } },120); return; }
  if(k.startsWith('lp:')){ const [id,suf]=k.slice(3).split('#'); showLes(id); ST.backTo={type:'les',id};
    setTimeout(()=>{ const el=document.getElementById(suf==='sam'?'les-sam':(suf&&suf[0]==='c'?'cue-'+suf.slice(1):'les-check')); el&&el.scrollIntoView({behavior:'smooth',block:'center'}); },120); return; }
  if(getBron(k)) return showOpenOnly(k);
  const [g]=k.split('#'); if(_goObj(g)) showGroteOefening(g);
}
// Alleen de open vraag van een bron tonen (zonder de meerkeuzevragen opnieuw te scoren)
function showOpenOnly(bronId){
  const b=getBron(bronId); if(!b) return;
  ST.curBron=bronId; ST.curChapter=_chapterOfBron(bronId); ST.curQIdx=b.vragen.length; ST.curAnswers=[];
  renderSourceBlock(b); renderOpenVraag(b);
  const nb=$('next-btn'); nb.textContent=_backLabel(); nb.onclick=()=>_backTarget();
  $('ex-back-btn').textContent=_backLabel(); $('ex-back-btn').onclick=()=>_backTarget();
  showView('view-exercise');
}
function showInbox(){
  ST.backTo=null;
  const L=[...V3.fb].sort((a,b)=>String(b.laatst||'').localeCompare(String(a.laatst||'')));
  L.forEach(f=>{ if(f.unread){ V3.fbReadQ[f.key]=1; } });
  $('inbox-content').innerHTML = `
    <button class="back-btn" onclick="showHome()">← Terug naar home</button>
    <div class="chapter-header"><div class="chapter-title">💬 Berichten</div>
      <div class="chapter-subtitle">Reacties van je leerkracht op jouw antwoorden, en jouw vragen. Je kunt telkens één keer antwoorden of je antwoord herschrijven.</div></div>
    <div class="ib-ask"><div class="ib-ask-t">✉️ Stel een vraag aan meneer Kestelyn</div><div class="small">Zit je vast of is iets niet duidelijk? Hij krijgt meteen een melding.</div><div class="vq open" id="vq-algemeen">${_vraagForm('algemeen')}</div></div>
    ${L.length?L.map((f,i)=>{
      const mine=ST.open[f.key]; const last=f.thread[f.thread.length-1]; const eigen=f.thread.slice().reverse().findIndex(m=>m.v!=='ll'); const nLL=eigen<0?f.thread.length:eigen;
      const vraag=f.key.startsWith('vraag:'); const canReply = last && !V3.fbReplyQ[f.key] && (last.v==='lk' || (vraag && nLL<3));
      return `<div class="ib-card ${f.unread?'unread':''}">
        <div class="ib-lbl">${f.unread?'<span class="ib-new">nieuw</span>':''}${_esc(_keyLabel(f.key))}</div>
        ${_keyQuestion(f.key)?`<div class="ib-q">${_esc(_keyQuestion(f.key))}</div>`:''}
        ${mine&&mine.t?`<div class="ib-mine"><div class="ib-who">Jouw antwoord</div>${_esc(mine.t)}</div>`:''}
        <div class="ib-thread">${f.thread.map(m=>`<div class="ib-msg ${m.v==='lk'?'lk':'ll'}"><div class="ib-who">${m.v==='lk'?'Je leerkracht':'Jij'} · ${new Date(m.ts).toLocaleDateString('nl-BE',{day:'numeric',month:'short'})}</div>${_esc(m.t)}</div>`).join('')}</div>
        <div class="ib-actions">
          ${canReply?`<textarea class="ib-ta" id="ib-ta-${i}" rows="2" maxlength="1000" placeholder="Antwoord je leerkracht (optioneel)…"></textarea><button class="btn-sec" onclick="_ibReply(${i})">Verstuur</button>`:''}
          ${f.key==='vraag:algemeen'?'':`<button class="btn-primary" onclick="_openItem('${_esc(f.key)}')">✎ ${vraag?'Open de oefening':'Bekijk / herschrijf je antwoord'}</button>`}
        </div></div>`;}).join('')
    :'<div class="empty-note">Nog geen berichten. Als je leerkracht reageert op een antwoord, verschijnt dat hier.</div>'}`;
  V3.fb.forEach(f=>f.unread=false); _inboxBadge();
  showView('view-inbox');
  if(Object.keys(V3.fbReadQ).length) _lpSave();
  V3._ibList = L;
}
function _ibReply(i){
  const f=V3._ibList[i]; const ta=$('ib-ta-'+i); if(!f||!ta) return;
  const t=ta.value.trim(); if(!t) return;
  V3.fbReplyQ[f.key]=t.slice(0,1000);
  f.thread.push({v:'ll', t, ts:new Date().toISOString()});
  _lpSave(true);
  showInbox();
}

// ═══════════════════════════════════════
// v4 — ZELFBEOORDELING MET CRITERIA · SCHRIJFKADERS · HERHAALSTAPEL
// ═══════════════════════════════════════
const XP_GO_STAP = 20;   // vaste XP per beoordeelde stap — los van de kleur, zodat eerlijk beoordelen loont
const XP_REVIEW  = 1;    // per herhaalde vraag uit de herhaalstapel

const CRIT = {
  open: [
    'Ik geef een duidelijk antwoord op de vraag (een standpunt).',
    'Ik gebruik concreet bewijs uit de bron: een citaat, detail of verwijzing.',
    'Ik gebruik de juiste begrippen en wat ik al weet over de periode.',
    'Ik leg verbanden (oorzaak-gevolg, context, vergelijking) of houd rekening met wie de bron maakte en waarom.',
    'De kern van het modelantwoord staat ook in mijn antwoord.',
  ],
  sam: [
    'Ik geef een duidelijk standpunt als antwoord op de historische vraag.',
    'Ik geef een eerste argument met bewijs uit een bron.',
    'Ik geef een tweede argument met bewijs uit een andere bron.',
    'Ik geef een tegenargument (anderzijds …).',
    'Ik weeg alles af en kom tot een besluit, met de begrippen van deze les.',
  ],
};
// Schrijfkaders: uit de cursus (De Bronbox p. 19) en aangevuld voor argumenteren — enkel ter inspiratie, niet invoegbaar
const KADERS = {
  open: [
    ['Antwoord', ['Mijn antwoord op de vraag is …', 'De bron toont vooral dat …']],
    ['Bewijs uit de bron', ['Dat blijkt uit de bron, want de maker schrijft / toont …', 'Een detail dat dit bevestigt, is …']],
    ['Bruikbaar', ['De bron is wel / niet bruikbaar om meer te weten te komen over …', 'De bron geeft me enkel informatie over … Ik kan daardoor slechts een deel van de historische vraag beantwoorden.']],
    ['Betrouwbaar', ['De maker van de bron is goed / slecht geïnformeerd over …, en dus is de bron eerder wel / eerder niet betrouwbaar.', 'De bron werd gemaakt met als doel … Dat maakt de bron minder betrouwbaar in het licht van deze historische vraag, omdat …']],
    ['Context en verbanden', ['Dat past in de context van …, omdat …', 'Dit was een oorzaak / gevolg van …', 'Anderzijds moet je er rekening mee houden dat …']],
  ],
  sam: [
    ['Mijn standpunt', ['Mijn antwoord op de historische vraag is …']],
    ['Argument 1 + bewijs', ['Een eerste argument is … Dat blijkt uit bron …, waar staat: “…”']],
    ['Argument 2 + bewijs', ['Daarnaast … Bron … toont dat …']],
    ['Anderzijds …', ['Anderzijds kun je zeggen dat …, want …']],
    ['Alles afwegend …', ['Alles afwegend denk ik dat …, omdat …']],
  ],
};
const _CL = {groen:'🟢 Volledig correct', oranje:'🟡 Grotendeels correct', rood:'🔴 Nog te leren'};
const V4 = { kader: {}, rq: [], ri: 0, rKnown: 0 };

function _critColor(bits){ const n=bits.filter(Boolean).length; return n>=4?'groen':n>=2?'oranje':'rood'; }
function _critInner(set, intro){
  return `<div class="go-sa-label">${intro}</div>
    <div class="crit-list">${CRIT[set].map((c,i)=>`<label class="crit-row"><input type="checkbox" data-i="${i}"><span>${_esc(c)}</span></label>`).join('')}</div>
    <div class="crit-foot"><button class="crit-btn" type="button">Bevestig mijn beoordeling</button><span class="crit-res"></span></div>
    <div class="crit-note">4–5 vinkjes = 🟢 · 2–3 = 🟡 · 0–1 = 🔴. Eerlijk aanvinken loont: je XP hangt niet af van de kleur.</div>`;
}
// key = sleutel van het antwoord (bronId, goId#stap of lp:ID#sam); de vinkjes gaan naar 'k:'+key
function _critBind(box, key, onConfirm){
  const cbs=[...box.querySelectorAll('input[type=checkbox]')], res=box.querySelector('.crit-res'), btn=box.querySelector('.crit-btn');
  const show=c=>{ res.innerHTML = c ? '→ <b class="crit-'+c+'">'+_CL[c]+'</b>' : ''; };
  const prev=ST.open['k:'+key];
  if(prev && prev.t){ String(prev.t).split('|')[0].split(',').forEach((v,i)=>{ if(cbs[i]) cbs[i].checked = v==='1'; }); }
  const cur=(ST.open[key]||{}).a || (ST.goAssessments[String(key).replace('#','_')]||'');
  if(cur){ show(cur); if(!(prev && prev.t)) res.insertAdjacentHTML('beforeend',' <span class="crit-old">(eerdere beoordeling — vink aan om opnieuw te beoordelen)</span>'); }
  btn.onclick=()=>{
    const bits=cbs.map(c=>c.checked?1:0); const color=_critColor(bits);
    _openSet('k:'+key, {t: bits.join(',') + (V4.kader[key]?'|s':'')});
    show(color);
    onConfirm(color, btn);
  };
  return { reset(){ cbs.forEach(c=>c.checked=false); show(''); } };
}
function _kaderHTML(set, key){
  return `<div class="kader"><button type="button" class="kader-btn" data-key="${_esc(key)}">✍️ Schrijfkader tonen</button>
    <div class="kader-box">${KADERS[set].map(([t,zs])=>`<div class="kader-grp"><b>${_esc(t)}</b>${zs.map(z=>`<div class="kader-z">${_esc(z)}</div>`).join('')}</div>`).join('')}
    <div class="crit-note">Gebruik deze zinsaanzetten als steun — schrijf je antwoord wel in je eigen woorden.</div></div></div>`;
}
function _kaderBind(root){
  root.querySelectorAll('.kader-btn').forEach(b=>{
    b.onclick=()=>{ const box=b.nextElementSibling; const on=box.classList.toggle('visible');
      b.textContent = on ? '✍️ Schrijfkader verbergen' : '✍️ Schrijfkader tonen';
      if(on) V4.kader[b.dataset.key]=1; };
  });
}

// Open vraag bij een bron: criteria i.p.v. drie knoppen + schrijfkader
const _rovOrig = renderOpenVraag;
renderOpenVraag = function(b){
  _rovOrig(b);
  const ta=$('open-ta'); if(!ta) return;
  ta.insertAdjacentHTML('beforebegin', _kaderHTML('open', b.id));
  _kaderBind($('q-card'));
  const sa=$('ov-sa'); sa.classList.add('crit');
  sa.innerHTML=_critInner('open','📊 Leg je antwoord naast het model. Vink eerlijk aan wat er in jóuw antwoord staat:');
  const ctl=_critBind(sa, b.id, (color, btn)=>{
    const first=!(ST.open[b.id]||{}).a;
    _openSet(b.id, {a: color}); saveProgress();
    if(first){ const r=btn.getBoundingClientRect(); addXP(XP_OPEN, r.left+r.width/2, r.top); }
  });
  const rw=$('ov-rewrite'); if(rw) rw.addEventListener('click', ()=>ctl.reset());
};

// Grote oefening: idem per stap
const _rgoOrig = renderGroteOefening;
renderGroteOefening = function(go){
  _rgoOrig(go);
  go.stappen.forEach((s,i)=>{
    const key=go.id+'#'+i;
    const area=$('go-ta-'+i)?.closest('.go-input-area');
    if(area) area.insertAdjacentHTML('beforebegin', _kaderHTML('open', key));
    const sa=$('go-sa-'+i); if(!sa) return;
    sa.classList.add('crit');
    sa.innerHTML=_critInner('open','📊 Vergelijk met het model. Vink eerlijk aan wat er in jóuw antwoord staat:');
    _critBind(sa, key, color=>goAssess(i, color));
  });
  _kaderBind($('go-content'));
};

// ── HERHAALSTAPEL (gespreide herhaling van de Cornell-sleutelvragen) ──
// lp:ID#rN = 'niveau|vervaldatum'. Gekend → 3, 7, 21 dagen; daarna klaar. Deels → 3 dagen. Niet gekend → morgen.
const REV_GROEN = [3, 7, 21];
function _today(){ const d=new Date(); return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0'); }
function _addDays(n){ const d=new Date(); d.setDate(d.getDate()+n); return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0'); }
function _revSchedule(lesId, i, color, base){
  let lvl=parseInt(String(base||'0').split('|')[0])||0, days;
  if(color==='groen'){ lvl++; days = lvl>REV_GROEN.length ? null : REV_GROEN[lvl-1]; }
  else if(color==='oranje'){ lvl=Math.max(0,lvl-1); days=3; }
  else { lvl=0; days=1; }
  _openSet(_lpKey(lesId,'r'+i), {t: lvl+'|'+(days==null?'':_addDays(days))});
}
function _revBase(lesId, i){ return String((ST.open[_lpKey(lesId,'r'+i)]||{}).t||''); }
function _revDue(){
  const t=_today(), out=[];
  LESSEN.filter(_lesVis).forEach(l=>l.c.forEach((c,i)=>{ const r=_revBase(l.id,i); const due=r.split('|')[1]; if(due && due<=t) out.push({les:l, i}); }));
  return out;
}
function _renderRevHome(){
  const el=$('v4-rev-home'); if(!el) return;
  const due=_revDue();
  if(!due.length){ el.innerHTML=''; return; }
  const lessen=[...new Set(due.map(d=>d.les.id))].length;
  el.innerHTML=`<div class="rev-box" onclick="showHerhaal()">
    <div class="rev-ic">🔁</div>
    <div class="rev-t"><b>Herhaal vandaag: ${due.length} ${due.length===1?'vraag':'vragen'}</b><span>uit ${lessen} les${lessen===1?'':'sen'} · gespreid herhalen zorgt dat je het blijft onthouden</span></div>
    <span class="bron-arrow">›</span></div>`;
}
function showHerhaal(){
  const due=_revDue();
  for(let k=due.length-1;k>0;k--){ const j=Math.floor(Math.random()*(k+1)); [due[k],due[j]]=[due[j],due[k]]; }
  V4.rq=due.slice(0,10); V4.ri=0; V4.rKnown=0;
  _renderRev(); showView('view-herhaal');
}
function _renderRev(){
  const el=$('herhaal-content');
  if(V4.ri>=V4.rq.length){
    const left=_revDue().length;
    el.innerHTML=`<button class="back-btn" onclick="showHome()">← Terug naar home</button>
      <div class="rev-done"><div style="font-size:2.4rem">🎉</div><h2>Herhaling klaar</h2>
      <p>${V4.rKnown} van ${V4.rq.length} vragen gekend. Wat je nog niet kende, komt binnenkort terug.</p>
      ${left?`<button class="btn-primary" onclick="showHerhaal()">Nog ${left} te herhalen →</button>`:''}
      <button class="btn-sec" onclick="showHome()">Naar home</button></div>`;
    _lpSave(true); return;
  }
  const {les, i}=V4.rq[V4.ri]; const r=_reeksById(les.r); const [q,a]=les.c[i];
  const base=_revBase(les.id,i);
  el.innerHTML=`<button class="back-btn" onclick="_lpSave(true);showHome()">← Stoppen</button>
    <div class="ex-progress-wrap"><div class="ex-progress-track"><div class="ex-progress-fill" style="width:${V4.ri/V4.rq.length*100}%"></div></div><span class="ex-step">${V4.ri+1} / ${V4.rq.length}</span></div>
    <div class="cue rev-card">
      <div class="lp-kicker">${_esc(r.label)} · les ${les.nr}: ${_esc(les.titel)}</div>
      <div class="cue-q"><span class="cue-nr">?</span><span>${_esc(q)}</span></div>
      <textarea class="cue-ta" id="rev-ta" rows="3" placeholder="Jouw antwoord, uit je hoofd…"></textarea>
      <div class="cue-row"><span class="cue-st" id="rev-st"></span><button class="cue-btn locked" id="rev-btn">🔒 Toon antwoord</button></div>
      <div class="cue-ans" id="rev-ans"><div class="cue-ans-lbl">Antwoord uit je cursus</div><div class="cue-ans-t">${_esc(a)}</div>
        <div class="cue-judge"><span>Hoe goed wist je dit?</span><button class="go-sa-btn" data-k="rood">✗ Niet gekend</button><button class="go-sa-btn" data-k="oranje">± Deels</button><button class="go-sa-btn" data-k="groen">✓ Gekend</button></div></div>
    </div>`;
  const ta=$('rev-ta'), btn=$('rev-btn');
  ta.addEventListener('input',()=>{ const w=_wordCount(ta.value); const okk=w>=LP_CUE_MINW; btn.classList.toggle('locked',!okk); btn.textContent=okk?'▼ Toon antwoord':'🔒 Toon antwoord'; $('rev-st').textContent=okk||!w?'':'nog '+(LP_CUE_MINW-w)+' woord'+(LP_CUE_MINW-w===1?'':'en'); });
  btn.onclick=()=>{ if(btn.classList.contains('locked')) return; ta.readOnly=true; ta.classList.add('locked'); btn.style.display='none'; $('rev-ans').classList.add('visible'); };
  $('rev-ans').querySelectorAll('.go-sa-btn').forEach(b=>b.onclick=()=>{
    const k=b.dataset.k;
    _openSet(_lpKey(les.id,'c'+i), {t: ta.value.trim().slice(0,800), w:_wordCount(ta.value), a:k});
    _revSchedule(les.id, i, k, base);
    if(k==='groen') V4.rKnown++;
    const rr=b.getBoundingClientRect(); addXP(XP_REVIEW, rr.left+rr.width/2, rr.top);
    V4.ri++; _lpSave(); setTimeout(_renderRev, 250);
  });
  ta.focus();
}

// ═══════════════════════════════════════
// v5 — OEFENINGEN UIT DE OEFENBUNDEL · OPLOSSINGEN VIA DE SERVER
// ═══════════════════════════════════════
const OEF = {"S1-1-1":{"id":"S1-1-1","les":"1.1","soort":"S","chip":"Klasopdracht S1.1-1","nu":false,"ster":"","titel":"21 januari 1793: een terechtstelling","meta":"alleen","info":[["Bron","de gravure hieronder"],["Bronbox","p. 16 (referentiekader) en p. 22 (redeneerwijzen)"],["Je oefent","BV3_08.01 · referentiekader en structuurbegrippen begrijpen"]],"taak":["Bekijk de gravure. Zoek online wat er op 21 januari 1793 gebeurde."],"tabel":null,"vragen":[{"nr":"a","q":"Wie werd hier terechtgesteld? Waar gebeurde het?"},{"nr":"b","q":"Leg uit hoe het tot zo’n bloederig tafereel kon komen. Gebruik: politieke revolutie, monarchie, republiek, burgerrechten, vrijheid, gelijkheid, en de structuurbegrippen breuk, revolutie, oorzaak en gevolg. Onderstreep de begrippen in je antwoord."}],"hulp":["Zoekterm: ‘21 januari 1793 guillotine Parijs’.","Werk in drie stappen: hoe werd Frankrijk vóór 1789 bestuurd? Wat wilden de revolutionairen? Wat was het gevolg voor de koning?"],"codes":["08.01"],"bronnen":[{"titel":"De gravure van Sieveking (1793)","tekst":[],"woorden":"","duiding":"","ref":"© Uit het handboek Sapiens 5 — enkel voor gebruik in de klas","imgs":["data:image/jpeg;base64,"]}]},"1-1-1":{"id":"1-1-1","les":"1.1","soort":"X","chip":"Extra 1.1-1","nu":true,"ster":"basis","titel":"Twee stemmen over het ancien régime","meta":"duo · ± 20 min · cursus 4.1-4.2 · p. 33-34","info":[["Bron","bron 1 · Een bisschop over de macht van de koning · bron 2 · Het klaagschrift van een dorp"],["Bronbox","p. 18-19 (soort bron, bruikbaar en betrouwbaar) en p. 26 (leesstrategieën)"],["Je oefent","BV3_08.06 · een bron kritisch analyseren (soort, maker, doel) · BV3_08.02 · verbanden tussen domeinen analyseren"]],"taak":["Gebruik bron 1, bron 2 en de leesstrategieën (p. 26)."],"tabel":{"cols":["bron 1","bron 2"],"rijen":["Soort bron?","Wie maakte de bron? Voor wie? Waarom?","Welk kenmerk van het ancien régime zie je in de bron? Citeer."]},"vragen":[{"nr":"a","q":"Bossuet en de inwoners van Lauris kijken heel anders naar dezelfde orde. Hoe verklaar je dat verschil?"},{"nr":"b","q":"Is het klaagschrift representatief voor alle Fransen in 1789? Leg uit."},{"nr":"c","q":"Zoek in bron 2 een economische klacht (geld) en een sociale klacht (wie krijgt welke rechten). Leg uit hoe die twee met elkaar samenhangen."}],"hulp":["Lees eerst de bronduiding (↑): daar staat wie de maker is.","Citeer = schrijf een woord of zinsdeel uit de bron over tussen aanhalingstekens.","Zinsstarter: ‘Bossuet was … en had er belang bij dat … De inwoners van Lauris hoorden bij … en droegen …’","Representatief: is één dorp genoeg om iets te zeggen over héél Frankrijk?","Economisch = over geld, belastingen, inkomsten. Sociaal = over groepen en hun rechten."],"codes":["08.06","08.02"],"bronnen":[{"titel":"Bron 1: Een bisschop over de macht van de koning","tekst":["“God stelt de koningen aan als zijn dienaars en regeert door hen over de volkeren. […] Het koninklijk gezag is heilig. […] Men moet de vorst gehoorzamen op grond van een godsdienstig beginsel. […] Zonder dat absolute gezag kan hij het goede niet doen en het kwade niet bestraffen: zijn macht moet zo groot zijn dat niemand kan hopen eraan te ontsnappen.”"],"woorden":"gezag = de macht om te bevelen · vorst = koning","duiding":"Jacques-Bénigne Bossuet (1627-1704) was bisschop en hoftheoloog van koning Lodewijk XIV. Hij schreef dit werk voor de opvoeding van de kroonprins. Het verscheen pas na zijn dood.","ref":"Bron: Bossuet, J.-B. (1709). Politique tirée des propres paroles de l’Écriture sainte. Parijs, boek III en IV. Vertaald en ingekort.","imgs":[]},{"titel":"Bron 2: Het klaagschrift van een dorp","tekst":["“De adel geniet en bezit alles, en zou zich graag van alles bevrijden. Maar al voert de adel het leger aan, het is de derde stand die het leger vormt. […] Alleen de edelen genieten alle voorrechten: grondbezit, eerbewijzen, waardigheden, gunsten, pensioenen, het bestuur van het land en gratis scholen. […] [Wij klagen over] de enorme pensioenen die worden toegekend aan verachtelijke en sluwe hovelingen. […] De adel verbruikt het grootste deel van de inkomsten van de staat.”"],"woorden":"hovelingen = edelen die aan het hof van de koning leven · pensioenen = geld dat iemand elk jaar krijgt van de koning","duiding":"In de lente van 1789 stelde elke parochie een klaagschrift op met eisen voor de Staten-Generaal. Lauris is een dorp in de Provence (Zuid-Frankrijk).","ref":"Bron: Klaagschrift (cahier de doléances) van de parochie Lauris, sénéchaussée Aix (1789). In: Goubert, P. & Denis, M. (1964). 1789: les Français ont la parole. Parijs: Julliard, p. 72-73. Vertaald en ingekort via de Engelse vertaling op revolution.chnm.org.","imgs":[]}]},"S1-2-1":{"id":"S1-2-1","les":"1.2","soort":"S","chip":"Klasopdracht S1.2-1","nu":true,"ster":"","titel":"Continuïteit of breuk?","meta":"duo","info":[["Bron","het kader ‘scharniermoment en constructie achteraf’ en de tijdlijn hieronder"],["Bronbox","p. 16 (tijd en domeinen) en p. 22 (continuïteit en verandering)"],["Je oefent","BV3_08.01 · scharnierpunten en kenmerken van de moderne tijd begrijpen"]],"taak":["Lees het kader en bekijk de tijdlijn. Kies één domein waarin er eerder continuïteit is tussen de vroegmoderne en de moderne tijd, en één met een duidelijke breuk."],"tabel":{"cols":["Domein","Argumentatie"],"rijen":["Eerder continuïteit","Duidelijke breuk"]},"vragen":[],"hulp":["Continuïteit = iets loopt gewoon verder. Breuk = iets verandert plots en grondig.","Kijk op de tijdlijn welke balken al vóór 1789 beginnen en daarna doorlopen."],"codes":["08.01"],"bronnen":[{"titel":"Tijdlijn en kader","tekst":[],"woorden":"","duiding":"","ref":"© Uit het handboek Sapiens 5 — enkel voor gebruik in de klas","imgs":["data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,"]}]},"S1-2-2":{"id":"S1-2-2","les":"1.2","soort":"S","chip":"Klasopdracht S1.2-2","nu":false,"ster":"","titel":"Wat verandert er per domein?","meta":"alleen","info":[["Bron","de tekst ‘Op weg naar een moderne tijd’ hieronder"],["Bronbox","p. 16 (maatschappelijke domeinen)"],["Je oefent","BV3_08.04.02 · kenmerken vergelijken tussen periodes analyseren"]],"taak":["Geef voor elk domein één verschil tussen de vroegmoderne en de moderne tijd."],"tabel":{"cols":["Domein","Verschil tussen de vroegmoderne en de moderne tijd"],"rijen":["Politiek","Economisch","Cultureel","Sociaal"]},"vragen":[],"hulp":["Politiek = macht en bestuur · economisch = geld, werk, productie · cultureel = ideeën, wetenschap, kunst, godsdienst · sociaal = groepen en hun rechten."],"codes":["08.04.02"],"bronnen":[{"titel":"Op weg naar een moderne tijd","tekst":["Uit de tijdlijn kun je afleiden dat er een grote continuïteit was van de vroegmoderne","naar de moderne tijd binnen de verschillende domeinen van de samenleving. Maar een aantal","ontwikkelingen kwamen vanaf ca. 1800 in een stroomversnelling terecht.","Een eerste aspect was de vooruitgang binnen de wetenschappen en technologie, die leidde tot","de industriële revolutie. Machines namen steeds vaker het werk over. Die industrialisering begon","in Groot-Brittannië in de eerste helft van de 18e eeuw en zette zich in sneltempo voort","op het Europese vasteland. Een tweede aspect was het imperialisme. Vanaf het begin van","de vroegmoderne tijd begonnen sommige Europese staten de wereld te verkennen en veroveren.","In de moderne tijd kende het imperialisme een groei en gingen bijna alle Europese staten op zoek","naar koloniën. Als derde aspect kregen de nieuwe verlichtingsidealen, bedacht door de filosofen","in de vroegmoderne tijd, steeds meer invulling in de moderne tijd. Men dacht na over hoe","de samenleving georganiseerd moest worden. Politieke ideologieën zoals het liberalisme,","dat de vrijheid van het individu vooropstelt, wedijverden met opvattingen zoals het socialisme,","dat streeft naar meer gelijkheid voor iedereen.","Franse Revolutie","In 1789 brak de Franse Revolutie uit. Er volgde een periode van geweld waarbij koning Lodewijk XVI in 1792 het leven liet onder de guillotine. Buitenlandse vorsten zagen die gebeurtenissen als een enorme bedreiging voor hun eigen macht en vormden een coalitie of bondgenootschap tegen de Franse revolutionairen. Andere landen verklaarden Frankrijk daarom de oorlog. Ook binnen Frankrijk zelf was er veel onenigheid over de manier waarop het land bestuurd moest worden. Revolutionairen stonden daarbij tegenover koningsgezinden.","Napoleon: generaal, consul, keizer","Napoleon maakte carrière tijdens de Franse Revolutie waarbij hij de kant van","de revolutionairen koos. Zowel in binnen- als buitenland behaalde hij militaire","successen, waarbij grote delen van Europa door Frankrijk werden ingepalmd.","Op die manier werkte hij zich op tot opperbevelhebber van het Franse leger.","Gesteund door de grote populariteit die hij verwierf, pleegde hij een staatsgreep","waarna hij de totale macht in handen kreeg en zich ten slotte liet uitroepen tot","keizer van Frankrijk. Zo ontstond er een autoritair regime waarbij Napoleon geen tegenstand","duldde. Hij controleerde de pers en maakte gebruik van een spionagenetwerk om informatie","te verzamelen over vriend en vijand.","In 1804 werd onder zijn leiding de Code Civil, het Franse burgerlijk wetboek, opgesteld.","Kernpunten van het wetboek waren verlichtingswaarden zoals gelijkheid voor de wet en","persoonlijke vrijheid voor iedere burger. Ook de scheiding tussen de kerk en de staat en het recht op bezit werden erin opgenomen. De Code Civil werd in alle veroverde landen ingevoerd en zou later zo de nationale wetgevingen beïnvloeden."],"woorden":"","duiding":"","ref":"© Uit het handboek Sapiens 5 — enkel voor gebruik in de klas","imgs":[]}]},"1-2-1":{"id":"1-2-1","les":"1.2","soort":"X","chip":"Extra 1.2-1","nu":false,"ster":"basis","titel":"Bossuet tegenover 1789","meta":"alleen · ± 15 min · cursus 6 · p. 37-38","info":[["Bron","bron 3 · De Verklaring van de Rechten van de Mens en de Burger"],["Bronbox","p. 22 (continuïteit en verandering)"],["Je oefent","BV3_08.04.02 · vroegmoderne en moderne tijd vergelijken analyseren"]],"taak":["Vergelijk de bron van Bossuet (les 1.1) met bron 3. Citeer telkens uit beide bronnen."],"tabel":{"cols":["Bossuet (1709)","Verklaring (1789)","Breuk of continuïteit?"],"rijen":["Waar komt de macht vandaan?","Zijn alle mensen gelijk?","Mag je kritiek uiten?"]},"vragen":[],"hulp":["Zoek in de Verklaring het juiste artikel: macht → art. 3 · gelijkheid → art. 1 en 6 · kritiek → art. 11.","Breuk = plots en volledig anders. Continuïteit = het blijft hetzelfde."],"codes":["08.04.02"],"bronnen":[{"titel":"Bron 1: Een bisschop over de macht van de koning","tekst":["“God stelt de koningen aan als zijn dienaars en regeert door hen over de volkeren. […] Het koninklijk gezag is heilig. […] Men moet de vorst gehoorzamen op grond van een godsdienstig beginsel. […] Zonder dat absolute gezag kan hij het goede niet doen en het kwade niet bestraffen: zijn macht moet zo groot zijn dat niemand kan hopen eraan te ontsnappen.”"],"woorden":"gezag = de macht om te bevelen · vorst = koning","duiding":"Jacques-Bénigne Bossuet (1627-1704) was bisschop en hoftheoloog van koning Lodewijk XIV. Hij schreef dit werk voor de opvoeding van de kroonprins. Het verscheen pas na zijn dood.","ref":"Bron: Bossuet, J.-B. (1709). Politique tirée des propres paroles de l’Écriture sainte. Parijs, boek III en IV. Vertaald en ingekort.","imgs":[],"uit":"les 1.1"},{"titel":"Bron 3: De Verklaring van de Rechten van de Mens en de Burger","tekst":["“Art. 1. De mensen worden vrij en gelijk in rechten geboren, en blijven het. […]","Art. 3. Het beginsel van alle soevereiniteit berust wezenlijk in de natie. Geen instantie, geen individu kan gezag uitoefenen dat er niet uitdrukkelijk uit voortvloeit.","Art. 6. De wet is de uitdrukking van de algemene wil. […] Allen zijn gelijk voor de wet […].","Art. 11. De vrije uitwisseling van gedachten en meningen is een van de kostbaarste rechten van de mens; iedere burger kan dus vrijelijk spreken, schrijven en drukken […].”"],"woorden":"soevereiniteit = de hoogste macht in een staat · natie = het volk als geheel","duiding":"Zes weken na de bestorming van de Bastille stemde de Nationale Vergadering deze verklaring. Ze werd later de inleiding van de Franse grondwet van 1791.","ref":"Bron: Assemblée nationale constituante (26 augustus 1789). Déclaration des droits de l’homme et du citoyen. Parijs, art. 1, 3, 6 en 11. Vertaald en ingekort.","imgs":[]}]},"1-2-2":{"id":"1-2-2","les":"1.2","soort":"X","chip":"Extra 1.2-2","nu":false,"ster":"basis","titel":"Onze tijdlijn naast een andere","meta":"duo · ± 15 min · Bronbox 3.1 · p. 16","info":[["Bronbox","p. 16 (referentiekader: tijd)"],["Je oefent","BV3_08.05 · de westerse periodisering vergelijken met andere indelingen · BV3_08.01 · scharnierpunten analyseren"]],"taak":[],"tabel":null,"vragen":[{"nr":"a","q":"Napoleons burgerlijk wetboek werd afgekondigd op ‘30 ventôse jaar XII’ (ventôse liep van ongeveer 20 februari tot 20 maart). In welk jaar van onze kalender was dat? Toon hoe je rekende."},{"nr":"b","q":"Waarom wilden de revolutionairen een volledig nieuwe kalender? Welk verband zie je met ‘breuk’?"},{"nr":"c","q":"Vergelijk onze indeling (moderne tijd vanaf 1789) met de Nederlandse tijdvakken. Noteer één gelijkenis en één verschil."},{"nr":"d","q":"Waarom is elke indeling van de tijd een keuze van historici (een constructie)?"}],"hulp":["Jaar I begon in september 1792. Jaar II begon dus in september 1793. Tel verder tot jaar XII.","Onze kalender telt vanaf de geboorte van Christus en heeft kerkelijke feestdagen. Wat zegt het als je die vervangt?","Een periode heeft geen natuurlijk begin: historici kiezen achteraf een scharniermoment. Wie kiest, en waarom die datum?"],"codes":["08.05","08.01"],"bronnen":[{"titel":"Andere manieren om de tijd in te delen","tekst":["• De Franse revolutionairen voerden in oktober 1793 een eigen kalender in. Jaar I begon op 22 september 1792, de dag waarop de republiek werd uitgeroepen. De maanden kregen nieuwe namen, zoals vendémiaire, brumaire, pluviôse, ventôse en thermidor. Napoleon schafte die kalender af vanaf 1 januari 1806.","• In Nederland leren leerlingen geschiedenis met tien ‘tijdvakken’ van ongeveer een eeuw. Tijdvak 7 heet de ‘tijd van pruiken en revoluties’ (1700-1800), tijdvak 8 de ‘tijd van burgers en stoommachines’ (1800-1900)."],"woorden":"","duiding":"","ref":"","imgs":[]}]},"1-3-1":{"id":"1-3-1","les":"1.3","soort":"X","chip":"Extra 1.3-1","nu":true,"ster":"basis","titel":"Wie mocht er gelijk zijn?","meta":"duo · ± 15 min · cursus 9 · p. 39","info":[["Bron","bron 4 · Olympe de Gouges eist rechten voor vrouwen"],["Bronbox","p. 23 (multiperspectiviteit)"],["Je oefent","BV3_08.06 · multiperspectiviteit: bronnen vergelijken analyseren"]],"taak":[],"tabel":null,"vragen":[{"nr":"a","q":"Vergelijk artikel 1 en 6 van bron 4 met artikel 1 en 6 van de Verklaring van 1789 (les 1.2). Wat verandert De Gouges?"},{"nr":"b","q":"Wat zegt dat over voor wie de ‘gelijkheid’ van 1789 gold?"},{"nr":"c","q":"Lees de bronduiding. Welk verband is er met de Terreur?"}],"hulp":["Leg de twee artikelen 1 naast elkaar en onderstreep wat anders is.","Zinsstarter: ‘De Gouges voegt … toe. Dat toont dat in 1789 …’"],"codes":["08.06"],"bronnen":[{"titel":"Bron 4: Olympe de Gouges eist rechten voor vrouwen","tekst":["“Art. 1. De vrouw wordt vrij geboren en blijft gelijk aan de man in rechten. […] Art. 6. De wet moet de uitdrukking zijn van de algemene wil; alle burgeressen en burgers moeten persoonlijk of via hun vertegenwoordigers meewerken aan haar totstandkoming. […] Art. 10. […] De vrouw heeft het recht het schavot te beklimmen; zij moet evengoed het recht hebben de spreektribune te beklimmen.”"],"woorden":"schavot = verhoging waarop de guillotine staat · spreektribune = plaats in het parlement waar je een toespraak houdt","duiding":"Olympe de Gouges (1748-1793) was een Franse toneelschrijfster. Ze schreef haar verklaring als antwoord op de Verklaring van 1789. Op 3 november 1793 werd ze tijdens de Terreur zelf onthoofd.","ref":"Bron: Gouges, O. de (1791). Déclaration des droits de la femme et de la citoyenne. Parijs, art. 1, 6 en 10. Vertaald en ingekort.","imgs":[]},{"titel":"Bron 3: De Verklaring van de Rechten van de Mens en de Burger","tekst":["“Art. 1. De mensen worden vrij en gelijk in rechten geboren, en blijven het. […]","Art. 3. Het beginsel van alle soevereiniteit berust wezenlijk in de natie. Geen instantie, geen individu kan gezag uitoefenen dat er niet uitdrukkelijk uit voortvloeit.","Art. 6. De wet is de uitdrukking van de algemene wil. […] Allen zijn gelijk voor de wet […].","Art. 11. De vrije uitwisseling van gedachten en meningen is een van de kostbaarste rechten van de mens; iedere burger kan dus vrijelijk spreken, schrijven en drukken […].”"],"woorden":"soevereiniteit = de hoogste macht in een staat · natie = het volk als geheel","duiding":"Zes weken na de bestorming van de Bastille stemde de Nationale Vergadering deze verklaring. Ze werd later de inleiding van de Franse grondwet van 1791.","ref":"Bron: Assemblée nationale constituante (26 augustus 1789). Déclaration des droits de l’homme et du citoyen. Parijs, art. 1, 3, 6 en 11. Vertaald en ingekort.","imgs":[],"uit":"les 1.2"}]},"1-4-1":{"id":"1-4-1","les":"1.4","soort":"X","chip":"Extra 1.4-1","nu":false,"ster":"basis","titel":"Een lied uit 1792 dat Frankrijk nog altijd zingt","meta":"alleen · ± 20 min · Bronbox 3.3.5 · p. 24-25","info":[["Bron","bron 5 · De Marseillaise (1792)"],["Bronbox","p. 24-25 (betekenissen toelichten) en p. 23 (presentisme)"],["Je oefent","BV3_08.09 · persoonlijke betekenis en collectieve herinnering toelichten begrijpen"]],"taak":[],"tabel":null,"vragen":[{"nr":"a","q":"Wanneer en waarom werd het lied geschreven? Wie zijn volgens jou de ‘woeste soldaten’ en de ‘tirannie’?"},{"nr":"b","q":"Onder Napoleon en tijdens de Restauratie was het lied verboden, in 1830 en 1879 kwam het terug. Leg uit waarom."},{"nr":"c","q":"Waarom zingt Frankrijk dit lied vandaag nog? Welk doel heeft deze collectieve herinnering (p. 25)?"},{"nr":"d","q":"Vandaag klinkt ‘laat onzuiver bloed onze akkers doordrenken’ hard. Hoe moet je die zin begrijpen in de context van 1792? Let op presentisme (p. 23)."},{"nr":"e","q":"Persoonlijke betekenis: welk lied, welke plaats of welk feest betekent iets voor jou of je familie omdat het verbonden is met iets uit het verleden? Wat betekent het voor jou? (Je kiest zelf wat je deelt.)"}],"hulp":["Lees de bronduiding: met wie was Frankrijk in april 1792 in oorlog?","Napoleon was keizer, de Restauratie bracht koningen terug. Past een revolutionair lied bij hen?","Doelen van een collectieve herinnering (p. 25): identiteit, samenhorigheid, waarden doorgeven."],"codes":["08.09"],"bronnen":[{"titel":"Bron 5: De Marseillaise (1792)","tekst":["“Allons enfants de la Patrie, / Le jour de gloire est arrivé ! / Contre nous de la tyrannie / L’étendard sanglant est levé. / Entendez-vous dans les campagnes / Mugir ces féroces soldats ? / Ils viennent jusque dans vos bras / Égorger vos fils, vos compagnes ! / Aux armes, citoyens, / Formez vos bataillons, / Marchons, marchons ! / Qu’un sang impur / Abreuve nos sillons !”","Vertaling: “Vooruit, kinderen van het vaderland, de dag van de glorie is gekomen! Tegen ons is de bloedige vlag van de tirannie gehesen. Horen jullie op het platteland die woeste soldaten brullen? Ze komen tot in jullie armen om jullie zonen en vrouwen de keel af te snijden! Te wapen, burgers, vorm jullie bataljons, voorwaarts, voorwaarts! Laat onzuiver bloed onze akkers doordrenken!”"],"woorden":"tirannie = wreed, onrechtvaardig bestuur · bataljon = legereenheid · akkers = landbouwgrond","duiding":"Claude-Joseph Rouget de Lisle, een officier, schreef het lied in de nacht van 25 op 26 april 1792 in Straatsburg, kort nadat Frankrijk de oorlog had verklaard aan Oostenrijk. De titel was ‘Oorlogslied voor het Rijnleger’. Vrijwilligers uit Marseille zongen het in augustus 1792 in Parijs; zo kreeg het zijn naam. In 1795 werd het een nationaal lied. Onder Napoleon en tijdens de Restauratie was het verboden; in 1830 kwam het terug. In 1879 werd het officieel het volkslied van de Republiek, en de grondwet van 1958 (art. 2) bevestigt dat nog altijd.","ref":"Bron: Rouget de Lisle, C.-J. (1792). Chant de guerre pour l’armée du Rhin (La Marseillaise), eerste strofe en refrein. Vertaald. Feiten: Présidence de la République (s.d.). La Marseillaise de Rouget de Lisle. www.elysee.fr.","imgs":[]}]},"1-4-2":{"id":"1-4-2","les":"1.4","soort":"X","chip":"Extra 1.4-2","nu":true,"ster":"basis","titel":"Gen Z in Nepal (2025): een nieuwe Franse Revolutie?","meta":"duo · ± 25 min · cursus 10 Actualiteit · p. 40","info":[["Bron","bron 6 · De Gen Z-opstand in Nepal (september 2025)"],["Bronbox","p. 22 (redeneerwijzen) en p. 23 (presentisme)"],["Je oefent","BV3_08.04.03 · actualiseren met aandacht voor presentisme · BV3_08.02 · verbanden tussen samenlevingen analyseren"]],"taak":["Vul samen de tabel in. De kolom 1789 is al ingevuld: die ken je uit de les. Zoek de gegevens over Nepal in het gele kader en in bron 6."],"tabel":{"cols":["Nepal 2025","Gelijkenis (G) of verschil (V)?"],"rijen":["Aanleiding (de vonk)","Diepere oorzaken","Wie komt in opstand, tegen wie?","Hoe verspreiden nieuws en ideeën zich?","Aanval op een symbool van de macht","Hoe werd het land bestuurd vóór de opstand?","Gevolgen"],"pre":["Frankrijk 1789: Staatsbankroet: de koning roept de Staten-Generaal samen (mei 1789). De broodprijs is torenhoog.","Frankrijk 1789: Ongelijkheid tussen de standen, privileges van adel en clerus, armoede en honger, ideeën van de Verlichting.","Frankrijk 1789: De derde stand (burgerij en volk van Parijs) tegen de absolute koning en de bevoorrechte standen.","Frankrijk 1789: Pamfletten, kranten, klaagschriften, politieke clubs.","Frankrijk 1789: Bestorming van de Bastille (14 juli 1789).","Frankrijk 1789: Absolute monarchie: een koning van goddelijk recht, geen verkiezingen, geen grondwet.","Frankrijk 1789: Einde van de absolute monarchie en de standen, Verklaring van de Rechten van de Mens, republiek (1792) — maar ook oorlog, Terreur en Napoleon."]},"vragen":[{"nr":"a","q":"Lees bron 6. Wat was de aanleiding (de vonk) van de opstand? Wat waren de diepere oorzaken? Duid ze in de bron aan: aanleiding in het groen, oorzaken in het rood."},{"nr":"b","q":"Wat is volgens jullie de belangrijkste gelijkenis tussen 1789 en Nepal 2025? Begin met: ‘Zowel in 1789 als in Nepal …’"},{"nr":"c","q":"Wat is het belangrijkste verschil? Kijk naar de rij ‘Hoe werd het land bestuurd vóór de opstand?’ Begin met: ‘In 1789 …, terwijl in Nepal …’"},{"nr":"d","q":"Was Nepal 2025 een revolutie zoals 1789? Leg uit met wat er na de opstand veranderde, en wat níet."},{"nr":"e","q":"Een klasgenoot zegt: ‘De Franse revolutionairen waren eigenlijk gewoon de Gen Z van 1789.’ Wat klopt daaraan, en waar loopt de vergelijking mank? Gebruik het woord presentisme."}],"hulp":["Aanleiding = de vonk, het laatste duwtje. Diepere oorzaak = een probleem dat er al lang was. In bron A: wat gebeurde er vlak vóór het protest? En waar waren de jongeren al lang boos over?","Gebruik het gele kader (tijdlijn) voor de rijen ‘aanval op een symbool’, ‘bestuur vóór de opstand’ en ‘gevolgen’.","Zet bij elke rij G of V. Twijfel je? Schrijf ‘deels’ en leg in één woord uit waarom.","Revolutie = een snelle én ingrijpende verandering van het hele systeem. Vraag je af: veranderde in Nepal het systeem (de staatsvorm), of vooral wie er regeert?","Presentisme = het verleden bekijken met de bril van vandaag. Tip: Robespierre was in 1789 31 jaar, Saint-Just 21. Maar hadden zij dezelfde rechten, middelen en doelen als jongeren vandaag?"],"codes":["08.04.03","08.02"],"bronnen":[{"titel":"Nepal in een notendop","tekst":["• Nepal ligt in de Himalaya, tussen India en China, en telt ongeveer 30 miljoen inwoners. Tot 2008 was het een koninkrijk. Na een burgeroorlog (1996-2006) werd de monarchie afgeschaft: sinds 2008 is Nepal een republiek met een parlement en verkiezingen. Sindsdien wisselden een handvol oude partijleiders elkaar telkens af als premier.","• 4 september 2025: de regering blokkeert 26 sociale media (o.a. Facebook, Instagram, YouTube en X), omdat ze zich niet officieel hadden laten registreren.","• 8 september: tienduizenden jongeren (‘Gen Z’) betogen in de hoofdstad Kathmandu. De politie schiet op de betogers. Het verbod wordt nog diezelfde nacht ingetrokken.","• 9 september: betogers steken het parlement, regeringsgebouwen en huizen van politici in brand. Premier K.P. Sharma Oli treedt af. Het leger neemt de controle over de hoofdstad.","• 12 september: na een online overleg op Discord met duizenden jongeren wordt oud-opperrechter Sushila Karki (73) interimpremier, de eerste vrouwelijke premier van Nepal. Het parlement wordt ontbonden. Balans van de opstand: minstens 77 doden.","• 5 maart 2026: verkiezingen. Een nieuwe partij (RSP) wint met een grote meerderheid. Eind maart wordt Balendra Shah (35), rapper en oud-burgemeester van Kathmandu, premier. Hij versloeg oud-premier Oli in diens eigen kiesdistrict."],"woorden":"","duiding":"","ref":"Naar: VRT NWS (14 september 2025); Associated Press (12 september 2025); Al Jazeera (17 september 2025); AFP (3 en 5 maart 2026).","imgs":[]},{"titel":"Bron 6: De Gen Z-opstand in Nepal (september 2025)","tekst":["A · “Het protest begon een week geleden. Jongeren kwamen massaal de straat op na een ban op populaire apps op sociale media (die intussen weer is ingetrokken), en tegen de corruptie in het land. Ze namen ook de armoede op de korrel, terwijl kinderen van politici, ook wel bekend als ‘nepo kids’, schijnbaar een luxueus leventje leiden. De protesten liepen uit de hand en de politie opende het vuur op betogers, waarbij tientallen slachtoffers vielen. […] Het resultaat van de protesten was wel dat de oude premier Khadga Oli opstapte. […] ‘Ze [de nieuwe premier Sushila Karki] is een oud-rechter, en is een tijd opperrechter geweest. Ze had toen een uitgesproken profiel tegen corruptie en een heel erg apolitiek profiel. Ze is dus niet erg verbonden met de gevestigde politieke partijen. Dat is precies wat de jonge demonstranten in Nepal willen: zij zijn klaar met die oude politieke partijen’, vertelt Lisa Dupuy, correspondente in Zuidoost-Azië.”","B · “Hoewel het verbod op sociale media de onrust uitlokte, werd ze ook gevoed door woede op de regering, in een land waar de werkloosheid rond 10 procent schommelt en het bbp per inwoner amper 1 447 dollar bedraagt.”"],"woorden":"ban = verbod · corruptie = misbruik van macht voor eigen voordeel, bv. omkoping · nepo kids = kinderen van machthebbers die voordelen krijgen dankzij hun ouders (van ‘nepotisme’ = vriendjespolitiek voor familie) · opperrechter = hoogste rechter van het land · apolitiek = niet verbonden met een politieke partij · gevestigde partijen = partijen die al lang de macht hebben · bbp per inwoner = hoeveel een land gemiddeld per inwoner per jaar produceert; in België is dat meer dan 30 keer zoveel","duiding":"A komt uit een artikel van VRT NWS van 14 september 2025, een week na het begin van de protesten. Correspondente Lisa Dupuy legt uit waarom de nieuwe premier populair is bij de jongeren. B komt uit een bericht van het Franse persagentschap AFP van maart 2026, net voor de verkiezingen in Nepal.","ref":"Bron: A: Torfs, M. (14 september 2025). Rust keert terug in Nepal, waarom is Nepalese interimpremier Karki (73) zo populair bij de jonge generatie van betogers? VRT NWS. www.vrt.be/vrtnws. Ingekort. B: AFP (3 maart 2026). Gen Z vs old guard: 19 million Nepalis to vote in landmark general election. Malay Mail. www.malaymail.com. Vertaald.","imgs":[]}]},"S2-1-1":{"id":"S2-1-1","les":"2.1","soort":"S","chip":"Klasopdracht S2.1-1","nu":false,"ster":"","titel":"Napoleons leven in schilderijen","meta":"duo","info":[["Bron","de schilderijen hieronder"],["Bronbox","p. 26 (kijkstrategieën voor visuele bronnen)"],["Je oefent","BV3_08.01 · situeren in tijd · BV3_08.06 · kijkstrategieën begrijpen"]],"taak":["a. Koppel de schilderijen aan de juiste mijlpaal (A tot M), eerst zonder de pagina te scannen. Beargumenteer.","b. Scan daarna de pagina, lees de context bij elk schilderij en verbeter je antwoorden met een andere kleur."],"tabel":{"cols":["Schilderij","Mijlpaal","Argumentatie: wat zie je dat erop wijst?"],"rijen":["Bron 1 · Ingres","Bron 2 · Kratke","Bron 3 · maker onbekend","Bron 4 · Flameng","Bron 5 · Scheffer"]},"vragen":[],"hulp":["Kijkstrategie (Bronbox p. 26): kijk eerst naar wat je ziet (personen, kleding, landschap), dan naar wat het betekent.","Een kroon wijst op een keizer, sneeuw op Rusland, een eiland en de zee op een verbanning."],"codes":["08.01","08.06"],"bronnen":[{"titel":"Napoleons leven in schilderijen","tekst":[],"woorden":"","duiding":"","ref":"© Uit het handboek Sapiens 5 — enkel voor gebruik in de klas","imgs":["data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,"]}]},"2-1-1":{"id":"2-1-1","les":"2.1","soort":"X","chip":"Extra 2.1-1","nu":false,"ster":"basis","titel":"Een schilderij op bestelling","meta":"duo · ± 15 min · cursus 1.1 · p. 42 en Bronbox 4.2 · p. 26","info":[["Bron","bron 1 · De kroning van Napoleon (1804)"],["Bronbox","p. 26 (kijkstrategieën) en p. 19 (betrouwbaarheid)"],["Je oefent","BV3_08.06 · presentatie van een bron analyseren analyseren"]],"taak":[],"tabel":null,"vragen":[{"nr":"a","q":"Wie kroont wie op het schilderij? Wat doet de paus?"},{"nr":"b","q":"David schilderde Napoleons moeder erbij, hoewel ze er niet was. Waarom zou hij dat gedaan hebben? Wat zegt dat over deze bron?"},{"nr":"c","q":"Waarom mag je een schilderij nooit lezen als een foto van wat er gebeurde? Gebruik bron 1 als voorbeeld."}],"hulp":["Kijk naar het midden: wie houdt de kroon vast, wie knielt?","Wie gaf David de opdracht? Wat wil zo iemand dat het schilderij toont?"],"codes":["08.06"],"bronnen":[{"titel":"Bron 1: De kroning van Napoleon (1804)","tekst":[],"woorden":"","duiding":"","ref":"","imgs":["data:image/jpeg;base64,"]}]},"S2-2-1":{"id":"S2-2-1","les":"2.2","soort":"S","chip":"Klasopdracht S2.2-1","nu":true,"ster":"","titel":"Lag Napoleon aan de basis van de moderne tijd?","meta":"alleen","info":[["Bron","bron 6 (Las Cases) met bronduiding hieronder"],["Bronbox","p. 26 (leesstrategieën)"],["Je oefent","BV3_08.07 · een standpunt onderbouwen met een bron analyseren"]],"taak":[],"tabel":null,"vragen":[{"nr":"a","q":"Lag Napoleon volgens bron 6 mee aan de basis van de moderne tijd? Beargumenteer met minstens twee voorbeelden uit de bron."}],"hulp":["Zoek in bron 6 Napoleons plannen voor Europa: recht, handel, munt, bestuur.","Vergelijk met de verschillen per domein uit opdracht 3."],"codes":["08.07"],"bronnen":[{"titel":"Bron 6: Las Cases over Napoleon","tekst":[],"woorden":"","duiding":"","ref":"© Uit het handboek Sapiens 5 — enkel voor gebruik in de klas","imgs":["data:image/jpeg;base64,"]}]},"S2-2-2":{"id":"S2-2-2","les":"2.2","soort":"S","chip":"Klasopdracht S2.2-2","nu":true,"ster":"","titel":"Kun je Napoleon geloven?","meta":"duo","info":[["Bron","bron 6 met bronduiding en de tekst ‘Op weg naar een moderne tijd’ (hieronder)"],["Bronbox","p. 19 (bruikbaar, betrouwbaar, representatief)"],["Je oefent","BV3_08.06 · bruikbaarheid en betrouwbaarheid analyseren"]],"taak":["Welke bedenkingen heb je bij deze bron?"],"tabel":{"cols":["Mijn bedenking + uitleg"],"rijen":["Bruikbaarheid","Betrouwbaarheid"]},"vragen":[],"hulp":["Bruikbaar = helpt de bron je om de vraag te beantwoorden? Betrouwbaar = kun je de maker geloven?","Wanneer en waar vertelde Napoleon dit? Wat had hij toen te winnen?"],"codes":["08.06"],"bronnen":[{"titel":"Bron 6: Las Cases over Napoleon","tekst":[],"woorden":"","duiding":"","ref":"© Uit het handboek Sapiens 5 — enkel voor gebruik in de klas","imgs":["data:image/jpeg;base64,"],"uit":"S2.2-1"},{"titel":"Op weg naar een moderne tijd","tekst":["Uit de tijdlijn kun je afleiden dat er een grote continuïteit was van de vroegmoderne","naar de moderne tijd binnen de verschillende domeinen van de samenleving. Maar een aantal","ontwikkelingen kwamen vanaf ca. 1800 in een stroomversnelling terecht.","Een eerste aspect was de vooruitgang binnen de wetenschappen en technologie, die leidde tot","de industriële revolutie. Machines namen steeds vaker het werk over. Die industrialisering begon","in Groot-Brittannië in de eerste helft van de 18e eeuw en zette zich in sneltempo voort","op het Europese vasteland. Een tweede aspect was het imperialisme. Vanaf het begin van","de vroegmoderne tijd begonnen sommige Europese staten de wereld te verkennen en veroveren.","In de moderne tijd kende het imperialisme een groei en gingen bijna alle Europese staten op zoek","naar koloniën. Als derde aspect kregen de nieuwe verlichtingsidealen, bedacht door de filosofen","in de vroegmoderne tijd, steeds meer invulling in de moderne tijd. Men dacht na over hoe","de samenleving georganiseerd moest worden. Politieke ideologieën zoals het liberalisme,","dat de vrijheid van het individu vooropstelt, wedijverden met opvattingen zoals het socialisme,","dat streeft naar meer gelijkheid voor iedereen.","Franse Revolutie","In 1789 brak de Franse Revolutie uit. Er volgde een periode van geweld waarbij koning Lodewijk XVI in 1792 het leven liet onder de guillotine. Buitenlandse vorsten zagen die gebeurtenissen als een enorme bedreiging voor hun eigen macht en vormden een coalitie of bondgenootschap tegen de Franse revolutionairen. Andere landen verklaarden Frankrijk daarom de oorlog. Ook binnen Frankrijk zelf was er veel onenigheid over de manier waarop het land bestuurd moest worden. Revolutionairen stonden daarbij tegenover koningsgezinden.","Napoleon: generaal, consul, keizer","Napoleon maakte carrière tijdens de Franse Revolutie waarbij hij de kant van","de revolutionairen koos. Zowel in binnen- als buitenland behaalde hij militaire","successen, waarbij grote delen van Europa door Frankrijk werden ingepalmd.","Op die manier werkte hij zich op tot opperbevelhebber van het Franse leger.","Gesteund door de grote populariteit die hij verwierf, pleegde hij een staatsgreep","waarna hij de totale macht in handen kreeg en zich ten slotte liet uitroepen tot","keizer van Frankrijk. Zo ontstond er een autoritair regime waarbij Napoleon geen tegenstand","duldde. Hij controleerde de pers en maakte gebruik van een spionagenetwerk om informatie","te verzamelen over vriend en vijand.","In 1804 werd onder zijn leiding de Code Civil, het Franse burgerlijk wetboek, opgesteld.","Kernpunten van het wetboek waren verlichtingswaarden zoals gelijkheid voor de wet en","persoonlijke vrijheid voor iedere burger. Ook de scheiding tussen de kerk en de staat en het recht op bezit werden erin opgenomen. De Code Civil werd in alle veroverde landen ingevoerd en zou later zo de nationale wetgevingen beïnvloeden."],"woorden":"","duiding":"","ref":"© Uit het handboek Sapiens 5 — enkel voor gebruik in de klas","imgs":[],"uit":"S1.2-2"}]},"S2-2-3":{"id":"S2-2-3","les":"2.2","soort":"S","chip":"Klasopdracht S2.2-3","nu":false,"ster":"","titel":"Historische vraag 1 beantwoorden","meta":"alleen","info":[["Bron","je antwoorden op S1.2-1, S2.1-1, S1.2-2, S2.2-1 en S2.2-2"],["Bronbox","p. 22 (redeneerwijzen) en p. 27 (checklist)"],["Je oefent","BV3_08.07 · historische vraag beantwoorden analyseren"]],"taak":[],"tabel":null,"vragen":[{"nr":"a","q":"Welke rol speelde Napoleon bij de overgang van de vroegmoderne naar de moderne tijd?"}],"hulp":["Opbouw: standpunt – argument + bewijs – tegenargument – afweging (Bronbox p. 19-20).","Wat was nieuw (Code Civil, verspreiding van ideeën) en wat bleef (autoritaire macht, keizer)?"],"codes":["08.07"],"bronnen":[]},"2-2-1":{"id":"2-2-1","les":"2.2","soort":"X","chip":"Extra 2.2-1","nu":true,"ster":"basis","titel":"Gelijkheid voor wie?","meta":"alleen · ± 15 min · cursus 3 · p. 43-44","info":[["Bron","bron 2 · De Code Civil (1804)"],["Bronbox","p. 26 (leesstrategieën)"],["Je oefent","BV3_08.06 · een wettekst als bron gebruiken analyseren"]],"taak":[],"tabel":null,"vragen":[{"nr":"a","q":"Welk artikel van bron 2 past bij Napoleon als hervormer? Citeer en leg uit."},{"nr":"b","q":"‘Iedere Fransman geniet de burgerlijke rechten’ (art. 8). Klopt dat voor vrouwen? Gebruik art. 213-215 als bewijs."},{"nr":"c","q":"Vergelijk met wat Napoleon op Sint-Helena vertelde (extra bron hieronder). Wat besluit je over zijn eigen herinneringen?"}],"hulp":["Hervormer = iemand die moderne, verlichte ideeën invoert. Welk artikel geldt voor iedereen?","Lees art. 213, 214 en 215: wat mag een vrouw niet zonder haar man?"],"codes":["08.06"],"bronnen":[{"titel":"Bron 2: De Code Civil (1804)","tekst":["“Art. 8. Iedere Fransman geniet de burgerlijke rechten.","Art. 213. De man is zijn vrouw bescherming verschuldigd, de vrouw haar man gehoorzaamheid.","Art. 214. De vrouw is verplicht bij haar man te wonen en hem te volgen overal waar hij goedvindt te gaan wonen. […]","Art. 215. De vrouw kan zonder de toestemming van haar man niet in rechte optreden, zelfs niet als zij openlijk handel drijft.","Art. 544. Eigendom is het recht om op de meest absolute wijze van een zaak te genieten en erover te beschikken, op voorwaarde dat men er geen gebruik van maakt dat verboden is door de wetten of reglementen.”"],"woorden":"burgerlijke rechten = rechten als burger, zoals eigendom en een contract sluiten · in rechte optreden = naar de rechtbank stappen","duiding":"Napoleon voerde het burgerlijk wetboek in in alle gebieden die Frankrijk bestuurde, ook in onze streken. In België werd de ‘maritale macht’ van de man (art. 213) pas in 1958 afgeschaft.","ref":"Bron: Code civil des Français (21 maart 1804). Parijs, art. 8, 213-215 en 544. Vertaald en ingekort.","imgs":[]},{"titel":"Extra bron: Napoleon op Sint-Helena over zijn nalatenschap","tekst":["\"Mijn ware glorie is niet dat ik veertig veldslagen heb gewonnen: Waterloo zal de herinnering aan al die overwinningen uitwissen. Maar wat door niets uitgewist zal worden, wat eeuwig zal blijven leven, is mijn Burgerlijk Wetboek, dat zijn de notulen van de Raad van State, dat zijn mijn brieven aan mijn ministers.\""],"woorden":"","duiding":"Na zijn definitieve nederlaag bij Waterloo (18 juni 1815) werd Napoleon verbannen naar het afgelegen eiland Sint-Helena in de zuidelijke Atlantische Oceaan. Daar dicteerde hij zijn herinneringen aan enkele metgezellen die hem in ballingschap volgden, zoals Emmanuel de Las Cases en generaal Charles de Montholon. Las Cases publiceerde zijn Mémorial de Sainte-Hélène al in 1823; het werd een bestseller die de 'Napoleontische legende' verspreidde. Deze uitspraak werd opgetekend door Montholon, die zijn herinneringen pas in 1847 publiceerde. Napoleon wist dat zijn woorden gepubliceerd zouden worden: hij bouwde bewust aan zijn eigen historisch beeld. Of de metgezellen letterlijk noteerden of zelf zaken toevoegden, weten we niet altijd.","ref":"Bron: Charles de Montholon (uitspraken van Napoleon Bonaparte) · Sint-Helena, 1816–1821 (gepubliceerd 1847)","imgs":[]}]},"2-2-2":{"id":"2-2-2","les":"2.2","soort":"X","chip":"Extra 2.2-2","nu":false,"ster":"basis","titel":"Verlichter voor wie? Haïti","meta":"duo · ± 25 min · cursus 3.2 Schema ‘herstel slavernij’ · p. 44","info":[["Bron","bron 3 · De Franse wet van 20 mei 1802 · bron 4 · De onafhankelijkheidsakte van Haïti (1804)"],["Bronbox","p. 23 (multiperspectiviteit)"],["Je oefent","BV3_08.03 · interculturele contacten vanuit beide perspectieven · BV3_08.02 · verbanden tussen domeinen begrijpen"]],"taak":[],"tabel":null,"vragen":[{"nr":"a","q":"Wat betekent ‘volgens de wetten van vóór 1789’ in bron 3? Wat maakt Napoleon zo ongedaan?"},{"nr":"b","q":"Waarom zwoeren de generaals in bron 4 om ‘voor altijd afstand te doen van Frankrijk’? Leg het verband met bron 3."},{"nr":"c","q":"Hoe veranderden Frankrijk én Haïti door hun contact? Noteer voor elk één verandering."},{"nr":"d","q":"Economie en politiek: waarom wilde Frankrijk Saint-Domingue zo graag terug onder controle? Leg het verband tussen de plantages (economisch) en de slavernij (sociaal/politiek)."},{"nr":"e","q":"Wie handelt er in de bronnen? Worden de inwoners van Haïti voorgesteld als slachtoffers of als mensen die zelf keuzes maken? Citeer."},{"nr":"f","q":"In je cursus staat Haïti in één regel (‘herstel slavernij in kolonies’). Wat zegt dat over het perspectief van waaruit we vaak geschiedenis vertellen (eurocentrisme)?"}],"hulp":["Eurocentrisme = geschiedenis vertellen vanuit Europa, alsof Europa het middelpunt is.","In 1794 was de slavernij afgeschaft. Wat was de situatie vóór 1789?","Wat wilde Napoleon in 1802 in Saint-Domingue? (zie het infokader)"],"codes":["08.03","08.02"],"bronnen":[{"titel":"Saint-Domingue en Haïti","tekst":["Saint-Domingue (het westen van het eiland Hispaniola) was de rijkste kolonie van Frankrijk. Honderdduizenden tot slaaf gemaakte Afrikanen werkten er op suiker- en koffieplantages. In 1791 kwamen ze in opstand, onder anderen onder leiding van Toussaint Louverture.","In 1794 schafte de Nationale Conventie de slavernij af in alle Franse kolonies. In 1802 stuurde Napoleon een leger naar Saint-Domingue om het Franse gezag te herstellen. Datzelfde jaar werd de slavernij in andere Franse kolonies opnieuw toegelaten."],"woorden":"","duiding":"","ref":"","imgs":[]},{"titel":"Bron 3: De Franse wet van 20 mei 1802","tekst":["“Art. 1. In de kolonies die in uitvoering van het Verdrag van Amiens […] aan Frankrijk zijn teruggegeven, blijft de slavernij behouden overeenkomstig de wetten en reglementen van vóór 1789. […] Art. 3. De slavenhandel en de invoer [van tot slaaf gemaakten] in die kolonies gebeuren overeenkomstig de wetten en reglementen die vóór 1789 bestonden.”"],"woorden":"Verdrag van Amiens = vredesverdrag tussen Frankrijk en Groot-Brittannië (1802) · slavenhandel = handel in mensen als koopwaar","duiding":"Napoleon was toen eerste consul. Door de Vrede van Amiens (1802) kreeg Frankrijk onder meer Martinique terug van Groot-Brittannië. Daar was de afschaffing van 1794 nooit uitgevoerd.","ref":"Bron: Loi relative à la traite des noirs et au régime des colonies (20 mei 1802 / 30 floréal jaar X). Parijs, art. 1 en 3. Vertaald en ingekort. Franse tekst via mjp.univ-perp.fr.","imgs":[]},{"titel":"Bron 4: De onafhankelijkheidsakte van Haïti (1804)","tekst":["“De generaals, doordrongen van deze heilige beginselen, hebben — nadat zij eensgezind hun steun hadden gegeven aan het duidelijk uitgesproken plan tot onafhankelijkheid — allen gezworen, voor de eeuwigheid en voor het hele universum, om voor altijd afstand te doen van Frankrijk en liever te sterven dan onder zijn heerschappij te leven.”"],"woorden":"universum = de hele wereld · heerschappij = macht, bestuur","duiding":"Het Franse leger werd in 1803 verslagen door het leger van voormalige slaven. Generaal Jean-Jacques Dessalines riep op 1 januari 1804 de onafhankelijkheid uit en gaf het land de naam Haïti, de naam die de oorspronkelijke bewoners van het eiland gebruikten.","ref":"Bron: Acte de l’indépendance (1 januari 1804). Gonaïves. Opgesteld door L. Boisrond-Tonnerre, ondertekend door J.-J. Dessalines en zijn generaals. Vertaald naar de Engelse vertaling van M. Abidor (marxists.org).","imgs":[]}]},"S2-3-1":{"id":"S2-3-1","les":"2.3","soort":"S","chip":"Klasopdracht S2.3-1","nu":true,"ster":"","titel":"Materieel of immaterieel erfgoed?","meta":"alleen","info":[["Bron","het kader ‘collectieve herinnering’ en bron 1-2 hieronder"],["Bronbox","p. 24-25 (betekenissen toelichten)"],["Je oefent","BV3_08.09 · collectieve herinnering begrijpen"]],"taak":["Kruis aan."],"tabel":{"cols":["Materieel erfgoed","Immaterieel erfgoed"],"rijen":["Het lied Waterloo (ABBA)","Bron 1: Waterloo Underground Station","Bron 2: de Leeuw van Waterloo"]},"vragen":[],"hulp":["Materieel = je kunt het aanraken (gebouw, beeld). Immaterieel = niet tastbaar (lied, verhaal, traditie)."],"codes":["08.09"],"bronnen":[{"titel":"Collectieve herinnering · bron 1 en 2","tekst":[],"woorden":"","duiding":"","ref":"© Uit het handboek Sapiens 5 — enkel voor gebruik in de klas","imgs":["data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,"]}]},"S2-3-2":{"id":"S2-3-2","les":"2.3","soort":"S","chip":"Klasopdracht S2.3-2","nu":true,"ster":"","titel":"Waarvoor dient de herinnering?","meta":"duo","info":[["Bron","het schema ‘functie van collectieve herinnering’ en bron 1-2 (hieronder)"],["Bronbox","p. 24-25 (betekenissen toelichten)"],["Je oefent","BV3_08.09 · functies van collectieve herinnering begrijpen"]],"taak":["Bekijk eerst het schema ‘functie van collectieve herinnering’ bij de bronnen hieronder."],"tabel":null,"vragen":[{"nr":"a","q":"Ik kies bron ……. Over welke functie van de collectieve herinnering vertelt die bron iets? Beargumenteer."}],"hulp":["Functies: identiteit, sociale cohesie, sociale uitsluiting, trots, slachtofferschap, waardenoverdracht.","Wie gaf het station zijn naam: de winnaars of de verliezers?"],"codes":["08.09"],"bronnen":[{"titel":"Collectieve herinnering · bron 1 en 2","tekst":[],"woorden":"","duiding":"","ref":"© Uit het handboek Sapiens 5 — enkel voor gebruik in de klas","imgs":["data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,"],"uit":"S2.3-1"}]},"S2-3-3":{"id":"S2-3-3","les":"2.3","soort":"S","chip":"Klasopdracht S2.3-3","nu":true,"ster":"","titel":"Welke nederlaag woog het zwaarst?","meta":"duo","info":[["Bron","bron 3 tot 8 hieronder"],["Bronbox","p. 22 (oorzaak en gevolg)"],["Je oefent","BV3_08.07 · redeneren met bronnen · BV3_08.06 · bronnen vergelijken analyseren"]],"taak":["Zet eerst de gegevens op een rij. Kies daarna een criterium en beargumenteer."],"tabel":{"cols":["Rusland (1812)","Leipzig (1813)","Waterloo (1815)"],"rijen":["Verliezen aan Franse zijde (cijfers)","Gevolg voor Napoleon (citeer uit de tekstbronnen)"]},"vragen":[{"nr":"a","q":"Mijn criterium: ……………………. Welke nederlaag had volgens jou de meest verregaande gevolgen voor Napoleon? Beargumenteer."}],"hulp":["Mogelijke criteria: aantal verliezen, gevolg voor de steun van de Fransen, definitief einde.","Lees bij elke grafiek de legende: totaal, verliezen, gevangenen."],"codes":["08.07","08.06"],"bronnen":[{"titel":"Bron 3 tot 8: Rusland, Leipzig en Waterloo","tekst":[],"woorden":"","duiding":"","ref":"© Uit het handboek Sapiens 5 — enkel voor gebruik in de klas","imgs":["data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,"]}]},"S2-3-4":{"id":"S2-3-4","les":"2.3","soort":"S","chip":"Klasopdracht S2.3-4","nu":false,"ster":"","titel":"Historische vraag 2 beantwoorden","meta":"alleen","info":[["Bron","je antwoorden op S2.3-1, S2.3-2 en S2.3-3"],["Bronbox","p. 24-25 en p. 27 (checklist)"],["Je oefent","BV3_08.07 · historische vraag beantwoorden · BV3_08.09 analyseren"]],"taak":[],"tabel":null,"vragen":[{"nr":"a","q":"Maakt de slag bij Waterloo terecht deel uit van onze collectieve herinnering?"}],"hulp":["Gebruik opdracht 3: was Waterloo de zwaarste nederlaag? Waarom onthouden we ze dan toch?"],"codes":["08.07","08.09"],"bronnen":[]},"S2-3-5":{"id":"S2-3-5","les":"2.3","soort":"S","chip":"Klasopdracht S2.3-5","nu":false,"ster":"","titel":"Synthese hoofdstuk 1","meta":"duo","info":[["Bron","het syntheseschema en de kaders historisch denken — krijg je in de klas"],["Bronbox","p. 16 (referentiekader)"],["Je oefent","BV3_08.01 · referentiekader en structuurbegrippen begrijpen"]],"taak":["Leg het schema in je eigen woorden uit aan je buur. Noteer daarna de kern."],"tabel":null,"vragen":[{"nr":"a","q":"Vat hoofdstuk 1 samen in vijf stappen, van ‘vroegmoderne tijd’ tot ‘sterft in 1821’. Gebruik minstens drie structuurbegrippen (zie ‘Hulp nodig?’)."}],"hulp":["Structuurbegrippen: breuk, continuïteit, scharniermoment, symbolische datum, collectieve herinnering."],"codes":["08.01"],"bronnen":[]},"S2-4-1":{"id":"S2-4-1","les":"2.4","soort":"S","chip":"Klasopdracht S2.4-1","nu":true,"ster":"","titel":"Europa hertekend: de kaart van 1812 en 1815","meta":"duo","info":[["Bron","bron 1 en bron 2 (de kaarten van 1812 en 1815) hieronder"],["Bronbox","p. 26 (kijkstrategieën) en p. 16 (ruimte)"],["Je oefent","BV3_08.06 · kijkstrategieën (kaart) · BV3_08.07 · oorzaak en gevolg analyseren"]],"taak":["Vergelijk de kaart van Europa in 1812 met die van 1815."],"tabel":null,"vragen":[{"nr":"a","q":"Noteer welke gebieden Frankrijk verloor."},{"nr":"b","q":"Welke drie landen hadden naast Groot-Brittannië een belangrijke invloed tijdens het Congres? Waaraan merk je dat?"},{"nr":"c","q":"Illustreer met één voorbeeld op de kaart hoe bufferstaten werden ingezet als bescherming tegen Frankrijk."}],"hulp":["Leg de twee kaarten naast elkaar en zoek wat van kleur verandert.","Buffer = een ‘kussen’ tussen twee landen, zodat ze elkaar niet rechtstreeks raken."],"codes":["08.06","08.07"],"bronnen":[{"titel":"Bron 1: Europa onder Napoleon (1812)","tekst":[],"woorden":"","duiding":"","ref":"© Uit het handboek Sapiens 5 — enkel voor gebruik in de klas","imgs":["data:image/jpeg;base64,"]},{"titel":"Bron 2: Het Congres van Wenen (1814-1815)","tekst":[],"woorden":"","duiding":"","ref":"© Uit het handboek Sapiens 5 — enkel voor gebruik in de klas","imgs":["data:image/jpeg;base64,"]}]},"S2-5-1":{"id":"S2-5-1","les":"2.5","soort":"S","chip":"Klasopdracht S2.5-1","nu":false,"ster":"","titel":"Historische vraag 1 beantwoorden","meta":"alleen","info":[["Bron","je antwoorden op S2.4-1"],["Bronbox","p. 27 (checklist)"],["Je oefent","BV3_08.07 · historische vraag beantwoorden analyseren"]],"taak":[],"tabel":null,"vragen":[{"nr":"a","q":"Wat waren de territoriale doelstellingen van het Congres van Wenen?"}],"hulp":["Gebruik a, b en c van opdracht 1: wat gebeurde er met de oude vorsten, met Frankrijk en met de grootmachten?"],"codes":["08.07"],"bronnen":[]},"2-5-1":{"id":"2-5-1","les":"2.5","soort":"X","chip":"Extra 2.5-1","nu":true,"ster":"basis","titel":"Wat moet eerst? Onze bronnen op de tijdlijn","meta":"duo · ± 15 min · Bronbox 3.1 · p. 16","info":[["Bronbox","p. 16 (referentiekader)"],["Je oefent","BV3_08.01 · een historisch referentiekader opbouwen: chronologie, scharnierpunten, domeinen begrijpen"]],"taak":["Je werkte in hoofdstuk 1 en 2 met deze bronnen: Bossuet · klaagschrift van Lauris · Verklaring van de Rechten van de Mens · Olympe de Gouges · de Marseillaise · Davids schilderij van de kroning · wet van 1802 · Code Civil · onafhankelijkheidsakte van Haïti."],"tabel":{"cols":["Bron","Jaar","Periode","Domein (en waarom)"],"rijen":["Bron 1 (oudste)","Bron 2","Bron 3","Bron 4","Bron 5 (jongste)"]},"vragen":[{"nr":"a","q":"Kies vijf bronnen en vul de tabel in van oud naar nieuw. Welk scharnierpunt ligt tussen de oudste en de jongste bron?"},{"nr":"b","q":"Kon de onafhankelijkheidsakte van Haïti bestaan vóór de wet van 1802? Kon Olympe de Gouges haar verklaring schrijven vóór 1789? Leg telkens uit waarom (niet)."}],"hulp":["De jaartallen staan in de bronvermeldingen.","Domeinen: politiek (macht, bestuur), economisch (geld, werk), sociaal (groepen, rechten), cultureel (ideeën, kunst, godsdienst).","‘Eerder moeten’ = het ene is een reactie op of een gevolg van het andere."],"codes":["08.01"],"bronnen":[]},"S3-1-1":{"id":"S3-1-1","les":"3.1","soort":"S","chip":"Klasopdracht S3.1-1","nu":false,"ster":"","titel":"Strijd voor vrijheid en inspraak door de eeuwen heen","meta":"duo","info":[["Bron","wat je de vorige jaren leerde — krijg je in de klas"],["Bronbox","p. 22 (continuïteit en verandering)"],["Je oefent","BV3_08.04.02 · kenmerken vergelijken tussen periodes begrijpen"]],"taak":["Herhaal hoe groepen meer vrijheid en inspraak in het bestuur zochten."],"tabel":{"cols":["Hoe streefden groepen naar meer vrijheid en inspraak?"],"rijen":["Het oude Athene","De Romeinse republiek","De middeleeuwse steden","De Franse Revolutie"]},"vragen":[],"hulp":["Athene: volksvergadering · Rome: plebejers en volkstribunen · middeleeuwse steden: stadsrechten · 1789: Nationale Vergadering en de Verklaring."],"codes":["08.04.02"],"bronnen":[]},"S3-1-2":{"id":"S3-1-2","les":"3.1","soort":"S","chip":"Klasopdracht S3.1-2","nu":false,"ster":"","titel":"1848: één revolutie of vele?","meta":"duo","info":[["Bron","bron 1 (overzicht van de revoluties 1848-1849) — krijg je in de klas"],["Bronbox","p. 22 (redeneerwijzen)"],["Je oefent","BV3_08.07 · oorzaak en gevolg, gelijktijdigheid analyseren"]],"taak":[],"tabel":null,"vragen":[{"nr":"a","q":"Waren de revoluties gelijktijdig of ongelijktijdig? Was de ruimte nationaal, Europees of mondiaal?"},{"nr":"b","q":"In de 19e eeuw verspreidde informatie zich sneller (postnetwerk, betere wegen en spoorwegen). Leg in een goed gestructureerde redenering uit hoe dat bijdroeg aan de (on)gelijktijdigheid."}],"hulp":["Gelijktijdig = op hetzelfde moment, op verschillende plaatsen.","Redenering: oorzaak → dus → gevolg. Begin met ‘Omdat nieuws sneller reisde, …’"],"codes":["08.07"],"bronnen":[]},"S3-1-3":{"id":"S3-1-3","les":"3.1","soort":"S","chip":"Klasopdracht S3.1-3","nu":false,"ster":"","titel":"Frankrijk en Hongarije vergeleken","meta":"duo","info":[["Bron","bron 2 (Frankrijk) en bron 3 (Hongarije) (hieronder)"],["Bronbox","p. 26 (leesstrategieën)"],["Je oefent","BV3_08.04.02 · vergelijken · BV3_08.06 · leesstrategieën analyseren"]],"taak":[],"tabel":{"cols":["Bron 2: Frankrijk","Bron 3: Hongarije"],"rijen":["Liberale eisen van de revolutionairen","Tegen welke staatsvorm?","Resultaat"]},"vragen":[{"nr":"a","q":"In Hongarije kwam er naast de liberale eisen nog een andere belangrijke eis bij. Welke?"}],"hulp":["Leesstrategie (Bronbox p. 26): onderstreep eerst wat de mensen eisten, daarna wat ze kregen.","Lees ook de twaalf punten in de bronduiding bij bron 3."],"codes":["08.04.02","08.06"],"bronnen":[{"titel":"Bij bron 3 · De twaalf punten van de Hongaarse revolutionairen (15 maart 1848)","tekst":["“Wat wil de Hongaarse natie? 1. Persvrijheid en afschaffing van de censuur. 2. Een verantwoordelijke regering in Boeda-Pest. 3. Elk jaar een parlement in Pest. 4. Gelijkheid voor de wet, burgerlijk en godsdienstig. 5. Een nationale garde. 6. Iedereen draagt bij aan de belastingen. 7. Afschaffing van de herendiensten. 8. Juryrechtbanken en vertegenwoordiging op basis van gelijkheid. 9. Een nationale bank. 10. Het leger legt de eed af op de grondwet; onze Hongaarse soldaten worden niet naar het buitenland gestuurd, de vreemde soldaten vertrekken. 11. Vrijlating van de politieke gevangenen. 12. Unie met Transsylvanië.”"],"woorden":"censuur = controle van de overheid op wat gedrukt wordt · verantwoordelijke regering = een regering die uitleg moet geven aan het parlement · herendiensten = verplicht en onbetaald werk van boeren voor hun heer","duiding":"Jonge revolutionairen lieten dit pamflet op 15 maart 1848 in Pest drukken, zonder toestemming van de censuur. Hongarije hoorde toen bij het keizerrijk Oostenrijk. In april 1848 keurde de keizer hervormingen goed; in 1849 sloeg Oostenrijk, met Russische hulp, de Hongaarse opstand neer en werden ze teruggedraaid.","ref":"Bron: Mit kíván a magyar nemzet [Wat wil de Hongaarse natie] (15 maart 1848). Pest: Landerer en Heckenast. Eigen vertaling uit het Hongaars.","imgs":[]}]},"S3-1-4":{"id":"S3-1-4","les":"3.1","soort":"S","chip":"Klasopdracht S3.1-4","nu":false,"ster":"","titel":"Historische vraag 4 beantwoorden","meta":"alleen","info":[["Bron","je antwoorden op S3.1-2 en S3.1-3"],["Bronbox","p. 27 (checklist)"],["Je oefent","BV3_08.07 · historische vraag beantwoorden analyseren"]],"taak":[],"tabel":null,"vragen":[{"nr":"a","q":"Welke liberale toegevingen deden vorsten in 1848?"}],"hulp":["Gebruik bron 2 en 3: wat kregen de revolutionairen, en hoe lang?"],"codes":["08.07"],"bronnen":[]},"3-1-1":{"id":"3-1-1","les":"3.1","soort":"X","chip":"Extra 3.1-1","nu":false,"ster":"basis","titel":"Vrijheid voor wie?","meta":"duo · ± 20 min · cursus 3.4-3.5 · p. 57-58","info":[["Bron","bron 1 · De wet-Le Chapelier (1791)"],["Bronbox","p. 26 (leesstrategieën) en p. 22 (oorzaak en gevolg)"],["Je oefent","BV3_08.06 en 08.07 · bronnen gebruiken om de liberale paradox te verklaren · BV3_08.02 analyseren"]],"taak":[],"tabel":null,"vragen":[{"nr":"a","q":"Wat verbiedt bron 1? Leg het uit in eigen woorden."},{"nr":"b","q":"Voor wie is die wet voordelig, voor wie nadelig?"},{"nr":"c","q":"In de 19e eeuw gold in veel landen cijnskiesrecht (cursus p. 57). Wie mocht dan stemmen, wie niet?"},{"nr":"d","q":"Leg met de bron en met het kiesrecht uit wat de cursus bedoelt met ‘de liberale paradox’."}],"hulp":["Le Chapelier: mogen arbeiders samen een vereniging (vakbond) oprichten en afspraken maken over hun loon?","Cijns = belasting. Wie betaalde er genoeg belasting om te mogen stemmen?","Zinsstarter: ‘De liberalen spraken over vrijheid en gelijkheid, maar …’"],"codes":["08.06","08.02","08.07"],"bronnen":[{"titel":"Bron 1: De wet-Le Chapelier (1791)","tekst":["“Art. 1. Omdat de afschaffing van alle soorten verenigingen van burgers van hetzelfde beroep of vak een van de fundamentele grondslagen van de Franse grondwet is, is het verboden ze opnieuw op te richten, onder welk voorwendsel of in welke vorm ook.","Art. 2. Burgers van hetzelfde beroep of vak, ondernemers, winkeliers, arbeiders en gezellen van elk ambacht mogen, wanneer ze samenkomen, geen voorzitter, secretaris of bestuurder aanstellen, geen boekhouding bijhouden, geen besluiten nemen en geen reglementen opstellen over hun zogenaamde gemeenschappelijke belangen. […]","Art. 4. Het is in strijd met de beginselen van de vrijheid en met de grondwet dat burgers met hetzelfde beroep, ambacht of vak samen overleggen of afspraken maken om de prijs van hun werk of hun arbeid vast te leggen.”"],"woorden":"gilden = verenigingen van mensen met hetzelfde beroep · gezellen = geschoolde arbeiders die nog geen meester zijn","duiding":"De wet schafte de gilden af en verbood tegelijk elke vereniging van arbeiders. In onze streken gold de wet tijdens de Franse periode (1795-1814).","ref":"Bron: Assemblée nationale constituante (14 juni 1791). Décret relatif aux assemblées d’ouvriers et artisans de même état et profession (wet-Le Chapelier). Parijs, art. 1, 2 en 4. Vertaald naar: Stewart, J.H. (1951). A Documentary Survey of the French Revolution. New York: Macmillan, p. 165-166.","imgs":[]}]},"S3-2-1":{"id":"S3-2-1","les":"3.2","soort":"S","chip":"Klasopdracht S3.2-1","nu":false,"ster":"","titel":"Bismarck: ‘bloed en ijzer’","meta":"alleen","info":[["Bron","bron 1 (toespraak van Bismarck, 1862; (hieronder)"],["Bronbox","p. 26 (leesstrategieën) en p. 17 (werken met bronnen)"],["Je oefent","BV3_08.06 · leesstrategieën · contextualiseren analyseren"]],"taak":[],"tabel":null,"vragen":[{"nr":"a","q":"Hoe stelde Bismarck het machtsevenwicht van het Congres van Wenen in vraag?"},{"nr":"b","q":"Hoe wilde hij dat bereiken?"}],"hulp":["Zoek in de bron ‘landsgrenzen van het Congres van Wenen’ en ‘bloed en ijzer’.","Naar welke ‘grote fout van 1848 en 1849’ verwijst hij? Denk aan HV4."],"codes":["08.06"],"bronnen":[{"titel":"Bron 1 · Bismarck: ‘ijzer en bloed’ (30 september 1862)","tekst":["“Niet naar het liberalisme van Pruisen kijkt Duitsland, maar naar zijn macht. […] Pruisen moet zijn kracht bundelen en bijeenhouden voor het gunstige ogenblik, dat al enkele keren gemist is. De grenzen van Pruisen volgens de verdragen van Wenen zijn niet gunstig voor een gezond staatsleven. Niet door toespraken en meerderheidsbesluiten worden de grote vragen van deze tijd beslist – dat was de grote fout van 1848 en 1849 – maar door ijzer en bloed.”"],"woorden":"meerderheidsbesluiten = beslissingen bij stemming in een parlement · staatsleven = het functioneren van de staat","duiding":"Otto von Bismarck was pas enkele dagen minister-president van Pruisen. Hij sprak voor de begrotingscommissie van het Pruisische parlement, dat geen extra geld wilde geven voor een groter leger. De toespraak staat bekend als de ‘Blut und Eisen’-rede.","ref":"Bron: Bismarck, O. von (30 september 1862). Toespraak voor de begrotingscommissie van het Pruisische Huis van Afgevaardigden. In: Schüßler, W. (red.) (1924-1935). Bismarck: Die gesammelten Werke, deel 10, p. 139-140. Berlijn: Stollberg. Via German History in Documents and Images (germanhistorydocs.org). Eigen vertaling uit het Duits, ingekort.","imgs":[]}]},"S3-2-2":{"id":"S3-2-2","les":"3.2","soort":"S","chip":"Klasopdracht S3.2-2","nu":false,"ster":"","titel":"Kunst als bouwsteen van de natie","meta":"duo","info":[["Bron","bron 2, 3 en 4 — krijg je in de klas"],["Bronbox","p. 19 (bruikbaarheid)"],["Je oefent","BV3_08.06 · bruikbaarheid van bronnen · BV3_08.09 · collectieve herinnering analyseren"]],"taak":["Selecteer eerst de bronnen die je kunt gebruiken."],"tabel":{"cols":["Bron","Bruikbaar?","Waarom (niet)?"],"rijen":["Bron 2 · Arc de Triomphe","Bron 3 · Hermannsmonument","Bron 4 · Wagner, Der Ring des Nibelungen"]},"vragen":[{"nr":"a","q":"Hoe werd het nationalistische wij-gevoel in Duitsland met kunst versterkt?"}],"hulp":["Vraag bij elke bron: gaat ze over Duitsland? Gaat ze over kunst die een wij-gevoel moet geven?"],"codes":["08.06","08.09"],"bronnen":[]},"S3-2-3":{"id":"S3-2-3","les":"3.2","soort":"S","chip":"Klasopdracht S3.2-3","nu":false,"ster":"","titel":"Begrippen en jaartallen","meta":"alleen","info":[["Bron","de tijdlijn van hoofdstuk 2 (bij S2.4-1) — krijg je in de klas"],["Bronbox","p. 16 (referentiekader)"],["Je oefent","BV3_08.01 · referentiekader: begrippen en scharnierdata begrijpen"]],"taak":["Kies uit: nationalisme · verlichting · absolutisme. Elk begrip mag maar één keer."],"tabel":{"cols":["Gebeurtenis","Jaartal","Begrip"],"rijen":["Déclaration des droits de l’homme et du citoyen","Congres van Wenen","Duitse eenmaking"]},"vragen":[],"hulp":["Elk begrip één keer. Begin met wat je zeker weet: welk begrip past bij het herstel van de oude vorsten?"],"codes":["08.01"],"bronnen":[]},"S3-2-4":{"id":"S3-2-4","les":"3.2","soort":"S","chip":"Klasopdracht S3.2-4","nu":false,"ster":"","titel":"Historische vraag 5 beantwoorden","meta":"alleen","info":[["Bron","je antwoorden op S3.2-1 tot S3.2-3"],["Bronbox","p. 27 (checklist)"],["Je oefent","BV3_08.07 · historische vraag beantwoorden analyseren"]],"taak":[],"tabel":null,"vragen":[{"nr":"a","q":"Hoe bouwde de 19e-eeuwse politieke elite een sterke natie uit?"}],"hulp":["Combineer Bismarck (politiek, oorlog) met kunst (standbeelden, opera). Wat wilden de machthebbers ermee bereiken?"],"codes":["08.07"],"bronnen":[]},"3-2-1":{"id":"3-2-1","les":"3.2","soort":"X","chip":"Extra 3.2-1","nu":false,"ster":"basis","titel":"Staats- of volksnationalisme?","meta":"groep (expert) · ± 20 min · cursus 4.1 en 4.4.1 · p. 59 en 61","info":[["Bron","bron 2 · Fichte over taal en volk · bron 3 · Renan: wat is een natie?"],["Bronbox","p. 23 (multiperspectiviteit)"],["Je oefent","BV3_08.04.02 · soorten nationalisme vergelijken · BV3_08.06 analyseren"]],"taak":["Expertgroepen: groep A werkt met bron 2, groep B met bron 3. Daarna vul je de tabel samen in met iemand van de andere groep."],"tabel":{"cols":["Fichte (bron 2)","Renan (bron 3)"],"rijen":["Wat maakt volgens hem een natie? Citeer.","Wie hoort erbij? Kan je lid worden?","Staats- of volksnationalisme?"]},"vragen":[{"nr":"a","q":"Hoe kleurt de situatie van elke auteur (waar, wanneer, wat was er net gebeurd) zijn antwoord?"},{"nr":"b","q":"Ook vandaag discussiëren mensen over wie ‘erbij hoort’. Geef een voorbeeld van zo’n discussie en zeg welke opvatting (Fichte of Renan) je erin herkent. Beschrijf neutraal, zonder partij te kiezen, en zeg waar de vergelijking met de 19e eeuw mank loopt."}],"hulp":["Staatsnationalisme: wie wil, kan erbij horen. Volksnationalisme: je hoort erbij door afkomst, taal of cultuur (p. 61).","Fichte: Berlijn 1807, bezet door Napoleon. Renan: 1882, Frankrijk verloor Elzas-Lotharingen aan Duitsland."],"codes":["08.04.02","08.06"],"bronnen":[{"titel":"Bron 2: Fichte over taal en volk","tekst":["“Wie dezelfde taal spreken, zijn al vóór alle menselijke kunst door de natuur zelf met talloze onzichtbare banden aan elkaar verbonden; zij verstaan elkaar en kunnen zich steeds duidelijker aan elkaar verstaanbaar maken; zij horen bij elkaar en vormen van nature één ondeelbaar geheel.”"],"woorden":"ondeelbaar = dat je niet kan opsplitsen","duiding":"Johann Gottlieb Fichte (1762-1814) was een Duitse filosoof. Hij hield deze toespraken in de winter van 1807-1808 in Berlijn, dat toen bezet was door de troepen van Napoleon. Er bestond nog geen Duitse staat.","ref":"Bron: Fichte, J.G. (1808). Reden an die deutsche Nation. Berlijn: Realschulbuchhandlung, dertiende rede. Vertaald.","imgs":[]},{"titel":"Bron 3: Renan: wat is een natie?","tekst":["“Een natie is een ziel, een geestelijk beginsel. […] Het ene is het gemeenschappelijk bezit van een rijke erfenis van herinneringen; het andere is de huidige instemming, de wens om samen te leven. […] Het bestaan van een natie is […] een dagelijks plebisciet.”"],"woorden":"plebisciet = volksraadpleging · instemming = akkoord gaan","duiding":"Ernest Renan (1823-1892) was een Franse filosoof en historicus. In 1871 had Frankrijk de oorlog tegen Duitsland verloren en moest het Elzas-Lotharingen afstaan. Duitsland vond dat gebied Duits, omdat er veel Duits gesproken werd. Een plebisciet is een volksraadpleging.","ref":"Bron: Renan, E. (11 maart 1882). Qu’est-ce qu’une nation? [lezing aan de Sorbonne]. Parijs. Vertaald en ingekort.","imgs":[]}]},"3-3-1":{"id":"3-3-1","les":"3.3","soort":"X","chip":"Extra 3.3-1","nu":false,"ster":"basis","titel":"Van vaderlandsliefde naar vijandbeeld","meta":"duo · ± 20 min · cursus 4.6 Wij-zij-denken · p. 62","info":[["Bron","bron 4 · Ernst Moritz Arndt: ‘Wat is het vaderland van de Duitser?’ (1813)"],["Bronbox","p. 17 (retorische strategieën)"],["Je oefent","BV3_08.06 · retorische strategieën · BV3_08.09 · collectieve herinnering · BV3_07.02 wij-zij-denken analyseren"]],"taak":[],"tabel":null,"vragen":[{"nr":"a","q":"Welke grens trekt Arndt voor het ‘vaderland van de Duitser’? Citeer."},{"nr":"b","q":"Duid voor elke fase van het escalatieproces (p. 62) aan of je ze in de bron terugvindt. Citeer telkens."},{"nr":"c","q":"Welke retorische strategieën gebruikt Arndt? Kijk naar herhaling en zwart-wit."},{"nr":"d","q":"Lees de bronduiding. Waarom schreef Arndt in 1813 zo vijandig over Fransen? Verklaar zonder het goed te praten."},{"nr":"e","q":"Lees de bronvermelding: in 1850 stond het lied nog in een ‘huisschat van het Duitse volk’, een liedboek voor thuis. Wat zegt dat over de rol van dit lied in de collectieve herinnering? Welk doel kan dat gehad hebben?"}],"hulp":["Fase 1 trots · fase 2 ‘wij zijn anders’ · fase 3 ‘wij zijn beter’ · fase 4 de ander als vijand.","Tel hoe vaak ‘Das soll es seyn’ terugkomt. Welke woorden staan tegenover elkaar: ‘Feind’ en …?","Context: wie bezette Duitsland in 1813?"],"codes":["08.06","08.09","07.02"],"bronnen":[{"titel":"Bron 4: Ernst Moritz Arndt: ‘Wat is het vaderland van de Duitser?’ (1813)","tekst":["“Was ist des Deutschen Vaterland? / Ist’s Preussenland? ist’s Schwabenland? / […] / O nein! nein! nein! / Sein Vaterland muß größer seyn! […]","So weit die deutsche Zunge klingt / Und Gott im Himmel Lieder singt, / Das soll es seyn! […]","Das ist des Deutschen Vaterland, / Wo Zorn vertilgt den wälschen Tand, / Wo jeder Franzmann heißet Feind, / Wo jeder Deutsche heißet Freund. / Das soll es seyn! / Das ganze Deutschland soll es seyn!”","Vertaling: “Wat is het vaderland van de Duitser? Is het Pruisen? Is het Zwaben? […] O nee, nee, nee! Zijn vaderland moet groter zijn! […] Zover als de Duitse taal klinkt en God in de hemel liederen zingt: dat moet het zijn! […] Dat is het vaderland van de Duitser, waar woede de buitenlandse prullen vernietigt, waar elke Fransman ‘vijand’ heet, waar elke Duitser ‘vriend’ heet. Dat moet het zijn! Heel Duitsland moet het zijn!”"],"woorden":"vaderland = het land waar je volgens de dichter thuishoort · wälschen Tand = buitenlandse (vooral Franse) prullen of mode · Zunge = taal","duiding":"Ernst Moritz Arndt (1769-1860) was een Duitse dichter en historicus. Hij schreef dit lied in 1813, tijdens de oorlog tegen Napoleon, die grote delen van Duitsland bezette. Er bestond toen nog geen Duitse staat: Duitsers woonden verspreid over tientallen staten zoals Pruisen en Beieren. Het lied werd in de 19e eeuw heel populair.","ref":"Bron: Arndt, E.M. (1813). Des Deutschen Vaterland. In: Wolff, O.L.B. (red.) (1850). Poetischer Hausschatz des deutschen Volkes. Leipzig: Wigand. Via German History in Documents and Images (germanhistorydocs.org). Strofen 1, 9 en 10 (ingekort), vertaald.","imgs":[]}]},"S3-4-1":{"id":"S3-4-1","les":"3.4","soort":"S","chip":"Klasopdracht S3.4-1","nu":false,"ster":"","titel":"Synthese: het schema aanvullen","meta":"alleen","info":[["Bron","het syntheseschema — krijg je in de klas"],["Bronbox","p. 16 (referentiekader)"],["Je oefent","BV3_08.01 · referentiekader en structuurbegrippen begrijpen"]],"taak":["Welk begrip hoort in welk leeg vak? Kies uit: politiek · liberalisme · territoriaal · nationalisme. De vakken in het midden van het schema (ons land tussen 1815 en 1839) sla je over: die komen in een later hoofdstuk."],"tabel":{"cols":["Leeg vak in het schema","Begrip"],"rijen":["Congres van Wenen → herstel van de oude monarchieën","Congres van Wenen → gebiedsuitbreiding van de grootmachten en bufferstaten","De restauratie mislukt door … (1848: revoluties)","De restauratie mislukt door … (1871: Duitse eenmaking)"]},"vragen":[],"hulp":["De restauratie had twee kanten: wie regeert (bestuur) en welke grenzen (grondgebied)?"],"codes":["08.01"],"bronnen":[]},"3-4-1":{"id":"3-4-1","les":"3.4","soort":"X","chip":"Extra 3.4-1","nu":false,"ster":"basis","titel":"Mijn eigen standplaats (in drie stappen)","meta":"alleen → duo → klas · ± 25 min · Bronbox 3.3.2 · p. 23","info":[["Bronbox","p. 23 (standplaatsgebondenheid)"],["Je oefent","BV3_08.08 · eigen standplaatsgebondenheid en die van anderen analyseren analyseren"]],"taak":["Stap 1 (alleen, indienen) — Fichte, Renan en Arndt werden in hun kijk op ‘de natie’ beïnvloed door: een buitenlandse bezetting · een verloren oorlog · de taal die ze spraken · hun beroep (filosoof, historicus) · de krant en boeken van hun tijd · het land waar ze woonden.","Welke van die elementen spelen ook mee in hoe jij vandaag kijkt naar nationalisme (bv. bij sport, taal of verkiezingen)? Kruis aan, vul aan en leg er twee uit. Je hoeft niets te delen wat je niet wil delen.","☐ waar ik woon ☐ de taal die ik thuis spreek ☐ mijn familie ☐ mijn levensbeschouwing ☐ sociale media en nieuws ☐ wat ik op school leerde ☐ vrienden ☐ eigen ervaringen ☐ …"],"tabel":{"cols":["Stap 2 (duo, indienen) — Wat is gelijk aan onze kijk?","Wat is verschillend? Hoe komt dat?"],"rijen":[]},"vragen":[{"nr":"a","q":"Stap 3 (klasgesprek) — Noteer één ding uit het klasgesprek dat je deed nadenken."}],"hulp":["Zinsstarter: ‘Omdat ik …, kijk ik naar … op een andere manier dan iemand die …’"],"codes":["08.08"],"bronnen":[]}};
const XP_OEF = 5;          // eerste keer een oefening volledig ingevuld
V3.opl = {};               // per hoofdstuk: {oefeningId: [..], 'hv:1.1': {model, noot}} — enkel als de leerkracht ze vrijgaf

function _oefKey(id, k){ return 'oef:'+id+'#'+k; }
function _oefFields(o){
  const f=[];
  if(o.tabel) o.tabel.rijen.forEach((r,i)=>f.push({k:'t'+i, lbl:r, pre:(o.tabel.pre&&o.tabel.pre[i])||'', sub:o.tabel.cols.length?'Vul in voor: '+o.tabel.cols.join(' · '):''}));
  o.vragen.forEach((v,i)=>{ if(v.q!=null) f.push({k:'v'+i, lbl:(v.nr?v.nr+'. ':'')+v.q, kop:null}); });
  if(!f.length) f.push({k:'v0', lbl:'Jouw antwoord'});
  return f;
}
function _oefState(o){
  const F=_oefFields(o); const n=F.filter(f=>{ const x=ST.open[_oefKey(o.id,f.k)]; return x && _wordCount(x.t)>0; }).length;
  return {n, tot:F.length, done:n===F.length};
}
function _oplShown(r){ return V3.hidden.has('toon-opl:'+r); }
async function _oplLoad(r){
  if(!_oplShown(r) || V3.opl[r]) return;
  const student=_gsStudent(); if(!student) return;
  try{
    const res=await _gsPost({action:'opl', student, code:_gsCode(), pin:_gsPin(), h:r});
    if(res && res.ok && res.opl){ V3.opl[r]=res.opl; const les=_lesById(V3.curLes); if(les && les.r===r && $('view-les').classList.contains('active')) _oplFill(les); }
  }catch(e){}
}

function _oefArticle(o){
  const F=_oefFields(o); const s=_oefState(o);
  const fb=V3.fb.find(f=>f.key==='oef:'+o.id);
  let vi=0;
  const fieldsHTML = (o.tabel? `<div class="oef-tl">📋 Tabel${o.tabel.cols.length?' · per rij: '+o.tabel.cols.map(_esc).join(' · '):''}</div>`:'') +
    F.filter(f=>f.k[0]==='t').map(f=>_oefField(o,f)).join('') +
    o.vragen.map((v,i)=> v.q==null ? `<div class="oef-vkop">${_esc(v.kop)}</div>` : _oefField(o, {k:'v'+i, lbl:(v.nr?v.nr+'. ':'')+v.q})).join('') +
    (F.length===1 && F[0].k==='v0' && !o.vragen.length && !o.tabel ? _oefField(o,F[0]) : '');
  return `<article class="oef ${o.soort==='S'?'is-s':'is-x'} ${s.done?'done':''}" id="oef-${o.id}">
    <div class="oef-kop"><span class="oef-chip">${_esc(o.chip)}</span>${o.ster?`<span class="oef-ster">${_esc(o.ster)}</span>`:''}
      ${_isNu(o)?'<span class="oef-nu">'+_esc(_nuLabel(o))+'</span>':'<span class="oef-later">later in de klas</span>'}
      <span class="oef-st" id="oef-st-${o.id}">${s.done?'✓ ingevuld':s.n+'/'+s.tot}</span></div>
    <h3 class="oef-titel">${_esc(o.titel)}</h3>
    ${o.meta?`<div class="oef-meta">${_esc(o.meta)}</div>`:''}
    ${o.info.length?`<dl class="oef-info">${o.info.map(([a,b])=>`<div><dt>${_esc(a)}</dt><dd>${_esc(b)}</dd></div>`).join('')}</dl>`:''}
    ${o.taak.map(p=>`<p class="oef-taak">${_esc(p)}</p>`).join('')}
    ${(o.bronnen||[]).length?`<div class="oef-bronnen">${o.bronnen.map(_oefBron).join('')}</div>`:''}
    <div class="oef-fields">${fieldsHTML}</div>
    ${o.hulp.length?`<details class="oef-hulp"><summary>Hulp nodig?</summary><ul>${o.hulp.map(h=>`<li>${_esc(h)}</li>`).join('')}</ul></details>`:''}
    <div class="oef-opl" id="oef-opl-${o.id}"></div>
    ${_oefScoreHTML(o)}
    <div class="oef-ask"><button class="oef-ask-btn" onclick="_vraagOpen('oef:${o.id}')">✉️ Vraag aan meneer Kestelyn</button><div class="vq" id="vq-oef:${o.id}"></div></div>
    ${fb?`<div class="les-fb">💬 Je leerkracht reageerde op deze oefening — <a href="#" onclick="showInbox();return false">bekijk bericht</a></div>`:''}
  </article>`;
}
function _oefBron(b){
  return `<div class="oef-bron"><div class="oef-bron-t">📄 ${_esc(b.titel)}${b.uit?` <span>(uit ${_esc(b.uit)})</span>`:''}</div>
    ${(b.imgs||[]).map(src=>`<img class="oef-bron-img" src="${src}" alt="${_esc(b.titel)}">`).join('')}
    ${(b.tekst||[]).map(p=>`<p class="oef-bron-p">${_esc(p)}</p>`).join('')}
    ${b.woorden?`<div class="oef-bron-w"><b>Moeilijke woorden:</b> ${_esc(b.woorden)}</div>`:''}
    ${b.duiding?`<div class="oef-bron-d"><b>↑ Bronduiding:</b> ${_esc(b.duiding)}</div>`:''}
    ${b.ref?`<div class="oef-bron-r">${_esc(b.ref)}</div>`:''}</div>`;
}
function _oefField(o, f){
  const id='oef-ta-'+o.id+'-'+f.k;
  return `<label class="oef-f" for="${id}"><span class="oef-q">${_esc(f.lbl)}</span>${f.pre?`<span class="oef-pre">${_esc(f.pre)}</span>`:''}${f.sub?`<span class="oef-sub">${_esc(f.sub)}</span>`:''}
    <textarea class="cue-ta oef-ta" id="${id}" data-oef="${o.id}" data-k="${f.k}" rows="2" placeholder="Jouw antwoord…"></textarea></label>`;
}
function _oefSectionHTML(les){
  if(!les.oef || !les.oef.length) return '';
  const L=les.oef.map(id=>OEF[id]).filter(Boolean);
  const nu=[...L.filter(o=>_isNu(o)&&o.soort!=='S'), ...L.filter(o=>_isNu(o)&&o.soort==='S')], later=L.filter(o=>!_isNu(o));
  const nuDone=nu.filter(o=>_oefState(o).done).length;
  return `<section class="les-sec" id="les-oef">
    <h2>📝 Oefeningen ${nu.length?`<span class="sec-n" id="les-oef-n">${nuDone}/${nu.length} 📌-oefeningen klaar</span>`:''}</h2>
    <p class="les-tip">Maak alle oefeningen met 📌 — de ✏ <b>extra oefeningen</b> zijn het belangrijkst. De bronnen staan bij elke oefening (en ook in je oefenbundel). Je typt je antwoorden hier — ze worden automatisch bewaard en je leerkracht kan ze lezen.
    ${_oplShown(les.r)?' Oplossingen verschijnen per oefening zodra je alles ingevuld hebt.':' De oplossingen komen online nadat je leerkracht je antwoorden bekeken heeft.'}</p>
    ${nu.map(_oefArticle).join('')}
    ${later.length?`<details class="oef-later-box"${nu.length?'':' open'}><summary>${nu.length?'Andere oefeningen — die doen we later in de klas':'Oefeningen van deze les'} (${later.length})</summary>${later.map(_oefArticle).join('')}</details>`:''}
  </section>`;
}
function _oefBind(les){
  document.querySelectorAll('#les-oef .oef-ta').forEach(ta=>{
    const id=ta.dataset.oef, k=ta.dataset.k, key=_oefKey(id,k), o=OEF[id];
    const prev=ST.open[key]; if(prev && prev.t) ta.value=prev.t;
    let pasted=false;
    ta.addEventListener('paste', e=>{ const t=(e.clipboardData||window.clipboardData)?.getData('text')||''; if(t.length>40) pasted=true; });
    ta.addEventListener('input', ()=>{
      const before=_oefState(o).done;
      _openSet(key, {t: ta.value.slice(0,3000), w:_wordCount(ta.value), p: (pasted||(ST.open[key]||{}).p)?1:0});
      const s=_oefState(o);
      const st=$('oef-st-'+id); if(st) st.textContent = s.done?'✓ ingevuld':s.n+'/'+s.tot;
      $('oef-'+id).classList.toggle('done', s.done);
      if(!before && s.done && !(ST.open[_oefKey(id,'x')]||{}).t){
        _openSet(_oefKey(id,'x'), {t:'1'});
        const r=ta.getBoundingClientRect(); addXP(XP_OEF, r.left+r.width/2, r.top);
      }
      if(before!==s.done) _oplFill(les);
      _lpAfterChange(les, false, 8000);
    });
    ta.addEventListener('blur', ()=>_lpSave());
  });
  _oplFill(les); _oplLoad(les.r);
}
function _oplFill(les){
  const P=V3.opl[les.r];
  (les.oef||[]).forEach(id=>{
    const el=$('oef-opl-'+id); if(!el) return;
    if(!_oplShown(les.r) || !P || !P[id] || !P[id].length){ el.innerHTML=''; return; }
    el.innerHTML = _oefState(OEF[id]).done
      ? `<details class="oef-opl-d"><summary>Toon oplossing</summary><ul>${P[id].map(x=>`<li>${_esc(x)}</li>`).join('')}</ul></details>`
      : '<div class="oef-opl-lock">🔒 Vul eerst alle antwoorden in, dan kun je de oplossing bekijken.</div>';
  });
  const m=$('lp-sam-model'); if(m){
    const hv=P && P['hv:'+les.id];
    const sam=_lpGet(les.id,'sam');
    m.innerHTML = (_oplShown(les.r) && hv && hv.model && sam && sam.t)
      ? `<details class="oef-opl-d"><summary>Toon een modelantwoord</summary><dl class="hvmodel">${hv.model.map(([a,b])=>`<div><dt>${_esc(a)}</dt><dd>${_esc(b)}</dd></div>`).join('')}</dl>${hv.noot?`<p class="crit-note">${_esc(hv.noot)}</p>`:''}</details>` : '';
  }
}

// ═══════════════════════════════════════
// v9 — opdrachten met deadline en punten, vragen, cursus, begrippen, voortgang, make-over
// ═══════════════════════════════════════
const CURSUS = {"delen": [{"id": "BB", "titel": "De Bronbox", "sub": "Historisch onderzoek: van verleden naar geschiedenis", "secties": [{"id": "BB-1", "titel": "Historische beeldvorming: van verleden naar geschiedenis", "p": 9, "html": "<p>Hoe komt een beeld van het verleden tot stand?</p><p><img src=\"data:image/png;base64,\" alt=\"\"></p>", "sub": [], "tekst": "hoe komt een beeld van het verleden tot stand"}, {"id": "BB-2", "titel": "1. Een historische vraag stellen", "p": 10, "html": "<h3 id=\"h-BB-2-1\">1.1 Voorwaarden voor een goede historische vraag</h3><p>Voordat je op onderzoek gaat, moet je weten wat je precies wilt onderzoeken.</p><p>Een goede onderzoeksvraag moet aan de volgende voorwaarden voldoen:</p><p><b>Voorwaarde 1 -</b> <b>specifiek</b>:</p><p>voldoende afgebakend in tijd, ruimte en/of maatschappelijk domein</p><p><b>Voorwaarde 2 -</b> <b>onderzoekbaar</b>:</p><p>voldoende bruikbare, betrouwbare en/of representatieve bronnen hebben</p><p><b>Voorwaarde 3 -</b> <b>relevant</b>:</p><p>niet gewoon vragen naar een historisch feitje, maar voldoende gebruik maken \nvan een of meerdere <br><b>historische redeneerwijzen</b>: oorzaak en gevolg, toeval, continuïteit en verandering, evolutie en revolutie &amp; gelijktijdigheid en ongelijktijdigheid<b> </b></p><p><b>Redeneerwijze A –</b> <b>oorzaak en gevolg </b></p><p>Waarom is iets gebeurd: aanleiding, dieperliggende oorzaken, en</p><p>de (on)bedoelde gevolgen op korte of lange termijn</p><p><i>Voorbeeld: De Eerste Wereldoorlog </i></p><p><i>▪ Aanleiding: Moord op aartshertog Franz Ferdinand \n<br>▪ Diepere oorzaken: Nationalisme, imperialisme, militarisme, wapenwedloop en allianties (afb)\n<br>▪ Bedoeld gevolg: Snelle oorlog \n<br>▪ Onbedoeld gevolg: Vier jaar lange, verwoestende oorlog </i></p><p><img src=\"data:image/jpeg;base64,\" alt=\"\"><b>Redeneerwijze B - toeval:</b></p><p>Gebeurtenis waarvoor geen oorzaak te vinden is: een historische gebeurtenis</p><p>wordt veroorzaakt door een onvoorspelbare, onbedoelde samenloop van</p><p>omstandigheden</p><p><i>▪ De chauffeur van Franz Ferdinand nam de verkeerde weg en geheel  toevallig kwam Princip op dat moment uit een bar. Princip had eerder op de dag zijn eerste kans gemist, maar schoot nu zowel de kroonprins als zijn echtgenote dood.</i></p><p><b>Redeneerwijze C - continuïteit en verandering:</b></p><p>Wat blijft hetzelfde, wat verandert er?</p><p><i>▪ Na de Eerste Wereldoorlog verdwenen grote rijken zoals Oostenrijk-Hongarije en het Ottomaanse Rijk en ontstonden nieuwe landen zoals Tsjechoslovakije en Joegoslavië</i></p><p><i>▪ Hoe veranderde de oorlogsvoering aan het westelijk front tussen 1914 en 1918?</i></p><p><b>Redeneerwijze D - evolutie en revolutie</b></p><p>- Is er sprake van revolutie, een geleidelijke ontwikkeling of van revolutie, een</p><p>ingrijpende, snelle omslag?</p><p>- Is er sprake van een breuk, een plotse verandering?</p><p><i>▪ In welke mate zorgde de Eerste Wereldoorlog voor een geleidelijke evolutie</i></p><p><i> dan wel een revolutionaire verandering in de positie van vrouwen in de </i></p><p><i>samenleving?</i></p><p><b>Redeneerwijze E - gelijktijdigheid en ongelijktijdigheid</b></p><p>Doen zaken zich op hetzelfde moment voor of gebeurden bepaalde zaken niet - overal ter wereld, in elke sociale groep - op hetzelfde moment?</p><p><i>▪ Hoe verliepen de ontwikkeling van de loopgravenoorlog en de introductie van nieuwe wapens ten opzichte van elkaar tussen 1914 en 1918?</i></p><p><i>▪ Hoe veroorzaakte het gelijktijdig gebruik van 19de-eeuwse militaire tactieken </i></p><p><i>en 20ste-eeuwse nieuwe wapens de loopgravenoorlog aan het Westelijk front </i></p><p><i>in 1914?</i></p><p><img src=\"data:image/jpeg;base64,\" alt=\"\"></p><h3 id=\"h-BB-2-2\">Soorten historische vragen</h3><p><img src=\"data:image/png;base64,\" alt=\"\"></p><h3 id=\"h-BB-2-3\">Oefening ‘een goede historische vraag’</h3><p>- Noteer aan welke voorwaarde niet werd voldaan?\n- Lees de <br>goede versie(s) van de onderzoeksvraag en bepaal of ze beschrijvend, verklarend, vergelijkend of beoordelend is/zijn?\n- Welke historische redeneerwijze(n) werd(en) gebruikt?<br></p><p>1) - Wat gebeurde er in de Middeleeuwen? ________________________________ \n    <br>+ <i>Hoe zag het dagelijks leven in Rome eruit tijdens de pestepidemie van 1348?</i>  \n       _______________________________________________________________<br>     \n    * Historische redeneerwijze: __________________________________________<br></p><p>2) - Wat dacht Julius Caesar toen hij werd vermoord? ________________________\n    + <br><i>Hoe beschreven Romeinse bronnen de moord op Julius Caesar?</i> ___________</p><p>* Historische redeneerwijze: __________________________________________</p><p>+ <i>Hoe beschreven tijdgenoten van Caesar de moord en hoe verschilden die met </i></p><p><i>       bronnen die later werden geschreven?</i> ________________________________</p><p>* Historische redeneerwijze: __________________________________________</p><p>3) - Wat zou er gebeurd zijn als Napoleon de slag bij Waterloo had gewonnen? \n       ________________________________________________________________<br>\n    + <br><i>Welke gevolgen had de nederlaag van Napoleon in Waterloo in 1815 voor de\n      <br> Europese machtsverhoudingen?</i> _____________________________________</p><p>* Historische redeneerwijze: __________________________________________\n     + <br><i>In welke mate verschilde de militaire strategie van Napoleon bij Waterloo van</i></p><p><i>       die tijdens eerdere veldslagen</i>? ______________________________________</p><p>* Historische redeneerwijze: __________________________________________</p><p>4) -  Hoe veranderde WO I de politiek? ____________________________________\n    + <br><i>In welke mate leidde de totale oorlog tussen 1914 en 1918 tot een inperking van </i></p><p><i>de democratische rechten en de persvrijheid in Groot-Brittannië</i>? _____________\n    * Historische redeneerwijze: __________________________________________<br></p><p>+ <i>Welke beperkingen werden tijdens WO I opgelegd aan de persvrijheid in Groot-Brittannië</i>? ________________________________________________________\n* Historische redeneerwijze: __________________________________________<br></p><p>5) - Hoeveel schepen had de VOC ter beschikking in de 1ste helft van de 17e eeuw?\n       _______________________________________________________________ <br></p><p>+ <i>In welke mate bepaalde de omvang van de VOC-vloot de militaire dominantie \n       <br>van de compagnie in de Banda-eilanden?</i> _____________________________\n     * Historische redeneerwijze: _________________________________________<br></p><p>+ <i>In welke mate vielen de groei van de VOC-vloot en de uitbreiding van de militaire dominantie van de VOC op de Banda-eilanden samen</i>? _____________\n* Historische redeneerwijze: __________________________________________<br>\n<br></p><p><u>Opmerking</u>: Deze ‘slechte’ vraag is inderdaad geen goede <b>hoofdonderzoeksvraag</b> maar wel een goede <b>deelvraag</b>. Deelvragen gaan over de basisfeiten die je nodig hebt om de hoofdvraag te kunnen beantwoorden. Dit zijn vaak de wie, wat, waar, hoeveel-vragen.</p>", "sub": [{"id": "h-BB-2-1", "t": "1.1 Voorwaarden voor een goede historische vraag", "p": 10}, {"id": "h-BB-2-2", "t": "Soorten historische vragen", "p": 14}, {"id": "h-BB-2-3", "t": "Oefening ‘een goede historische vraag’", "p": 14}], "tekst": "1 1 voorwaarden voor een goede historische vraag voordat je op onderzoek gaat moet je weten wat je precies wilt onderzoeken een goede onderzoeksvraag moet aan de volgende voorwaarden voldoen voorwaarde 1 specifiek voldoende afgebakend in tijd ruimte en of maatschappelijk domein voorwaarde 2 onderzoekbaar voldoende bruikbare betrouwbare en of representatieve bronnen hebben voorwaarde 3 relevant niet gewoon vragen naar een historisch feitje maar voldoende gebruik maken van een of meerdere historische redeneerwijzen oorzaak en gevolg toeval continuïteit en verandering evolutie en revolutie amp gelijktijdigheid en ongelijktijdigheid redeneerwijze a oorzaak en gevolg waarom is iets gebeurd aanleiding dieperliggende oorzaken en de on bedoelde gevolgen op korte of lange termijn voorbeeld de eerste wereldoorlog aanleiding moord op aartshertog franz ferdinand diepere oorzaken nationalisme imperialisme militarisme wapenwedloop en allianties afb bedoeld gevolg snelle oorlog onbedoeld gevolg vier jaar lange verwoestende oorlog redeneerwijze b toeval gebeurtenis waarvoor geen oorzaak te vinden is een historische gebeurtenis wordt veroorzaakt door een onvoorspelbare onbedoelde samenloop van omstandigheden de chauffeur van franz ferdinand nam de verkeerde weg en geheel toevallig kwam princip op dat moment uit een bar princip had eerder op de dag zijn eerste kans gemist maar schoot nu zowel de kroonprins als zijn echtgenote dood redeneerwijze c continuïteit en verandering wat blijft hetzelfde wat verandert er na de eerste wereldoorlog verdwenen grote rijken zoals oostenrijk hongarije en het ottomaanse rijk en ontstonden nieuwe landen zoals tsjechoslovakije en joegoslavië hoe veranderde de oorlogsvoering aan het westelijk front tussen 1914 en 1918 redeneerwijze d evolutie en revolutie is er sprake van revolutie een geleidelijke ontwikkeling of van revolutie een ingrijpende snelle omslag is er sprake van een breuk een plotse verandering in welke mate zorgde de eerste wereldoorlog voor een geleidelijke evolutie dan wel een revolutionaire verandering in de positie van vrouwen in de samenleving redeneerwijze e gelijktijdigheid en ongelijktijdigheid doen zaken zich op hetzelfde moment voor of gebeurden bepaalde zaken niet overal ter wereld in elke sociale groep op hetzelfde moment hoe verliepen de ontwikkeling van de loopgravenoorlog en de introductie van nieuwe wapens ten opzichte van elkaar tussen 1914 en 1918 hoe veroorzaakte het gelijktijdig gebruik van 19de eeuwse militaire tactieken en 20ste eeuwse nieuwe wapens de loopgravenoorlog aan het westelijk front in 1914 soorten historische vragen oefening een goede historische vraag noteer aan welke voorwaarde niet werd voldaan lees de goede versie s van de onderzoeksvraag en bepaal of ze beschrijvend verklarend vergelijkend of beoordelend is zijn welke historische redeneerwijze n werd en gebruikt 1 wat gebeurde er in de middeleeuwen ________________________________ hoe zag het dagelijks leven in rome eruit tijdens de pestepidemie van 1348 _______________________________________________________________ historische redeneerwijze __________________________________________ 2 wat dacht julius caesar toen hij werd vermoord ________________________ hoe beschreven romeinse bronnen de moord op julius caesar ___________ historische redeneerwijze __________________________________________ hoe beschreven tijdgenoten van caesar de moord en hoe verschilden die met bronnen die later werden geschreven ________________________________ historische redeneerwijze __________________________________________ 3 wat zou er gebeurd zijn als napoleon de slag bij waterloo had gewonnen ________________________________________________________________ welke gevolgen had de nederlaag van napoleon in waterloo in 1815 voor de europese machtsverhoudingen _____________________________________ historische redeneerwijze __________________________________________ in welke mate verschilde de militaire strategie van napoleon bij waterloo van die tijdens eerdere veldslagen ______________________________________ historische redeneerwijze __________________________________________ 4 hoe veranderde wo i de politiek ____________________________________ in welke mate leidde de totale oorlog tussen 1914 en 1918 tot een inperking van de democratische rechten en de persvrijheid in groot brittannië _____________ historische redeneerwijze __________________________________________ welke beperkingen werden tijdens wo i opgelegd aan de persvrijheid in groot brittannië ________________________________________________________ historische redeneerwijze __________________________________________ 5 hoeveel schepen had de voc ter beschikking in de 1ste helft van de 17e eeuw _______________________________________________________________ in welke mate bepaalde de omvang van de voc vloot de militaire dominantie van de compagnie in de banda eilanden _____________________________ historische redeneerwijze _________________________________________ in welke mate vielen de groei van de voc vloot en de uitbreiding van de militaire dominantie van de voc op de banda eilanden samen _____________ historische redeneerwijze __________________________________________ opmerking deze slechte vraag is inderdaad geen goede hoofdonderzoeksvraag maar wel een goede deelvraag deelvragen gaan over de basisfeiten die je nodig hebt om de hoofdvraag te kunnen beantwoorden dit zijn vaak de wie wat waar hoeveel vragen"}, {"id": "BB-3", "titel": "Bronnenstudie uitvoeren", "p": 16, "html": "<h3 id=\"h-BB-3-1\">Stap 1: Bouw het historisch referentiekader uit</h3><p><img src=\"data:image/png;base64,\" alt=\"\"></p><h3 id=\"h-BB-3-2\">Stap 2: Werk met en over historische bronnen</h3><p><img src=\"data:image/png;base64,\" alt=\"\"></p><h4 id=\"h-BB-3-3\">Soorten bronnen</h4><p><img src=\"data:image/png;base64,\" alt=\"\"><b>\n<br></b></p><h4 id=\"h-BB-3-4\">Bruikbaar, betrouwbaar, representatief</h4><p><b>Bruikbaar</b></p><p>Wat is de inhoud van de bron is: bevat die informatie die je kan helpen om de historische vraag te beantwoorden. \nOok een bron die bepaalde informatie verzwijgt, kan bruikbaar zijn. <br></p><p>Om de bruikbaarheid van een bron te beargumenteren gebruik ik deze schrijfkaders:</p><div class=\"cu-tw\"><table><tr><th></th></tr><tr><td>De bron is wel / niet bruikbaar om meer te weten te komen over …</td></tr><tr><td>De bron gaat over … Ik kan ze daarom wel / niet gebruiken om … te onderzoeken.</td></tr><tr><td>De bron geeft me enkel informatie over … Ik kan daardoor slechts een deel van de historische vraag met de bron beantwoorden.</td></tr></table></div><p><b>Betrouwbaar</b></p><p>Een bruikbare bron is niet noodzakelijk een betrouwbare bron. \n<br>Om de betrouwbaarheid van een bron te beoordelen: \n- <br>ga je na hoe correct en nauwkeurig de informatie uit de bron is. \n- onderzoek je de<br> motieven van de maker die kunnen wijzen op onbetrouwbaarheid.</p><p>Voor het beoordelen van de betrouwbaarheid moet je altijd rekening houden met de historische vraag. Zo zijn de memoires van een politicus misschien niet betrouwbaar als je onderzoekt hoe een beslissing precies tot stand kwam, maar kunnen ze wel betrouwbaar zijn als je de politieke cultuur in een bepaalde periode onderzoekt.</p><p>Betrouwbaarheid en objectiviteit zijn daarom geen synoniemen: egodocumenten, zoals dagboekfragmenten of memoires, kunnen bijvoorbeeld betrouwbare informatie geven over de manier waarop de auteur bepaalde gebeurtenissen ervaarde of wilde presenteren, maar ze zijn niet objectief. Hoe betrouwbaarder het bronnenmateriaal is, hoe beter je een historische vraag kunt beantwoorden.</p><p>Om de betrouwbaarheid van een bron te beargumenteren gebruik ik deze schrijfkaders:</p><div class=\"cu-tw\"><table><tr><th>De maker van de bron is goed / slecht geïnformeerd over … , en dus is de bron eerder wel / eerder niet betrouwbaar.</th></tr><tr><td>De maker van de bron weet er veel / weinig over, dus is de bron eerder wel / eerder niet betrouwbaar om … te beantwoorden.</td></tr><tr><td>De bron werd gemaakt met als doel ... Dat maakt de bron minder betrouwbaar in het licht van deze historische vraag, omdat ...</td></tr><tr><td>Een reden waarom ik de informatie in de bron betrouwbaar vind, is de informatie waarover de auteur beschikte. De auteur baseerde zich namelijk op ...</td></tr><tr><td>Hoewel de bron een jaar na de feiten tot stand kwam, denk ik dat de informatie in de bron betrouwbaar is, omdat ...</td></tr></table></div><h4 id=\"h-BB-3-5\">Oefening soorten bronnen</h4><p>Welke soort historische bron is dit? \nDe historische vraag die moet worden beantwoord is cursief gedrukt.<br></p><p>Is de bron bruikbaar, betrouwbaar en/of representatief?</p><p>1) Fragment uit het dagboek van een IJzer-soldaat uit WOI waarin hij de situatie in de loopgraven beschrijft.\n<br><i>In welke omstandigheden leefden de soldaten in de loopgraven aan het Westelijk front gedurende WOI?\n<br></i> ________________________________________________________________  ________________________________________________________________ ___________________________________________________________________</p><p>2) Re-enactment van de veldslag ter gelegenheid van 200 jaar Slag bij Waterloo.\n<br><i>Hoe waren de soldaten opgesteld op het slagveld tijdens de Slag bij Waterloo</i></p><p><i>op 18 juni 1815? \n<br></i> ________________________________________________________________  ________________________________________________________________ ___________________________________________________________________</p><p>3) Militaire stafkaart van vlak voor de Slag bij Waterloo, getekend door Napoleon.</p><p><i>Hoe waren de soldaten opgesteld op het slagveld tijdens de Slag bij Waterloo</i></p><p><i>op 18 juni 1815? \n<br></i> _________________________________________________________________  _________________________________________________________________ ___________________________________________________________________</p><p>4) Historische roman over Karel V.</p><p><i>Hoe beschrijven hedendaagse auteurs de historische figuur Karel V?</i></p><p>________________________________________________________________  ________________________________________________________________ ___________________________________________________________________</p><p>5)<i> </i>Historische roman over Karel V en de vervolging van de protestanten.</p><p><i>Welke straffen kregen protestanten tussen 1520 en 1555 onder Karel V?\n<br></i> ________________________________________________________________  ________________________________________________________________ ___________________________________________________________________</p><h4 id=\"h-BB-3-6\">2.2.5 Oefening bronnen zoeken</h4><p>Kies een historische gebeurtenis uit je regio. Zoek vijf verschillende soorten bronnen erover.</p><p>▪ Een geschreven bron (krant, document)</p><p>▪ Een visuele bron (foto, schilderij)</p><p>▪ Een materiële bron (gebouw, voorwerp)</p><p>▪ Een mondelinge bron (interview, verhaal)</p><p>▪ Een historisch werk (geschiedenisboek, documentaire, podcast, artikel)</p><h3 id=\"h-BB-3-7\">Stap 3: De historische vraag beantwoorden</h3><p>Na de bronnenstudie kan de historische vraag beantwoord worden. Dit antwoord moet onderbouwd zijn met informatie uit de bronnen. Het bewijsmateriaal is sterker als het gebaseerd is op meerdere bronnen en/of afkomstig is van betrouwbare en representatieve bronnen.</p><p><img src=\"data:image/png;base64,\" alt=\"\"></p><h4 id=\"h-BB-3-8\">Maak gebruik van de historische redeneerwijzen</h4><p>Beantwoord de vraag gebruik makend van de historische redeneerwijzen en de correcte begrippen. Dit maakt het verschil tussen historische kennis en historisch redeneren.</p><p><i>▪ “Waarom brak de Eerste Wereldoorlog uit?”</i></p><p><b>Historische kennis</b>: “Er was de moord op Franz Ferdinand. Er waren bondgenootschappen. Er was nationalisme. Duitsland verklaarde de oorlog...”</p><p><b>Historisch redeneren</b>: “De moord op Franz Ferdinand was de directe aanleiding voor het uitbreken van WO I, maar de oorlog kan niet uitsluitend hierdoor verklaard worden. Er waren ook verschillende maatschappelijke stromingen zoals het nationalisme en het imperialisme die tegelijk voorkwamen en die ervoor zorgden dat een lokaal conflict kon uitgroeien tot een Europese oorlog.”</p><h4 id=\"h-BB-3-9\">Zorg voor multiperspectiviteit</h4><p><b>Perspectief 1 - Vanuit de 4 maatschappelijke domeinen: </b></p><p>- Politiek perspectief: Welke politieke belangen en machtsverhoudingen</p><p>spelen een rol?</p><p>- Economisch perspectief: Wie profiteert of verliest economisch door de</p><p>gebeurtenis?</p><p>- Sociaal perspectief: Welke gevolgen heeft de gebeurtenis voor verschillende</p><p>bevolkingsgroepen en hun onderlinge verhoudingen? Welke rol spelen \nrolpatronen hierbij?<br></p><p>- Cultureel perspectief: Welke normen, waarden, overtuigingen en tradities</p><p>beïnvloeden de gebeurtenis? Welke rol speelt wetenschappelijke kennis?</p><p>Welke rol speelde de godsdienst?</p><p><b>Perspectief 2 - Standplaatsgebondenheid</b>: \n<br>Hoe ervaren verschillende (groepen) personen dezelfde gebeurtenis? Eenzelfde historische gebeurtenis zal door de machthebbers, de soldaat, de vrouw, de winnaars, de verliezers, …anders ervaren en beoordeeld worden<b> </b></p><p><i>▪ “Hoe werd het uitbreken van de Eerste Wereldoorlog in 1914 ervaren?”</i></p><p><i>De Duitse regering zag de situatie vanuit de belangen en veiligheid van Duitsland, terwijl voor de radicale Servische nationalisten de oorlog werd gezien als een strijd voor nationale bevrijding en eenwording.   </i></p><p><b>Perspectief 3 – Tijdsperspectief:</b></p><p>Hier kijk je naar de tijd waarin mensen leefden en probeer je hun denken te begrijpen vanuit die historische context.</p><p>Wat was de mentaliteit in de tijd van de gebeurtenis? Hoe dacht men toen? \n<br>Vermijd presentisme en beoordeel het verleden niet met de normen en de kennis van vandaag.</p><p><i>▪ “Hoe keken de mensen in 1914 naar oorlog?”</i></p><p><i>In grote delen van Europa bestond er in 1914 meer aanvaarding van oorlog als een legitiem middel van politiek dan vandaag. Oorlog was voor veel mensen niet iets ondenkbaars. Europese staten hadden in de decennia ervoor geregeld oorlog gevoerd en militairen genoten in veel samenlevingen aanzien.</i></p><p><i>Ook bestond er bij het uitbreken van de oorlog bij sommige bevolkingsgroepen enthousiasme of patriottisme. Sommige jongemannen meldden zich vrijwillig en verwachtten vaak dat de oorlog relatief kort zou duren.</i></p><h4 id=\"h-BB-3-10\">Oefening perspectieven vergelijken</h4><p>Kies een controversiële historische gebeurtenis, bv. de atoombom op Hiroshima.\nZoek bronnen die er  verschillend over denken en beantwoord per bron deze vragen: <br></p><p>▪ Wat zijn de verschillende standpunten?</p><p>▪ Hoe kun je deze verschillen verklaren?</p><p>▪ Welke argumenten gebruikt elke partij?</p><p>▪ Wat is jouw eigen, gefundeerde mening?</p><h4 id=\"h-BB-3-11\">Vermijd veralgemening (stereotypering) en vooroordelen</h4><p>Niet iedereen mag over dezelfde kam worden geschoren, pas op met oordelen over de ‘eigen’ groep en de ‘anderen’, schrijf geen kenmerken toe aan een volledige groep zonder nuance, …</p><p><i>▪ “Hoe keken de mensen in 1914 naar oorlog?” </i>Een voorbeeld van veralgemening zou zijn: <i>De mensen in 1914 vonden oorlog helemaal niet zo erg. Alle jongemannen meldden zich vrijwillig en waren enthousiast om deel te nemen.    </i></p><h4 id=\"h-BB-3-12\">2.3.5 Licht betekenissen toe</h4><p>Bij sommige onderzoeksvragen is het nodig om de betekenis toe te lichten. Weten wat iets betekende voor een persoon of groep, kan historisch handelen van de mensen toen verklaren. Het kan gaan om de betekenis voor één persoon, een groep personen of de betekenis van een feit voor een hele natie.</p><p><i>▪  “Hoe kan je de uitbraak van WO I verklaren vanuit de betekenis die de moord op de kroonprins in 1914 had voor Oostenrijk-Hongarije?”</i></p><p><i>Voor Oostenrijk-Hongarije werd dit niet zomaar gezien als de moord op één individu. Het </i><u><i>betekende</i></u><i> dat het Servisch nationalisme een grote bedreiging was voor het voortbestaan van hun rijk. Dat verklaart dus waarom er zo’n streng ultimatum aan Servië werd gesteld dat uiteindelijk tot oorlog leidde en er niet werd gekozen voor een diplomatieke, vredevolle oplossing.</i></p><p><b>Collectieve herinnering</b></p><p>Veel herinneringen uit het verleden leven voort in het geheugen van een grote groep mensen, zoals de inwoners van een stad of land. Dit is niet noodzakelijk een herinnering aan wat er precies is gebeurd, maar wel de <u>betekenis</u> die aan een gebeurtenis gegeven wordt.</p><p>Collectieve herinneringen kunnen door overheden geïntroduceerd worden en een uiting krijgen in materieel (standbeeld, …) of immaterieel erfgoed (feestdag, …). Ze kunnen ook via familieverhalen worden doorverteld (migratie- of oorlogsverhalen).</p><p>Een collectieve herinnering had/heeft meestal een doel: een collectieve identiteit construeren, samenhorigheid of net uitsluiting aanwakkeren, waarden overbrengen, … Hiertoe wordt vaak eenzijdig en slectief omgegaan met het verleden.</p><p><i>Een historisch feit kan voor mensen vandaag nog een grote betekenis heeft is de Franse Revolutie. Deze </i><u><i>betekent</i></u><i> voor veel mensen een overwinning van de vrijheid, de gelijkheid en volkssoevereiniteit op het absolutisme en het machtsmisbruik. In 1880 koos de overheid 14 juli als nationale feestdag. De republikeinse overheid van 1880 gaf een nieuwe betekenis aan een gebeurtenis uit 1789 en gebruikten die om de Republiek van hun eigen tijd te legitimeren en te versterken.</i></p>", "sub": [{"id": "h-BB-3-1", "t": "Stap 1: Bouw het historisch referentiekader uit", "p": 16}, {"id": "h-BB-3-2", "t": "Stap 2: Werk met en over historische bronnen", "p": 17}, {"id": "h-BB-3-3", "t": "Soorten bronnen", "p": 18}, {"id": "h-BB-3-4", "t": "Bruikbaar, betrouwbaar, representatief", "p": 19}, {"id": "h-BB-3-5", "t": "Oefening soorten bronnen", "p": 20}, {"id": "h-BB-3-6", "t": "2.2.5 Oefening bronnen zoeken", "p": 21}, {"id": "h-BB-3-7", "t": "Stap 3: De historische vraag beantwoorden", "p": 22}, {"id": "h-BB-3-8", "t": "Maak gebruik van de historische redeneerwijzen", "p": 22}, {"id": "h-BB-3-9", "t": "Zorg voor multiperspectiviteit", "p": 23}, {"id": "h-BB-3-10", "t": "Oefening perspectieven vergelijken", "p": 24}, {"id": "h-BB-3-11", "t": "Vermijd veralgemening (stereotypering) en vooroordelen", "p": 24}, {"id": "h-BB-3-12", "t": "2.3.5 Licht betekenissen toe", "p": 24}], "tekst": "stap 1 bouw het historisch referentiekader uit stap 2 werk met en over historische bronnen soorten bronnen bruikbaar betrouwbaar representatief bruikbaar wat is de inhoud van de bron is bevat die informatie die je kan helpen om de historische vraag te beantwoorden ook een bron die bepaalde informatie verzwijgt kan bruikbaar zijn om de bruikbaarheid van een bron te beargumenteren gebruik ik deze schrijfkaders de bron is wel niet bruikbaar om meer te weten te komen over de bron gaat over ik kan ze daarom wel niet gebruiken om te onderzoeken de bron geeft me enkel informatie over ik kan daardoor slechts een deel van de historische vraag met de bron beantwoorden betrouwbaar een bruikbare bron is niet noodzakelijk een betrouwbare bron om de betrouwbaarheid van een bron te beoordelen ga je na hoe correct en nauwkeurig de informatie uit de bron is onderzoek je de motieven van de maker die kunnen wijzen op onbetrouwbaarheid voor het beoordelen van de betrouwbaarheid moet je altijd rekening houden met de historische vraag zo zijn de memoires van een politicus misschien niet betrouwbaar als je onderzoekt hoe een beslissing precies tot stand kwam maar kunnen ze wel betrouwbaar zijn als je de politieke cultuur in een bepaalde periode onderzoekt betrouwbaarheid en objectiviteit zijn daarom geen synoniemen egodocumenten zoals dagboekfragmenten of memoires kunnen bijvoorbeeld betrouwbare informatie geven over de manier waarop de auteur bepaalde gebeurtenissen ervaarde of wilde presenteren maar ze zijn niet objectief hoe betrouwbaarder het bronnenmateriaal is hoe beter je een historische vraag kunt beantwoorden om de betrouwbaarheid van een bron te beargumenteren gebruik ik deze schrijfkaders de maker van de bron is goed slecht geïnformeerd over en dus is de bron eerder wel eerder niet betrouwbaar de maker van de bron weet er veel weinig over dus is de bron eerder wel eerder niet betrouwbaar om te beantwoorden de bron werd gemaakt met als doel dat maakt de bron minder betrouwbaar in het licht van deze historische vraag omdat een reden waarom ik de informatie in de bron betrouwbaar vind is de informatie waarover de auteur beschikte de auteur baseerde zich namelijk op hoewel de bron een jaar na de feiten tot stand kwam denk ik dat de informatie in de bron betrouwbaar is omdat oefening soorten bronnen welke soort historische bron is dit de historische vraag die moet worden beantwoord is cursief gedrukt is de bron bruikbaar betrouwbaar en of representatief 1 fragment uit het dagboek van een ijzer soldaat uit woi waarin hij de situatie in de loopgraven beschrijft in welke omstandigheden leefden de soldaten in de loopgraven aan het westelijk front gedurende woi ________________________________________________________________ ________________________________________________________________ ___________________________________________________________________ 2 re enactment van de veldslag ter gelegenheid van 200 jaar slag bij waterloo hoe waren de soldaten opgesteld op het slagveld tijdens de slag bij waterloo op 18 juni 1815 ________________________________________________________________ ________________________________________________________________ ___________________________________________________________________ 3 militaire stafkaart van vlak voor de slag bij waterloo getekend door napoleon hoe waren de soldaten opgesteld op het slagveld tijdens de slag bij waterloo op 18 juni 1815 _________________________________________________________________ _________________________________________________________________ ___________________________________________________________________ 4 historische roman over karel v hoe beschrijven hedendaagse auteurs de historische figuur karel v ________________________________________________________________ ________________________________________________________________ ___________________________________________________________________ 5 historische roman over karel v en de vervolging van de protestanten welke straffen kregen protestanten tussen 1520 en 1555 onder karel v ________________________________________________________________ ________________________________________________________________ ___________________________________________________________________ 2 2 5 oefening bronnen zoeken kies een historische gebeurtenis uit je regio zoek vijf verschillende soorten bronnen erover een geschreven bron krant document een visuele bron foto schilderij een materiële bron gebouw voorwerp een mondelinge bron interview verhaal een historisch werk geschiedenisboek documentaire podcast artikel stap 3 de historische vraag beantwoorden na de bronnenstudie kan de historische vraag beantwoord worden dit antwoord moet onderbouwd zijn met informatie uit de bronnen het bewijsmateriaal is sterker als het gebaseerd is op meerdere bronnen en of afkomstig is van betrouwbare en representatieve bronnen maak gebruik van de historische redeneerwijzen beantwoord de vraag gebruik makend van de historische redeneerwijzen en de correcte begrippen dit maakt het verschil tussen historische kennis en historisch redeneren waarom brak de eerste wereldoorlog uit historische kennis er was de moord op franz ferdinand er waren bondgenootschappen er was nationalisme duitsland verklaarde de oorlog historisch redeneren de moord op franz ferdinand was de directe aanleiding voor het uitbreken van wo i maar de oorlog kan niet uitsluitend hierdoor verklaard worden er waren ook verschillende maatschappelijke stromingen zoals het nationalisme en het imperialisme die tegelijk voorkwamen en die ervoor zorgden dat een lokaal conflict kon uitgroeien tot een europese oorlog zorg voor multiperspectiviteit perspectief 1 vanuit de 4 maatschappelijke domeinen politiek perspectief welke politieke belangen en machtsverhoudingen spelen een rol economisch perspectief wie profiteert of verliest economisch door de gebeurtenis sociaal perspectief welke gevolgen heeft de gebeurtenis voor verschillende bevolkingsgroepen en hun onderlinge verhoudingen welke rol spelen rolpatronen hierbij cultureel perspectief welke normen waarden overtuigingen en tradities beïnvloeden de gebeurtenis welke rol speelt wetenschappelijke kennis welke rol speelde de godsdienst perspectief 2 standplaatsgebondenheid hoe ervaren verschillende groepen personen dezelfde gebeurtenis eenzelfde historische gebeurtenis zal door de machthebbers de soldaat de vrouw de winnaars de verliezers anders ervaren en beoordeeld worden hoe werd het uitbreken van de eerste wereldoorlog in 1914 ervaren de duitse regering zag de situatie vanuit de belangen en veiligheid van duitsland terwijl voor de radicale servische nationalisten de oorlog werd gezien als een strijd voor nationale bevrijding en eenwording perspectief 3 tijdsperspectief hier kijk je naar de tijd waarin mensen leefden en probeer je hun denken te begrijpen vanuit die historische context wat was de mentaliteit in de tijd van de gebeurtenis hoe dacht men toen vermijd presentisme en beoordeel het verleden niet met de normen en de kennis van vandaag hoe keken de mensen in 1914 naar oorlog in grote delen van europa bestond er in 1914 meer aanvaarding van oorlog als een legitiem middel van politiek dan vandaag oorlog was voor veel mensen niet iets ondenkbaars europese staten hadden in de decennia ervoor geregeld oorlog gevoerd en militairen genoten in veel samenlevingen aanzien ook bestond er bij het uitbreken van de oorlog bij sommige bevolkingsgroepen enthousiasme of patriottisme sommige jongemannen meldden zich vrijwillig en verwachtten vaak dat de oorlog relatief kort zou duren oefening perspectieven vergelijken kies een controversiële historische gebeurtenis bv de atoombom op hiroshima zoek bronnen die er verschillend over denken en beantwoord per bron deze vragen wat zijn de verschillende standpunten hoe kun je deze verschillen verklaren welke argumenten gebruikt elke partij wat is jouw eigen gefundeerde mening vermijd veralgemening stereotypering en vooroordelen niet iedereen mag over dezelfde kam worden geschoren pas op met oordelen over de eigen groep en de anderen schrijf geen kenmerken toe aan een volledige groep zonder nuance hoe keken de mensen in 1914 naar oorlog een voorbeeld van veralgemening zou zijn de mensen in 1914 vonden oorlog helemaal niet zo erg alle jongemannen meldden zich vrijwillig en waren enthousiast om deel te nemen 2 3 5 licht betekenissen toe bij sommige onderzoeksvragen is het nodig om de betekenis toe te lichten weten wat iets betekende voor een persoon of groep kan historisch handelen van de mensen toen verklaren het kan gaan om de betekenis voor één persoon een groep personen of de betekenis van een feit voor een hele natie hoe kan je de uitbraak van wo i verklaren vanuit de betekenis die de moord op de kroonprins in 1914 had voor oostenrijk hongarije voor oostenrijk hongarije werd dit niet zomaar gezien als de moord op één individu het betekende dat het servisch nationalisme een grote bedreiging was voor het voortbestaan van hun rijk dat verklaart dus waarom er zo n streng ultimatum aan servië werd gesteld dat uiteindelijk tot oorlog leidde en er niet werd gekozen voor een diplomatieke vredevolle oplossing collectieve herinnering veel herinneringen uit het verleden leven voort in het geheugen van een grote groep mensen zoals de inwoners van een stad of land dit is niet noodzakelijk een herinnering aan wat er precies is gebeurd maar wel de betekenis die aan een gebeurtenis gegeven wordt collectieve herinneringen kunnen door overheden geïntroduceerd worden en een uiting krijgen in materieel standbeeld of immaterieel erfgoed feestdag ze kunnen ook via familieverhalen worden doorverteld migratie of oorlogsverhalen een collectieve herinnering had heeft meestal een doel een collectieve identiteit construeren samenhorigheid of net uitsluiting aanwakkeren waarden overbrengen hiertoe wordt vaak eenzijdig en slectief omgegaan met het verleden een historisch feit kan voor mensen vandaag nog een grote betekenis heeft is de franse revolutie deze betekent voor veel mensen een overwinning van de vrijheid de gelijkheid en volkssoevereiniteit op het absolutisme en het machtsmisbruik in 1880 koos de overheid 14 juli als nationale feestdag de republikeinse overheid van 1880 gaf een nieuwe betekenis aan een gebeurtenis uit 1789 en gebruikten die om de republiek van hun eigen tijd te legitimeren en te versterken"}, {"id": "BB-4", "titel": "Lees- en kijkstrategieën", "p": 26, "html": "<h3 id=\"h-BB-4-1\">Voor geschreven bronnen</h3><p><b>Stap 1: Oriënterend lezen </b></p><p class=\"cu-oef\">▪ Scan de tekst: Kijk naar titels, ondertitels, eerste zinnen</p><p class=\"cu-oef\">▪ Zoek de kernboodschap: Waar gaat het over?</p><p class=\"cu-oef\">▪ Let op de structuur: Hoe is de tekst opgebouwd?</p><p class=\"cu-oef\"><b>Stap 2: Intensief lezen </b></p><p class=\"cu-oef\">▪ Lees aandachtig: Probeer elk detail te begrijpen</p><p class=\"cu-oef\">▪ Maak notities: Schrijf belangrijke punten op</p><p class=\"cu-oef\">▪ Zoek verbanden: Hoe hangen verschillende delen samen?</p><p class=\"cu-oef\"><b>Stap 3: Kritisch lezen </b></p><p class=\"cu-oef\">▪ Stel vragen: Klopt dit? Waarom denkt de auteur dit?</p><p class=\"cu-oef\">▪ Zijn er retorische strategieën gebruikt? Dit kan wijzen op onbetrouwbaarheid.</p><p class=\"cu-oef\">Vergelijk met andere bronnen: Wat zeggen andere bronnen hierover?</p><h3 id=\"h-BB-4-2\">3.2 Voor visuele bronnen</h3><p><b>Stap 1: Oriënterend kijken </b></p><p class=\"cu-oef\">▪ Eerste indruk: Wat zie je als eerste?</p><p class=\"cu-oef\">▪ Globale compositie: Hoe is het beeld opgebouwd?</p><p class=\"cu-oef\">▪ Sfeer: Welke emotie roept het op?</p><p><b>Stap 2: Gedetailleerd kijken </b></p><p class=\"cu-oef\">▪ Voorgrond, middengrond, achtergrond: Wat staat waar?</p><p class=\"cu-oef\">▪ Personen: Wie zie je? Hoe zijn ze gekleed? Wat doen ze?</p><p class=\"cu-oef\">Objecten: Welke voorwerpen zie je? Wat betekenen ze?</p><p class=\"cu-oef\">▪ Symboliek: Welke symbolen herken je?</p><p><b>Stap 3: Kritisch kijken </b></p><p class=\"cu-oef\">▪ Perspectief: Vanuit welk standpunt is dit gemaakt?</p><p class=\"cu-oef\">▪ Manipulatie: Is het beeld bewerkt of geënsceneerd?</p>", "sub": [{"id": "h-BB-4-1", "t": "Voor geschreven bronnen", "p": 26}, {"id": "h-BB-4-2", "t": "3.2 Voor visuele bronnen", "p": 26}], "tekst": "voor geschreven bronnen stap 1 oriënterend lezen scan de tekst kijk naar titels ondertitels eerste zinnen zoek de kernboodschap waar gaat het over let op de structuur hoe is de tekst opgebouwd stap 2 intensief lezen lees aandachtig probeer elk detail te begrijpen maak notities schrijf belangrijke punten op zoek verbanden hoe hangen verschillende delen samen stap 3 kritisch lezen stel vragen klopt dit waarom denkt de auteur dit zijn er retorische strategieën gebruikt dit kan wijzen op onbetrouwbaarheid vergelijk met andere bronnen wat zeggen andere bronnen hierover 3 2 voor visuele bronnen stap 1 oriënterend kijken eerste indruk wat zie je als eerste globale compositie hoe is het beeld opgebouwd sfeer welke emotie roept het op stap 2 gedetailleerd kijken voorgrond middengrond achtergrond wat staat waar personen wie zie je hoe zijn ze gekleed wat doen ze objecten welke voorwerpen zie je wat betekenen ze symboliek welke symbolen herken je stap 3 kritisch kijken perspectief vanuit welk standpunt is dit gemaakt manipulatie is het beeld bewerkt of geënsceneerd"}, {"id": "BB-5", "titel": "Checklist voor een goede historische analyse", "p": 27, "html": "<ul><li>[ ] Heb ik verschillende soorten bronnen gebruikt?</li><li>[ ] Heb ik de context van elke bron onderzocht?</li><li>[ ] Heb ik de bruikbaarheid, betrouwbaarheid en representativiteit beoordeeld?</li><li>[ ] Heb ik bronnen met elkaar vergeleken?</li><li>[ ] Heb ik gezocht naar verschillende perspectieven?</li><li>[ ] Heb ik gebeurtenissen in hun historische context geplaatst?</li><li>[ ] Heb ik onderscheid gemaakt tussen oorzaken en gevolgen?</li><li>[ ] Heb ik gelet op continuïteit en verandering?</li><li>[ ] Heb ik vermeden om het verleden te beoordelen met huidige normen?</li><li>[ ] Heb ik meerdere oorzaken voor gebeurtenissen onderzocht?</li><li>[ ] Is mijn onderzoeksvraag helder geformuleerd?</li><li>[ ] Heb ik mijn beweringen onderbouwd met bewijsmateriaal?</li><li>[ ] Heb ik tegenargumenten overwogen?</li><li>[ ] Heb ik genuanceerd geantwoord?</li><li>[ ] Heb ik aangegeven wat nog onduidelijk blijft?</li></ul>", "sub": [], "tekst": "heb ik verschillende soorten bronnen gebruikt heb ik de context van elke bron onderzocht heb ik de bruikbaarheid betrouwbaarheid en representativiteit beoordeeld heb ik bronnen met elkaar vergeleken heb ik gezocht naar verschillende perspectieven heb ik gebeurtenissen in hun historische context geplaatst heb ik onderscheid gemaakt tussen oorzaken en gevolgen heb ik gelet op continuïteit en verandering heb ik vermeden om het verleden te beoordelen met huidige normen heb ik meerdere oorzaken voor gebeurtenissen onderzocht is mijn onderzoeksvraag helder geformuleerd heb ik mijn beweringen onderbouwd met bewijsmateriaal heb ik tegenargumenten overwogen heb ik genuanceerd geantwoord heb ik aangegeven wat nog onduidelijk blijft"}, {"id": "BB-6", "titel": "(extra) Praktische Oefeningen", "p": 28, "html": "<h3 id=\"h-BB-6-1\">🏛️ Voor elk nieuw historisch onderwerp</h3><p class=\"cu-oef\">Oefening 1: Bronnen Zoeken\nKies een historische gebeurtenis uit je regio. Zoek vijf verschillende soorten bronnen erover:<br></p><ul><li>Een geschreven bron (krant, document)</li><li>Een visuele bron (foto, schilderij)</li><li>Een materiële bron (gebouw, voorwerp)</li><li>Een mondelinge bron (interview, verhaal)</li><li>Een moderne interpretatie (geschiedenisboek, documentaire)</li></ul><p class=\"cu-oef\">Oefening 2: Perspectieven vergelijken\nKies een controversiële historische gebeurtenis. Zoek bronnen die er verschillend over denken:<br></p><ul><li>Wat zijn de verschillende standpunten?</li><li>Hoe kun je deze verschillen verklaren?</li><li>Welke argumenten gebruikt elke kant?</li><li>Wat is jouw eigen, gefundeerde mening?</li></ul><p class=\"cu-oef\">Oefening 3: Verandering door de tijd\nKies een aspect van het dagelijkse leven (werk, wonen, onderwijs, vrije tijd):<br></p><ul><li>Hoe was dit in 1800?</li><li>Hoe was dit in 1900?</li><li>Hoe was dit in 2000?</li><li>Wat veranderde er? Wat bleef hetzelfde?</li><li>Hoe kun je deze veranderingen verklaren?</li></ul><p class=\"cu-oef\">Oefening 4: Lokale Geschiedenis\nOnderzoek de geschiedenis van je eigen woonplaats:<br></p><ul><li>Welke sporen van het verleden zie je nog?</li><li>Welke verhalen leven er in je familie of buurt?</li><li>Hoe wordt de lokale geschiedenis herinnerd?</li><li>Wiens verhalen worden verteld? Wiens verhalen ontbreken?</li></ul><p class=\"cu-oef\">Reflectievragen voor zelfbeoordeling</p><p>Na elke historische analyse kun je jezelf deze vragen stellen:</p><p><b>🎯 Over je onderzoek</b></p><ul><li>Was mijn onderzoeksvraag helder en onderzoekbaar?</li><li>Heb ik voldoende en gevarieerde bronnen gebruikt?</li><li>Heb ik de bronnen kritisch geanalyseerd?</li><li>Heb ik verschillende perspectieven onderzocht?</li></ul><p><b>🧭 Over je conclusies</b></p><ul><li>Zijn mijn conclusies goed onderbouwd?</li><li>Heb ik genuanceerd geantwoord?</li><li>Heb ik mijn eigen vooroordelen herkend en vermeden?</li><li>Welke nieuwe vragen zijn er ontstaan?</li></ul><p><b>📈 Over je leerproces</b></p><ul><li>Wat heb ik geleerd over deze historische periode?</li><li>Welke onderzoeksvaardigheden heb ik ontwikkeld?</li><li>Wat kan ik beter doen bij mijn volgende onderzoek?</li><li>Hoe helpt dit me om het heden beter te begrijpen?</li></ul>", "sub": [{"id": "h-BB-6-1", "t": "🏛️ Voor elk nieuw historisch onderwerp", "p": 28}], "tekst": "voor elk nieuw historisch onderwerp oefening 1 bronnen zoeken kies een historische gebeurtenis uit je regio zoek vijf verschillende soorten bronnen erover een geschreven bron krant document een visuele bron foto schilderij een materiële bron gebouw voorwerp een mondelinge bron interview verhaal een moderne interpretatie geschiedenisboek documentaire oefening 2 perspectieven vergelijken kies een controversiële historische gebeurtenis zoek bronnen die er verschillend over denken wat zijn de verschillende standpunten hoe kun je deze verschillen verklaren welke argumenten gebruikt elke kant wat is jouw eigen gefundeerde mening oefening 3 verandering door de tijd kies een aspect van het dagelijkse leven werk wonen onderwijs vrije tijd hoe was dit in 1800 hoe was dit in 1900 hoe was dit in 2000 wat veranderde er wat bleef hetzelfde hoe kun je deze veranderingen verklaren oefening 4 lokale geschiedenis onderzoek de geschiedenis van je eigen woonplaats welke sporen van het verleden zie je nog welke verhalen leven er in je familie of buurt hoe wordt de lokale geschiedenis herinnerd wiens verhalen worden verteld wiens verhalen ontbreken reflectievragen voor zelfbeoordeling na elke historische analyse kun je jezelf deze vragen stellen over je onderzoek was mijn onderzoeksvraag helder en onderzoekbaar heb ik voldoende en gevarieerde bronnen gebruikt heb ik de bronnen kritisch geanalyseerd heb ik verschillende perspectieven onderzocht over je conclusies zijn mijn conclusies goed onderbouwd heb ik genuanceerd geantwoord heb ik mijn eigen vooroordelen herkend en vermeden welke nieuwe vragen zijn er ontstaan over je leerproces wat heb ik geleerd over deze historische periode welke onderzoeksvaardigheden heb ik ontwikkeld wat kan ik beter doen bij mijn volgende onderzoek hoe helpt dit me om het heden beter te begrijpen"}, {"id": "BB-7", "titel": "Conclusie: Geschiedenis als levensvaardigheid", "p": 30, "html": "<p>De BRONBOX leert je meer dan alleen geschiedenis. De vaardigheden die je ontwikkelt - kritisch denken, bronnenonderzoek, verschillende perspectieven begrijpen, beweringen controleren - zijn essentieel in onze moderne wereld vol informatie en desinformatie.</p><p><b>Elke dag pas je historische vaardigheden toe:</b></p><ul><li>Wanneer je nieuwsberichten leest en afvraagt wie de bron is</li><li>Wanneer je sociale media berichten kritisch bekijkt</li><li>Wanneer je begrijpt dat elke gebeurtenis meerdere oorzaken heeft</li><li>Wanneer je respectvol omgaat met mensen uit andere culturen</li><li>Wanneer je beseft dat jouw perspectief niet het enige is</li></ul><p>De geschiedenis helpt je om de wereld van vandaag beter te begrijpen. Want het heden is het gevolg van het verleden, en door het verleden te begrijpen, kun je beter anticiperen op de toekomst.</p><p><b>Onthoud</b>: Geschiedenis gaat niet over het uit het hoofd leren van feiten, maar over het begrijpen van mensen, hun motivaties, hun keuzes en de gevolgen daarvan. Het maakt je wijzer, kritischer en empathischer.</p><p><b>Veel succes met je historische ontdekkingstochten! </b></p>", "sub": [], "tekst": "de bronbox leert je meer dan alleen geschiedenis de vaardigheden die je ontwikkelt kritisch denken bronnenonderzoek verschillende perspectieven begrijpen beweringen controleren zijn essentieel in onze moderne wereld vol informatie en desinformatie elke dag pas je historische vaardigheden toe wanneer je nieuwsberichten leest en afvraagt wie de bron is wanneer je sociale media berichten kritisch bekijkt wanneer je begrijpt dat elke gebeurtenis meerdere oorzaken heeft wanneer je respectvol omgaat met mensen uit andere culturen wanneer je beseft dat jouw perspectief niet het enige is de geschiedenis helpt je om de wereld van vandaag beter te begrijpen want het heden is het gevolg van het verleden en door het verleden te begrijpen kun je beter anticiperen op de toekomst onthoud geschiedenis gaat niet over het uit het hoofd leren van feiten maar over het begrijpen van mensen hun motivaties hun keuzes en de gevolgen daarvan het maakt je wijzer kritischer en empathischer veel succes met je historische ontdekkingstochten"}]}, {"id": "H1", "titel": "Hoofdstuk 1", "sub": "Van de vroegmoderne tijd naar de moderne tijd", "secties": [{"id": "H1-1", "titel": "🗡️ De Franse Revolutie: een radicale breuk met het verleden.", "p": 31, "html": "<h3 id=\"h-H1-1-1\">📅 21 januari 1793: De dag die Europa veranderde</h3><p>Stelt je het eens voor... Het is een koude winterdag in Parijs. Duizenden mensen stromen samen op de Place de la Révolution (het huidige Place de la Concorde). Op het podium staat een vreemde machine: de guillotine. Er zijn 50.000 soldaten op de been om de orde te bewaren. En dan... <i>KLAP!</i> Het hoofd van koning <b>Lodewijk XVI</b> valt in een mand. De beul houdt het hoofd omhoog naar de menigte, die uitbarst in kreten van &quot;Vive la République!&quot; (Leve de Republiek).</p><p>De koning was slechts 39 jaar oud toen hij stierf. Hij was de enige koning van Frankrijk die ooit werd geëxecuteerd. Zijn vrouw Marie-Antoinette zou enkele maanden later hetzelfde lot ondergaan.</p><p><i>💭 <b>Denk even na</b>: Waarom was dit moment zo revolutionair? Een koning - iemand die zijn macht van God zou hebben gekregen - wordt door zijn eigen volk ter dood gebracht. Dit was ondenkbaar in de vroegmoderne tijd! Met deze executie kwam er definitief een einde aan het <b>Ancien Régime</b>, het absolutistisch geregeerde Frankrijk van voor de Franse Revolutie.</i></p>", "sub": [{"id": "h-H1-1-1", "t": "📅 21 januari 1793: De dag die Europa veranderde", "p": 31}], "tekst": "21 januari 1793 de dag die europa veranderde stelt je het eens voor het is een koude winterdag in parijs duizenden mensen stromen samen op de place de la révolution het huidige place de la concorde op het podium staat een vreemde machine de guillotine er zijn 50 000 soldaten op de been om de orde te bewaren en dan klap het hoofd van koning lodewijk xvi valt in een mand de beul houdt het hoofd omhoog naar de menigte die uitbarst in kreten van quot vive la république quot leve de republiek de koning was slechts 39 jaar oud toen hij stierf hij was de enige koning van frankrijk die ooit werd geëxecuteerd zijn vrouw marie antoinette zou enkele maanden later hetzelfde lot ondergaan denk even na waarom was dit moment zo revolutionair een koning iemand die zijn macht van god zou hebben gekregen wordt door zijn eigen volk ter dood gebracht dit was ondenkbaar in de vroegmoderne tijd met deze executie kwam er definitief een einde aan het ancien régime het absolutistisch geregeerde frankrijk van voor de franse revolutie"}, {"id": "H1-2", "titel": "🔍 Onderzoeksvraag", "p": 32, "html": "<p>Als historici moeten we altijd kijken naar <b>oorzaken en gevolgen</b>. Het verhaal start niet met de onthoofding, maar met wat er leefde bij de mensen. Wat voelden zij? Waar hadden zij het moeilijk mee?</p>", "sub": [], "tekst": "als historici moeten we altijd kijken naar oorzaken en gevolgen het verhaal start niet met de onthoofding maar met wat er leefde bij de mensen wat voelden zij waar hadden zij het moeilijk mee"}, {"id": "H1-3", "titel": "📊 Schema: van onvrede naar revolutie", "p": 33, "html": "<p><b>1788-1789: DE PERFECTE STORM</b>\n<br>├ 💰 <b>ECONOMISCHE CRISIS</b>\n<br>│  ├ Staatsschuld: 4,5 miljard livres (onbetaalbaar!)\n<br>│  ├ Belastingen: Alleen de 3e stand (98% volk) betaalt\n<br>│  ├ Broodprijzen: 80% van dagloon → honger!\n<br>│  └ Mislukte oogsten door regen en hagel\n<br>├─ 🏰 <b>SOCIALE ONGELIJKHEID</b>  \n<br>│  ├ adel+clerus: 3% - geen belastingen, veel <b>privileges. </b>\n<br>│  └ 3e Stand (rest): 97% - alle lasten, geen rechten\n<br>└─ <b>🤔 NIEUWE IDEEËN (Verlichting)</b>\n   <br>├ &quot;Waarom heeft de koning alle macht?&quot;\n   <br>├ &quot;Zijn we niet allemaal gelijk?&quot;\n   <br>└ &quot;Moet het volk niet meebeslissen?&quot;</p>", "sub": [], "tekst": "1788 1789 de perfecte storm economische crisis staatsschuld 4 5 miljard livres onbetaalbaar belastingen alleen de 3e stand 98 volk betaalt broodprijzen 80 van dagloon honger mislukte oogsten door regen en hagel sociale ongelijkheid adel clerus 3 geen belastingen veel privileges 3e stand rest 97 alle lasten geen rechten nieuwe ideeën verlichting quot waarom heeft de koning alle macht quot quot zijn we niet allemaal gelijk quot quot moet het volk niet meebeslissen quot"}, {"id": "H1-4", "titel": "🏰 Het ancien régime: \"de oude orde\" in Detail", "p": 33, "html": "<h3 id=\"h-H1-4-1\">Wat was het Ancien Régime?</h3><p>Het <b>Ancien Régime</b> (Frans voor &quot;oud stelsel&quot;) was de politieke en maatschappelijke organisatie van het Franse koninkrijk zoals die bestond in de vroegmoderne tijd. Deze periode lag tussen de late middeleeuwen en de Franse Revolutie van 1789, die het begin van de moderne tijd markeert.</p><p><b>Typische kenmerken van het Ancien Régime waren:</b></p><ul><li><b>Absolute monarchie</b>: de koning had alle macht</li><li><b>Talrijke privileges</b> voor adel en clerus</li><li><b>Standenmaatschappij</b> met drie rigide groepen</li><li><b>Bevoorrechte staatskerk</b> (katholieke kerk)</li><li><b>Territoriale versnippering</b> met lokale verschillen</li></ul><h3 id=\"h-H1-4-2\">📊 De standenmaatschappij in detail</h3><p>De <b>standenmaatschappij</b> was een samenleving waarin de bevolking in verschillende grote groepen werd opgedeeld, elk met eigen rechten, plichten en maatschappelijke rol:</p><div class=\"cu-tw\"><table><tr><th><b>Stand</b></th><th><b>Samenstelling</b></th><th><b>Percentage</b></th><th><b>Privileges</b></th><th><b>Verplichtingen</b></th></tr><tr><td><b>Clerus</b></td><td>Bisschoppen, priesters, monniken, nonnen</td><td>1%</td><td>• Geen belastingen<br>• Vrijgesteld van krijgsdienst</td><td>• Bidden voor het volk<br>• Geestelijke zorg</td></tr><tr><td><b>Adel</b></td><td>Hoge adel (hertogen), lage adel (barons)</td><td>2%</td><td>• Geen belastingen<br>• Herendiensten ontvangen<br>• Jachtrechten</td><td>• Vechten voor de koning<br>• Bestuur helpen</td></tr><tr><td><b>3de stand: Rest</b></td><td>Bourgeoisie, ambachtslui, boeren, arbeiders</td><td>97%</td><td>• Geen privileges</td><td>• Alle belastingen betalen<br>• Herendiensten werken</td></tr></table></div><h3 id=\"h-H1-4-3\">De Derde Stand: Een wereld apart</h3><p>Binnen de <b>derde stand</b> bestonden grote verschillen:</p><h4 id=\"h-H1-4-4\">Bovenste laag: de bourgeoisie</h4><ul><li>Rijke handelaars, bankiers, advocaten</li><li>Geletterd en welvarend</li><li><b>Groeiende ontevredenheid</b>: hadden geld maar geen politieke macht</li></ul><h4 id=\"h-H1-4-5\">Middenlaag: Ambachtslui en kleine handelaars</h4><ul><li>Konden redelijk leven</li><li>Afhankelijk van economische schommelingen</li></ul><h4 id=\"h-H1-4-6\">Onderste laag: boeren en arbeiders</h4><ul><li>80% van de bevolking</li><li>Leefden in extreme armoede</li><li>Pachtten kleine stukjes land van landheren</li></ul><p><i>🎯 <b>Actuele link</b>: Stel je voor dat in België vandaag alleen politici en kerkleiders geen belastingen zouden betalen, terwijl gewone mensen wel alles moeten betalen. En dat je nooit politiek mee zou kunnen beslissen, ongeacht je intelligentie of opleiding. Hoe zou jij reageren?</i></p><p><img src=\"data:image/jpeg;base64,\" alt=\"\"></p><p><i>Spotprent gemaakt om kritiek te geven op de standenmaatschappij: de adel en clerus worden letterlijk (en dus figuurlijk) gedragen door de derde stand. </i></p>", "sub": [{"id": "h-H1-4-1", "t": "Wat was het Ancien Régime?", "p": 33}, {"id": "h-H1-4-2", "t": "📊 De standenmaatschappij in detail", "p": 33}, {"id": "h-H1-4-3", "t": "De Derde Stand: Een wereld apart", "p": 34}, {"id": "h-H1-4-4", "t": "Bovenste laag: de bourgeoisie", "p": 34}, {"id": "h-H1-4-5", "t": "Middenlaag: Ambachtslui en kleine handelaars", "p": 34}, {"id": "h-H1-4-6", "t": "Onderste laag: boeren en arbeiders", "p": 34}], "tekst": "wat was het ancien régime het ancien régime frans voor quot oud stelsel quot was de politieke en maatschappelijke organisatie van het franse koninkrijk zoals die bestond in de vroegmoderne tijd deze periode lag tussen de late middeleeuwen en de franse revolutie van 1789 die het begin van de moderne tijd markeert typische kenmerken van het ancien régime waren absolute monarchie de koning had alle macht talrijke privileges voor adel en clerus standenmaatschappij met drie rigide groepen bevoorrechte staatskerk katholieke kerk territoriale versnippering met lokale verschillen de standenmaatschappij in detail de standenmaatschappij was een samenleving waarin de bevolking in verschillende grote groepen werd opgedeeld elk met eigen rechten plichten en maatschappelijke rol stand samenstelling percentage privileges verplichtingen clerus bisschoppen priesters monniken nonnen 1 geen belastingen vrijgesteld van krijgsdienst bidden voor het volk geestelijke zorg adel hoge adel hertogen lage adel barons 2 geen belastingen herendiensten ontvangen jachtrechten vechten voor de koning bestuur helpen 3de stand rest bourgeoisie ambachtslui boeren arbeiders 97 geen privileges alle belastingen betalen herendiensten werken de derde stand een wereld apart binnen de derde stand bestonden grote verschillen bovenste laag de bourgeoisie rijke handelaars bankiers advocaten geletterd en welvarend groeiende ontevredenheid hadden geld maar geen politieke macht middenlaag ambachtslui en kleine handelaars konden redelijk leven afhankelijk van economische schommelingen onderste laag boeren en arbeiders 80 van de bevolking leefden in extreme armoede pachtten kleine stukjes land van landheren actuele link stel je voor dat in belgië vandaag alleen politici en kerkleiders geen belastingen zouden betalen terwijl gewone mensen wel alles moeten betalen en dat je nooit politiek mee zou kunnen beslissen ongeacht je intelligentie of opleiding hoe zou jij reageren spotprent gemaakt om kritiek te geven op de standenmaatschappij de adel en clerus worden letterlijk en dus figuurlijk gedragen door de derde stand"}, {"id": "H1-5", "titel": "💡 De Verlichting: nieuwe ideeën veranderen alles", "p": 36, "html": "<h3 id=\"h-H1-5-1\">De grote denkers en hun revolutionaire impact</h3><p>De Franse Revolutie was niet alleen een opstand van hongerige mensen - het was ook de <b>praktische toepassing</b> van nieuwe ideeën die al decennia werden ontwikkeld door verlichtingsfilosofen:</p><div class=\"cu-tw\"><table><tr><th>Denker</th><th>Jaren</th><th>Revolutionaire Idee</th><th>Concrete Impact op 1789</th></tr><tr><td><b>René Descartes</b></td><td>1596-1650</td><td>&quot;Cogito ergo sum&quot; - gebruik je verstand!</td><td>Rationeel denken wordt norm: mensen gaan de koning in vraag stellen</td></tr><tr><td><b>Voltaire</b></td><td>1694-1778</td><td>Vrijheid van denken en spreken</td><td>Einde van censuur wordt geëist; godsdienstvrijheid</td></tr><tr><td><b>Montesquieu</b></td><td>1689-1755</td><td>Scheiding der machten (trias politica)</td><td>Grondwet van 1791 met verschillende machten</td></tr><tr><td><b>Jean-Jacques Rousseau</b></td><td>1712-1778</td><td>Volkssoevereiniteit - &quot;het volk is de baas!&quot;</td><td>&quot;Wij zijn de baas, niet de koning!&quot; → democratie</td></tr><tr><td><b>John Locke</b></td><td>1632-1704</td><td>Natuurrechten op leven, vrijheid, eigendom</td><td>Mensenrechtenverklaring van 1789</td></tr></table></div><h3 id=\"h-H1-5-2\">Van theorie naar revolutionaire praktijk</h3><p><b>Het contract social van Rousseau</b> werd de bijbel van de revolutionairen:</p><ul><li>&quot;De mens wordt vrij geboren, maar overal ligt hij in ketenen&quot;</li><li>&quot;De soevereiniteit kan niet worden overgedragen, vertegenwoordigd of gedeeld&quot;</li><li>Deze ideeën legitimeerden de opstand tegen de koning</li></ul><p><b>Voltairess kritiek</b> op kerk en staat inspireerde:</p><ul><li>Secularisering van het onderwijs</li><li>Afschaffing van kerkelijke privileges</li><li>Godsdienstvrijheid in de nieuwe grondwet</li></ul>", "sub": [{"id": "h-H1-5-1", "t": "De grote denkers en hun revolutionaire impact", "p": 36}, {"id": "h-H1-5-2", "t": "Van theorie naar revolutionaire praktijk", "p": 36}], "tekst": "de grote denkers en hun revolutionaire impact de franse revolutie was niet alleen een opstand van hongerige mensen het was ook de praktische toepassing van nieuwe ideeën die al decennia werden ontwikkeld door verlichtingsfilosofen denker jaren revolutionaire idee concrete impact op 1789 rené descartes 1596 1650 quot cogito ergo sum quot gebruik je verstand rationeel denken wordt norm mensen gaan de koning in vraag stellen voltaire 1694 1778 vrijheid van denken en spreken einde van censuur wordt geëist godsdienstvrijheid montesquieu 1689 1755 scheiding der machten trias politica grondwet van 1791 met verschillende machten jean jacques rousseau 1712 1778 volkssoevereiniteit quot het volk is de baas quot quot wij zijn de baas niet de koning quot democratie john locke 1632 1704 natuurrechten op leven vrijheid eigendom mensenrechtenverklaring van 1789 van theorie naar revolutionaire praktijk het contract social van rousseau werd de bijbel van de revolutionairen quot de mens wordt vrij geboren maar overal ligt hij in ketenen quot quot de soevereiniteit kan niet worden overgedragen vertegenwoordigd of gedeeld quot deze ideeën legitimeerden de opstand tegen de koning voltairess kritiek op kerk en staat inspireerde secularisering van het onderwijs afschaffing van kerkelijke privileges godsdienstvrijheid in de nieuwe grondwet"}, {"id": "H1-6", "titel": "⚡ 1789: Het Omslagpunt naar de moderne tijd", "p": 37, "html": "<h3 id=\"h-H1-6-1\">📊 Uitgebreide Voor en Na Vergelijking</h3><p>VROEGMODERNE TIJD (tot 1789)          →          MODERNE TIJD (vanaf 1789)\n<br>\nPOLITIEK<br>\n<br>├─ Absolute monarchie                  →          Volkssoevereiniteit  \n<br>├─ &quot;L&#x27;État, c&#x27;est moi&quot; (Lodewijk XIV) →          &quot;Het volk is soeverein&quot;\n<br>├─ Goddelijk recht van koningen        →          Grondwet en rechtsstaat\n<br>├─ Geen volksvertegenwoordiging        →          Gekozen parlement\n<br>└─ Willekeurige rechtspraak           →          Onafhankelijke rechters\n<br>\nSOCIAAL  <br>\n<br>├─ Geboorte bepaalt positie           →          Verdienste telt \n<br>├─ Standenmaatschappij                →          Burgerschap\n<br>├─ Privileges voor adel/clerus        →          Gelijkheid voor de wet\n<br>├─ Horigheid en herendiensten         →          Persoonlijke vrijheid\n<br>└─ &quot;Onderdanen&quot;                       →          &quot;Burgers&quot; met rechten\n<br>\nECONOMISCH<br>\n<br>├─ Gildesysteem                       →          Vrije beroepskeuze\n<br>├─ Feodale lasten                     →          Eigendomsrechten\n<br>├─ Handelsmonopolies                  →          Vrijhandel\n<br>└─ Standsgebonden beroepen            →          Sociale mobiliteit\n<br>\nCULTUREEL<br>\n<br>├─ Censuur                            →       Vrijheid van meningsuiting\n<br>├─ Kerkelijke dominantie              →        Secularisering\n<br>├─ Latijn als geleerde taal           →        Volkstaal wordt belangrijk\n<br>└─ Traditie en autoriteit            →         Rede en wetenschap</p><h3 id=\"h-H1-6-2\">🏛️ De Geboorte van moderne concepten</h3><p><b>26 augustus 1789</b>: De <b>Verklaring van de Rechten van de Mens en de Burger</b> introduceerde concepten die vandaag nog steeds fundamenteel zijn:</p><p><b>Artikel 1</b>: <i>&quot;Alle mensen worden vrij en gelijk in rechten geboren en blijven dit&quot;</i>\n<br><b>Artikel 2</b>: <i>&quot;Het doel van elke politieke vereniging is het behoud van de natuurlijke en onvervreemdbare rechten van de mens: vrijheid, eigendom, veiligheid en weerstand tegen onderdrukking&quot;</i>\n<br><b>Artikel 6</b>: <i>&quot;De wet is de uitdrukking van de algemene wil&quot;</i>\n<br><b>Artikel 11</b>: <i>&quot;Het vrije verkeer van gedachten en meningen is een van de kostbaarste rechten van de mens&quot;</i></p><p><i>🌍 <b>Wist je dat?</b> Deze rechten staan nog steeds in onze grondwet! De Universele Verklaring van de Rechten van de Mens (VN, 1948) is direct geïnspireerd op dit document van 1789.</i></p>", "sub": [{"id": "h-H1-6-1", "t": "📊 Uitgebreide Voor en Na Vergelijking", "p": 37}, {"id": "h-H1-6-2", "t": "🏛️ De Geboorte van moderne concepten", "p": 37}], "tekst": "uitgebreide voor en na vergelijking vroegmoderne tijd tot 1789 moderne tijd vanaf 1789 politiek absolute monarchie volkssoevereiniteit quot l x27 état c x27 est moi quot lodewijk xiv quot het volk is soeverein quot goddelijk recht van koningen grondwet en rechtsstaat geen volksvertegenwoordiging gekozen parlement willekeurige rechtspraak onafhankelijke rechters sociaal geboorte bepaalt positie verdienste telt standenmaatschappij burgerschap privileges voor adel clerus gelijkheid voor de wet horigheid en herendiensten persoonlijke vrijheid quot onderdanen quot quot burgers quot met rechten economisch gildesysteem vrije beroepskeuze feodale lasten eigendomsrechten handelsmonopolies vrijhandel standsgebonden beroepen sociale mobiliteit cultureel censuur vrijheid van meningsuiting kerkelijke dominantie secularisering latijn als geleerde taal volkstaal wordt belangrijk traditie en autoriteit rede en wetenschap de geboorte van moderne concepten 26 augustus 1789 de verklaring van de rechten van de mens en de burger introduceerde concepten die vandaag nog steeds fundamenteel zijn artikel 1 quot alle mensen worden vrij en gelijk in rechten geboren en blijven dit quot artikel 2 quot het doel van elke politieke vereniging is het behoud van de natuurlijke en onvervreemdbare rechten van de mens vrijheid eigendom veiligheid en weerstand tegen onderdrukking quot artikel 6 quot de wet is de uitdrukking van de algemene wil quot artikel 11 quot het vrije verkeer van gedachten en meningen is een van de kostbaarste rechten van de mens quot wist je dat deze rechten staan nog steeds in onze grondwet de universele verklaring van de rechten van de mens vn 1948 is direct geïnspireerd op dit document van 1789"}, {"id": "H1-7", "titel": "🌪️ De moderne tijd: een woelige periode begint", "p": 38, "html": "<p><b>Waarom was de periode na 1789 zo turbulent?</b></p><p>De nieuwe ideeën verspreidden zich als <b>een lopend vuurtje</b> door Europa, maar ze botsten overal op <b>weerstand</b>. Oude machten - koningen, adel, kerk - zagen hun privileges bedreigd en sloegen terug.</p><h3 id=\"h-H1-7-1\">📊 Het domino-effect van 1789: Europa in beweging</h3><p>1789: Franse Revolutie\n  ↓ <br><b>GEVOLG</b>: Andere Europese monarchen vrezen voor hun troon\n1792-1815: Napoleontische Oorlogen<br>\n  ↓ <br><b>GEVOLG</b>: Franse ideeën verspreiden zich door heel Europa  \n1830: Revoluties in België, Polen, Italië<br>\n  ↓ <br><b>GEVOLG</b>: Nationalisme en liberalisme groeien\n1848: &quot;Het Jaar van Revoluties&quot; - heel Europa<br>\n  ↓ <br><b>GEVOLG</b>: Democratisering en nationale eenmaking\n1850-1914: Industrialisatie &amp; Democratisering<br>\n  ↓ <br><b>GEVOLG</b>: Sociale spanningen, nieuwe ideologieën\n20e eeuw: Wereldoorlogen &amp; Moderne Democratieën<br></p>", "sub": [{"id": "h-H1-7-1", "t": "📊 Het domino-effect van 1789: Europa in beweging", "p": 38}], "tekst": "waarom was de periode na 1789 zo turbulent de nieuwe ideeën verspreidden zich als een lopend vuurtje door europa maar ze botsten overal op weerstand oude machten koningen adel kerk zagen hun privileges bedreigd en sloegen terug het domino effect van 1789 europa in beweging 1789 franse revolutie gevolg andere europese monarchen vrezen voor hun troon 1792 1815 napoleontische oorlogen gevolg franse ideeën verspreiden zich door heel europa 1830 revoluties in belgië polen italië gevolg nationalisme en liberalisme groeien 1848 quot het jaar van revoluties quot heel europa gevolg democratisering en nationale eenmaking 1850 1914 industrialisatie amp democratisering gevolg sociale spanningen nieuwe ideologieën 20e eeuw wereldoorlogen amp moderne democratieën"}, {"id": "H1-8", "titel": "🏭 Niet alleen politiek: Ook technologie en economie transformeren", "p": 38, "html": "<p>De verlichting beïnvloedde <b>alle</b> levensdomeinen:</p><h3 id=\"h-H1-8-1\">Technologie &amp; wetenschap:</h3><ul><li><b>Stoommachine</b> (James Watt, 1769) - mechanisatie begint</li><li><b>Spoorwegen</b> (1830s) - sneller transport verbindt Europa</li><li><b>Wetenschappelijke methode</b> wordt standaard</li><li><b>Medische vooruitgang</b> - variabilisatie tegen pokken (Jenner, 1798)</li></ul><h3 id=\"h-H1-8-2\">Economie:</h3><ul><li><b>Kapitalisme</b> ontwikkelt zich - private eigendom wordt heilig</li><li><b>Vrije handel</b> vervangt gildesysteem</li><li><b>Industrialisatie</b> - van ambacht naar fabriek</li><li><b>Nieuwe sociale klassen</b> - industriële bourgeoisie vs proletariaat</li></ul><h3 id=\"h-H1-8-3\">Cultuur &amp; onderwijs:</h3><ul><li><b>Secularisering</b> - minder invloed van de kerk</li><li><b>Democratisering van kennis</b> - kranten, boeken voor iedereen</li><li><b>Romantiek</b> als reactie op rationalisme</li><li><b>Nationale literaturen</b> in volkstaal</li></ul>", "sub": [{"id": "h-H1-8-1", "t": "Technologie & wetenschap:", "p": 38}, {"id": "h-H1-8-2", "t": "Economie:", "p": 38}, {"id": "h-H1-8-3", "t": "Cultuur & onderwijs:", "p": 39}], "tekst": "de verlichting beïnvloedde alle levensdomeinen technologie amp wetenschap stoommachine james watt 1769 mechanisatie begint spoorwegen 1830s sneller transport verbindt europa wetenschappelijke methode wordt standaard medische vooruitgang variabilisatie tegen pokken jenner 1798 economie kapitalisme ontwikkelt zich private eigendom wordt heilig vrije handel vervangt gildesysteem industrialisatie van ambacht naar fabriek nieuwe sociale klassen industriële bourgeoisie vs proletariaat cultuur amp onderwijs secularisering minder invloed van de kerk democratisering van kennis kranten boeken voor iedereen romantiek als reactie op rationalisme nationale literaturen in volkstaal"}, {"id": "H1-9", "titel": "🎭 Van hoop naar terreur: de keerzijde van de revolutie", "p": 39, "html": "<p><b>Het Verhaal wordt donkerder...</b></p><p><b>De Franse Revolutie bracht niet alleen vrijheid, maar ook ongekend geweld:</b></p><ul><li>1793-1794: De Schrikbewind (La Terreur);</li><li>Maximilien Robespierre en het Comité voor Openbare Veiligheid nemen de macht</li><li>Wet van de verdachten: iedereen kan worden gearresteerd op verdenking</li><li>16.000 mensen geëxecuteerd met de guillotine</li><li>&quot;Vijanden van het volk&quot; worden systematisch opgejaagd</li></ul><p><b>De logica van het geweld:</b></p><ul><li>&quot;Terror is niets anders dan snelle, strenge, onbuigzame gerechtigheid&quot; - Robespierre</li><li>Revolutionairen geloofden dat geweld nodig was om de oude orde definitief te vernietigen</li><li><b>Paranoia</b>: overal werden samenzweerders vermoord.</li></ul><p><b>Het einde van de terreur:</b></p><ul><li><b>27 juli 1794</b>: Robespierre zelf wordt gearresteerd en geëxecuteerd</li><li>Het geweld had zijn eigen leiders opgegeten</li><li><i>🤔 <b>Kritisch denken</b>: Waarom denk je dat revoluties vaak gewelddadig worden? Kun je moderne voorbeelden bedenken van revoluties die vreedzaam bleven? </i></li></ul>", "sub": [], "tekst": "het verhaal wordt donkerder de franse revolutie bracht niet alleen vrijheid maar ook ongekend geweld 1793 1794 de schrikbewind la terreur maximilien robespierre en het comité voor openbare veiligheid nemen de macht wet van de verdachten iedereen kan worden gearresteerd op verdenking 16 000 mensen geëxecuteerd met de guillotine quot vijanden van het volk quot worden systematisch opgejaagd de logica van het geweld quot terror is niets anders dan snelle strenge onbuigzame gerechtigheid quot robespierre revolutionairen geloofden dat geweld nodig was om de oude orde definitief te vernietigen paranoia overal werden samenzweerders vermoord het einde van de terreur 27 juli 1794 robespierre zelf wordt gearresteerd en geëxecuteerd het geweld had zijn eigen leiders opgegeten kritisch denken waarom denk je dat revoluties vaak gewelddadig worden kun je moderne voorbeelden bedenken van revoluties die vreedzaam bleven"}, {"id": "H1-10", "titel": "🔄 Actualiteit: waarom 1789 nog steeds relevant is: wereldwijde democratische uitdagingen", "p": 39, "html": "<ul><li><b>Populisme</b>: &quot;Wij het volk tegen de elite&quot; - echo&#x27;s van 1789</li><li><b>Polarisatie</b>: Extreme standpunten, geen compromis mogelijk</li><li><b>Social media</b>: Moderne vorm van &quot;volksmenners&quot;?</li><li><b>Desinformatie</b>: Nieuwe vorm van propaganda</li></ul><h3 id=\"h-H1-10-1\">📊 Parallellen 1789 ↔ 2025</h3><div class=\"cu-tw\"><table><tr><th><b>1789</b></th><th><b>2025</b></th></tr><tr><td>Financiële crisis staatsschuld</td><td>Inflatie, koopkrachtcrisis</td></tr><tr><td>Privileges voor adel/clerus</td><td>Belastingvoordelen voor multinationals</td></tr><tr><td>Geen politieke inspraak 3e stand</td><td>Gevoel van politieke machteloosheid</td></tr><tr><td>Pamfletten verspreiden ideeën</td><td>Social media en viral content</td></tr><tr><td>&quot;Het volk&quot; vs &quot;de koning&quot;</td><td>&quot;Het volk&quot; vs &quot;de elite&quot;</td></tr></table></div>", "sub": [{"id": "h-H1-10-1", "t": "📊 Parallellen 1789 ↔ 2025", "p": 40}], "tekst": "populisme quot wij het volk tegen de elite quot echo x27 s van 1789 polarisatie extreme standpunten geen compromis mogelijk social media moderne vorm van quot volksmenners quot desinformatie nieuwe vorm van propaganda parallellen 1789 2025 1789 2025 financiële crisis staatsschuld inflatie koopkrachtcrisis privileges voor adel clerus belastingvoordelen voor multinationals geen politieke inspraak 3e stand gevoel van politieke machteloosheid pamfletten verspreiden ideeën social media en viral content quot het volk quot vs quot de koning quot quot het volk quot vs quot de elite quot"}, {"id": "H1-11", "titel": "Synthese: De Geboorte van onze moderne wereld", "p": 40, "html": "<p>De onthoofding van Lodewijk XVI was meer dan een executie - het was het <b>symbolische einde</b> van de oude wereld en het <b>begin van de moderne tijd</b>. Maar deze overgang was geen eenvoudig proces. Het was een <b>woelige periode</b> vol <b>tegenstrijdigheden</b>:</p><h3 id=\"h-H1-11-1\">🔑 Kernpunten van de Overgang:</h3><ul><li><b>1789 = Definitief Breekpunt</b>: Van onderdanen naar burgers, van privileges naar rechten</li><li><b>Verlichtingsideeën worden Praktijk</b>: Van filosofische theorie naar politieke realiteit</li><li><b>Volkssoevereiniteit</b>: Het volk wordt de bron van alle politieke macht</li><li><b>Gewelddadige Transformatie</b>: Verandering gaat gepaard met terreur en oorlog</li><li><b>Europese Verspreiding</b>: Franse ideeën veroveren heel Europa</li><li><b>Blijvende Relevantie</b>: Democratische waarden blijven kwetsbaar</li></ul>", "sub": [{"id": "h-H1-11-1", "t": "🔑 Kernpunten van de Overgang:", "p": 40}], "tekst": "de onthoofding van lodewijk xvi was meer dan een executie het was het symbolische einde van de oude wereld en het begin van de moderne tijd maar deze overgang was geen eenvoudig proces het was een woelige periode vol tegenstrijdigheden kernpunten van de overgang 1789 definitief breekpunt van onderdanen naar burgers van privileges naar rechten verlichtingsideeën worden praktijk van filosofische theorie naar politieke realiteit volkssoevereiniteit het volk wordt de bron van alle politieke macht gewelddadige transformatie verandering gaat gepaard met terreur en oorlog europese verspreiding franse ideeën veroveren heel europa blijvende relevantie democratische waarden blijven kwetsbaar"}, {"id": "H1-12", "titel": "🌍 Waarom is dit relevant voor jullie?", "p": 40, "html": "<p><b>Als toekomstige volwassen burgers</b> leven jullie in een wereld die direct voortvloeit uit 1789:</p><ul><li><b>Jullie stemrecht</b> - dankzij volkssoevereiniteit</li><li><b>Jullie vrijheid van meningsuiting</b> - dankzij de Mensenrechten van 1789</li><li><b>Jullie gelijkheid voor de wet</b> - afschaffing van standenvoorrechten</li><li><b>Jullie recht op onderwijs</b> - democratisering van kennis</li></ul><p><b>Maar ook de uitdagingen</b> van vandaag hebben hun wortels in 1789:</p><ul><li>Spanning tussen meerderheid en minderheid - tyranny of the majority</li><li>Populisme vs expertise - direct vs representatieve democratie</li><li>Nationalisme vs globalisme - wie hoort bij &quot;het volk&quot;?</li></ul><p><i>💭 <b>Slotgedachte</b>: De Franse Revolutie laat zien dat <b>gewone mensen</b> de geschiedenis kunnen veranderen. Maar het toont ook dat <b>verandering niet altijd vreedzaam</b> verloopt en dat <b>democratie geen eindpunt is</b>, maar een voortdurend proces van herdefiniëring. De vraag is: hoe kunnen wij vandaag leren van 1789 om onze democratie te versterken?</i></p>", "sub": [], "tekst": "als toekomstige volwassen burgers leven jullie in een wereld die direct voortvloeit uit 1789 jullie stemrecht dankzij volkssoevereiniteit jullie vrijheid van meningsuiting dankzij de mensenrechten van 1789 jullie gelijkheid voor de wet afschaffing van standenvoorrechten jullie recht op onderwijs democratisering van kennis maar ook de uitdagingen van vandaag hebben hun wortels in 1789 spanning tussen meerderheid en minderheid tyranny of the majority populisme vs expertise direct vs representatieve democratie nationalisme vs globalisme wie hoort bij quot het volk quot slotgedachte de franse revolutie laat zien dat gewone mensen de geschiedenis kunnen veranderen maar het toont ook dat verandering niet altijd vreedzaam verloopt en dat democratie geen eindpunt is maar een voortdurend proces van herdefiniëring de vraag is hoe kunnen wij vandaag leren van 1789 om onze democratie te versterken"}, {"id": "H1-13", "titel": "🔍 Voorbereiding volgende les: Napoleon en Europa", "p": 41, "html": "<p><b>Denk na over:</b></p><ul><li>Hoe kon Napoleon de macht grijpen na al deze democratische verworvenheden?</li><li>Waarom accepteerde Europa aanvankelijk een nieuwe &quot;keizer&quot;?</li><li>Welke revolutionaire ideeën verspreidden zich door de Napoleontische oorlogen?</li></ul><p><b>Onderzoek:</b></p><ul><li>Zoek een actueel voorbeeld van democratische backsliding (terugval)</li><li>Vergelijk met Frankrijk 1799-1804: welke parallellen zie je?</li></ul><p><br></p>", "sub": [], "tekst": "denk na over hoe kon napoleon de macht grijpen na al deze democratische verworvenheden waarom accepteerde europa aanvankelijk een nieuwe quot keizer quot welke revolutionaire ideeën verspreidden zich door de napoleontische oorlogen onderzoek zoek een actueel voorbeeld van democratische backsliding terugval vergelijk met frankrijk 1799 1804 welke parallellen zie je"}]}, {"id": "H2", "titel": "Hoofdstuk 2", "sub": "Napoleon & het Congres van Wenen – tussen macht en mythe", "secties": [{"id": "H2-1", "titel": "Inleiding Napoleon: van Corsicaan tot keizer", "p": 42, "html": "<p>Napoleon Bonaparte groeit op op Corsica, pas recent een deel van Frankrijk. Als outsider verovert hij eerst het vertrouwen van revolutionair Frankrijk via zijn militaire successen in Italië. De samenleving is in beroering door jaren revolutie, onrust en economische ontwrichting.</p><h3 id=\"h-H2-1-1\">De machtsgreep (1799-1804)</h3><p>In <b>1799</b> grijpt Napoleon dankzij een slimme staatsgreep (18 Brumaire) de macht en wordt <b>Eerste Consul</b>. Later wordt hij Consul voor het leven en uiteindelijk laat hij zichzelf kronen tot <b>Keizer in 1804</b>. Met zijn kroning in de Notre-Dame breekt Napoleon symbolisch én feitelijk met het republikeins ideaal – hij brengt orde en stabiliteit, maar vestigt tegelijk een stevig persoonlijk bewind.</p><p>Historici zoals Cobban (1940s) beschouwden Napoleon als een vroege vorm van moderne <b>dictatuur</b>, vergelijkbaar met 20e-eeuwse regimes.<u></u> Recentere academici zoals Broers (2014) nuanceren dit beeld en benadrukken dat zijn regime elementen combineerde van <b>verlicht despotisme</b> en autoritair bestuur.<u></u></p>", "sub": [{"id": "h-H2-1-1", "t": "De machtsgreep (1799-1804)", "p": 42}], "tekst": "napoleon bonaparte groeit op op corsica pas recent een deel van frankrijk als outsider verovert hij eerst het vertrouwen van revolutionair frankrijk via zijn militaire successen in italië de samenleving is in beroering door jaren revolutie onrust en economische ontwrichting de machtsgreep 1799 1804 in 1799 grijpt napoleon dankzij een slimme staatsgreep 18 brumaire de macht en wordt eerste consul later wordt hij consul voor het leven en uiteindelijk laat hij zichzelf kronen tot keizer in 1804 met zijn kroning in de notre dame breekt napoleon symbolisch én feitelijk met het republikeins ideaal hij brengt orde en stabiliteit maar vestigt tegelijk een stevig persoonlijk bewind historici zoals cobban 1940s beschouwden napoleon als een vroege vorm van moderne dictatuur vergelijkbaar met 20e eeuwse regimes recentere academici zoals broers 2014 nuanceren dit beeld en benadrukken dat zijn regime elementen combineerde van verlicht despotisme en autoritair bestuur"}, {"id": "H2-2", "titel": "Positieve hervormingen vs. Autoritair bestuur", "p": 43, "html": "<h3 id=\"h-H2-2-1\">✅ Wat als positief ervaren wordt aan Napoleons bestuur:</h3><ul><li>Rust, bloeiende economie, tewerkstelling</li><li><b>Concordaat</b> (akkoord met de Kerk) - religieuze vrede</li><li>Vrede met het buitenland (aanvankelijk)</li><li>Adel mag terugkeren uit ballingschap</li><li>Groot <b>imperialisme</b>: <b>satellietstaten</b> en veroveringen</li></ul><h3 id=\"h-H2-2-2\">❌ Wat als negatief ervaren wordt aan Napoleons bestuur:</h3><ul><li>Onderdrukking van binnenlandse vijanden (koningsgezinden én <b>revolutionair</b>en)</li><li><b>Censuur</b> op pers en publicaties</li><li>Geheime politie en spionagenetwerk</li><li>Kritiek verboden, geen vrije meningsuiting</li></ul><p><b>💡 Denkvraag:</b> Waarom kon Napoleon, ondanks zoveel verzet buiten Frankrijk, toch zo populair blijven bij grote delen van zijn eigen land?</p>", "sub": [{"id": "h-H2-2-1", "t": "✅ Wat als positief ervaren wordt aan Napoleons bestuur:", "p": 43}, {"id": "h-H2-2-2", "t": "❌ Wat als negatief ervaren wordt aan Napoleons bestuur:", "p": 43}], "tekst": "wat als positief ervaren wordt aan napoleons bestuur rust bloeiende economie tewerkstelling concordaat akkoord met de kerk religieuze vrede vrede met het buitenland aanvankelijk adel mag terugkeren uit ballingschap groot imperialisme satellietstaten en veroveringen wat als negatief ervaren wordt aan napoleons bestuur onderdrukking van binnenlandse vijanden koningsgezinden én revolutionair en censuur op pers en publicaties geheime politie en spionagenetwerk kritiek verboden geen vrije meningsuiting denkvraag waarom kon napoleon ondanks zoveel verzet buiten frankrijk toch zo populair blijven bij grote delen van zijn eigen land"}, {"id": "H2-3", "titel": "HERVORMER OF DICTATOR? – De Code Civil & Napoleons erfenis", "p": 43, "html": "<p>Napoleons hervormingen zijn duurzaam: zijn burgerlijk wetboek (Code Civil, 1804) introduceert juridische <b>gelijkheid</b> (voor mannen!), bescherming van eigendom, uniforme procedures, burgerlijke stand en kadaster. Alle burgers worden geregistreerd; bureaucratie en rechtszekerheid krijgen de bovenhand.</p><p>De <b>Code Civil</b> wordt door historicus Gordley (1994) echter genuanceerd benaderd: veel &quot;revolutionaire&quot; principes waren al eerder geformuleerd door Franse juristen en gebaseerd op Romeins recht.<u></u> De werkelijke innovatie lag in de systematische codificatie en uniforme toepassing, niet zozeer in de inhoud zelf.</p><h3 id=\"h-H2-3-1\">🏛️ Napoleons blijvende erfenis (nog steeds zichtbaar!)</h3><ul><li><b>Bestuurlijke indeling:</b> Provincies, kantons, gemeenten (ipv heerlijkheden en vorstendommen)</li><li><b>Kadaster:</b> Dienst waar alle onroerende eigendommen worden bijgehouden</li><li><b>Rechtssysteem:</b> Rechtbanken, strafrecht en <b>Code Civil</b> voor het hele keizerrijk</li><li><b>Burgerlijke stand:</b> Familienamen registreren, geboorte/overlijden bijhouden</li><li><b>Nationale bank:</b> Eenheidsmunt voor economische stabiliteit</li><li><b>Metriek stelsel:</b> Meter, liter, kilogram (internationale standaard!)</li><li><b>Verkeer:</b> Rechts rijden op de weg</li><li><b>Cultuur:</b> Zelfs snoep! De Antwerpse &quot;Napoleon&quot; (1912) dankt zijn naam aan de keizer</li></ul><h3 id=\"h-H2-3-2\">Schema: belangrijkste vernieuwingen en dwingende beperkingen</h3><div class=\"cu-tw\"><table><tr><th><b>🚦 Verlichting</b></th><th><b>⛔ Autoritair</b></th></tr><tr><td>Gelijkheid voor de wet</td><td>Censuur op pers/critici</td></tr><tr><td>Eigendomsbescherming</td><td>Patriarchaal familierecht</td></tr><tr><td>Uniform burgerlijk recht</td><td>Strakke politie, geheime dienst</td></tr><tr><td>Vrijheid van beroep</td><td>Herstel slavernij in kolonies</td></tr><tr><td>Burgerlijke stand, kadaster</td><td>Vrouwen blijven ondergeschikt</td></tr><tr><td>Technologie &amp; wetenschap bevorderen</td><td>Politieke oppositie verboden</td></tr></table></div><p>Deze mix verklaart de dubbele erfenis van Napoleon: hij breekt met feodalisme en privilege, maar vestigt tegelijk een <b>dictatuur</b> onder schijn van <b>constitutionele monarchie</b>. Historicus Carbonnier omschrijft de Code Civil als de &quot;burgerlijke grondwet van Frankrijk&quot; - een document dat zowel revolutionaire idealen als conservatieve waarden bevat.<u></u></p>", "sub": [{"id": "h-H2-3-1", "t": "🏛️ Napoleons blijvende erfenis (nog steeds zichtbaar!)", "p": 43}, {"id": "h-H2-3-2", "t": "Schema: belangrijkste vernieuwingen en dwingende beperkingen", "p": 44}], "tekst": "napoleons hervormingen zijn duurzaam zijn burgerlijk wetboek code civil 1804 introduceert juridische gelijkheid voor mannen bescherming van eigendom uniforme procedures burgerlijke stand en kadaster alle burgers worden geregistreerd bureaucratie en rechtszekerheid krijgen de bovenhand de code civil wordt door historicus gordley 1994 echter genuanceerd benaderd veel quot revolutionaire quot principes waren al eerder geformuleerd door franse juristen en gebaseerd op romeins recht de werkelijke innovatie lag in de systematische codificatie en uniforme toepassing niet zozeer in de inhoud zelf napoleons blijvende erfenis nog steeds zichtbaar bestuurlijke indeling provincies kantons gemeenten ipv heerlijkheden en vorstendommen kadaster dienst waar alle onroerende eigendommen worden bijgehouden rechtssysteem rechtbanken strafrecht en code civil voor het hele keizerrijk burgerlijke stand familienamen registreren geboorte overlijden bijhouden nationale bank eenheidsmunt voor economische stabiliteit metriek stelsel meter liter kilogram internationale standaard verkeer rechts rijden op de weg cultuur zelfs snoep de antwerpse quot napoleon quot 1912 dankt zijn naam aan de keizer schema belangrijkste vernieuwingen en dwingende beperkingen verlichting autoritair gelijkheid voor de wet censuur op pers critici eigendomsbescherming patriarchaal familierecht uniform burgerlijk recht strakke politie geheime dienst vrijheid van beroep herstel slavernij in kolonies burgerlijke stand kadaster vrouwen blijven ondergeschikt technologie amp wetenschap bevorderen politieke oppositie verboden deze mix verklaart de dubbele erfenis van napoleon hij breekt met feodalisme en privilege maar vestigt tegelijk een dictatuur onder schijn van constitutionele monarchie historicus carbonnier omschrijft de code civil als de quot burgerlijke grondwet van frankrijk quot een document dat zowel revolutionaire idealen als conservatieve waarden bevat"}, {"id": "H2-4", "titel": "VAN GLORIE NAAR VAL – Het Franse Keizerrijk (1803-1815)", "p": 44, "html": "<h3 id=\"h-H2-4-1\">Het hoogtepunt (1803-1812)</h3><p>Vanaf <b>1803</b> verovert Napoleon grote delen van Europa en sticht <b>satellietstaten</b>. Het Franse Keizerrijk bereikt zijn grootste omvang in <b>1812</b> - van Spanje tot Polen, van Nederland tot Italië. Dit <b>imperialisme</b> verspreidt verlichtingsidealen, maar is zelden vrijwillig.</p><p>Broers (2009) benadrukt dat Napoleons Europa-project meer was dan militaire conquête: het bracht moderne administratie, rechtssystemen en economische structuren naar achtergebleven gebieden.<u></u> Tegelijk dwong het lokale elites tot samenwerking met het Franse systeem.</p><p><img src=\"data:image/jpeg;base64,\" alt=\"\"></p><h3 id=\"h-H2-4-2\">De keerpunten - waarom valt Napoleon?</h3><h3 id=\"h-H2-4-3\">🔥 Militaire nederlagen:</h3><ul><li><b>Slag bij Trafalgar (1805):</b> Nelson vernietigt de Franse vloot</li><li><b>Mislukte Russische veldtocht (1812):</b> Catastrofale nederlaag in de winter</li><li><b>Continentale Blokkade mislukt:</b> Handelsboycot tegen Engeland werkt niet</li></ul><h3 id=\"h-H2-4-4\">Groeiende vijandschap</h3><p>Pruisen, Groot-Brittannië en Oostenrijk vormen coalities tegen Napoleon. Zijn populariteit neemt af door de constante oorlogen.</p><h3 id=\"h-H2-4-5\">Van Elba tot Waterloo (1814-1815)</h3><ul><li>1814: Coalitie valt Frankrijk aan, Napoleon wordt verbannen naar Elba</li><li>1815: Napoleon ontsnapt spectaculair, herovert Frankrijk in &quot;100 dagen&quot;</li><li>18 juni 1815: Definitieve nederlaag bij Waterloo tegen Pruisen, GB, Oostenrijk en Nederland</li><li>Ballingschap Sint-Helena: Hier schrijft hij zijn memoires vol propaganda over zijn eigen erfenis</li></ul>", "sub": [{"id": "h-H2-4-1", "t": "Het hoogtepunt (1803-1812)", "p": 44}, {"id": "h-H2-4-2", "t": "De keerpunten - waarom valt Napoleon?", "p": 45}, {"id": "h-H2-4-3", "t": "🔥 Militaire nederlagen:", "p": 45}, {"id": "h-H2-4-4", "t": "Groeiende vijandschap", "p": 45}, {"id": "h-H2-4-5", "t": "Van Elba tot Waterloo (1814-1815)", "p": 45}], "tekst": "het hoogtepunt 1803 1812 vanaf 1803 verovert napoleon grote delen van europa en sticht satellietstaten het franse keizerrijk bereikt zijn grootste omvang in 1812 van spanje tot polen van nederland tot italië dit imperialisme verspreidt verlichtingsidealen maar is zelden vrijwillig broers 2009 benadrukt dat napoleons europa project meer was dan militaire conquête het bracht moderne administratie rechtssystemen en economische structuren naar achtergebleven gebieden tegelijk dwong het lokale elites tot samenwerking met het franse systeem de keerpunten waarom valt napoleon militaire nederlagen slag bij trafalgar 1805 nelson vernietigt de franse vloot mislukte russische veldtocht 1812 catastrofale nederlaag in de winter continentale blokkade mislukt handelsboycot tegen engeland werkt niet groeiende vijandschap pruisen groot brittannië en oostenrijk vormen coalities tegen napoleon zijn populariteit neemt af door de constante oorlogen van elba tot waterloo 1814 1815 1814 coalitie valt frankrijk aan napoleon wordt verbannen naar elba 1815 napoleon ontsnapt spectaculair herovert frankrijk in quot 100 dagen quot 18 juni 1815 definitieve nederlaag bij waterloo tegen pruisen gb oostenrijk en nederland ballingschap sint helena hier schrijft hij zijn memoires vol propaganda over zijn eigen erfenis"}, {"id": "H2-5", "titel": "HET CONGRES VAN WENEN (1814-1815) - Europa hertekent de kaart", "p": 46, "html": "<p><img src=\"data:image/jpeg;base64,\" alt=\"\"></p><h3 id=\"h-H2-5-1\">De hoofdrolspelers &amp; hun doelen</h3><p>Na Napoleons val komen de Europese leiders samen in Wenen. <b>Metternich</b> (minister van Buitenlandse Zaken van Oostenrijk) drukt zijn stempel op de beslissingen.</p><p>Volgens Jarrett (2013) was het Congres niet enkel reactionnaire restauratie, maar een poging tot pragmatische internationale samenwerking om vrede en stabiliteit te garanderen.<u></u> Zamoyski (2014) benadrukt daarentegen het repressieve karakter en de angst voor revolutionaire bewegingen.<u></u></p><h4 id=\"h-H2-5-2\">🎯 Vijf hoofddoelen van het Congres:</h4><ul><li><b>Restauratie</b> van <b>het Ancien Régime</b> - oude monarchies terugbrengen</li><li>Rust en orde - geen nieuwe <b>politieke revoluties</b></li><li><b>Franse expansie</b> voorkomen - <b>Frankrijk</b> moet <b>ingekapseld</b> worden</li><li><b>Machtsevenwicht</b> herstellen in Europa</li><li>Frankrijk straffen voor de <b>revolutionaire</b> <b>chaos</b></li></ul><p><b>💃 &quot;Le congrès danse...&quot;</b>\n<br>Overdag politieke onderhandelingen, &#x27;s avonds feesten en bals - diplomatiek entertainment!</p><p><img src=\"data:image/jpeg;base64,\" alt=\"\"></p><p><i>Karikatuur van dansende staatshoofden op het Congres van Wenen</i></p><h3 id=\"h-H2-5-3\">De vier middelen van het Congres</h3><p><b>1️⃣ Legitimiteitsprincipe</b></p><p>Vorsten krijgen hun macht terug - een macht die niet beperkt mag worden en zo groot mogelijk moet zijn. Terug naar <b>absolutisme</b>! Dit principe werd geformuleerd door Talleyrand en omhelsde de idee dat alleen &quot;rechtmatige&quot; heersers - afstammelingen van pre-revolutionaire dynastieën - legitiem konden regeren.<u></u></p><p><b>2️⃣ Grote Alliantie</b></p><p>Militaire alliantie (solidariteit) tussen grootmachten die <b>revolutionair</b>e opstanden de kop moet indrukken.</p><p>3️⃣ <b>Bufferstaten</b></p><p>Sterke, neutrale landen <b>rond</b> Frankrijk:</p><ul><li>Verenigd Koninkrijk der Nederlanden (VKN) - nieuw land! (Nederland + België)</li><li>Piemont-Sardinië in Italië</li></ul><p><b>4️⃣ Territoriale wijzigingen</b></p><ul><li>Frankrijk moet veroveringen teruggeven</li><li>Verdwenen landen worden heropgericht</li><li>Imperialistische uitbreiding voor Oostenrijk, Pruisen en Rusland</li></ul><h3 id=\"h-H2-5-4\">EUROPA NA WENEN - Slaagt de restauratie?</h3><h4 id=\"h-H2-5-5\">Het nieuwe Europa (1815)</h4><p>Het Congres hertekent de Europese kaart drastisch:</p><ul><li><b>Polen</b> verdwijnt opnieuw (verdeeld tussen Rusland, Pruisen, Oostenrijk)</li><li><b>Duitse Bond</b> vervangt het Heilige Roomse Rijk</li><li><b>VKN</b> ontstaat (Nederland + België samen)</li><li><b>Zwitserland</b> krijgt neutrale status</li><li>Italië blijft versnipperd</li></ul><p>Vick (2014) benadrukt dat het Congres niet enkel een reactionaire onderneming was, maar ook ruimte bood voor liberale en nationale ideeën, zij het binnen strikte grenzen.<u></u> De spanning tussen restauratie en modernisering zou de 19e eeuw blijven kenmerken.</p><p><img src=\"data:image/jpeg;base64,\" alt=\"\"></p><h4 id=\"h-H2-5-6\">De contradictie: restauratie vs. moderne tijd</h4><p>Het Congres probeert de klok terug te draaien, maar de ideeën van <b>vrijheid</b>, <b>gelijkheid</b> en <b>nationalisme</b> laten zich niet meer uitwissen. Overal in Europa groeien nieuwe <b>politieke revolutie</b>s en <b>natie</b>-bewustzijn.</p><p><b>Paradox:</b> Terwijl diplomaten <b>absolutisme</b> willen herstellen, verspreiden Napoleons hervormingen zich verder door <b>technologie</b>, <b>wetenschap</b> en nieuwe <b>staatsvorm</b>.</p>", "sub": [{"id": "h-H2-5-1", "t": "De hoofdrolspelers & hun doelen", "p": 46}, {"id": "h-H2-5-2", "t": "🎯 Vijf hoofddoelen van het Congres:", "p": 46}, {"id": "h-H2-5-3", "t": "De vier middelen van het Congres", "p": 47}, {"id": "h-H2-5-4", "t": "EUROPA NA WENEN - Slaagt de restauratie?", "p": 48}, {"id": "h-H2-5-5", "t": "Het nieuwe Europa (1815)", "p": 48}, {"id": "h-H2-5-6", "t": "De contradictie: restauratie vs. moderne tijd", "p": 48}], "tekst": "de hoofdrolspelers amp hun doelen na napoleons val komen de europese leiders samen in wenen metternich minister van buitenlandse zaken van oostenrijk drukt zijn stempel op de beslissingen volgens jarrett 2013 was het congres niet enkel reactionnaire restauratie maar een poging tot pragmatische internationale samenwerking om vrede en stabiliteit te garanderen zamoyski 2014 benadrukt daarentegen het repressieve karakter en de angst voor revolutionaire bewegingen vijf hoofddoelen van het congres restauratie van het ancien régime oude monarchies terugbrengen rust en orde geen nieuwe politieke revoluties franse expansie voorkomen frankrijk moet ingekapseld worden machtsevenwicht herstellen in europa frankrijk straffen voor de revolutionaire chaos quot le congrès danse quot overdag politieke onderhandelingen x27 s avonds feesten en bals diplomatiek entertainment karikatuur van dansende staatshoofden op het congres van wenen de vier middelen van het congres 1 legitimiteitsprincipe vorsten krijgen hun macht terug een macht die niet beperkt mag worden en zo groot mogelijk moet zijn terug naar absolutisme dit principe werd geformuleerd door talleyrand en omhelsde de idee dat alleen quot rechtmatige quot heersers afstammelingen van pre revolutionaire dynastieën legitiem konden regeren 2 grote alliantie militaire alliantie solidariteit tussen grootmachten die revolutionair e opstanden de kop moet indrukken 3 bufferstaten sterke neutrale landen rond frankrijk verenigd koninkrijk der nederlanden vkn nieuw land nederland belgië piemont sardinië in italië 4 territoriale wijzigingen frankrijk moet veroveringen teruggeven verdwenen landen worden heropgericht imperialistische uitbreiding voor oostenrijk pruisen en rusland europa na wenen slaagt de restauratie het nieuwe europa 1815 het congres hertekent de europese kaart drastisch polen verdwijnt opnieuw verdeeld tussen rusland pruisen oostenrijk duitse bond vervangt het heilige roomse rijk vkn ontstaat nederland belgië samen zwitserland krijgt neutrale status italië blijft versnipperd vick 2014 benadrukt dat het congres niet enkel een reactionaire onderneming was maar ook ruimte bood voor liberale en nationale ideeën zij het binnen strikte grenzen de spanning tussen restauratie en modernisering zou de 19e eeuw blijven kenmerken de contradictie restauratie vs moderne tijd het congres probeert de klok terug te draaien maar de ideeën van vrijheid gelijkheid en nationalisme laten zich niet meer uitwissen overal in europa groeien nieuwe politieke revolutie s en natie bewustzijn paradox terwijl diplomaten absolutisme willen herstellen verspreiden napoleons hervormingen zich verder door technologie wetenschap en nieuwe staatsvorm"}, {"id": "H2-6", "titel": "Argumentatieschema: Napoleon verlichter of dictator?", "p": 49, "html": "<div class=\"cu-tw\"><table><tr><th><b>🟢 VERLICHTER</b></th><th><b>🔴 DICTATOR</b></th><th><b>📊 Bewijs</b></th></tr><tr><td>Code Civil: gelijkheid</td><td>Censuur &amp; geheime politie</td><td>Wetteksten vs praktijk</td></tr><tr><td>Technologie bevorderen</td><td>Herstel slavernij</td><td>Academies vs kolonies</td></tr><tr><td>Vrijheid van beroep</td><td>Vrouwen ondergeschikt</td><td>Economie vs familierecht</td></tr><tr><td>Religieuze tolerantie</td><td>Politieke onderdrukking</td><td>Concordaat vs oppositie</td></tr></table></div>", "sub": [], "tekst": "verlichter dictator bewijs code civil gelijkheid censuur amp geheime politie wetteksten vs praktijk technologie bevorderen herstel slavernij academies vs kolonies vrijheid van beroep vrouwen ondergeschikt economie vs familierecht religieuze tolerantie politieke onderdrukking concordaat vs oppositie"}, {"id": "H2-7", "titel": "Evaluatieschema: Slaagde het Congres van Wenen?", "p": 49, "html": "<div class=\"cu-tw\"><table><tr><th><b>🟢 SUCCES (korte termijn)</b></th><th><b>🔴 MISLUKKING (lange termijn)</b></th><th><b>🗺️ Bewijs</b></th></tr><tr><td>Frankrijk ingekapseld</td><td>Nationalisme groeit</td><td>VKN valt uiteen 1830</td></tr><tr><td>Bufferstaten werken</td><td>Liberalisme verspreidt</td><td>Revoluties 1830/1848</td></tr><tr><td>40 jaar relatieve vrede</td><td>Moderne ideeën onuitwisbaar</td><td>Industrialisatie verandert alles</td></tr></table></div>", "sub": [], "tekst": "succes korte termijn mislukking lange termijn bewijs frankrijk ingekapseld nationalisme groeit vkn valt uiteen 1830 bufferstaten werken liberalisme verspreidt revoluties 1830 1848 40 jaar relatieve vrede moderne ideeën onuitwisbaar industrialisatie verandert alles"}, {"id": "H2-8", "titel": "EINDCONCLUSIE", "p": 49, "html": "<p><b>Napoleon combineert verlichtingsidealen met dictoriaal bestuur</b> - hij verspreidt <b>gelijkheid</b>, <b>technologie</b> en moderne staatsstructuren, maar via <b>censuur</b> en oorlog. De <b>Code Civil</b> brengt juridische vooruitgang, maar politieke <b>vrijheid</b> ontbreekt. <b>Het Congres van Wenen probeert de klok terug te draaien</b>, maar <b>nationalisme</b>, <b>liberalisme</b> en moderne staatsvormen laten zich niet stoppen. Europa evolueert onvermijdelijk naar <b>constitutionele monarchie</b>ën ondanks pogingen tot <b>absolutisme</b>.<b>De werkelijke erfenis:</b> Napoleon als modernisator én onderdrukker, het Congres als reactionaire poging die de toekomst niet kon tegenhouden.</p>", "sub": [], "tekst": "napoleon combineert verlichtingsidealen met dictoriaal bestuur hij verspreidt gelijkheid technologie en moderne staatsstructuren maar via censuur en oorlog de code civil brengt juridische vooruitgang maar politieke vrijheid ontbreekt het congres van wenen probeert de klok terug te draaien maar nationalisme liberalisme en moderne staatsvormen laten zich niet stoppen europa evolueert onvermijdelijk naar constitutionele monarchie ën ondanks pogingen tot absolutisme de werkelijke erfenis napoleon als modernisator én onderdrukker het congres als reactionaire poging die de toekomst niet kon tegenhouden"}, {"id": "H2-9", "titel": "Evaluatie en synthese", "p": 52, "html": "<p><b>Zelftest:</b></p><ul><li>[ ] Ik kan het verschil uitleggen tussen <b>verlichting</b> en <b>dictatuur</b></li><li>[ ] Ik begrijp waarom <b>nationalisme</b> het <b>absolutisme</b> bedreigt</li><li>[ ] Ik kan <b>Napoleons erfenis</b> herkennen in de moderne wereld</li><li>[ ] Ik kan uitleggen waarom het <b>Congres van Wenen</b> faalde op lange termijn</li><li>[ ] Ik begrijp hoe <b>collectieve herinnering</b> geschiedenis beïnvloedt</li></ul>", "sub": [], "tekst": "zelftest ik kan het verschil uitleggen tussen verlichting en dictatuur ik begrijp waarom nationalisme het absolutisme bedreigt ik kan napoleons erfenis herkennen in de moderne wereld ik kan uitleggen waarom het congres van wenen faalde op lange termijn ik begrijp hoe collectieve herinnering geschiedenis beïnvloedt"}]}, {"id": "H3", "titel": "Hoofdstuk 3", "sub": "Liberalisme en nationalisme", "secties": [{"id": "H3-1", "titel": "🎯 Onderzoeksvraag", "p": 53, "html": "<p><i><b>Hoe ondermijnden liberalisme en nationalisme het Congres van Wenen? Welke invloed hebben deze 19e-eeuwse ideologieën nog steeds op onze huidige politiek?</b></i></p><p><b>📖 Inleiding: Europa in opstand (1848)</b></p><p>Het is 1848, en over heel Europa breken <b>politieke revoluties</b> uit. Van Parijs tot Wenen, van Berlijn tot Milaan gaan mensen de straat op voor <b>vrijheid</b>, <b>gelijkheid</b> en <b>nationale zelfbeschikking</b>.</p><p>De <b>restauratie</b> van het Congres van Wenen staat onder druk. Twee nieuwe <b>ideologieën</b> ondermijnen de oude orde:</p><ul><li><b>Liberalisme</b>: vrijheid voor het individu</li><li><b>Nationalisme</b>: het volk als basis van de staat</li></ul><p>Deze ideeën wortelen in de <b>verlichting</b> en Franse Revolutie, maar zijn tegelijk een reactie op de <b>autoritaire</b> <b>restauratie</b>. Ze zullen niet alleen de 19e eeuw bepalen, maar blijven vandaag relevant in onze democratische samenlevingen.</p><p><img src=\"data:image/jpeg;base64,\" alt=\"\"><i>💡 <b>Metternich&#x27;s cartoon</b>: De Oostenrijkse <b>kanselier</b> probeert het deksel op de pot van liberalisme en nationalisme te houden, maar de stoom laat zich niet meer onderdrukken...</i></p>", "sub": [], "tekst": "hoe ondermijnden liberalisme en nationalisme het congres van wenen welke invloed hebben deze 19e eeuwse ideologieën nog steeds op onze huidige politiek inleiding europa in opstand 1848 het is 1848 en over heel europa breken politieke revoluties uit van parijs tot wenen van berlijn tot milaan gaan mensen de straat op voor vrijheid gelijkheid en nationale zelfbeschikking de restauratie van het congres van wenen staat onder druk twee nieuwe ideologieën ondermijnen de oude orde liberalisme vrijheid voor het individu nationalisme het volk als basis van de staat deze ideeën wortelen in de verlichting en franse revolutie maar zijn tegelijk een reactie op de autoritaire restauratie ze zullen niet alleen de 19e eeuw bepalen maar blijven vandaag relevant in onze democratische samenlevingen metternich x27 s cartoon de oostenrijkse kanselier probeert het deksel op de pot van liberalisme en nationalisme te houden maar de stoom laat zich niet meer onderdrukken"}, {"id": "H3-2", "titel": "Van Franse Revolutie naar nieuwe ideologieën", "p": 54, "html": "<h3 id=\"h-H3-2-1\">📊 Drie cruciale momenten</h3><p>1789: FRANSE REVOLUTIE\n<br>├─ Verlichtingsideeën worden praktijk\n<br>├─ Volkssoevereiniteit vs absolute monarchie  \n<br>├─ Burgerrechten en grondwet\n<br>└─ Nieuwe concepten van vrijheid en gelijkheid\n<br>\n1799-1815: NAPOLEON<br>\n<br>├─ Verspreiding Franse ideeën door Europa\n<br>├─ Code Civil en moderne staatsstructuur\n<br>├─ Maar: nieuwe vorm van dictatuur\n<br>└─ Reactie: nationale bewegingen tegen Frankrijk\n<br>\n1815: CONGRES VAN WENEN  <br>\n<br>├─ Restauratie van legitimiteitsbeginsel\n<br>├─ Onderdrukking van revolutionaire ideeën\n<br>├─ Kunstmatige grenzen zonder volkswil\n<br>└─ GEVOLG: Groei van liberalisme en nationalisme</p><h3 id=\"h-H3-2-2\">Het falen van de restauratie: waarom terugkeer onmogelijk was</h3><p><b>Nieuwe sociale realiteiten:</b></p><ul><li><b>Burgerij</b> had economische macht verworven</li><li><b>Industrialisering</b> creëerde nieuwe behoeften</li><li>Verspreiding van ideeën door drukpers en transport</li><li><b>Nationale identiteit</b> was ontwaakt bij verschillende volkeren</li></ul><p><b>Technologische veranderingen:</b></p><ul><li>Snellere communicatie</li><li>Betere wegen en later spoorwegen</li><li><b>Propaganda</b> bereikte bredere lagen</li><li><b>Elite</b> kon informatie niet langer monopoliseren</li></ul>", "sub": [{"id": "h-H3-2-1", "t": "📊 Drie cruciale momenten", "p": 54}, {"id": "h-H3-2-2", "t": "Het falen van de restauratie: waarom terugkeer onmogelijk was", "p": 54}], "tekst": "drie cruciale momenten 1789 franse revolutie verlichtingsideeën worden praktijk volkssoevereiniteit vs absolute monarchie burgerrechten en grondwet nieuwe concepten van vrijheid en gelijkheid 1799 1815 napoleon verspreiding franse ideeën door europa code civil en moderne staatsstructuur maar nieuwe vorm van dictatuur reactie nationale bewegingen tegen frankrijk 1815 congres van wenen restauratie van legitimiteitsbeginsel onderdrukking van revolutionaire ideeën kunstmatige grenzen zonder volkswil gevolg groei van liberalisme en nationalisme het falen van de restauratie waarom terugkeer onmogelijk was nieuwe sociale realiteiten burgerij had economische macht verworven industrialisering creëerde nieuwe behoeften verspreiding van ideeën door drukpers en transport nationale identiteit was ontwaakt bij verschillende volkeren technologische veranderingen snellere communicatie betere wegen en later spoorwegen propaganda bereikte bredere lagen elite kon informatie niet langer monopoliseren"}, {"id": "H3-3", "titel": "LIBERALISME – Vrijheid voor het individu", "p": 55, "html": "<h3 id=\"h-H3-3-1\">De kern van de liberale ideologie</h3><p><b>Liberalisme</b> stelt het individu centraal in staat en maatschappij. Het gelooft dat individuele <b>vrijheid</b> niet alleen persoonlijk goed is, maar ook de beste weg naar welvaart en vooruitgang voor iedereen.</p><p><b>Kernprincipes:</b></p><ul><li><b>Negatieve vrijheid</b>: afwezigheid van dwang</li><li><b>Natuurrechten</b>: leven, vrijheid, eigendom</li><li><b>Beperkte overheidsmacht</b>: bescherming, geen controle</li><li><b>Individuele autonomie</b>: eigen keuzes maken</li></ul><h3 id=\"h-H3-3-2\">📚 Politiek liberalisme: John Locke&#x27;s erfenis</h3><p><b>John Locke (1632-1704)</b> legde de fundamenten van modern democratisch denken. Locke&#x27;s revolutionaire ideeën waren:</p><ul><li><b>Natuurrechten</b> gaan vooraf aan elke regering</li><li><b>Sociaal contract</b>: regering dient het volk, niet omgekeerd</li><li>Wanneer regering rechten schendt → volk heeft recht op verzet</li><li>Basis voor Amerikaanse Onafhankelijkheidsverklaring (1776) en Franse Revolutie (1789)\n<br>\n<br>\n<br>\n<br>\n<br>\n<br>\n<br></li></ul><p>Concrete liberale eisen in de 19e eeuw:</p><div class=\"cu-tw\"><table><tr><th><b>Politiek gebied</b></th><th><b>Liberale eis</b></th><th><b>Doel</b></th></tr><tr><td><b>Grondwet</b></td><td>Geschreven constitutie</td><td>Grenzen van regeringsmacht vastleggen</td></tr><tr><td><b>Machten</b></td><td>Scheiding der machten</td><td>Voorkomen van absolutisme</td></tr><tr><td><b>Rechten</b></td><td>Burgerrechten gegarandeerd</td><td>Vrijheid van meningsuiting, pers, godsdienst</td></tr><tr><td><b>Wetgeving</b></td><td>Gelijkheid voor de wet</td><td>Einde van standenvoorrechten</td></tr><tr><td><b>Politiek</b></td><td>Volksvertegenwoordiging</td><td>Parlement met echte macht</td></tr></table></div><h3 id=\"h-H3-3-3\">💰 Economisch liberalisme: Adam Smith&#x27;s vrije markt</h3><p><b>Adam Smith (1723-1790)</b> ontwikkelde de theorie van de moderne markteconomie. <b>Smith’s hoofdprincipes waren:</b></p><ul><li><b>&quot;Onzichtbare hand&quot;</b>: eigenbelang leidt tot algemeen welzijn</li><li><b>Laissez-faire</b>: overheid bemoeit zich niet met economie</li><li><b>Vrije concurrentie</b>: beste producten overleven</li><li><b>Afschaffing</b> van gilden, monopolies en handelsbeperkingen</li></ul><p>Voorbeeld: Een bakker bakt brood niet uit goedheid, maar voor winst. Toch zorgt zijn eigenbelang ervoor dat anderen brood hebben.</p><p><b>De nachtwakersstaat (&quot;l&#x27;état gendarme&quot;):</b></p><ul><li><b>Minimale overheidstaken:</b></li><li>Veiligheid (leger, politie)</li><li>Eigendomsrechten beschermen</li><li>Publieke werken (wegen)</li><li><b>Geen overheidsbemoeiing</b> met prijzen, lonen, arbeidsomstandigheden.</li></ul><h3 id=\"h-H3-3-4\">⚖️ Het kiesrecht: van cijnskiesrecht naar democratie</h3><ul><li><b>19e-eeuwse liberalen waren niet automatisch democratisch!</b></li></ul><p><b>Cijnskiesrecht (beperkt stemrecht):</b></p><ul><li>Alleen eigendomsbezitters mogen stemmen</li><li>Logica: wie belasting betaalt, heeft belang bij goed bestuur</li><li><b>Gevolg</b>: kleine <b>elite</b> bepaalt politiek</li></ul><p><b>Evolutie in België:</b></p><ul><li><b>1830</b>: Cijnskiesrecht - 1% van bevolking stemt</li><li><b>1893</b>: Algemeen meervoudig stemrecht - iedereen minstens 1 stem</li><li><b>1919</b>: Algemeen enkelvoudig stemrecht voor mannen</li><li><b>1948</b>: Vrouwenstemrecht</li><li><img src=\"data:image/jpeg;base64,\" alt=\"\"></li></ul><h3 id=\"h-H3-3-5\">⚠️ De sociale contradictie van het liberalisme</h3><p><b>De liberale paradox:</b> Spreken over vrijheid en gelijkheid, maar creëren nieuwe ongelijkheid.</p><p><b>Gevolgen voor arbeiders:</b></p><ul><li>Afschaffing recht op samenkomst → geen sociale bescherming</li><li>Verbod op vakbonden → individuele arbeider machteloos</li><li>Geen sociale wetgeving → lange werkdagen, kinderarbeid</li><li>&quot;Contractuele vrijheid&quot; → hongerige arbeider niet echt vrij</li></ul><p><b>Voorbeeld wet-Le Chapelier (1791):</b></p><ul><li>✅ Vrije toegang tot beroepen</li><li>❌ Verbod op vakbonden en ziekenfondsen</li><li><b>Resultaat</b>: Individuele vrijheid, maar sociale onzekerheid</li></ul>", "sub": [{"id": "h-H3-3-1", "t": "De kern van de liberale ideologie", "p": 55}, {"id": "h-H3-3-2", "t": "📚 Politiek liberalisme: John Locke's erfenis", "p": 55}, {"id": "h-H3-3-3", "t": "💰 Economisch liberalisme: Adam Smith's vrije markt", "p": 56}, {"id": "h-H3-3-4", "t": "⚖️ Het kiesrecht: van cijnskiesrecht naar democratie", "p": 56}, {"id": "h-H3-3-5", "t": "⚠️ De sociale contradictie van het liberalisme", "p": 57}], "tekst": "de kern van de liberale ideologie liberalisme stelt het individu centraal in staat en maatschappij het gelooft dat individuele vrijheid niet alleen persoonlijk goed is maar ook de beste weg naar welvaart en vooruitgang voor iedereen kernprincipes negatieve vrijheid afwezigheid van dwang natuurrechten leven vrijheid eigendom beperkte overheidsmacht bescherming geen controle individuele autonomie eigen keuzes maken politiek liberalisme john locke x27 s erfenis john locke 1632 1704 legde de fundamenten van modern democratisch denken locke x27 s revolutionaire ideeën waren natuurrechten gaan vooraf aan elke regering sociaal contract regering dient het volk niet omgekeerd wanneer regering rechten schendt volk heeft recht op verzet basis voor amerikaanse onafhankelijkheidsverklaring 1776 en franse revolutie 1789 concrete liberale eisen in de 19e eeuw politiek gebied liberale eis doel grondwet geschreven constitutie grenzen van regeringsmacht vastleggen machten scheiding der machten voorkomen van absolutisme rechten burgerrechten gegarandeerd vrijheid van meningsuiting pers godsdienst wetgeving gelijkheid voor de wet einde van standenvoorrechten politiek volksvertegenwoordiging parlement met echte macht economisch liberalisme adam smith x27 s vrije markt adam smith 1723 1790 ontwikkelde de theorie van de moderne markteconomie smith s hoofdprincipes waren quot onzichtbare hand quot eigenbelang leidt tot algemeen welzijn laissez faire overheid bemoeit zich niet met economie vrije concurrentie beste producten overleven afschaffing van gilden monopolies en handelsbeperkingen voorbeeld een bakker bakt brood niet uit goedheid maar voor winst toch zorgt zijn eigenbelang ervoor dat anderen brood hebben de nachtwakersstaat quot l x27 état gendarme quot minimale overheidstaken veiligheid leger politie eigendomsrechten beschermen publieke werken wegen geen overheidsbemoeiing met prijzen lonen arbeidsomstandigheden het kiesrecht van cijnskiesrecht naar democratie 19e eeuwse liberalen waren niet automatisch democratisch cijnskiesrecht beperkt stemrecht alleen eigendomsbezitters mogen stemmen logica wie belasting betaalt heeft belang bij goed bestuur gevolg kleine elite bepaalt politiek evolutie in belgië 1830 cijnskiesrecht 1 van bevolking stemt 1893 algemeen meervoudig stemrecht iedereen minstens 1 stem 1919 algemeen enkelvoudig stemrecht voor mannen 1948 vrouwenstemrecht de sociale contradictie van het liberalisme de liberale paradox spreken over vrijheid en gelijkheid maar creëren nieuwe ongelijkheid gevolgen voor arbeiders afschaffing recht op samenkomst geen sociale bescherming verbod op vakbonden individuele arbeider machteloos geen sociale wetgeving lange werkdagen kinderarbeid quot contractuele vrijheid quot hongerige arbeider niet echt vrij voorbeeld wet le chapelier 1791 vrije toegang tot beroepen verbod op vakbonden en ziekenfondsen resultaat individuele vrijheid maar sociale onzekerheid"}, {"id": "H3-4", "titel": "NATIONALISME – Het volk als fundament van de staat", "p": 58, "html": "<p><b>De revolutionaire idee van de natie</b></p><p>Nationalisme wordt in deze periode een bepalend maatschappelijk fenomeen dat de Europese geschiedenis blijvend markeert. De wortels ervan liggen deels in de ideeën van de <b>Franse Revolutie</b> en de verspreiding van de ‘<b>natiestaatgedachte’</b> door Napoleon zelf, die talrijke Europese grenzen hertekende en oude rijken opdeelde of samenvoegde. Door de ervaring van bezetting, oorlog en herverdeling van grondgebieden ontwaakt bij vele volkeren—van Duitsland tot Italië, van België tot Polen—<b>een diepere hunkering naar politieke en culturele zelfbeschikking</b>. Nationale identiteit en collectieve herinnering worden doelbewust versterkt via symbolen, heldenverhalen, culturele gebruiken en een gemeenschappelijke voertaal. Tegelijkertijd <b>worstelen</b> veel regio’s met de gevolgen van dat nationalisme: ze botsen met <b>de oude staatsstructuren</b>, botsen met elkaar of met supranationale machten, en gebruiken kunst, educatie en media als instrumenten om het <b>‘wij-gevoel’ te voeden</b>.</p><p><b>Revolutionaire gevolgen:</b></p><ul><li>Koning regeert niet door God, maar door wil van het volk</li><li>Elke <b>natie</b> heeft recht op <b>zelfbeschikking</b></li><li>&quot;Ingebeelde gemeenschap&quot;: mensen voelen verbondenheid zonder elkaar te kennen</li><li>Nieuwe vorm van solidariteit en identiteit</li><li><img src=\"data:image/jpeg;base64,\" alt=\"\"><i>De Slag der Gulden Sporen (1836) van Nicaise de Keyser (Stedelijke musea Kortrijk). De mythevorming rond het middeleeuwse graafschap Vlaanderen vormde aanvankelijk een belangrijk onderdeel van het Belgisch nationaal-historisch bewustzijn. Tegen 1900 was ze echter uitgegroeid tot hét historische fundament van de Vlaamse ‘verbeelde gemeenschap</i></li></ul><h3 id=\"h-H3-4-1\">🏛️ Wat maakt een volk tot een natie?</h3><p><b>Gemeenschappelijke kenmerken (voorbeeld: Vlamingen):</b></p><div class=\"cu-tw\"><table><tr><th><b>Kenmerk</b></th><th>Vlaamse toepassing</th><th>Probleem</th></tr><tr><td><b>Taal</b></td><td>Belgisch-Nederlands</td><td>Amerikanen/Britten: zelfde taal, verschillende naties</td></tr><tr><td><b>Grondgebied</b></td><td>Vlaamse Gemeenschap</td><td>Palestijnen/Israëli&#x27;s claimen zelfde gebied</td></tr><tr><td><b>Geschiedenis</b></td><td>Guldensporenslag, Vlaamse steden</td><td>Geschiedenis kan verschillend geïnterpreteerd worden</td></tr><tr><td><b>Afkomst</b></td><td>Franken sinds 3e eeuw</td><td>Biologische afstamming vaak fictief</td></tr><tr><td><b>Godsdienst</b></td><td>Katholicisme</td><td>Secularisering vermindert rol religie</td></tr><tr><td><b>Cultuur</b></td><td>Flandriens, frietcultuur</td><td>Culturen veranderen voortdurend</td></tr></table></div><p><img src=\"data:image/jpeg;base64,\" alt=\"\"></p><p>⚠️ <b>Belangrijk</b>: <b>Nationale identiteit</b> is grotendeels <b>constructie</b> - bewust gecreëerd door intellectuelen en politici!</p><h3 id=\"h-H3-4-2\">📍 Natie en staat: drie mogelijke verhoudingen</h3><p><b>VERHOUDING 1: STAAT MET MEERDERE NATIES</b>\n<br>┌─────────────────────────┐\n<br>│    STAAT BELGIË          │\n<br>│  ┌─────────┬─────────┐  │\n<br>│  │ NATIE   │ NATIE   │  │\n<br>│  │ VLAAMS  │ WAALS   │  │\n<br>│  └─────────┴─────────┘  │\n<br>└─────────────────────────┘\n<br><b>VERHOUDING 2: VERDEELDE NATIE</b>  \n<br>┌──────────┐  ┌──────────┐\n<br>│ STAAT A  │  │ STAAT B  │\n<br>│ ┌──────┐ │  │ ┌──────┐ │\n<br>│ │NATIE │ │  │ │NATIE │ │\n<br>│ │(deel)│ │  │ │(deel)│ │\n<br>│ └──────┘ │  │ └──────┘ │\n<br>└──────────┘  └──────────┘\n<br><b>Voorbeeld: Koerden verspreid over 4 staten</b></p><p><b>VERHOUDING 3: NATIESTAAT </b>\n<br>┌─────────────────────────┐\n<br>│                         │\n<br>│    STAAT = NATIE        │\n<br>│                         │\n<br>└─────────────────────────┘</p><h3 id=\"h-H3-4-3\">🌱 De oorsprong van het moderne nationalisme</h3><p><b>Drie katalysatoren:</b></p><h4 id=\"h-H3-4-4\">Franse Revolutie (1789)</h4><ul><li>Van &quot;onderdanen van de koning&quot; naar &quot;Franse burgers&quot;</li><li><b>Levée en masse</b> (1793): nationale volksarmee</li><li>Symbolen: Marseillaise, tricolor, nationale feestdagen</li><li><b>Voertaal</b> gestandaardiseerd, nationale identiteit verspreid</li></ul><h4 id=\"h-H3-4-5\">Napoleontische overheersing (1799-1815)</h4><ul><li><b>Paradox</b>: Napoleon verspreidt Franse ideeën, maar creëert weerstand</li><li>Duitse intellectuelen ontwikkelen theorie van &quot;volksgeest&quot;</li><li>Spaanse guerrilla&#x27;s, Russische patriotten verzetten zich</li><li>Lokale volkeren ontdekken eigen <b>nationale identiteit</b></li></ul><h4 id=\"h-H3-4-6\">Congres van Wenen (1815)</h4><ul><li><b>Legitimiteitsprincipe</b> negeert <b>volkssoevereiniteit</b></li><li><b>Volkeren</b> behandeld als <b>bezittingen</b> <b>van dinastieën</b></li><li><b>België + Nederland</b> <b>geforceerd</b> samengevoegd als <b>bufferstaat</b></li><li><b>Gevolg</b>: Nationalistische bewegingen worden <b>radicaler</b></li></ul><h3 id=\"h-H3-4-7\">🔀 Verschillende soorten nationalisme</h3><h4 id=\"h-H3-4-8\">Staatsnationalisme vs volksnationalisme:</h4><div class=\"cu-tw\"><table><tr><th><b>Staatsnationalisme</b></th><th><b>Volksnationalisme</b></th></tr><tr><td><b>Criterium</b>: Burgerschap van de staat</td><td><b>Criterium</b>: Etnische/culturelle kenmerken</td></tr><tr><td><b>Inclusief</b>: Iedereen kan lid worden</td><td><b>Exclusief</b>: Geboorte bepaalt lidmaatschap</td></tr><tr><td><b>Voorbeeld</b>: Franse model - assimilatie</td><td><b>Voorbeeld</b>: Duitse model - biologische afstamming</td></tr><tr><td><b>Hedendaags</b>: Spanje vs Catalanen</td><td><b>Hedendaags</b>: Vlaams Belang standpunt</td></tr></table></div><h4 id=\"h-H3-4-9\">Middelpuntzoekend vs Middelpuntvliedend:</h4><div class=\"cu-tw\"><table><tr><th><b>Middelpuntzoekend</b></th><th><b>Middelpuntvliedend</b></th></tr><tr><td><b>Doel</b>: Verdeelde natie verenigen</td><td><b>Doel</b>: Natie bevrijden uit multinationale staat</td></tr><tr><td><b>Strategie</b>: Centralisatie, unitaire staat</td><td><b>Strategie</b>: Decentralisatie, federalisme, afscheuring</td></tr><tr><td><b>19e eeuw:</b> Duitse en Italiaanse eenmaking</td><td><b>19e eeuw:</b> Belgische onafhankelijkheid (1830)</td></tr><tr><td><b>Vandaag</b>: Koerdische onafhankelijkheidsstrijd</td><td>Vandaag: Catalaans, Schots nationalisme</td></tr></table></div><p><br></p><h3 id=\"h-H3-4-10\">🎨 Intellectuelen en romantiek: het uitvinden van tradities</h3><p><b>Nationalisme ontstaat niet spontaan - het wordt geconstrueerd!</b></p><p><b>Romantiek als ideologische basis:</b></p><ul><li><b>Verlichting</b>: Universele rede en vooruitgang</li><li><b>Romantiek</b>: Emotie, traditie, volkswijsheid</li><li>Elke <b>natie</b> heeft unieke &quot;volksgeest&quot;</li></ul><p><b>Instrumenten van nationale identiteit:**</b></p><ul><li><b>Schrijvers</b>: Hendrik Conscience &quot;De Leeuw van Vlaanderen&quot; (1838)</li><li><b>Historici</b>: Herschrijven verleden voor nationale continuïteit</li><li><b>Taalkundigen</b>: Standaardiseren dialecten tot nationale talen</li><li><b>Kunstenaars</b>: Nationale symboliek en mythologie</li></ul><h3 id=\"h-H3-4-11\">⚠️ Wij-zij-denken: het gevaarlijke mechanisme</h3><p><b>Escalatieproces van nationalisme:</b></p><p><b>FASE 1: POSITIEVE IDENTITEIT</b>\n<br>├─ Trots op eigen cultuur en geschiedenis\n<br>├─ Gemeenschapsgevoel en solidariteit\n<br>└─ Nog geen bedreiging voor anderen\n<br>\n<br><b>FASE 2: VERGELIJKING</b>\n<br>├─ &quot;Wij zijn anders dan zij&quot;\n<br>├─ Competitie en wedijver ontstaat\n<br>└─ Neutrale verschillen worden benadrukt\n<br>\n<br><b>FASE 3: SUPERIORITEIT</b>  \n<br>├─ &quot;Wij zijn beter dan zij&quot;\n<br>├─ Discriminatie tegen minderheden\n<br>└─ Tweederangsburgerschap voor &quot;anderen&quot;\n<br>\n<br><b>FASE 4: UITSLUITING EN GEWELD</b>\n<br>├─ Anderen als existentiële bedreiging\n<br>├─ Etnische zuiveringen, genocide\n<br>└─ Agressieve oorlogen tegen &quot;vijandelijke&quot; naties</p><p><br></p><h3 id=\"h-H3-4-12\">🌍 Hedendaagse voorbeelden van nationalisme</h3><p><b>America First (Trump):</b></p><ul><li>Economisch nationalisme vs globalisme</li><li>&quot;Echte Amerikanen&quot; vs internationale <b>elite</b></li><li>Handelspolitiek en immigratie als nationale prioriteiten</li></ul><p><b>Brexit (Verenigd Koninkrijk):</b></p><ul><li>Nationale soevereiniteit vs Europese integratie</li><li>&quot;Take back control&quot; - democratie bedreigd door Brussel</li><li>Spanning tussen internationale samenwerking en nationale autonomie</li></ul><p><b>Catalaans nationalisme (Spanje):</b></p><ul><li>Middelpuntvliedend: eigen staat voor Catalanen</li><li>Culturele onderdrukking (taalverbod Franco)</li><li>Economische uitbuiting (transfers naar Madrid)</li><li>Referendum 2017 → constitutionele crisis</li></ul><p><b>Gaza-conflict als voorbeeld van wij-zij-denken:</b></p><ul><li>Beide kanten claimen exclusieve rechten op zelfde grondgebied</li><li>Historische narratieven die eigen positie legitimeren</li><li><b>Polarisatie</b>: geen tussenposities mogelijk</li><li>Cyclus van geweld en wraak</li></ul>", "sub": [{"id": "h-H3-4-1", "t": "🏛️ Wat maakt een volk tot een natie?", "p": 59}, {"id": "h-H3-4-2", "t": "📍 Natie en staat: drie mogelijke verhoudingen", "p": 59}, {"id": "h-H3-4-3", "t": "🌱 De oorsprong van het moderne nationalisme", "p": 60}, {"id": "h-H3-4-4", "t": "Franse Revolutie (1789)", "p": 60}, {"id": "h-H3-4-5", "t": "Napoleontische overheersing (1799-1815)", "p": 60}, {"id": "h-H3-4-6", "t": "Congres van Wenen (1815)", "p": 60}, {"id": "h-H3-4-7", "t": "🔀 Verschillende soorten nationalisme", "p": 60}, {"id": "h-H3-4-8", "t": "Staatsnationalisme vs volksnationalisme:", "p": 60}, {"id": "h-H3-4-9", "t": "Middelpuntzoekend vs Middelpuntvliedend:", "p": 61}, {"id": "h-H3-4-10", "t": "🎨 Intellectuelen en romantiek: het uitvinden van tradities", "p": 62}, {"id": "h-H3-4-11", "t": "⚠️ Wij-zij-denken: het gevaarlijke mechanisme", "p": 62}, {"id": "h-H3-4-12", "t": "🌍 Hedendaagse voorbeelden van nationalisme", "p": 63}], "tekst": "de revolutionaire idee van de natie nationalisme wordt in deze periode een bepalend maatschappelijk fenomeen dat de europese geschiedenis blijvend markeert de wortels ervan liggen deels in de ideeën van de franse revolutie en de verspreiding van de natiestaatgedachte door napoleon zelf die talrijke europese grenzen hertekende en oude rijken opdeelde of samenvoegde door de ervaring van bezetting oorlog en herverdeling van grondgebieden ontwaakt bij vele volkeren van duitsland tot italië van belgië tot polen een diepere hunkering naar politieke en culturele zelfbeschikking nationale identiteit en collectieve herinnering worden doelbewust versterkt via symbolen heldenverhalen culturele gebruiken en een gemeenschappelijke voertaal tegelijkertijd worstelen veel regio s met de gevolgen van dat nationalisme ze botsen met de oude staatsstructuren botsen met elkaar of met supranationale machten en gebruiken kunst educatie en media als instrumenten om het wij gevoel te voeden revolutionaire gevolgen koning regeert niet door god maar door wil van het volk elke natie heeft recht op zelfbeschikking quot ingebeelde gemeenschap quot mensen voelen verbondenheid zonder elkaar te kennen nieuwe vorm van solidariteit en identiteit de slag der gulden sporen 1836 van nicaise de keyser stedelijke musea kortrijk de mythevorming rond het middeleeuwse graafschap vlaanderen vormde aanvankelijk een belangrijk onderdeel van het belgisch nationaal historisch bewustzijn tegen 1900 was ze echter uitgegroeid tot hét historische fundament van de vlaamse verbeelde gemeenschap wat maakt een volk tot een natie gemeenschappelijke kenmerken voorbeeld vlamingen kenmerk vlaamse toepassing probleem taal belgisch nederlands amerikanen britten zelfde taal verschillende naties grondgebied vlaamse gemeenschap palestijnen israëli x27 s claimen zelfde gebied geschiedenis guldensporenslag vlaamse steden geschiedenis kan verschillend geïnterpreteerd worden afkomst franken sinds 3e eeuw biologische afstamming vaak fictief godsdienst katholicisme secularisering vermindert rol religie cultuur flandriens frietcultuur culturen veranderen voortdurend belangrijk nationale identiteit is grotendeels constructie bewust gecreëerd door intellectuelen en politici natie en staat drie mogelijke verhoudingen verhouding 1 staat met meerdere naties staat belgië natie natie vlaams waals verhouding 2 verdeelde natie staat a staat b natie natie deel deel voorbeeld koerden verspreid over 4 staten verhouding 3 natiestaat staat natie de oorsprong van het moderne nationalisme drie katalysatoren franse revolutie 1789 van quot onderdanen van de koning quot naar quot franse burgers quot levée en masse 1793 nationale volksarmee symbolen marseillaise tricolor nationale feestdagen voertaal gestandaardiseerd nationale identiteit verspreid napoleontische overheersing 1799 1815 paradox napoleon verspreidt franse ideeën maar creëert weerstand duitse intellectuelen ontwikkelen theorie van quot volksgeest quot spaanse guerrilla x27 s russische patriotten verzetten zich lokale volkeren ontdekken eigen nationale identiteit congres van wenen 1815 legitimiteitsprincipe negeert volkssoevereiniteit volkeren behandeld als bezittingen van dinastieën belgië nederland geforceerd samengevoegd als bufferstaat gevolg nationalistische bewegingen worden radicaler verschillende soorten nationalisme staatsnationalisme vs volksnationalisme staatsnationalisme volksnationalisme criterium burgerschap van de staat criterium etnische culturelle kenmerken inclusief iedereen kan lid worden exclusief geboorte bepaalt lidmaatschap voorbeeld franse model assimilatie voorbeeld duitse model biologische afstamming hedendaags spanje vs catalanen hedendaags vlaams belang standpunt middelpuntzoekend vs middelpuntvliedend middelpuntzoekend middelpuntvliedend doel verdeelde natie verenigen doel natie bevrijden uit multinationale staat strategie centralisatie unitaire staat strategie decentralisatie federalisme afscheuring 19e eeuw duitse en italiaanse eenmaking 19e eeuw belgische onafhankelijkheid 1830 vandaag koerdische onafhankelijkheidsstrijd vandaag catalaans schots nationalisme intellectuelen en romantiek het uitvinden van tradities nationalisme ontstaat niet spontaan het wordt geconstrueerd romantiek als ideologische basis verlichting universele rede en vooruitgang romantiek emotie traditie volkswijsheid elke natie heeft unieke quot volksgeest quot instrumenten van nationale identiteit schrijvers hendrik conscience quot de leeuw van vlaanderen quot 1838 historici herschrijven verleden voor nationale continuïteit taalkundigen standaardiseren dialecten tot nationale talen kunstenaars nationale symboliek en mythologie wij zij denken het gevaarlijke mechanisme escalatieproces van nationalisme fase 1 positieve identiteit trots op eigen cultuur en geschiedenis gemeenschapsgevoel en solidariteit nog geen bedreiging voor anderen fase 2 vergelijking quot wij zijn anders dan zij quot competitie en wedijver ontstaat neutrale verschillen worden benadrukt fase 3 superioriteit quot wij zijn beter dan zij quot discriminatie tegen minderheden tweederangsburgerschap voor quot anderen quot fase 4 uitsluiting en geweld anderen als existentiële bedreiging etnische zuiveringen genocide agressieve oorlogen tegen quot vijandelijke quot naties hedendaagse voorbeelden van nationalisme america first trump economisch nationalisme vs globalisme quot echte amerikanen quot vs internationale elite handelspolitiek en immigratie als nationale prioriteiten brexit verenigd koninkrijk nationale soevereiniteit vs europese integratie quot take back control quot democratie bedreigd door brussel spanning tussen internationale samenwerking en nationale autonomie catalaans nationalisme spanje middelpuntvliedend eigen staat voor catalanen culturele onderdrukking taalverbod franco economische uitbuiting transfers naar madrid referendum 2017 constitutionele crisis gaza conflict als voorbeeld van wij zij denken beide kanten claimen exclusieve rechten op zelfde grondgebied historische narratieven die eigen positie legitimeren polarisatie geen tussenposities mogelijk cyclus van geweld en wraak"}, {"id": "H3-5", "titel": "VERGELIJKING: Liberalisme versus Nationalisme", "p": 63, "html": "<h3 id=\"h-H3-5-1\">🤝 Gemeenschappelijke wortels</h3><p><b>Beiden ‘kinderen’ van verlichting en Franse Revolutie:</b></p><ul><li>Anti-<b>absolutistisch</b>: macht komt van het volk</li><li><b>Volkssoevereiniteit</b>: toestemming van geregeerden</li><li>Moderniserend: tegen privileges en standenmaatschappij</li><li>Voor rationele, efficiënte <b>staatsstructuur</b></li></ul><p><b>Samenwerking in 19e eeuw:</b></p><ul><li><b>Belgische Revolutie (1830)</b>: liberale rechten + nationale onafhankelijkheid</li><li><b>Duitse/Italiaanse eenmaking</b>: nationale eenheid + <b>constitutionele monarchie</b></li><li><b>&quot;Liberal nationalisme&quot;</b>: synthese van beide ideologieën</li></ul><h3 id=\"h-H3-5-2\">⚔️ Fundamentele spanningen</h3><div class=\"cu-tw\"><table><tr><th><b>Liberalisme</b></th><th><b>Nationalisme</b></th></tr><tr><td><b>Focus</b>: Individuele rechten</td><td><b>Focus</b>: Collectieve identiteit</td></tr><tr><td><b>Universeel</b>: Rechten voor alle mensen. (hoewel, niet altijd zo geweest -&gt; cijnskiesrecht</td><td><b>Particulier</b>: Rechten voor leden van natie</td></tr><tr><td><b>Inclusief</b>: Iedereen kan burger worden</td><td>Kan exclusief zijn: Etnische/culturele criteria</td></tr><tr><td><b>Prioriteit</b>: Persoonlijke vrijheid</td><td><b>Prioriteit</b>: Nationale eenheid</td></tr><tr><td><b>Internationaal</b>: Vrije handel, open grenzen</td><td><b>Kan protectionistisch zijn:</b> Nationale economie</td></tr></table></div>", "sub": [{"id": "h-H3-5-1", "t": "🤝 Gemeenschappelijke wortels", "p": 63}, {"id": "h-H3-5-2", "t": "⚔️ Fundamentele spanningen", "p": 64}], "tekst": "gemeenschappelijke wortels beiden kinderen van verlichting en franse revolutie anti absolutistisch macht komt van het volk volkssoevereiniteit toestemming van geregeerden moderniserend tegen privileges en standenmaatschappij voor rationele efficiënte staatsstructuur samenwerking in 19e eeuw belgische revolutie 1830 liberale rechten nationale onafhankelijkheid duitse italiaanse eenmaking nationale eenheid constitutionele monarchie quot liberal nationalisme quot synthese van beide ideologieën fundamentele spanningen liberalisme nationalisme focus individuele rechten focus collectieve identiteit universeel rechten voor alle mensen hoewel niet altijd zo geweest gt cijnskiesrecht particulier rechten voor leden van natie inclusief iedereen kan burger worden kan exclusief zijn etnische culturele criteria prioriteit persoonlijke vrijheid prioriteit nationale eenheid internationaal vrije handel open grenzen kan protectionistisch zijn nationale economie"}, {"id": "H3-6", "titel": "ACTUALISERING: Belgische politiek vandaag", "p": 64, "html": "<h3 id=\"h-H3-6-1\">🇧🇪 Liberalisme in België vandaag</h3><p><b>Open VLD</b> (Vlaanderen) en <b>MR</b> (Wallonië) zijn erfgenamen van 19e-eeuws liberalisme.</p><p><b>Moderne liberale standpunten:</b></p><ul><li><b>Politiek</b>: Europese integratie, rechtsstaat, democratische instellingen</li><li><b>Ethisch</b>: Euthanasie, homohuwelijk → individuele autonomie</li><li><b>Economisch</b>: Vrije markt + sociale vangnetten</li><li><b>Evolutie</b>: Van <b>nachtwakersstaat</b> naar &quot;slimme regulering&quot;</li><li><img src=\"data:image/png;base64,\" alt=\"\"><img src=\"data:image/png;base64,\" alt=\"\"></li></ul><h3 id=\"h-H3-6-2\">🔵 Vlaamse nationalistische partijen: N-VA vs Vlaams Belang</h3><p><b>N-VA (Nieuw-Vlaamse Alliantie):</b></p><ul><li><b>Type</b>: Middelpuntvliedend staatsnationalisme</li><li><b>Doel</b>: Vlaamse autonomie binnen confederatie</li><li><b>Criterium</b>: Cultureel-linguïstisch (wie Nederlands spreekt = Vlaming)</li><li><b>Economisch</b>: Liberaal (fiscale autonomie, minder transfers)</li><li><b>Internationaal</b>: Pro-Europees, pro-globalisme</li></ul><p><b>Vlaams Belang:</b></p><ul><li><b>Type</b>: <b>Volksnationalisme</b> met etnische criteria</li><li><b>Doel</b>: Vlaamse onafhankelijkheid</li><li><b>Criterium</b>: Afkomst en cultuur (immigranten blijven vreemd)</li><li><b>Economisch</b>: Protectionistisch (jobs voor eigen volk eerst)</li><li><b>Internationaal</b>: Eurosceptisch, anti-globalisme</li><li><img src=\"data:image/jpeg;base64,\" alt=\"\"><img src=\"data:image/png;base64,\" alt=\"\"></li></ul>", "sub": [{"id": "h-H3-6-1", "t": "🇧🇪 Liberalisme in België vandaag", "p": 64}, {"id": "h-H3-6-2", "t": "🔵 Vlaamse nationalistische partijen: N-VA vs Vlaams Belang", "p": 65}], "tekst": "liberalisme in belgië vandaag open vld vlaanderen en mr wallonië zijn erfgenamen van 19e eeuws liberalisme moderne liberale standpunten politiek europese integratie rechtsstaat democratische instellingen ethisch euthanasie homohuwelijk individuele autonomie economisch vrije markt sociale vangnetten evolutie van nachtwakersstaat naar quot slimme regulering quot vlaamse nationalistische partijen n va vs vlaams belang n va nieuw vlaamse alliantie type middelpuntvliedend staatsnationalisme doel vlaamse autonomie binnen confederatie criterium cultureel linguïstisch wie nederlands spreekt vlaming economisch liberaal fiscale autonomie minder transfers internationaal pro europees pro globalisme vlaams belang type volksnationalisme met etnische criteria doel vlaamse onafhankelijkheid criterium afkomst en cultuur immigranten blijven vreemd economisch protectionistisch jobs voor eigen volk eerst internationaal eurosceptisch anti globalisme"}, {"id": "H3-7", "titel": "Synthese: liberalisme en nationalisme", "p": 65, "html": "<p>Het Congres van Wenen (1815) probeerde Europa terug te brengen naar de <b>oude orde</b>: koningen die regeerden “door God”, kunstmatige grenzen zonder rekening te houden met volkeren, en onderdrukking van alle revolutionaire ideeën uit de Franse tijd. Maar de sociale en technologische veranderingen maakten terugkeer onmogelijk. De burgerij had economische macht verworven, industrialisering creëerde nieuwe behoeften, en drukpers en transport verspreidden ideeën sneller dan ooit.</p><p><b>Twee krachtige ideologieën ondermijnden systematisch deze restauratie:</b></p><ul><li><b>Liberalisme</b> stelde het <b>individu</b> centraal met natuurrechten, beperkte overheidsmacht en burgerlijke vrijheden. John Locke&#x27;s sociaal contract keerde de machtsverhoudingen om: regering dient volk, niet andersom. Adam Smith&#x27;s economische liberalisme eiste een nachtwakersstaat die enkel veiligheid en eigendom beschermde. Toch bleef een paradox: liberalen spraken over gelijkheid maar hielden het cijnskiesrecht, waardoor slechts 1% van de Belgen mocht stemmen in 1830.</li><li><b>Nationalisme</b> maakte het <b>volk</b> tot basis van de staat. Napoleon&#x27;s paradox hielp hieraan: hij verspreidde Franse ideeën, maar creëerde tegelijk nationale weerstand ertegen. Volkeren zoals Duitsers, Italianen en Belgen ontdekten hun eigen identiteit via symbolen, taal en heldenverhalen. De Guldensporenslag werd van lokaal conflict tot fundament van Vlaamse identiteit getransformeerd.</li></ul><p><b>Waarom het Congres faalde</b></p><p>De restauratie kon niet werken omdat beide ideologieën de <b>legitimiteitsbasis</b> van het oude systeem aanvielen. Liberalen beweerden dat macht van het volk kwam, niet van God. Nationalisten eisten dat grenzen volkeren respecteerden, niet dynastieke belangen. De revoluties van 1830 (België) en 1848 (hele Europa) toonden aan dat Metternich&#x27;s &quot;deksel op de pot&quot; niet meer werkte.</p><p><b>Blijvende spanning vandaag</b></p><p>In de Belgische politiek zien we deze 19e-eeuwse spanningen nog steeds: <b>Open VLD</b> (liberaal: individuele rechten, Europese integratie) versus <b>N-VA/Vlaams Belang</b> (nationalistisch: collectieve identiteit, Vlaamse autonomie). Internationale debatten over Brexit, Trump&#x27;s &quot;America First&quot; en het Catalaanse referendum tonen dezelfde fundamentele vragen: Wie hoort bij &quot;het volk&quot;? Wat is belangrijker - individuele vrijheid of nationale eenheid?</p>", "sub": [], "tekst": "het congres van wenen 1815 probeerde europa terug te brengen naar de oude orde koningen die regeerden door god kunstmatige grenzen zonder rekening te houden met volkeren en onderdrukking van alle revolutionaire ideeën uit de franse tijd maar de sociale en technologische veranderingen maakten terugkeer onmogelijk de burgerij had economische macht verworven industrialisering creëerde nieuwe behoeften en drukpers en transport verspreidden ideeën sneller dan ooit twee krachtige ideologieën ondermijnden systematisch deze restauratie liberalisme stelde het individu centraal met natuurrechten beperkte overheidsmacht en burgerlijke vrijheden john locke x27 s sociaal contract keerde de machtsverhoudingen om regering dient volk niet andersom adam smith x27 s economische liberalisme eiste een nachtwakersstaat die enkel veiligheid en eigendom beschermde toch bleef een paradox liberalen spraken over gelijkheid maar hielden het cijnskiesrecht waardoor slechts 1 van de belgen mocht stemmen in 1830 nationalisme maakte het volk tot basis van de staat napoleon x27 s paradox hielp hieraan hij verspreidde franse ideeën maar creëerde tegelijk nationale weerstand ertegen volkeren zoals duitsers italianen en belgen ontdekten hun eigen identiteit via symbolen taal en heldenverhalen de guldensporenslag werd van lokaal conflict tot fundament van vlaamse identiteit getransformeerd waarom het congres faalde de restauratie kon niet werken omdat beide ideologieën de legitimiteitsbasis van het oude systeem aanvielen liberalen beweerden dat macht van het volk kwam niet van god nationalisten eisten dat grenzen volkeren respecteerden niet dynastieke belangen de revoluties van 1830 belgië en 1848 hele europa toonden aan dat metternich x27 s quot deksel op de pot quot niet meer werkte blijvende spanning vandaag in de belgische politiek zien we deze 19e eeuwse spanningen nog steeds open vld liberaal individuele rechten europese integratie versus n va vlaams belang nationalistisch collectieve identiteit vlaamse autonomie internationale debatten over brexit trump x27 s quot america first quot en het catalaanse referendum tonen dezelfde fundamentele vragen wie hoort bij quot het volk quot wat is belangrijker individuele vrijheid of nationale eenheid"}, {"id": "H3-8", "titel": "Zelftest: Ken je de onderzoeksvraag?", "p": 66, "html": "<ul><li>[ ] Ik kan uitleggen waarom het Congres van Wenen probeerde de Franse Revolutie &quot;ongedaan te maken&quot; en waarom dit niet kon lukken</li><li>[ ] Ik begrijp hoe liberalisme (individuele vrijheid) en nationalisme (volkssoevereiniteit) de oude machtsverhoudingen ondermijnden</li><li>[ ] Ik kan voorbeelden geven van hoe beide ideologieën samenwerkten (Belgische Revolutie 1830) maar ook botsten (universele rechten vs nationale identiteit)</li><li>[ ] Ik herken deze spanningen in actuele politiek: migratie, Europa, identiteit, kiesrecht</li><li>[ ] Ik kan met bronnen (spotprenten, grondwetten, partijprogramma&#x27;s) argumenteren vanuit verschillende perspectieven</li><li>[ ] Ik begrijp waarom democratie een balans nodig heeft tussen beide ideologieën: zonder liberalisme dreigt uitsluiting, zonder nationalisme ontbreekt volksbasis</li></ul>", "sub": [], "tekst": "ik kan uitleggen waarom het congres van wenen probeerde de franse revolutie quot ongedaan te maken quot en waarom dit niet kon lukken ik begrijp hoe liberalisme individuele vrijheid en nationalisme volkssoevereiniteit de oude machtsverhoudingen ondermijnden ik kan voorbeelden geven van hoe beide ideologieën samenwerkten belgische revolutie 1830 maar ook botsten universele rechten vs nationale identiteit ik herken deze spanningen in actuele politiek migratie europa identiteit kiesrecht ik kan met bronnen spotprenten grondwetten partijprogramma x27 s argumenteren vanuit verschillende perspectieven ik begrijp waarom democratie een balans nodig heeft tussen beide ideologieën zonder liberalisme dreigt uitsluiting zonder nationalisme ontbreekt volksbasis"}]}, {"id": "BR", "titel": "Bronvermelding", "sub": "Waar komen de bronnen in de cursus vandaan?", "secties": [{"id": "BR-1", "titel": "Bronnen", "p": 66, "html": "<p><b>📚 GERAADPLEEGDE BRONNEN HOOFDSTUK 1</b></p><p><b>Primaire bronnen</b></p><ul><li>Burke, Edmund (1790). Reflections on the Revolution in France. J. Dodsley</li><li>Tocqueville, Alexis de (1856). L&#x27;Ancien Régime et la Révolution. Gallimard</li></ul><p><b>Moderne Academische standaardwerken</b></p><ul><li>Chartier, Roger (1991). <i>The Cultural Origins of the French Revolution</i>. Duke University Press</li><li>Doyle, William (2018). <i>The Oxford History of the French Revolution</i>. 3rd edition. Oxford University Press</li><li>Furet, François (1978). <i>Penser la Révolution française</i>. Gallimard</li><li>Invloedrijke revisionist die marxistische interpretatie bekritiseerde</li><li>Lefebvre, Georges (1962-1967). <i>The French Revolution</i> (4 volumes). Routledge</li><li>Schama, Simon (1989). <i>Citizens: A Chronicle of the French Revolution</i>. Knopf</li><li>Soboul, Albert (1965). <i>La Révolution française</i>. Presses Universitaires de France</li></ul><p><b>Gedetailleerde Online Bronnen</b></p><p> IsGeschiedenis (2024). &quot;Onthoofding Franse koning Lodewijk XVI&quot;\n ExamenOverzicht (2023). &quot;De Franse Revolutie: Oorzaken, Verloop en Gevolgen&quot;<br>\n Historiek (2024). &quot;Franse Revolutie - Tijdlijn, samenvatting, oorzaken&quot;<br>\n AbsoluteFacts (2015). &quot;Executie Lodewijk XVI op 21 januari 1793&quot;<br>\n IsGeschiedenis (2023). &quot;Bestorming van de Bastille&quot;<br>\n Historiek (2024). &quot;Industriële Revolutie - Oorzaken en gevolgen&quot;<br>\n Wikipedia (2008). &quot;Bestorming van de Bastille&quot;<br>\n ExamenOverzicht (2023). &quot;De industriële revolutie&quot;<br>\n Frankrijk in Nederland (2017). &quot;Quatorze juillet: de nationale feestdag&quot;<br>\n Wikipedia (2021). &quot;Tijdlijn van de Franse Revolutie&quot;<br>\n Brunsveld Geschiedenis (2018). &quot;Standensamenleving&quot; [YouTube]<br>\n Studeersnel (2023). &quot;Samenvatting Ancien Régime - De standen&quot;<br>\n Visiting Paris (2024). &quot;De dood van Lodewijk XVI op de guillotine&quot;<br>\n<br> Wikipedia (2004). &quot;Standenmaatschappij&quot;\n Super-Prof (2025). &quot;Franse Revolutie Tijdlijn&quot;<br>\n Historiek (2025). &quot;Koning Lodewijk XVI - Van Versailles tot guillotine&quot;<br>\n Wikipedia (2005). &quot;Ancien régime&quot;<br>\n MindOnMap (2024). &quot;Hoe maak je een tijdlijn van de Franse Revolutie&quot;<br>\n Historiek (2022). &quot;Ancien régime - Betekenis en kenmerken&quot;<br></p><p><b>📚 GERAADPLEEGDE BRONNEN HOOFDSTUK 2</b></p><p><b>Primaire Bronnen</b></p><ul><li>Final Act of the Congress of Vienna/General Treaty (1815). World Japan Database. Available at:</li><li>PowerPoint Presentatie: &quot;Napoleon en het Congres van Wenen.&quot; [Gebruikte lesmateriaal]</li><li><b>Online Academische Databansen</b></li><li>Research Database:</li><li>The Napoleon Series:</li><li>64 Parishes (Louisiana Historical Association):</li><li>International Journal of Eurasia Social Sciences: &quot;The Effects of the Vienna Congress on the European System and the Non-European World&quot; (2024)</li></ul><p><b>Historiografische Studies:</b></p><ul><li>University of Nottingham Repository: &quot;The Congress of Vienna, 1814-1815: Diplomacy, Political Culture and Sociability&quot; (2015)</li><li>English Historical Review: &quot;A Priceless Grace? The Congress of Vienna of 1815, the Ottoman Empire and the Question of the Eastern Question&quot; (2021)</li><li>Database: Multiple peer-reviewed articles on Congress of Vienna and Napoleonic legacy</li><li><i>Alle bronnen geraadpleegd tussen augustus 2025. Academische bronnen geselecteerd op basis van peer-review status en reputatie van uitgever/instelling.</i></li><li>Cobban, Alfred. <i>Dictatorship: Its History and Theory</i>. London: Jonathan Cape, 1939. Republished in: <i>Napoleon Interpretations</i>, Various Authors, Educational Press, 1940s.</li><li>Broers, Michael. <i>Napoleon: Soldier of Destiny</i>. London: Faber &amp; Faber, 2014. Available at:</li><li>Gordley, James. &quot;Myths of the French Civil Code.&quot; <i>American Journal of Comparative Law</i> 42, no. 3 (1994): 459-505. Referenced in: Li, Zilei, and Carlos Hernández. &quot;The Overemphasized Legacy of the Napoleonic Code.&quot; <i>Journal of Student Research</i> 10, no. 2 (2021).</li><li>Carbonnier, Jean. <i>Droit civil</i>. Paris: PUF, 2004. Referenced in: &quot;Code Civil.&quot; <i>Max-EuP 2012</i>, Max Planck Institute for Comparative and International Private Law, 2021.</li><li>Broers, Michael. <i>Europe under Napoleon, 1799-1815</i>. London: Arnold, 2009.</li><li>Jarrett, Mark. <i>The Congress of Vienna and Its Legacy: War and Great Power Diplomacy after Napoleon</i>. London: I.B. Tauris, 2013.</li><li>Zamoyski, Adam. <i>Phantom Terror: Political Paranoia and the Creation of the Modern State, 1789-1848</i>. New York: Basic Books, 2014.</li><li>&quot;The Congress of Vienna (1814-15).&quot; <i>Magadh Mahila College Educational Materials</i>, 2020. Available at:</li><li>Vick, Brian. <i>The Congress of Vienna: Power and Politics after Napoleon</i>. Cambridge, MA: Harvard University Press, 2014.</li><li><b>📚 GERAADPLEEGDE BRONNEN HOOFDSTUK 3</b></li></ul><p><b>Primaire Bronnen</b></p><ul><li>Locke, John (1689). <i>Two Treatises of Government</i>. Awnsham Churchill</li><li>Smith, Adam (1776). <i>An Inquiry into the Nature and Causes of the Wealth of Nations</i>. W. Strahan &amp; T. Cadell</li><li>Mill, John Stuart (1859). <i>On Liberty</i>. John W. Parker &amp; Son</li><li>Renan, Ernest (1882). <i>&quot;Qu&#x27;est-ce qu&#x27;une nation?&quot;</i> Lecture Sorbonne</li></ul><p><b>Moderne Academische Werken</b></p><ul><li>Anderson, Benedict (1983). Imagined Communities: Reflections on the Origin and Spread of Nationalism. Verso</li><li>Hobsbawm, Eric (1990). Nations and Nationalism since 1780. Cambridge University Press</li><li>Gellner, Ernest (1983). Nations and Nationalism. Blackwell</li><li>Gray, John (1995). Liberalism. 2nd edition. Open University Press</li><li>Müller, Jan-Werner (2016). What Is Populism? University of Pennsylvania Press</li><li>Belgische Specialisten</li><li>Witte, Els (2010). De Belgische Revolutie. Davidsfonds</li><li>Mabille, Xavier (2011). Histoire politique de la Belgique. CRISP</li><li>De Schaepdrijver, Sophie (2018). Elites for the Capital? Foreign Migration to Mid-Nineteenth-Century Brussels. UCL Press</li><li>Deprez, Kas &amp; Vos, Louis (1998). Nationalism in Belgium. Palgrave Macmillan</li><li><b>Online Databases</b></li><li>Stanford Encyclopedia of Philosophy - Entries on Liberalism, Nationalism</li><li>European History Online (EGO) - Institute of European History, Mainz</li><li>Cambridge Core - Journal articles on 19th century political thought</li><li>JSTOR Digital Library - Historical journal archives</li></ul>", "sub": [], "tekst": "geraadpleegde bronnen hoofdstuk 1 primaire bronnen burke edmund 1790 reflections on the revolution in france j dodsley tocqueville alexis de 1856 l x27 ancien régime et la révolution gallimard moderne academische standaardwerken chartier roger 1991 the cultural origins of the french revolution duke university press doyle william 2018 the oxford history of the french revolution 3rd edition oxford university 