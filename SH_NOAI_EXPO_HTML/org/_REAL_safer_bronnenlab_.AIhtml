// ══════════════════════════════
// STAP 2 — SHOP
// ══════════════════════════════
function wtGetSpent(){
  return WATERLOO_UNITS.reduce((s,u)=>s+(WT.army[u.id]||0)*u.cost, 0);
}
function wtGetRemain(){
  return WT.budget - wtGetSpent();
}

function wtRenderShop(){
  const typeLabel = {inf:'Infanterie',cav:'Cavalerie',art:'Artillerie',elit:'Elite'};
  const cards = WATERLOO_UNITS.map(u=>{
    const qty = WT.army[u.id] || 0;
    const canBuy = wtGetRemain() >= u.cost;
    return `<div class="wt-unit-card${qty>0?' wt-owned':''}" id="wt-card-${u.id}">
      <div class="wt-unit-icon">${u.icon}</div>
      <span class="wt-unit-type wt-type-${u.type}">${typeLabel[u.type]}</span>
      <div class="wt-unit-name">${u.name}</div>
      <div class="wt-unit-cost">⚡ ${u.cost} XP</div>
      <div class="wt-unit-stats">
        <span class="wt-unit-stat">⚔️ ${u.atk}</span>
        <span class="wt-unit-stat">🛡️ ${u.def}</span>
      </div>
      <div class="wt-unit-tip">${u.tip}</div>
      <div class="wt-unit-controls">
        <button class="wt-qty-btn" onclick="wtBuy('${u.id}',-1)" id="wt-min-${u.id}" ${qty===0?'disabled':''}>−</button>
        <span class="wt-qty-display" id="wt-qty-${u.id}">${qty}</span>
        <button class="wt-qty-btn" onclick="wtBuy('${u.id}',1)" id="wt-add-${u.id}" ${!canBuy?'disabled':''}>+</button>
      </div>
    </div>`;
  }).join('');

  const spent = wtGetSpent();
  const remain = WT.budget - spent;
  $('wt-content').innerHTML = `
    <div class="wt-phase wt-active">
      <div class="wt-phase-title">🛒 Stel je leger samen</div>
      <div class="wt-phase-sub">Koop eenheden met je verdiende XP. <strong style="color:var(--text)">Verlies je de slag, dan ben je de gespendeerde XP kwijt.</strong> Win je, dan krijg je ze terug plus 50% bonus!</div>
      <div class="wt-shop-grid">${cards}</div>
      <div class="wt-shop-footer">
        <div class="wt-spend-info">
          Gespendeerd: <strong id="wt-spent-val">${spent}</strong> XP &nbsp;·&nbsp;
          Resterend: <strong id="wt-remain-val" style="color:${remain<20?'#f87171':'var(--amber)'}">${remain}</strong> XP
        </div>
        <button class="wt-btn-primary" id="wt-btn-to-deploy" onclick="wtGoToDeploy()" ${spent===0?'disabled':''}>
          Naar het slagveld →
        </button>
      </div>
    </div>`;
}

function wtBuy(id, delta){
  const u = WATERLOO_UNITS.find(x=>x.id===id);
  if(!u) return;
  const current = WT.army[id] || 0;
  if(delta > 0 && wtGetRemain() < u.cost) return;
  if(delta < 0 && current <= 0) return;
  WT.army[id] = current + delta;
  if(WT.army[id] <= 0) delete WT.army[id];
  // Update UI
  const spent = wtGetSpent();
  const remain = WT.budget - spent;
  // qty display
  WATERLOO_UNITS.forEach(u2=>{
    const q = WT.army[u2.id] || 0;
    const card = $('wt-card-'+u2.id);
    if(card){ card.classList.toggle('wt-owned', q>0); }
    if($('wt-qty-'+u2.id)) $('wt-qty-'+u2.id).textContent = q;
    const addBtn = $('wt-add-'+u2.id);
    if(addBtn) addBtn.disabled = remain < u2.cost;
    const minBtn = $('wt-min-'+u2.id);
    if(minBtn) minBtn.disabled = (WT.army[u2.id]||0) === 0;
  });
  if($('wt-spent-val')) $('wt-spent-val').textContent = spent;
  if($('wt-remain-val')){
    $('wt-remain-val').textContent = remain;
    $('wt-remain-val').style.color = remain < 20 ? '#f87171' : 'var(--amber)';
  }
  if($('wt-btn-to-deploy')) $('wt-btn-to-deploy').disabled = spent === 0;
}

function wtGoToDeploy(){
  if(wtGetSpent() === 0) return;
  WT.xpSpent = wtGetSpent();
  WT.deployed = { left:[null,null,null], centre:[null,null,null], right:[null,null,null] };
  WT.selectedUnit = null;
  wtSetPhase('deploy');
}

// ══════════════════════════════
// STAP 3 — DEPLOY
// ══════════════════════════════
const WT_ROWS = ['Voorhoede','Middenlinie','Achterhoede'];
const WT_LANES = ['left','centre','right'];

function wtCountDeployed(){
  return WT_LANES.reduce((n,l)=>n + WT.deployed[l].filter(Boolean).length, 0);
}

function wtUnitAvailableQty(uid){
  const total = WT.army[uid] || 0;
  const used = WT_LANES.reduce((n,l)=>n + WT.deployed[l].filter(x=>x===uid).length, 0);
  return total - used;
}

function wtRenderDeploy(){
  // Build army panel
  const armyItems = WATERLOO_UNITS
    .filter(u=>(WT.army[u.id]||0)>0)
    .map(u=>{
      const avail = wtUnitAvailableQty(u.id);
      const sel = WT.selectedUnit === u.id;
      return `<div class="wt-army-unit${sel?' wt-sel':''}${avail===0?' wt-exhausted':''}"
        id="wt-au-${u.id}" onclick="wtSelectUnit('${u.id}')">
        <span class="wt-army-unit-icon">${u.icon}</span>
        <div class="wt-army-unit-info">
          <div class="wt-army-unit-name">${u.name}</div>
          <div class="wt-army-unit-qty">${avail} beschikbaar</div>
        </div>
      </div>`;
    }).join('');

  // Build napoleon grid (3 lanes × 3 rows)
  const laneLabels = {left:'LINKERFLANK<br><small>Hougoumont</small>', centre:'CENTRUM<br><small>La Haye Sainte</small>', right:'RECHTERFLANK<br><small>Plancenoit</small>'};
  const labelRow = WT_LANES.map(l=>`<div class="wt-bf-lane-label">${laneLabels[l]}</div>`).join('');

  const laneCols = WT_LANES.map(lane=>{
    const slots = WT.deployed[lane].map((uid, ri)=>{
      const rowLabel = WT_ROWS[ri];
      const u = uid ? WATERLOO_UNITS.find(x=>x.id===uid) : null;
      const highlight = !uid && WT.selectedUnit ? ' wt-slot-highlight' : '';
      return `<div class="wt-slot${uid?' wt-slot-occupied':''}${highlight}"
        id="wt-slot-${lane}-${ri}" onclick="wtPlaceUnit('${lane}',${ri})">
        <span class="wt-slot-row-label">${rowLabel}</span>
        ${u ? `<span class="wt-slot-unit">${u.icon}</span>
               <span class="wt-slot-unit-name">${u.name}</span>
               <span class="wt-slot-remove" onclick="wtRemoveUnit(event,'${lane}',${ri})">✕</span>` : ''}
      </div>`;
    }).join('');
    return `<div class="wt-lane-col">${slots}</div>`;
  }).join('');

  // Wellington row
  const welRow = WT_LANES.map(l=>{
    const w = WT_WEL[l];
    return `<div class="wt-wel-card">
      <div class="wt-wel-icon">${w.icon}</div>
      <div class="wt-wel-name">${w.name}</div>
      <div class="wt-wel-def">Verdediging: ${w.def}</div>
      <div class="wt-wel-desc">${w.desc}</div>
    </div>`;
  }).join('');

  const deployed = wtCountDeployed();
  $('wt-content').innerHTML = `
    <div class="wt-phase wt-active">
      <div class="wt-phase-title">🗺️ Tactische opstelling</div>
      <div class="wt-phase-sub">Selecteer een eenheid (links) → klik een slot op het slagveld. <strong style="color:var(--text)">Tip: artillerie achteraan, cavalerie op de flanken!</strong></div>
      <div class="wt-deploy-wrap">
        <div class="wt-army-panel">
          <div class="wt-army-title">Jouw leger</div>
          <div id="wt-army-items">${armyItems}</div>
        </div>
        <div class="wt-bf-outer">
          <div class="wt-bf-lane-labels">${labelRow}</div>
          <div class="wt-napoleon-grid">${laneCols}</div>
          <div class="wt-bf-divider">⚔️ GEVECHTSLINIE ⚔️</div>
          <div class="wt-wellington-row">${welRow}</div>
        </div>
      </div>
      <div class="wt-deploy-footer">
        <button class="wt-btn-secondary" onclick="wtSetPhase('shop')">← Terug naar winkel</button>
        <button class="wt-btn-primary" id="wt-btn-battle" onclick="wtStartBattle()" ${deployed===0?'disabled':''}>
          ⚔️ Slag beginnen!
        </button>
      </div>
    </div>`;
}

function wtSelectUnit(uid){
  if(wtUnitAvailableQty(uid) === 0) return;
  WT.selectedUnit = WT.selectedUnit === uid ? null : uid;
  wtRenderDeploy();
}

function wtPlaceUnit(lane, row){
  if(!WT.selectedUnit) return;
  if(WT.deployed[lane][row] !== null) return; // slot bezet
  if(wtUnitAvailableQty(WT.selectedUnit) <= 0) return;
  WT.deployed[lane][row] = WT.selectedUnit;
  WT.selectedUnit = null;
  wtRenderDeploy();
}

function wtRemoveUnit(e, lane, row){
  e.stopPropagation();
  WT.deployed[lane][row] = null;
  wtRenderDeploy();
}

function wtStartBattle(){
  if(wtCountDeployed() === 0) return;
  wtSetPhase('combat');
}

// ══════════════════════════════
// COMBAT — data
// ══════════════════════════════
function wtMakeWellingtonArmy(){
  return {
    left:[
      {id:'wl1',name:'Britse Garde',          icon:'🔵',hp:6, maxHp:6, atk:3, type:'inf', square:false},
      {id:'wl2',name:'Britse Garde',          icon:'🔵',hp:6, maxHp:6, atk:3, type:'inf', square:false},
      {id:'wl3',name:'Brits Kanon',           icon:'💂',hp:4, maxHp:4, atk:5, type:'art', square:false},
    ],
    centre:[
      {id:'wc1',name:'Britse Linie',          icon:'🔵',hp:5, maxHp:5, atk:2, type:'inf', square:false},
      {id:'wc2',name:'King\'s German Legion', icon:'🔵',hp:6, maxHp:6, atk:4, type:'inf', square:false},
      {id:'wc3',name:'Britse Linie',          icon:'🔵',hp:5, maxHp:5, atk:2, type:'inf', square:false},
      {id:'wc4',name:'Brits Kanon',           icon:'💂',hp:4, maxHp:4, atk:5, type:'art', square:false},
    ],
    right:[
      {id:'wr1',name:'Ned.-Belg. Inf.',       icon:'🟡',hp:4, maxHp:4, atk:2, type:'inf', square:false},
      {id:'wr2',name:'Ned.-Belg. Inf.',       icon:'🟡',hp:4, maxHp:4, atk:2, type:'inf', square:false},
      // Pruisen komen in ronde 3
    ],
  };
}

function wtMakeNapoleonArmy(){
  const army = {left:[],centre:[],right:[]};
  WT_LANES.forEach(lane=>{
    WT.deployed[lane].forEach((uid,ri)=>{
      if(!uid) return;
      const u = WATERLOO_UNITS.find(x=>x.id===uid);
      if(!u) return;
      army[lane].push({
        id:`n_${lane}_${ri}`, name:u.name, icon:u.icon,
        hp:u.def*2+2, maxHp:u.def*2+2,   // HP gebaseerd op def-waarde
        atk:u.atk, type:u.type, row:ri,
      });
    });
  });
  return army;
}

// Combat state
const WTC = {
  napoleon: null,    // {left:[...], centre:[...], right:[...]}
  wellington: null,
  round: 1,
  maxRounds: 6,
  selected: null,    // {lane, idx, side}
  attacksLeft: 0,
  log: [],
  prussianArrived: false,
  laneDecided: {left:null, centre:null, right:null}, // 'napoleon'|'wellington'|null
  roundEvent: null,   // huidig ronde-event
  usedEventIds: [],   // bijgehouden events om herhaling te vermijden
};

function wtInitCombat(){
  WTC.napoleon   = wtMakeNapoleonArmy();
  WTC.wellington = wtMakeWellingtonArmy();
  WTC.round = 1;
  WTC.selected = null;
  WTC.log = [];
  WTC.prussianArrived = false;
  WTC.laneDecided = {left:null, centre:null, right:null};
  WTC.roundEvent = null;
  WTC.usedEventIds = [];
  WTC.wellingtonTurn = false;
  WTC.attacksLeft = WT_LANES.reduce((n, lane) => {
    const hasTargets = WTC.wellington[lane].some(u => u.hp > 0);
    return n + (hasTargets ? WTC.napoleon[lane].filter(u => u.hp > 0).length : 0);
  }, 0);
}



const WT_PHASES = ['intro','shop','deploy','combat','result'];
const WT_PHASE_LABELS = {intro:'Uitleg',shop:'Winkel',deploy:'Opstelling',combat:'Gevecht',result:'Resultaat'};

function wtSetPhase(name){
  WT.phase = name;
  $('wt-content').innerHTML = '';
  wtRenderStepper(name);
  if(name==='intro')  wtRenderIntro();
  if(name==='shop')   wtRenderShop();
  if(name==='deploy') wtRenderDeploy();
  if(name==='combat'){ wtInitCombat(); wtRenderCombat(); }
  if(name==='result') wtRenderResult();
}

function wtRenderStepper(active){
  const steps = ['shop','deploy','combat','result'];
  const labels = {shop:'🛒 Winkel',deploy:'🗺️ Opstelling',combat:'⚔️ Gevecht',result:'🏆 Resultaat'};
  if(active==='intro'){ $('wt-stepper').innerHTML=''; return; }
  const idx = steps.indexOf(active);
  $('wt-stepper').innerHTML = steps.map((s,i)=>`
    <div class="wt-step ${i<idx?'wt-step-done':i===idx?'wt-step-active':'wt-step-todo'}">
      <div class="wt-step-dot">${i<idx?'✓':i+1}</div>
      <div class="wt-step-lbl">${labels[s]}</div>
    </div>
    ${i<steps.length-1?'<div class="wt-step-line '+(i<idx?'wt-step-line-done':'')+'"></div>':''}
  `).join('');
}

// ══════════════════════════════
// STAP 4b — COMBAT (tactisch)
// ══════════════════════════════
const WT_TYPE_NAMES = {inf:'Infanterie',cav:'Cavalerie',art:'Artillerie',elit:'Elite'};
const WT_LANE_NAMES = {left:'Linkerflank',centre:'Centrum',right:'Rechterflank'};
const WT_LANE_SUBS  = {left:'Hougoumont', centre:'La Haye Sainte', right:'Plancenoit'};

function wtTokenHTML(u, side, lane, idx){
  if(!u) return '';
  const dead = u.hp <= 0;
  const welTurn = WTC.wellingtonTurn;
  const sel = !welTurn && WTC.selected && WTC.selected.side===side && WTC.selected.lane===lane && WTC.selected.idx===idx;
  const canTarget = !welTurn && !dead && side==='wellington' && WTC.selected && WTC.selected.side==='napoleon' && WTC.attacksLeft>0;
  const canSelect = !welTurn && !dead && side==='napoleon' && WTC.attacksLeft>0 && !WTC.selected;
  const hpPct = Math.max(0, Math.round(u.hp / u.maxHp * 100));
  const hpColor = hpPct > 60 ? '#4ade80' : hpPct > 30 ? '#f59e0b' : '#ef4444';
  const typeColors = {inf:'#4ade80',cav:'#60a5fa',art:'#fb923c',elit:'#fbbf24'};
  const squareMark = u.square ? ' 🟥' : '';

  // Damage preview (deterministisch, geen random)
  let dmgPreviewHTML = '';
  if(canTarget && WTC.selected){
    const nap = WTC.napoleon[WTC.selected.lane][WTC.selected.idx];
    if(nap && nap.hp > 0){
      const {dmg, note, noteClass} = wtCalcDmgPreview(nap, u);
      dmgPreviewHTML = `<span class="wt-dmg-preview ${noteClass}">⚔ ~${dmg}${note?' '+note:''}</span>`;
    }
  }

  let cls = `wt-token wt-token-${side}`;
  if(dead)       cls += ' wt-token-dead';
  else if(sel)   cls += ' wt-token-selected';
  else if(canTarget) cls += ' wt-token-targetable';
  else if(canSelect) cls += ' wt-token-selectable';
  else           cls += ' wt-token-passive';

  const clickAttr = dead || welTurn ? '' :
    side==='napoleon' && WTC.attacksLeft>0
      ? `onclick="wtSelectNapoleon('${lane}',${idx})"`
      : side==='wellington' && WTC.selected && WTC.selected.side==='napoleon'
        ? `onclick="wtAttack('${lane}',${idx})"`
        : '';

  const atkVal = u.atk || 3;

  return `<div class="${cls}" id="wt-tok-${side}-${lane}-${idx}" ${clickAttr}>
    <div class="wt-token-row1">
      <span class="wt-token-icon">${dead?'☠️':u.icon}</span>
      <span class="wt-token-name">${dead?'<s>'+u.name+'</s>':u.name+squareMark}</span>
      <span class="wt-token-atk wt-token-atk-${side}" title="Aanvalswaarde">⚔${atkVal}</span>
    </div>
    <div class="wt-token-row2">
      <span class="wt-token-type-badge" style="background:${typeColors[u.type]}22;color:${typeColors[u.type]};border:1px solid ${typeColors[u.type]}44">
        ${WT_TYPE_NAMES[u.type]||u.type}
      </span>
      ${dmgPreviewHTML}
    </div>
    <div class="wt-hp-bar-wrap" style="margin-top:4px">
      <div class="wt-hp-bar" style="width:${hpPct}%;background:${hpColor};transition:width .4s ease"></div>
    </div>
    <div class="wt-token-hp-row">
      <span class="wt-token-hp-num" style="color:${hpColor}">${u.hp}</span>
      <span class="wt-token-hp-max">/ ${u.maxHp} HP</span>
    </div>
  </div>`;
}

function wtRenderCombat(){
  const laneCards = WT_LANES.map(lane=>{
    const decided = WTC.laneDecided[lane];
    const napUnits  = WTC.napoleon[lane].map((u,i)=>wtTokenHTML(u,'napoleon',lane,i)).join('');
    const welUnits  = WTC.wellington[lane].map((u,i)=>wtTokenHTML(u,'wellington',lane,i)).join('');
    let decidedBanner = '';
    if(decided==='napoleon') decidedBanner = `<div style="text-align:center;padding:4px 8px;background:#16a34a33;border:1px solid #4ade80;border-radius:6px;font-size:.65rem;color:#4ade80;margin-bottom:6px;font-weight:700">🏆 Napoleon wint!</div>`;
    else if(decided==='wellington') decidedBanner = `<div style="text-align:center;padding:4px 8px;background:#dc262633;border:1px solid #f87171;border-radius:6px;font-size:.65rem;color:#f87171;margin-bottom:6px;font-weight:700">💀 Wellington wint</div>`;
    return `<div class="wt-combat-lane" style="${decided?'opacity:.65;':''}" >
      <div class="wt-lane-header">
        <div class="wt-lane-header-name">${WT_LANE_NAMES[lane]}</div>
        <div class="wt-lane-header-sub">${WT_LANE_SUBS[lane]}</div>
      </div>
      ${decidedBanner}
      <div class="wt-camp-label wt-camp-label-napoleon">🇫🇷 NAPOLEON</div>
      <div class="wt-camp wt-camp-napoleon">${napUnits||'<span style="font-size:.7rem;color:var(--muted);padding:8px 0;display:block;text-align:center">Geen troepen</span>'}</div>
      <div class="wt-camp-divider">— FRONTLINIE —</div>
      <div class="wt-camp wt-camp-wellington">${welUnits}</div>
      <div class="wt-camp-label wt-camp-label-wellington">🇬🇧 WELLINGTON</div>
    </div>`;
  }).join('');

  const welTurn = WTC.wellingtonTurn;
  const hint = welTurn
    ? `<span style="color:#93c5fd">🔵 Wellington voert zijn aanvallen uit…</span>`
    : WTC.selected
      ? `<strong>Kies een doelwit</strong> — rode eenheden zijn aanvalbaar. <span style="color:var(--muted);font-size:.72rem">ESC = deselecteren</span>`
      : WTC.attacksLeft > 0
        ? `<strong>Selecteer een van jouw eenheden</strong> om aan te vallen. Hover over vijand voor damage preview.`
        : `Alle aanvallen gebruikt — <strong>sluit de ronde af</strong>.`;

  const logHTML = WTC.log.slice(-8).map(e=>`<div class="wt-log-entry-${e.type}">${e.msg}</div>`).join('');

  const napWinCount = wtNapLanesWinning();
  const showRetreat = !welTurn && WTC.round >= 3 && napWinCount < 2;
  const retreatBtn = showRetreat
    ? `<button class="wt-btn-secondary" onclick="wtRetreat()" style="border-color:#f59e0b;color:#f59e0b">🚩 Terugtrekken (redt 30% XP)</button>`
    : '';

  const eventBar = WTC.roundEvent
    ? `<div style="padding:8px 12px;background:rgba(245,158,11,.12);border:1px solid var(--amber);border-radius:8px;font-size:.78rem;color:#fbbf24;margin-bottom:10px">
        ${WTC.roundEvent.icon} <strong>Event ronde ${WTC.round}:</strong> ${WTC.roundEvent.text}
       </div>`
    : '';

  const allDecided = WT_LANES.every(l=>WTC.laneDecided[l]!==null);
  const isLastRound = WTC.round >= WTC.maxRounds || allDecided;
  const turnBadge = welTurn
    ? `<div class="wt-turn-badge wt-turn-wellington" style="animation:wt-blink .9s step-end infinite">🔵 Wellington's beurt</div>`
    : `<div class="wt-turn-badge wt-turn-napoleon">⚔️ Napoleon's beurt</div>`;

  $('wt-content').innerHTML = `
    <div class="wt-phase wt-active">
      <div class="wt-combat-header">
        <div class="wt-round-badge">Ronde ${WTC.round} / ${WTC.maxRounds}</div>
        ${turnBadge}
        <div class="wt-attacks-left">Aanvallen: <strong>${WTC.attacksLeft}</strong></div>
      </div>
      ${eventBar}
      <div class="wt-combat-grid">${laneCards}</div>
      <div class="wt-log" id="wt-log-box">${logHTML||'<em style="color:var(--muted)">Slag begint… selecteer een eenheid om aan te vallen.</em>'}</div>
      <div class="wt-combat-footer">
        <div class="wt-hint-box">💡 ${hint}</div>
        <div style="display:flex;gap:10px;flex-wrap:wrap;justify-content:center">
          ${retreatBtn}
          <button class="wt-btn-primary" onclick="wtEndRound()" ${(WTC.attacksLeft>0||welTurn)?'disabled':''}>
            ${isLastRound ? '⚔️ Eindresultaat' : 'Volgende ronde →'}
          </button>
        </div>
      </div>
    </div>`;
  // Auto-scroll log naar beneden
  const logEl = document.getElementById('wt-log-box');
  if(logEl) logEl.scrollTop = logEl.scrollHeight;
}

function wtSelectNapoleon(lane, idx){
  if(WTC.wellingtonTurn) return;
  const u = WTC.napoleon[lane][idx];
  if(!u || u.hp<=0) return;
  if(WTC.selected && WTC.selected.side==='napoleon' && WTC.selected.lane===lane && WTC.selected.idx===idx){
    WTC.selected = null;
  } else {
    WTC.selected = {side:'napoleon', lane, idx};
  }
  wtRenderCombat();
}

// Deterministisch (geen random) — voor damage preview
function wtCalcDmgPreview(attacker, target){
  let dmg = attacker.atk || 3;
  let mod = 1; let note = ''; let noteClass = 'wt-dmg-preview-neu';
  if(attacker.type==='cav' && target.type==='inf'){
    if(target.square){ mod=0.5; note='🟥×0.5'; noteClass='wt-dmg-preview-neg'; }
    else             { mod=1.5; note='⚡×1.5'; noteClass='wt-dmg-preview-pos'; }
  }
  if(attacker.type==='cav' && target.type==='art'){ mod=1.5; note='⚡×1.5'; noteClass='wt-dmg-preview-pos'; }
  if(attacker.type==='inf' && target.type==='art'){ mod=1.4; note='⚡×1.4'; noteClass='wt-dmg-preview-pos'; }
  if(attacker.type==='elit'){                       mod*=1.3; note='⭐×1.3'; noteClass='wt-dmg-preview-pos'; }
  if(target.type==='elit'){                         mod*=0.7; note='🛡×0.7'; noteClass='wt-dmg-preview-neg'; }
  dmg = Math.max(1, Math.round(dmg * mod));
  return {dmg, note, noteClass};
}

function wtCalcDamage(attacker, target){
  let dmg = attacker.atk || 3;
  let note = '';
  // Type-voordelen
  if(attacker.type==='cav' && target.type==='inf'){
    if(target.square){ dmg = Math.round(dmg*0.5); note='🟥 Vierkant! ×0.5'; }
    else             { dmg = Math.round(dmg*1.5); note='⚡ Cavalerie vs. inf ×1.5'; }
  }
  if(attacker.type==='cav' && target.type==='art'){ dmg=Math.round(dmg*1.5); note='⚡ Cavalerie vs. art ×1.5'; }
  if(attacker.type==='inf' && target.type==='art'){ dmg=Math.round(dmg*1.4); note='⚡ Infanterie vs. art ×1.4'; }
  if(attacker.type==='elit'){                       dmg=Math.round(dmg*1.3); note='⭐ Elite ×1.3'; }
  if(target.type==='elit'){                         dmg=Math.round(dmg*0.7); note='🛡️ Elite verdediging ×0.7'; }
  // Kleine willekeur ±1
  dmg = Math.max(1, dmg + Math.floor(Math.random()*3)-1);
  return {dmg, note};
}

function wtShowDmgFloat(tokenId, dmg){
  const tok = $(tokenId);
  if(!tok) return;
  const float = document.createElement('div');
  float.className = 'wt-dmg-float';
  float.textContent = '-'+dmg;
  tok.style.position = 'relative';
  tok.appendChild(float);
  setTimeout(()=>float.remove(), 950);
}

function wtAddLog(msg, type='napoleon'){
  WTC.log.push({msg, type});
  if(WTC.log.length > 20) WTC.log.shift();
}

function wtAttack(welLane, welIdx){
  if(WTC.wellingtonTurn) return;
  if(!WTC.selected || WTC.selected.side!=='napoleon') return;
  const nap = WTC.napoleon[WTC.selected.lane][WTC.selected.idx];
  const wel = WTC.wellington[welLane][welIdx];
  if(!nap || !wel || nap.hp<=0 || wel.hp<=0) return;

  // Cavalerie-aanval: infanterie vormt automatisch vierkant
  if(nap.type==='cav' && wel.type==='inf') wel.square = true;

  const {dmg, note} = wtCalcDamage(nap, wel);
  wel.hp = Math.max(0, wel.hp - dmg);

  wtAddLog(`${nap.name} ⚔️ ${wel.name}: −${dmg} HP${note?' ('+note+')':''}`, 'napoleon');

  WTC.selected = null;
  WTC.attacksLeft--;

  // Herbereken: eenheden zonder doelwitten overslaan
  const effectiveLeft = WT_LANES.reduce((n, lane) => {
    const hasTargets = WTC.wellington[lane].some(u => u.hp > 0);
    return n + (hasTargets ? WTC.napoleon[lane].filter(u => u.hp > 0).length : 0);
  }, 0);
  if(WTC.attacksLeft > effectiveLeft) WTC.attacksLeft = effectiveLeft;

  wtRenderCombat();
  setTimeout(()=>{ wtShowDmgFloat(`wt-tok-wellington-${welLane}-${welIdx}`, dmg); }, 30);

  // Na aanval: check of ronde voorbij
  if(WTC.attacksLeft <= 0){
    setTimeout(wtWellingtonTurn, 900);
  }
}

function wtWellingtonTurn(){
  // Verzamel alle Wellington-aanvallen in een wachtrij
  const attacks = [];
  WT_LANES.forEach(lane=>{
    WTC.wellington[lane].forEach((wel,wi)=>{
      if(wel.hp <= 0) return;
      const targets = WTC.napoleon[lane].filter(u=>u.hp>0);
      if(targets.length === 0) return;
      // AI-strategie: ronde 1-3 = pak zwakste HP; ronde 4+ = pak hoogste ATK (bedreiging)
      const target = WTC.round >= 4
        ? targets.reduce((a,b)=>((a.atk||3)>=(b.atk||3))?a:b)
        : targets.reduce((a,b)=>a.hp<=b.hp?a:b);
      const ni = WTC.napoleon[lane].indexOf(target);
      attacks.push({wel, welLane:lane, welIdx:wi, target, napLane:lane, napIdx:ni});
    });
  });

  if(attacks.length === 0){
    // Geen aanvallen mogelijk — meteen afronden
    WT_LANES.forEach(lane=>WTC.wellington[lane].forEach(u=>{ u.square=false; }));
    WTC.wellingtonTurn = false;
    wtRenderCombat();
    return;
  }

  // Block speler + toon Wellington-banner
  WTC.wellingtonTurn = true;
  wtRenderCombat();
  wtShowTurnOverlay('wellington');

  // Voer aanvallen sequentieel uit
  const BASE_DELAY = 750;
  const STEP = 580;
  attacks.forEach((atk, i)=>{
    setTimeout(()=>{
      // Flash de aanvallende Wellington-eenheid
      const welTok = document.getElementById(`wt-tok-wellington-${atk.welLane}-${atk.welIdx}`);
      if(welTok){ welTok.classList.add('wt-token-striking'); setTimeout(()=>welTok&&welTok.classList.remove('wt-token-striking'), 380); }

      // Bereken en pas schade toe
      const welAtk = {atk: atk.wel.atk||(atk.wel.type==='art'?7:atk.wel.type==='inf'?3:4), type:atk.wel.type};
      atk.wel.square = false;
      const {dmg} = wtCalcDamage(welAtk, atk.target);
      atk.target.hp = Math.max(0, atk.target.hp - dmg);
      wtAddLog(`${atk.wel.name} ↩ ${atk.target.name}: −${dmg} HP`, 'wellington');

      // Re-render + hit-animatie op Napoleon-token
      wtRenderCombat();
      setTimeout(()=>{
        const napTok = document.getElementById(`wt-tok-napoleon-${atk.napLane}-${atk.napIdx}`);
        if(napTok){ napTok.classList.add('wt-token-hit'); setTimeout(()=>napTok&&napTok.classList.remove('wt-token-hit'), 450); }
        wtShowDmgFloat(`wt-tok-napoleon-${atk.napLane}-${atk.napIdx}`, dmg);
      }, 40);

      // Na de laatste aanval: reset + terug naar Napoleon
      if(i === attacks.length - 1){
        setTimeout(()=>{
          WT_LANES.forEach(lane=>WTC.wellington[lane].forEach(u=>{ u.square=false; }));
          WTC.wellingtonTurn = false;
          wtRenderCombat();
          wtShowTurnOverlay('napoleon');
        }, 650);
      }
    }, BASE_DELAY + i * STEP);
  });
}

// ── Hulpfuncties voor uitgebreid gevecht ──

function wtShowBanner(html, duration=3500){
  const banner = document.createElement('div');
  banner.className = 'wt-prussian-banner';
  banner.innerHTML = html;
  const grid = $('wt-content').querySelector('.wt-combat-grid');
  const content = $('wt-content').querySelector('.wt-phase');
  (grid || content || $('wt-content')).before(banner);
  setTimeout(()=>banner.remove(), duration);
}

function wtShowTurnOverlay(side, duration=1600){
  document.querySelectorAll('.wt-turn-overlay').forEach(el=>el.remove());
  const overlay = document.createElement('div');
  overlay.className = 'wt-turn-overlay';
  overlay.innerHTML = side==='wellington'
    ? `<div class="wt-turn-overlay-inner wt-turn-overlay-wellington">🔵 WELLINGTON'S BEURT</div>`
    : `<div class="wt-turn-overlay-inner wt-turn-overlay-napoleon">⚔️ NAPOLEON'S BEURT</div>`;
  document.body.appendChild(overlay);
  setTimeout(()=>overlay.remove(), duration);
}

function wtCheckLaneDecisions(){
  WT_LANES.forEach(lane=>{
    if(WTC.laneDecided[lane]) return; // al beslist
    const napAlive = WTC.napoleon[lane].some(u=>u.hp>0);
    const welAlive = WTC.wellington[lane].some(u=>u.hp>0);
    if(!napAlive && welAlive){
      WTC.laneDecided[lane] = 'wellington';
      wtAddLog(`🏴 ${WT_LANE_NAMES[lane]}: alle Franse troepen vernietigd — Wellington wint deze laan!`, 'wellington');
    } else if(!welAlive && napAlive){
      WTC.laneDecided[lane] = 'napoleon';
      wtAddLog(`🏆 ${WT_LANE_NAMES[lane]}: alle Britse troepen vernietigd — Napoleon wint deze laan!`, 'napoleon');
    }
  });
}

function wtApplyRoundEvent(ev){
  if(!ev || !ev.effects) return;
  ev.effects.forEach(eff=>{
    if(eff.type==='cav_all'){
      WT_LANES.forEach(lane=>WTC.napoleon[lane].forEach(u=>{
        if(u.type==='cav' && u.hp>0) u.atk = Math.max(1, (u.atk||4) + eff.val);
      }));
    }
    if(eff.type==='all_atk'){
      WT_LANES.forEach(lane=>WTC.napoleon[lane].forEach(u=>{
        if(u.hp>0) u.atk = Math.max(1, (u.atk||3) + eff.val);
      }));
    }
    if(eff.type==='lane_atk'){
      WTC.napoleon[eff.lane]&&WTC.napoleon[eff.lane].forEach(u=>{
        if(u.hp>0) u.atk = Math.max(1, (u.atk||3) + eff.val);
      });
    }
    if(eff.type==='lane_def'){
      WTC.wellington[eff.lane]&&WTC.wellington[eff.lane].forEach(u=>{
        if(u.hp>0){ u.hp = Math.min(u.maxHp, u.hp + Math.abs(eff.val)); }
      });
    }
    if(eff.type==='garde_bonus'){
      WT_LANES.forEach(lane=>WTC.napoleon[lane].forEach(u=>{
        if(u.type==='elit' && u.hp>0) u.atk = Math.max(1, (u.atk||12) + eff.val);
      }));
    }
  });
}

function wtNapLanesWinning(){
  return WT_LANES.filter(lane=>{
    if(WTC.laneDecided[lane]==='napoleon') return true;
    if(WTC.laneDecided[lane]==='wellington') return false;
    const napHP = WTC.napoleon[lane].reduce((s,u)=>s+Math.max(0,u.hp),0);
    const welHP = WTC.wellington[lane].reduce((s,u)=>s+Math.max(0,u.hp),0);
    return napHP > welHP;
  }).length;
}

function wtRetreat(){
  if(!confirm('Terugtrekken? Je verliest 70% van je gespendeerde XP maar redt 30%.')) return;
  const saved = Math.round(WT.xpSpent * 0.3);
  _xpForce(ST.xp + saved);
  updateXPHeader(); saveProgress();
  WT.victory = false;
  WT.retreated = true;
  wtSetPhase('result');
}

function wtEndRound(){
  // Controleer of lanen al beslist zijn
  wtCheckLaneDecisions();

  // Check vroegtijdig einde: alle lanen beslist
  const allDecided = WT_LANES.every(l=>WTC.laneDecided[l]!==null);
  if(WTC.round >= WTC.maxRounds || allDecided){
    wtSetPhase('result');
    return;
  }

  WTC.round++;

  // Pruisische versterkingen in ronde 3
  if(WTC.round===3 && !WTC.prussianArrived){
    WTC.prussianArrived = true;
    WTC.wellington.right.push(
      {id:'wp1',name:'Pruisische Inf.',icon:'🔷',hp:6,maxHp:6,atk:2,type:'inf',square:false},
      {id:'wp2',name:'Pruisische Inf.',icon:'🔷',hp:6,maxHp:6,atk:2,type:'inf',square:false}
    );
    wtAddLog('🇩🇪 Blücher\'s Pruisen arriveren bij Plancenoit! (+2 sterke eenheden rechts)', 'event');
  }

  // Historisch event elke 2 rondes (ronde 2 en 4)
  WTC.roundEvent = null;
  if(WTC.round===2 || WTC.round===4 || WTC.round===6){
    const available = WT_EVENTS.filter(e=>!WTC.usedEventIds.includes(e.id));
    if(available.length>0){
      WTC.roundEvent = available[Math.floor(Math.random()*available.length)];
      WTC.usedEventIds.push(WTC.roundEvent.id);
      wtApplyRoundEvent(WTC.roundEvent);
      wtAddLog(`${WTC.roundEvent.icon} ${WTC.roundEvent.text}`, 'event');
    }
  }

  // Tel enkel Napoleon-eenheden die een geldig doelwit hebben
  WTC.attacksLeft = WT_LANES.reduce((n, lane) => {
    const hasTargets = WTC.wellington[lane].some(u => u.hp > 0);
    return n + (hasTargets ? WTC.napoleon[lane].filter(u => u.hp > 0).length : 0);
  }, 0);
  WTC.selected = null;
  wtRenderCombat();

  // Banners
  if(WTC.prussianArrived && WTC.round===3){
    setTimeout(()=>wtShowBanner('🇩🇪 <strong>Blüchers Pruisen zijn aangekomen!</strong> Rechterflank krijgt 2 extra eenheden.'), 100);
  }
  if(WTC.roundEvent){
    const ev = WTC.roundEvent;
    setTimeout(()=>wtShowBanner(`${ev.icon} <strong>Historisch event!</strong> ${ev.text}`), WTC.round===3?3600:100);
  }
}

document.addEventListener('keydown', e=>{
  if(e.key==='Escape' && WTC.selected){ WTC.selected=null; wtRenderCombat(); }
});

// ══════════════════════════════
// STAP 4 — BATTLE
// ══════════════════════════════




// NEO: where's stap 4 lol??




// ══════════════════════════════
// STAP 5 — RESULT
// ══════════════════════════════
function wtRenderResult(){
  // Bereken lane-resultaten: gebruik laneDecided waar beslist, anders HP-vergelijking
  if(WTC.napoleon && WTC.wellington){
    WT_LANES.forEach(lane=>{
      if(WTC.laneDecided[lane]==='napoleon'){ WT.laneResult[lane]='win'; return; }
      if(WTC.laneDecided[lane]==='wellington'){ WT.laneResult[lane]='loss'; return; }
      const napHP = WTC.napoleon[lane].reduce((s,u)=>s+Math.max(0,u.hp),0);
      const welHP = WTC.wellington[lane].reduce((s,u)=>s+Math.max(0,u.hp),0);
      WT.laneResult[lane] = napHP >= welHP ? 'win' : 'loss';
    });
  }
  const wins = WT_LANES.filter(l=>WT.laneResult[l]==='win').length;
  WT.victory = wins >= 2;

  let xpEffect = 0, xpMsg = '', xpClass = '';
  if(WT.retreated){
    // Al verwerkt in wtRetreat()
    const saved = Math.round(WT.xpSpent * 0.3);
    xpMsg = `🚩 Teruggetrokken — ${saved} XP gered (30% van ${WT.xpSpent})`;
    xpClass = 'color:#f59e0b';
  } else if(WT.victory){
    const bonus = Math.round(WT.xpSpent * 0.5);
    xpEffect = WT.xpSpent + bonus;
    _xpForce(ST.xp + xpEffect);
    xpMsg = `+${xpEffect} XP (terug: ${WT.xpSpent} + bonus: ${bonus})`;
    xpClass = 'color:#4ade80';
  } else {
    xpEffect = -WT.xpSpent;
    _xpForce(Math.max(0, ST.xp - WT.xpSpent));
    xpMsg = `−${WT.xpSpent} XP verloren`;
    xpClass = 'color:#f87171';
  }
  updateXPHeader();
  saveProgress();

  // Laan-resultaten visueel
  const laneResultHTML = WT_LANES.map(lane=>{
    const win = WT.laneResult[lane]==='win';
    const decided = WTC.laneDecided[lane];
    const decLabel = decided ? ` <span style="font-size:.65rem;opacity:.7">(${decided==='napoleon'?'volledig ingenomen':'volledig verloren'})</span>` : '';
    return `<div style="padding:10px 14px;border-radius:8px;border:1px solid ${win?'#4ade80':'#f87171'};background:${win?'#16a34a22':'#dc262622'};text-align:center">
      <div style="font-size:.75rem;color:var(--muted)">${WT_LANE_NAMES[lane]}</div>
      <div style="font-size:1.2rem;margin:2px 0">${win?'✅':'❌'}</div>
      <div style="font-size:.7rem;color:${win?'#4ade80':'#f87171'}">${win?'Napoleon':'Wellington'}${decLabel}</div>
    </div>`;
  }).join('');

  const histText = WT.retreated
    ? `Napoleon koos ervoor zijn leger te sparen door tijdig terug te trekken. In werkelijkheid wachtte hij te lang —
       pas na de catastrofale neerlaag vluchtte hij richting Parijs. Door tijdig terug te trekken heb je misschien
       meer levens gespaard dan de historische Napoleon.`
    : WT.victory
    ? `In de echte slag van 18 juni 1815 verloor Napoleon echter van Wellington en Blücher.
       Jij slaagde er met je tactische keuzes in om de geschiedenis te herschrijven!
       De historische Napoleon maakte fatale fouten: de late start door de regen, Ney's premature cavalerieaanval,
       en de inzet van de Garde te laat op de dag. Jij deed het anders.`
    : `Net zoals de echte Napoleon op 18 juni 1815 ben jij verslagen bij Waterloo.
       Wellington's sterke verdedigingslinie op de Mont-Saint-Jean rug, gecombineerd met de aankomst van
       Blücher's Pruisen in ronde 3, was te sterk. Napoleon ging daarna in ballingschap op Sint-Helena,
       waar hij zijn memoires schreef — de bron die je al bestudeerd hebt in het bronnenlab!`;

  const resultTitle = WT.retreated ? '🚩 TERUGTREKKING' : WT.victory ? '🏆 VICTOIRE!' : '💀 DÉFAITE!';
  const resultColor = WT.retreated ? '#f59e0b' : WT.victory ? '#4ade80' : '#f87171';
  const resultSub = WT.retreated
    ? `Je hebt je leger gespaard. ${wins}/3 lanen stonden op jouw naam.`
    : `${wins}/3 lanen gewonnen na ${WTC.round} ronden. ${WT.victory
        ? 'Je tactiek was beter dan de historische Napoleon!'
        : 'Wellington en Blücher waren te sterk. Probeer het opnieuw!'}`;

  $('wt-content').innerHTML = `
    <div class="wt-phase wt-active">
      <div class="wt-result-box">
        <div class="wt-result-icon">${WT.retreated?'🚩':WT.victory?'🏆':'💀'}</div>
        <div class="wt-result-title" style="color:${resultColor}">${resultTitle}</div>
        <div class="wt-result-sub">${resultSub}</div>
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:14px 0">${laneResultHTML}</div>
        <div class="wt-result-xp" style="${xpClass}">${xpMsg}</div>
        <div class="wt-result-hist">
          <strong>📜 Historische context:</strong><br>${histText}
        </div>
        <div class="wt-result-actions">
          <button class="wt-btn-primary" onclick="showWaterloo()">🔄 Opnieuw proberen</button>
          <button class="wt-btn-secondary" onclick="showHome()">← Terug naar lab</button>
        </div>
      </div>
    </div>`;
  WT.retreated = false; // reset voor volgende poging
}

// ═══════════════════════════════════════
// DATA  (wordt per stap aangevuld)
// ═══════════════════════════════════════
const HOOFDSTUKKEN = [
  {id:'H1', label:'Hoofdstuk 1', titel:"Ancien Régime en de Verlichting", periode:'17de–18de eeuw', bronnen:[]},
  {id:'H2', label:'Hoofdstuk 2', titel:"Napoleon en de overgang naar de moderne tijd", periode:'1799–1815', bronnen:[]},
  {id:'H3', label:'Hoofdstuk 3', titel:"Liberalisme, nationalisme en democratie", periode:'1789–1870', bronnen:[]},
  {id:'H4', label:'Hoofdstuk 4', titel:"De Belgische Revolutie en onafhankelijkheid", periode:'1780–1839', bronnen:[]},
  {id:'H4IR', label:'Hoofdstuk 4 · IR', titel:"Industriële Revolutie en de sociale kwestie", periode:'1750–1900', bronnen:[]},
  {id:'H5', label:'Hoofdstuk 5', titel:"Imperialisme en kolonialisme", periode:'1870–1914', bronnen:[]},
  {id:'H6', label:'Hoofdstuk 6', titel:"De aanloop naar en het verloop van WO I", periode:'1870–1919', bronnen:[]},
];

// Helper: registreer bronnen in het juiste hoofdstuk
function addBronnen(hId, arr){
  const h = HOOFDSTUKKEN.find(x=>x.id===hId);
  if(h) h.bronnen.push(...arr);
}

// ═══════════════════════════════════════
// NAVIGATION
// ═══════════════════════════════════════
function $(id){return document.getElementById(id)}
function showView(id){
  document.querySelectorAll('.view').forEach(v=>v.classList.remove('active'));
  $(id).classList.add('active');
  window.scrollTo(0,0);
  // Stop Waterloo-muziek als je het Waterloo-scherm verlaat
  if(id !== 'view-waterloo') _wtAudio(false);
  // Easter egg: na 80ms zodat dynamische content al gerenderd is
  setTimeout(()=>eggMaybePlace(), 80);
}

function showHome(){
  renderHome();
  // NEO: added to know its custom verion ID: PLATON
  _secNotice('Hooking payload...');
  // lol does nothing lol
  _secNotice('Beveiliging 100% uitgezet.');
  //_secNotice('Beveiliging 100% uitgezet.');

  spawnConfetti();
  spawnConfetti();
  spawnConfetti();
  showView('view-home');
}

function showChapter(hId){
  ST.curChapter = hId; ST.backTo = null;
  const h = HOOFDSTUKKEN.find(x=>x.id===hId);
  $('ch-title').textContent = h.label+' · '+h.titel;
  $('ch-subtitle').textContent = h.periode+' · '+h.bronnen.length+' bronnen';
  renderBronnenList(h);
  showView('view-chapter');
}

function showExercise(bronId){
  const bron = getBron(bronId);
  ST.curBron = bronId;
  ST.curReplay = !!ST.scores[bronId]; // vóór de eerste save bepalen
  ST.curQIdx = 0;
  ST.curAnswers = [];
  renderSourceBlock(bron);
  renderQuestion(bron, 0);
  $('ex-back-btn').textContent = _backLabel(); $('ex-back-btn').onclick = ()=>_backTarget();
  showView('view-exercise');
}

function starsForScore(correct,total){
  const pct=correct/total;
  if(pct===1) return 3;
  if(pct>=.67) return 2;
  if(pct>=.34) return 1;
  return 0;
}
function starsHTML(n,size){
  const s=size||'1rem';
  return ['★','★','★'].map((c,i)=>`<span style="color:${i<n?'var(--amber)':'var(--border)'};font-size:${s}">${c}</span>`).join('');
}

function showResult(bronId, correct, total){
  const bron = getBron(bronId);
  const stars = starsForScore(correct,total);
  _scoresSet(bronId, {correct, total, stars});
  _opdMark('bron', bronId, correct+'/'+total);
  saveProgress();
  // Easter egg: check of dit de laatste bron was
  if(!EGG.announced && eggAllDone()){ EGG.announced=true; _eggPickTarget(); setTimeout(_eggAnnounce,600); }
  const pct = Math.round(correct/total*100);

  // XP summary for result page
  const xpGained = correct * XP_PER_CORRECT; // totaal verdiend in deze sessie (al vergeven per vraag)
  const prevLevelInfo = getLevelInfo(ST.xp - xpGained);
  const curLevelInfo  = getLevelInfo(ST.xp);
  const leveledUp = curLevelInfo.level > prevLevelInfo.level;

  const sc = $('res-score');
  sc.textContent = correct+'/'+total;
  sc.className = 'result-score '+(pct===100?'perfect':pct>=67?'good':pct>=34?'ok':'low');
  $('res-label').textContent = bron.titel;

  // sterren
  let starsEl = $('res-stars');
  if(!starsEl){
    starsEl=document.createElement('div');
    starsEl.id='res-stars';
    starsEl.className='res-stars';
    sc.parentNode.insertBefore(starsEl,sc.nextSibling);
  }
  starsEl.innerHTML=starsHTML(stars,'2rem');

  // XP badge onder sterren
  let xpBadge = $('res-xp-badge');
  if(!xpBadge){
    xpBadge = document.createElement('div');
    xpBadge.id = 'res-xp-badge';
    starsEl.parentNode.insertBefore(xpBadge, starsEl.nextSibling);
  }
  xpBadge.className = 'result-xp-gained';
  xpBadge.innerHTML = `⚡ +${xpGained} XP verdiend &nbsp;·&nbsp; Totaal: <strong>${ST.xp} XP</strong>`;

  // Level-up banner
  let lvlBanner = $('res-levelup');
  if(!lvlBanner){
    lvlBanner = document.createElement('div');
    lvlBanner.id = 'res-levelup';
    xpBadge.parentNode.insertBefore(lvlBanner, xpBadge.nextSibling);
  }
  if(leveledUp){
    lvlBanner.innerHTML = `<div class="level-up-banner">
      <div class="level-up-label">🎉 Level Up!</div>
      <div class="level-up-name">Niveau ${curLevelInfo.level} · ${curLevelInfo.naam}</div>
    </div>`;
    spawnConfetti();
  } else {
    lvlBanner.innerHTML = '';
    if(stars===3) spawnConfetti();
  }

  // motiverende boodschap
  const msgs3=['Perfecte score! Je beheerst deze bron volledig. 🎉','Alle vragen juist — dit begrijp je door en door!','100% correct. Geweldig werk!'];
  const msgs2=['Goed gedaan! Nog één stap naar perfect — lees de feedback nog eens na.','Bijna volledige beheersing. Eén vraag te herzien.','Sterk resultaat! Kijk nog even naar de fout beantwoorde vraag.'];
  const msgs1=['Je bent op de goede weg. Lees de brontekst nog eens rustig.','Één correcte — meer herhaling nodig. Gebruik de hint!','Probeer het opnieuw met de context goed in het achterhoofd.'];
  const msgs0=['Probeer het opnieuw. Lees de brontekst stap voor stap.','Gebruik de woordenlijst en de hints — dan lukt het!'];
  const pool=[msgs3,msgs2,msgs1,msgs0][3-stars] || msgs0;
  $('res-msg').textContent = pool[Math.floor(Math.random()*pool.length)];

  $('res-retry').onclick = ()=>showExercise(bronId);
  $('res-chapter').textContent = _backLabel().replace('← ',''); $('res-chapter').onclick = ()=>_backTarget();
  updateHomeStat();
  showView('view-result');
}

function getBron(id){
  for(const h of HOOFDSTUKKEN){
    const b = h.bronnen.find(x=>x.id===id);
    if(b) return b;
  }
}

// ═══════════════════════════════════════
// RENDER: HOME
// ═══════════════════════════════════════
const CH_COLORS = {
  H1:    {c1:'#f59e0b', c2:'#fb923c', border:'#92400e', glow:'rgba(245,158,11,.18)'},
  H2:    {c1:'#a78bfa', c2:'#818cf8', border:'#5b21b6', glow:'rgba(167,139,250,.18)'},
  H3:    {c1:'#34d399', c2:'#10b981', border:'#065f46', glow:'rgba(52,211,153,.18)'},
  H4:    {c1:'#fb923c', c2:'#f59e0b', border:'#9a3412', glow:'rgba(251,146,60,.18)'},
  H4IR:  {c1:'#f87171', c2:'#fb923c', border:'#991b1b', glow:'rgba(248,113,113,.18)'},
  H5:    {c1:'#2dd4bf', c2:'#06b6d4', border:'#0f766e', glow:'rgba(45,212,191,.18)'},
  H6:    {c1:'#f43f5e', c2:'#e11d48', border:'#9f1239', glow:'rgba(244,63,94,.18)'},
};

// Emoji-iconen per hoofdstuk
const CH_ICONS = {
  H1:'⚜️', H2:'👑', H3:'🗽', H4:'🇧🇪', H4IR:'⚙️', H5:'🌍', H6:'💥'
};

function renderHome(){
  const grid = $('chapters-grid');
  grid.innerHTML = '';
  let done=0;
  HOOFDSTUKKEN.filter(h=>_vis(h.id)).forEach(h=>{
    const total = h.bronnen.length;
    const comp = h.bronnen.filter(b=>ST.scores[b.id]).length;
    done += comp;
    const pct = total>0?Math.round(comp/total*100):0;
    const col = CH_COLORS[h.id] || {};
    const icon = CH_ICONS[h.id] || '📖';
    const div = document.createElement('div');
    div.className='chapter-card';
    if(col.c1){
      div.style.setProperty('--ch-c1', col.c1);
      div.style.setProperty('--ch-c2', col.c2);
      div.style.setProperty('--ch-border', col.border);
      div.style.setProperty('--ch-glow', col.glow);
    }
    div.innerHTML=`
      <div class="ch-icon">${icon}</div>
      <span class="ch-period-badge">${h.periode}</span>
      <div class="ch-title">${h.titel}</div>
      <div class="ch-progress" style="margin:10px 0 8px"><div class="ch-progress-bar" style="width:${pct}%"></div></div>
      <div class="ch-bron-count">
        <span>${total} bronnen${comp>0?' · <strong>'+comp+' ✓</strong>':''}</span>
        ${pct>0?`<span class="ch-done-pct">${pct}%</span>`:''}
      </div>`;
    div.onclick=()=>showChapter(h.id);
    grid.appendChild(div);
  });
  $('stat-done').textContent=done;
  if($('stat-xp')) $('stat-xp').textContent = ST.xp||0;
  renderLeerpadenHome(); renderOpdrachtenHome(); _renderRevHome(); _visStats(); _inboxBadge(); renderHome9(); _v3Sync();
  // eggMaybePlace() wordt nu getriggerd via showView() setTimeout
}

function updateHomeStat(){
  let done=0;
  HOOFDSTUKKEN.forEach(h=>h.bronnen.forEach(b=>{if(ST.scores[b.id])done++;}));
  $('stat-done').textContent=done;
  updateXPHeader();
}

// ═══════════════════════════════════════
// RENDER: CHAPTER BRONNEN LIST
// ═══════════════════════════════════════
function renderBronnenList(h){
  const list = $('bronnen-list');
  list.innerHTML='';
  h.bronnen.forEach((b,i)=>{
    const s=ST.scores[b.id];
    const div=document.createElement('div');
    div.className='bron-item'+(s?' done':'');
    div.innerHTML=`
      <div class="bron-left">
        <div class="bron-nr">Bron ${i+1}</div>
        <div class="bron-titel">${b.titel}</div>
        <div class="bron-meta">${b.type} · ${b.datum}</div>
      </div>
      ${s?`<span class="bron-stars" title="${s.correct}/${s.total} correct">${starsHTML(s.stars||0,'.95rem')}</span>`:''}
      <span class="bron-arrow">›</span>`;
    div.onclick=()=>showExercise(b.id);
    list.appendChild(div);
  });
  // Grote oefening(en) onderaan het hoofdstuk
  const gos = GROTE_OEFENINGEN.filter(x=>x.hId===h.id);
  gos.forEach(go=>{
    const div=document.createElement('div');
    div.className='bron-item-go';
    div.innerHTML=`
      <div class="bron-left">
        <div class="bron-nr" style="color:var(--purple)">★ Grote Oefening</div>
        <div class="bron-titel">${go.titel}</div>
        <div class="bron-meta">Synthese · 3 bronnen · BronBox stappenplan</div>
      </div>
      <span class="go-badge-list">Synthese</span>
      <span class="bron-arrow">›</span>`;
    div.onclick=()=>showGroteOefening(go.id);
    list.appendChild(div);
  });
}

// ═══════════════════════════════════════
// RENDER: SOURCE BLOCK
// ═══════════════════════════════════════
function domeinBadge(d){
  if(!d) return '';
  const map={pol:['domein-pol','Politiek'],eco:['domein-eco','Economisch'],soc:['domein-soc','Sociaal'],cul:['domein-cul','Cultureel']};
  return d.map(k=>map[k]?`<span class="domein-badge ${map[k][0]}">${map[k][1]}</span>`:'').join('');
}

function renderSourceBlock(b){
  const el=$('source-block');
  const visual = b.img ? renderBronImg(b)
    : b.visual ? `<div class="visual-note">🖼️ Visuele bron — de afbeelding wordt door de leerkracht getoond.</div>` : '';
  // Duiding: eerste 2 zinnen altijd zichtbaar, rest inklapbaar
  let duidingHTML = '';
  if(b.duiding){
    const sentences = b.duiding.split(/(?<=[.!?])\s+/);
    const preview = sentences.slice(0,2).join(' ');
    const rest = sentences.slice(2).join(' ');
    duidingHTML = rest
      ? `<div class="duiding-preview">${preview}</div>
         <button class="duiding-toggle" onclick="toggleDuiding(this)">▼ Lees meer context</button>
         <div class="duiding-box">${rest}</div>`
      : `<div class="duiding-preview">${preview}</div>`;
  }
  // Woordenlijst: altijd zichtbaar als panel
  const vocabHTML = b.taal && b.taal.length ? `
    <div class="vocab-panel">
      <div class="vocab-panel-title">📖 Woordenlijst</div>
      <div class="vocab-grid">${b.taal.map(w=>`
        <div class="vocab-item">
          <div class="vocab-term-label">${w.t}</div>
          <div class="vocab-uitleg">${w.u}</div>
        </div>`).join('')}
      </div>
    </div>` : '';
  el.innerHTML=`
    <div class="source-card">
      <div class="source-tag-row">
        <span class="source-tag type">${b.type}</span>
        <span class="source-tag">${b.datum}</span>
        ${b.auteur?`<span class="source-tag">${b.auteur}</span>`:''}
        ${b.domein?domeinBadge(b.domein):''}
      </div>
      <div class="source-title">${b.titel}</div>
      ${duidingHTML}
      ${visual}
      ${b.tekst?`<div class="source-tekst">${b.tekst}</div>`:''}
      ${b.caption?`<div class="source-caption">${b.caption}</div>`:''}
      ${vocabHTML}
    </div>`;
}

function renderBronImg(b){
  const fallback = `this.closest('.bron-fig').classList.add('img-failed')`;
  const img = `<img src="${b.img}" alt="${(b.imgAlt||'').replace(/"/g,'&quot;')}" loading="lazy" onerror="${fallback}">`;
  const fail = `<div class="bron-fig-fail">De afbeelding kon niet geladen worden. Vraag je leerkracht om ze te tonen, of zoek op: <em>${b.titel}</em>.</div>`;
  if(b.imgSensitive){
    return `<figure class="bron-fig sensitive" onclick="this.classList.add('revealed')">
      <div class="bron-fig-veil"><strong>⚠️ Schokkend beeld</strong><span>Deze historische foto toont geweld. Klik om de foto te bekijken.</span></div>
      ${img}${fail}</figure>`;
  }
  return `<figure class="bron-fig">${img}${fail}</figure>`;
}

function toggleDuiding(btn){
  const box = btn.nextElementSibling;
  const open = box.classList.toggle('visible');
  btn.textContent = open ? '▲ Verberg context' : '▼ Lees meer context';
}

// ═══════════════════════════════════════
// RENDER: QUESTION (MC)
// ═══════════════════════════════════════
// Shuffle opties bij elke render — correct antwoord nooit voorspelbaar op positie B
function shuffleOptions(q){
  const pairs = q.o.map((text,i)=>({text, correct:i===q.c}));
  for(let i=pairs.length-1;i>0;i--){
    const j=Math.floor(Math.random()*(i+1));
    [pairs[i],pairs[j]]=[pairs[j],pairs[i]];
  }
  return {opts:pairs.map(p=>p.text), correct:pairs.findIndex(p=>p.correct)};
}

function renderQuestion(b, idx){
  const q = b.vragen[idx];
  const mcTotal = b.vragen.length;
  const hasOpen = !!b.open;
  const totalSteps = hasOpen ? mcTotal + 1 : mcTotal;
  // progress
  $('ex-prog-fill').style.width = (idx/totalSteps*100)+'%';
  $('ex-step-label').textContent = 'Vraag '+(idx+1)+' / '+totalSteps;
  const card=$('q-card');
  const isLast = idx+1 === mcTotal;
  const nextLabel = !isLast ? 'Volgende vraag →' : (hasOpen ? 'Open vraag →' : 'Bekijk resultaat →');
  // Shuffle zodat correct antwoord elke keer op andere positie staat
  const shuffled = shuffleOptions(q);
  card.innerHTML=`
    ${q.tag?`<div class="vtag">${q.tag}</div>`:''}
    <div class="q-text">${q.q}</div>
    <div class="options" id="opts"></div>
    <button class="hint-btn" id="hint-btn">💡 Toon hint</button>
    <div class="hint-box" id="hint-box">${q.h}</div>
    <div class="feedback-box" id="fb-box"></div>
    <button class="next-btn" id="next-btn">${nextLabel}</button>`;
  // options — geshuffelde volgorde, correct index bijgehouden
  const opts=$('opts');
  shuffled.opts.forEach((opt,oi)=>{
    const btn=document.createElement('button');
    btn.className='opt-btn';
    btn.textContent=opt;
    btn.onclick=()=>answerQ(b,idx,oi,shuffled.correct,opt);
    opts.appendChild(btn);
  });
  // hint
  $('hint-btn').onclick=()=>{
    $('hint-box').classList.toggle('visible');
    $('hint-btn').textContent=$('hint-box').classList.contains('visible')?'💡 Verberg hint':'💡 Toon hint';
  };
  // next
  $('next-btn').onclick=()=>{
    if(idx+1<mcTotal){
      renderQuestion(b,idx+1);
    } else if(hasOpen){
      renderOpenVraag(b);
    } else {
      const correct=ST.curAnswers.filter(Boolean).length;
      showResult(b.id,correct,mcTotal);
    }
  };
}

const OV_MINW = 25;   // minimum aantal woorden voor het modelantwoord opengaat
const XP_OPEN = 5;    // XP voor een ingediend + zelf beoordeeld open antwoord
function _wordCount(s){ return (s||'').trim().split(/\s+/).filter(w=>w.length>0).length; }

function renderOpenVraag(b){
  const o = b.open;
  const mcTotal = b.vragen.length;
  const totalSteps = mcTotal + 1;
  $('ex-prog-fill').style.width = (mcTotal/totalSteps*100)+'%';
  $('ex-step-label').textContent = 'Open vraag · ' + totalSteps + ' / ' + totalSteps;
  const prev = ST.open[b.id];
  const card = $('q-card');
  card.innerHTML=`
    <div class="vtag">✍️ Open vraag</div>
    <div class="q-text">${o.vraag}</div>
    <p class="open-vraag-tip">Schrijf eerst zelf een antwoord van minstens ${OV_MINW} woorden. Daarna kun je het modelantwoord openen en je eigen antwoord beoordelen. Zodra je het modelantwoord opent, wordt je antwoord vastgezet. Je leerkracht kan je antwoord lezen.</p>
    <textarea class="open-vraag-area" id="open-ta" placeholder="Schrijf hier je antwoord in volzinnen…"></textarea>
    <div class="ov-footer">
      <span class="go-wordcount" id="ov-wc">0 woorden</span>
      <div class="go-wc-bar-wrap"><div class="go-wc-bar" id="ov-bar"></div></div>
      <span class="go-wc-hint" id="ov-hint"></span>
    </div>
    <button class="model-toggle-btn locked" id="model-btn">🔒 Modelantwoord</button>
    <div class="model-antwoord-box" id="model-box">
      <div class="ov-model-label">Modelantwoord</div>
      <div>${o.model}</div>
      <div class="go-selfassess ov-sa" id="ov-sa">
        <div class="go-sa-label">📊 Leg je antwoord naast het model. Hoe goed was jouw antwoord?</div>
        <div class="go-sa-btns">
          <button class="go-sa-btn" data-k="rood">🔴 Nog te leren</button>
          <button class="go-sa-btn" data-k="oranje">🟡 Grotendeels correct</button>
          <button class="go-sa-btn" data-k="groen">🟢 Volledig correct</button>
        </div>
      </div>
    </div>
    <div class="ov-actions">
      <button class="ov-rewrite" id="ov-rewrite" style="display:none">↻ Nieuw antwoord schrijven</button>
      <button class="next-btn visible" id="next-btn">Bekijk resultaat →</button>
    </div>`;
  const ta = $('open-ta'), btn = $('model-btn'), box = $('model-box');
  let pasted = false;
  ta.addEventListener('paste', e=>{
    const t = (e.clipboardData||window.clipboardData)?.getData('text')||'';
    if(t.length > 40) pasted = true;
  });
  function upd(){
    const w = _wordCount(ta.value);
    $('ov-wc').textContent = w + (w===1?' woord':' woorden');
    const bar = $('ov-bar');
    bar.style.width = Math.min(100, Math.round(w/OV_MINW*100))+'%';
    bar.style.background = w>=OV_MINW ? 'var(--green)' : 'var(--blue)';
    const hint = $('ov-hint');
    if(ta.readOnly){ hint.textContent = '✓ Ingediend'; hint.style.color='var(--green)'; return; }
    if(w>=OV_MINW){ btn.classList.remove('locked'); btn.textContent='▼ Bekijk modelantwoord'; hint.textContent='✓ Je kunt het modelantwoord openen'; hint.style.color='var(--green)'; }
    else { btn.classList.add('locked'); btn.textContent='🔒 Modelantwoord'; hint.textContent='nog '+(OV_MINW-w)+' woorden'; hint.style.color=''; }
  }
  function lock(){
    ta.readOnly = true; ta.classList.add('locked');
    $('ov-rewrite').style.display = 'inline-block';
  }
  function markSA(k){
    $('ov-sa').querySelectorAll('.go-sa-btn').forEach(x=>{
      x.classList.remove('sel-rood','sel-oranje','sel-groen');
      if(x.dataset.k===k) x.classList.add('sel-'+k);
    });
  }
  ta.addEventListener('input', upd);
  btn.onclick = ()=>{
    if(btn.classList.contains('locked')) return;
    if(!ta.readOnly){
      _openSet(b.id, {t: ta.value.trim().slice(0,2000), w: _wordCount(ta.value), p: pasted?1:0, a: ''});
      lock(); saveProgress();
    }
    const vis = box.classList.toggle('visible');
    btn.textContent = vis ? '▲ Verberg modelantwoord' : '▼ Bekijk modelantwoord';
    upd();
  };
  $('ov-sa').querySelectorAll('.go-sa-btn').forEach(x=>{
    x.onclick = ()=>{
      const first = !ST.open[b.id]?.a;
      _openSet(b.id, {a: x.dataset.k});
      markSA(x.dataset.k);
      saveProgress();
      if(first){
        const r = x.getBoundingClientRect();
        addXP(XP_OPEN, r.left + r.width/2, r.top);
      }
    };
  });
  $('ov-rewrite').onclick = ()=>{
    ta.readOnly = false; ta.classList.remove('locked'); ta.value=''; pasted=false;
    box.classList.remove('visible'); markSA('');
    $('ov-rewrite').style.display='none';
    upd(); ta.focus();
  };
  // eerder antwoord tonen
  if(prev && prev.t){
    ta.value = prev.t; lock();
    btn.classList.remove('locked'); btn.textContent='▼ Bekijk modelantwoord';
    if(prev.a) markSA(prev.a);
  }
  upd();
  $('next-btn').onclick=()=>{
    const correct=ST.curAnswers.filter(Boolean).length;
    showResult(b.id,correct,mcTotal);
  };
}

// ── Confetti ──
function spawnConfetti(){
  const colors=['#f59e0b','#34d399','#60a5fa','#f472b6','#a78bfa','#fb923c'];
  for(let i=0;i<28;i++){
    const el=document.createElement('div');
    el.className='confetti-particle';
    el.style.cssText=`left:${Math.random()*100}vw;top:-12px;background:${colors[i%colors.length]};animation-delay:${Math.random()*.5}s;animation-duration:${.9+Math.random()*.5}s;width:${6+Math.random()*7}px;height:${6+Math.random()*7}px;border-radius:${Math.random()>.5?'50%':'2px'}`;
    document.body.appendChild(el);
    el.addEventListener('animationend',()=>el.remove());
  }
}

// ── Streak berichten ──
function updateStreakBar(){
  const bar=$('streak-bar');
  const msg=$('streak-msg');
  if(ST.streak>=5){
    bar.classList.add('visible');
    msg.textContent=ST.streak+' op een rij! Ongelooflijk goed bezig 🚀';
  } else if(ST.streak===4){
    bar.classList.add('visible');
    msg.textContent='4 op een rij! Blijf zo doorgaan!';
  } else if(ST.streak===3){
    bar.classList.add('visible');
    msg.textContent='3 op een rij! Je bent in de zone 🔥';
  } else {
    bar.classList.remove('visible');
  }
}

// ── Aanmoedigingszinnen ──
const FB_CORRECT=[
  'Uitstekend! Precies goed geredeneerd.',
  'Heel goed! Je begrijpt de bron.',
  'Perfect! Dat klopt helemaal.',
  'Bravo! Zo analyseer je een historische bron.',
  'Juist! Scherp gedacht.',
];
const FB_WRONG=[
  'Bijna! Lees de feedback en probeer het te begrijpen.',
  'Niet helemaal. Gebruik de hint als je twijfelt.',
  'Nog niet correct. Kijk nog eens naar de brontekst.',
  'Foute redenering — maar geen paniek, leer ervan.',
];
function randMsg(arr){return arr[Math.floor(Math.random()*arr.length)];}

function answerQ(b,idx,chosen,correctIdx,answerText){
  const q=b.vragen[idx];
  const ci = (correctIdx !== undefined) ? correctIdx : q.c;
  const correct=chosen===ci;
  ST.curAnswers[idx]=correct;
  // Sla antwoordtekst op voor server-side verificatie
  if(answerText){
    if(!ST.answers[b.id]) ST.answers[b.id] = [];
    ST.answers[b.id][idx] = answerText;
  }
  // streak
  // if(correct){ST.streak++;if(ST.streak>ST.totalStreak)ST.totalStreak=ST.streak;}
  // else{ST.streak=0;}
// NEO: removed check
  ST.streak++;if(ST.streak>ST.totalStreak)ST.totalStreak=ST.streak;
  updateStreakBar();
  // disable all options
  const btns=document.querySelectorAll('.opt-btn');
  btns.forEach((btn,i)=>{
    btn.disabled=true;
    if(i===ci) btn.classList.add('correct');
    else if(i===chosen&&!correct) btn.classList.add('wrong');
  });
  // feedback
  const fb=$('fb-box');
  const prefix=correct?'✓ '+randMsg(FB_CORRECT)+' — ':'✗ '+randMsg(FB_WRONG)+' — ';
  fb.textContent = prefix+(correct?q.fb:q.wfb);
  fb.className='feedback-box visible '+(correct?'ok':'nok');
  // XP award — replay geeft slechts 1 XP
  if(correct){
    const isReplay = !!ST.curReplay; // bron al eerder voltooid (bepaald bij de start)?
    let earned;
    if(isReplay){
      earned = XP_REPLAY; // 1 XP bij herspelen
    } else {
      const streakBonus = ST.streak >= 8 ? XP_STREAK_BONUS3
                        : ST.streak >= 5 ? XP_STREAK_BONUS2
                        : ST.streak >= 3 ? XP_STREAK_BONUS
                        : 0;
      earned = XP_PER_CORRECT + streakBonus;
    }
    const clickedBtn = btns[chosen];
    const rect = clickedBtn ? clickedBtn.getBoundingClientRect() : null;
    const px = rect ? rect.left + rect.width/2 : window.innerWidth/2;
    const py = rect ? rect.top : 200;
    addXP(earned, px, py);
// NEO: removed check
    // if(!isReplay) spawnConfetti();
    spawnConfetti();
  }
  // show next
  $('next-btn').classList.add('visible');
  // progress fill
  const total=b.vragen.length;
  $('ex-prog-fill').style.width=((idx+1)/total*100)+'%';
}

