 {
  "id": "h5b2",
  "titel": "Rudyard Kipling — The White Man's Burden (1899)",
  "auteur": "Rudyard Kipling (1865-1936), Brits-Indisch schrijver",
  "type": "Gedicht (literaire bron)",
