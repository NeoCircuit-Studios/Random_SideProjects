<!DOCTYPE html>
<html lang="nl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>!BronnenLab · !Geschiedenis</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&family=Press+Start+2P&family=Bungee&family=Rubik:wght@500;600;700;800&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">
<!-- Supabase via directe REST API — geen CDN nodig -->
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  /* Warm dark palette — geïnspireerd op Montanja */
  --bg:#100f0d;
  --surface:#161412;
  --card:#1c1916;
  --card2:#22201c;
  --border:#2d2a25;
  --text:#f0ede6;
  --muted:#7a7268;

  /* Accent — Montanja oranje-koraal */
  --accent:#ff5729;
  --accent-bg:#2a1510;
  --accent-border:#6b2a18;
  --accent-light:#ff7a52;

  /* Secundaire kleuren */
  --blue:#4f9cf9;
  --blue-light:#7ab8ff;
  --blue-bg:#111e38;
  --blue-border:#1e3a6a;
  --green:#3ecf7a;
  --green-bg:#0c2a1a;
  --red:#f06565;
  --red-bg:#2c0f0f;
  --amber:#f0b429;
  --amber-bg:#271800;
  --purple:#b794ff;

  --radius:12px;
  --radius-sm:8px;
}
html{scroll-behavior:smooth}
body{
  font-family:'DM Sans',sans-serif;
  background:var(--bg);
  color:var(--text);
  min-height:100vh;
  line-height:1.7;
  font-size:16px;
  -webkit-font-smoothing:antialiased;
}

/* ── HEADER ── */
#header{
  position:sticky;top:0;z-index:100;
  background:rgba(16,15,13,.88);
  backdrop-filter:blur(16px);
  -webkit-backdrop-filter:blur(16px);
  border-bottom:1px solid var(--border);
  padding:0 28px;
  height:58px;
  display:flex;align-items:center;justify-content:space-between;
}
.logo{
  font-family:'Nunito',sans-serif;
  font-weight:800;font-size:1.05rem;
  color:var(--text);
  letter-spacing:-.2px;
  text-transform:uppercase;
}
.logo span{color:var(--muted);font-weight:700}
#header-right{display:flex;align-items:center;gap:10px}
.badge-df{
  font-family:'DM Sans',sans-serif;
  font-size:.7rem;font-weight:600;
  background:transparent;
  color:var(--muted);
  border:1px solid var(--border);
  padding:4px 10px;border-radius:6px;
  letter-spacing:.5px;text-transform:uppercase;
}
#btn-home{
  background:none;border:1px solid var(--border);
  color:var(--muted);font-family:'DM Sans',sans-serif;
  font-size:.82rem;font-weight:500;
  padding:5px 14px;border-radius:6px;
  cursor:pointer;transition:all .18s;letter-spacing:.2px;
}
#btn-home:hover{border-color:var(--accent);color:var(--accent)}

/* ── VIEWS ── */
.view{display:none;padding:32px 24px;max-width:900px;margin:0 auto}
.view.active{display:block}

/* ══════════════════════════════════════
   ── STAP 2: HOME REDESIGN
   ══════════════════════════════════════ */

/* Animated gradient background pulse */
@keyframes heroBg{
  0%,100%{background-position:0% 50%}
  50%{background-position:100% 50%}
}

/* ── HOME ── */
.home-hero{
  text-align:center;
  padding:56px 0 44px;
  position:relative;
}
.home-hero::before{
  content:'';position:absolute;
  top:-32px;left:50%;transform:translateX(-50%);
  width:600px;height:300px;
  background:radial-gradient(ellipse at center,rgba(79,156,249,.13) 0%,transparent 70%);
  pointer-events:none;
}
.home-hero-img{
  width:100%;max-width:300px;height:auto;
  border-radius:var(--radius);
  border:1px solid rgba(79,156,249,.3);
  box-shadow:0 24px 64px rgba(0,0,0,.6),0 0 40px rgba(79,156,249,.1);
  margin-bottom:36px;
  display:block;margin-left:auto;margin-right:auto;
  transition:transform .4s ease,box-shadow .4s ease;
}
.home-hero-img:hover{
  transform:translateY(-4px) scale(1.01);
  box-shadow:0 32px 72px rgba(0,0,0,.7),0 0 48px rgba(79,156,249,.18);
}
.home-hero h1{
  font-family:'Nunito',sans-serif;
  font-size:3.2rem;font-weight:800;
  line-height:1.05;margin-bottom:16px;
  text-transform:uppercase;
  letter-spacing:-.5px;
  color:var(--text);
}
.home-tagline{
  color:#a0b0cc;font-size:1.1rem;
  max-width:520px;margin:0 auto 36px;
  font-weight:500;line-height:1.6;
}

/* ── HOME INTRO ELEMENTS ── */
.home-klas-badge{
  display:inline-block;
  background:rgba(79,156,249,.12);
  border:1px solid rgba(79,156,249,.35);
  color:var(--blue-light);
  font-family:'Nunito',sans-serif;
  font-size:.78rem;font-weight:700;
  letter-spacing:.04em;text-transform:uppercase;
  border-radius:20px;padding:5px 14px;
  margin-bottom:20px;
}
.home-intro-card{
  background:var(--card);
  border:1px solid var(--border);
  border-radius:var(--radius);
  padding:28px 32px;
  max-width:680px;margin:0 auto 32px;
  border-top:3px solid var(--blue);
}
.home-intro-title{
  font-family:'Nunito',sans-serif;
  font-size:1.1rem;font-weight:800;
  color:var(--text);margin-bottom:12px;
}
.home-intro-tekst{
  font-size:.93rem;color:#a0b0cc;
  line-height:1.7;margin:0 0 10px;
}
.home-intro-skills{
  display:flex;flex-wrap:wrap;gap:8px;
  margin-top:16px;
}
.home-skill-chip{
  background:rgba(139,92,246,.1);
  border:1px solid rgba(139,92,246,.3);
  color:#c4b5fd;
  font-family:'Nunito',sans-serif;
  font-size:.75rem;font-weight:700;
  border-radius:20px;padding:5px 12px;
  white-space:nowrap;
}
.home-steps{
  display:flex;flex-direction:column;gap:12px;
  max-width:620px;margin:0 auto 40px;
}
.home-step{
  display:flex;align-items:flex-start;gap:16px;
  background:var(--card2);
  border:1px solid var(--border);
  border-radius:var(--radius);
  padding:16px 20px;
  transition:border-color .2s,transform .2s;
}
.home-step:hover{
  border-color:var(--blue-border);
  transform:translateX(4px);
}
.home-step-nr{
  flex-shrink:0;
  width:34px;height:34px;
  border-radius:50%;
  background:linear-gradient(135deg,var(--blue) 0%,var(--purple) 100%);
  display:flex;align-items:center;justify-content:center;
  font-family:'Nunito',sans-serif;font-weight:800;font-size:.95rem;
  color:#fff;margin-top:1px;
}
.home-step-body{ flex:1; }
.home-step-title{
  font-family:'Nunito',sans-serif;
  font-size:.95rem;font-weight:700;
  color:var(--text);margin-bottom:4px;
}
.home-step-desc{
  font-size:.83rem;color:var(--muted);line-height:1.6;
}

/* Stat cards — redesign */
.home-stats{
  display:flex;gap:14px;justify-content:center;flex-wrap:wrap;
  margin-bottom:52px;
}
.stat-card{
  background:var(--card);
  border:1px solid var(--border);
  border-radius:var(--radius);
  padding:16px 24px;
  text-align:center;
  min-width:110px;
  position:relative;overflow:hidden;
  transition:border-color .2s,transform .2s;
}
.stat-card:hover{
  border-color:var(--blue-border);
  transform:translateY(-2px);
}
.stat-card::after{
  content:'';position:absolute;
  bottom:0;left:0;right:0;height:2px;
  background:linear-gradient(90deg,var(--sc-c1,var(--blue)),var(--sc-c2,var(--purple)));
}
.stat-num{
  font-family:'Nunito',sans-serif;
  font-size:1.8rem;font-weight:800;
  color:var(--sc-c1,var(--blue-light));
  line-height:1.1;margin-bottom:4px;
}
.stat-lbl{
  font-size:.75rem;font-weight:600;
  color:var(--muted);letter-spacing:.4px;
  text-transform:uppercase;
  font-family:'Nunito',sans-serif;
}

/* Section header boven de grid */
.section-header{
  display:flex;align-items:center;gap:12px;
  margin-bottom:20px;
}
.section-title{
  font-family:'Nunito',sans-serif;
  font-size:1rem;font-weight:700;
  color:var(--text);letter-spacing:.2px;
}
.section-line{
  flex:1;height:1px;background:var(--border);
}

.chapters-grid{
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(268px,1fr));
  gap:16px;
}

/* Enhanced chapter card */
.chapter-card{
  padding:22px 20px 18px;
}
.ch-icon{
  font-size:1.4rem;margin-bottom:10px;line-height:1;
}
.ch-period-badge{
  display:inline-block;
  font-family:'Nunito',sans-serif;
  font-size:.68rem;font-weight:600;
  padding:2px 8px;border-radius:10px;
  border:1px solid var(--ch-border,var(--blue-border));
  color:var(--ch-c1,var(--blue-light));
  background:transparent;
  margin-bottom:10px;letter-spacing:.2px;
}
.ch-bron-count{
  font-size:.8rem;color:var(--muted);
  font-family:'Nunito',sans-serif;
  margin-top:10px;
  display:flex;align-items:center;justify-content:space-between;
}
.ch-done-pct{
  font-weight:700;color:var(--ch-c1,var(--blue));
  font-size:.78rem;
}
.chapter-card{
  background:var(--card);
  border:1px solid var(--border);
  border-radius:var(--radius);
  padding:22px 20px 18px;
  cursor:pointer;
  transition:border-color .2s,background .2s,transform .2s;
  position:relative;overflow:hidden;
}
.chapter-card::after{
  content:'';position:absolute;
  bottom:0;left:0;right:0;height:2px;
  background:var(--ch-c1,var(--accent));
  transform:scaleX(0);transform-origin:left;
  transition:transform .25s cubic-bezier(.22,.61,.36,1);
}
.chapter-card:hover{
  border-color:var(--ch-border,var(--border));
  background:var(--card2);
  transform:translateY(-2px);
}
.chapter-card:hover::after{transform:scaleX(1)}
.ch-label{
  font-family:'DM Sans',sans-serif;
  font-size:.68rem;font-weight:600;
  color:var(--muted);letter-spacing:.8px;
  text-transform:uppercase;margin-bottom:6px;
}
.ch-title{
  font-family:'Nunito',sans-serif;
  font-size:.98rem;font-weight:700;
  margin-bottom:8px;color:var(--text);
  letter-spacing:-.2px;
}
.ch-meta{font-size:.82rem;color:var(--muted)}
.ch-progress{
  margin-top:12px;height:4px;
  background:var(--border);border-radius:2px;overflow:hidden;
}
.ch-progress-bar{height:100%;background:var(--ch-c1,var(--blue));border-radius:2px;transition:width .4s}

/* ── CHAPTER VIEW ── */
.chapter-header{margin-bottom:28px}
.back-btn{
  display:inline-flex;align-items:center;gap:6px;
  background:none;border:none;color:var(--muted);
  font-family:'DM Sans',sans-serif;font-size:.9rem;
  cursor:pointer;padding:0;margin-bottom:16px;
  transition:color .2s;
}
.back-btn:hover{color:var(--blue-light)}
.chapter-title{
  font-family:'Nunito',sans-serif;
  font-size:1.7rem;font-weight:700;
  margin-bottom:6px;
}
.chapter-subtitle{color:var(--muted);font-size:.95rem}
.bronnen-list{display:flex;flex-direction:column;gap:12px}
.bron-item{
  background:var(--card);border:1px solid var(--border);
  border-radius:var(--radius);padding:16px 20px;
  cursor:pointer;transition:all .2s;
  display:flex;align-items:center;justify-content:space-between;
  gap:16px;
}
.bron-item:hover{border-color:var(--blue-border);background:var(--card2)}
.bron-item.done{border-color:var(--green);opacity:.8}
.bron-left{flex:1}
.bron-nr{
  font-family:'Nunito',sans-serif;
  font-size:.72rem;color:var(--blue);
  font-weight:600;letter-spacing:.5px;text-transform:uppercase;
  margin-bottom:3px;
}
.bron-titel{
  font-family:'Nunito',sans-serif;
  font-size:.98rem;font-weight:600;margin-bottom:2px;
}
.bron-meta{font-size:.8rem;color:var(--muted)}
.bron-score{
  font-family:'Nunito',sans-serif;
  font-size:.85rem;font-weight:600;
  color:var(--green);white-space:nowrap;
}
.bron-arrow{color:var(--muted);font-size:1.1rem}

/* ── EXERCISE VIEW ── */
.ex-header{margin-bottom:24px}
.ex-progress-wrap{
  display:flex;align-items:center;gap:12px;margin-bottom:20px;
}
.ex-progress-track{
  flex:1;height:6px;background:var(--border);
  border-radius:3px;overflow:hidden;
}
.ex-progress-fill{height:100%;background:var(--blue);border-radius:3px;transition:width .3s}
.ex-step{
  font-family:'Nunito',sans-serif;
  font-size:.82rem;color:var(--muted);white-space:nowrap;
}
.source-card{
  background:var(--card);border:1px solid var(--border);
  border-radius:var(--radius);padding:20px 24px;
  margin-bottom:24px;
}
.source-tag-row{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px}
.source-tag{
  font-size:.72rem;font-weight:500;
  padding:3px 10px;border-radius:20px;
  border:1px solid var(--border);color:var(--muted);
  font-family:'Nunito',sans-serif;letter-spacing:.2px;
}
.source-tag.type{background:var(--blue-bg);border-color:var(--blue-border);color:var(--blue-light)}
.source-title{
  font-family:'Nunito',sans-serif;
  font-size:1.05rem;font-weight:600;margin-bottom:10px;
}
.source-tekst{
  font-family:'DM Sans',sans-serif;
  font-style:normal;
  font-weight:400;
  font-size:1.02rem;line-height:2;
  color:#d8e2f0;
  background:#101828;
  border-left:4px solid var(--blue);
  border-radius:0 var(--radius-sm) var(--radius-sm) 0;
  padding:16px 20px;margin:12px 0;
}
.source-caption{font-size:.78rem;color:var(--muted);margin-top:6px}
.duiding-preview{
  font-size:.85rem;color:#a0b0cc;line-height:1.65;
  margin:8px 0 4px;padding:8px 12px;
  border-left:3px solid var(--purple);
  background:rgba(139,92,246,.06);
  border-radius:0 var(--radius-sm) var(--radius-sm) 0;
}
.visual-note{
  display:flex;align-items:center;gap:8px;
  background:var(--amber-bg);border:1px solid var(--amber);
  border-radius:var(--radius-sm);padding:10px 14px;
  font-size:.82rem;color:var(--amber);margin-top:10px;
}
.q-card{
  background:var(--card);border:1px solid var(--border);
  border-radius:var(--radius);padding:20px 24px;
}
.q-text{
  font-family:'Nunito',sans-serif;
  font-size:1.05rem;font-weight:600;
  margin-bottom:16px;line-height:1.5;
}
.options{display:flex;flex-direction:column;gap:10px;margin-bottom:16px}
.opt-btn{
  background:var(--card2);border:1px solid var(--border);
  border-radius:var(--radius-sm);padding:12px 16px;
  color:var(--text);font-family:'DM Sans',sans-serif;
  font-size:.92rem;text-align:left;cursor:pointer;
  transition:all .2s;line-height:1.5;
}
.opt-btn:hover:not(:disabled){border-color:var(--blue);background:var(--blue-bg)}
.opt-btn.correct{background:var(--green-bg);border-color:var(--green);color:#7ee787}
.opt-btn.wrong{background:var(--red-bg);border-color:var(--red);color:#ffa198}
.opt-btn:disabled{cursor:default}
.hint-btn{
  background:none;border:1px solid var(--border);
  color:var(--amber);font-family:'DM Sans',sans-serif;
  font-size:.82rem;padding:5px 14px;border-radius:20px;
  cursor:pointer;transition:all .2s;margin-bottom:12px;
}
.hint-btn:hover{border-color:var(--amber);background:var(--amber-bg)}
.hint-box{
  background:var(--amber-bg);border:1px solid var(--amber);
  border-radius:var(--radius-sm);padding:10px 14px;
  font-size:.85rem;color:var(--amber);margin-bottom:12px;
  display:none;
}
.hint-box.visible{display:block}
.feedback-box{
  border-radius:var(--radius-sm);padding:12px 16px;
  font-size:.88rem;line-height:1.6;margin-bottom:16px;
  display:none;
}
.feedback-box.visible{display:block}
.feedback-box.ok{background:var(--green-bg);border:1px solid var(--green);color:#7ee787}
.feedback-box.nok{background:var(--red-bg);border:1px solid var(--red);color:#ffa198}
.next-btn{
  background:var(--blue);color:#fff;
  font-family:'Nunito',sans-serif;
  font-weight:600;font-size:.95rem;
  border:none;border-radius:var(--radius-sm);
  padding:11px 28px;cursor:pointer;
  transition:background .2s;display:none;
}
.next-btn:hover{background:var(--blue-light)}
.next-btn.visible{display:inline-flex;align-items:center;gap:8px}

/* ── OPEN VRAAG ── */
.open-vraag-area{
  width:100%;min-height:110px;
  background:var(--bg);border:1px solid var(--border);
  border-radius:8px;padding:12px 14px;
  color:var(--fg);font-family:'DM Sans',sans-serif;font-size:.97rem;line-height:1.6;
  resize:vertical;margin:14px 0 12px;transition:border-color .2s;box-sizing:border-box;
}
.open-vraag-area:focus{outline:none;border-color:var(--purple)}
.open-vraag-area::placeholder{color:var(--fg-dim);opacity:.6}
.model-toggle-btn{
  display:inline-flex;align-items:center;gap:6px;
  background:none;border:1px solid var(--purple);
  color:var(--purple);font-family:'Nunito',sans-serif;
  font-size:.85rem;padding:8px 16px;border-radius:6px;
  cursor:pointer;margin-bottom:14px;transition:all .2s;
}
.model-toggle-btn:hover{background:rgba(168,85,247,.12)}
.model-antwoord-box{
  background:rgba(168,85,247,.08);border:1px solid rgba(168,85,247,.4);
  border-radius:8px;padding:14px 16px;margin-bottom:16px;
  color:var(--fg-dim);font-family:'DM Sans',sans-serif;font-size:.93rem;line-height:1.7;
  display:none;
}
.model-antwoord-box.visible{display:block}
.open-vraag-tip{
  font-size:.82rem;color:var(--fg-dim);margin-bottom:10px;
  font-style:italic;
}

/* ── STREAK ── */
.streak-bar{
  display:none;align-items:center;gap:8px;
  background:rgba(245,158,11,.12);border:1px solid var(--amber);
  border-radius:8px;padding:8px 14px;margin-bottom:14px;
  font-family:'Nunito',sans-serif;font-size:.88rem;color:var(--amber);
}
.streak-bar.visible{display:flex}
.streak-fire{font-size:1.2rem}
.streak-msg{font-weight:600}

/* ── STERREN ── */
.bron-stars{color:var(--amber);font-size:.9rem;letter-spacing:1px}
.res-stars{font-size:1.8rem;letter-spacing:3px;margin:8px 0}

/* ── CONFETTI ── */
.confetti-particle{
  position:fixed;width:8px;height:8px;border-radius:2px;
  pointer-events:none;z-index:9999;
  animation:confetti-fall 1.1s ease-in forwards;
}
@keyframes confetti-fall{
  0%{transform:translateY(-10px) rotate(0deg);opacity:1}
  100%{transform:translateY(100vh) rotate(720deg);opacity:0}
}

/* ══════════════════════════════════════
   ── STAP 3: XP-SYSTEEM & RESULTAAT
   ══════════════════════════════════════ */

/* Header XP widget */
.xp-widget{
  display:flex;align-items:center;gap:8px;
}
.xp-level-badge{
  font-family:'Nunito',sans-serif;
  font-size:.72rem;font-weight:700;
  background:#1a1f3a;border:1px solid var(--blue-border);
  color:var(--blue-light);padding:3px 9px;border-radius:12px;
  letter-spacing:.3px;white-space:nowrap;
}
.xp-bar-wrap{
  width:72px;height:6px;background:var(--border);
  border-radius:3px;overflow:hidden;
}
.xp-bar-fill{
  height:100%;border-radius:3px;
  background:linear-gradient(90deg,var(--blue),var(--purple));
  transition:width .5s cubic-bezier(.22,.61,.36,1);
}
.xp-count{
  font-family:'Nunito',sans-serif;
  font-size:.75rem;font-weight:600;
  color:var(--muted);white-space:nowrap;
}

/* XP gained popup */
@keyframes xpFloat{
  0%{opacity:0;transform:translateY(0) scale(.8)}
  25%{opacity:1;transform:translateY(-16px) scale(1.1)}
  75%{opacity:1;transform:translateY(-28px) scale(1)}
  100%{opacity:0;transform:translateY(-44px) scale(.9)}
}
.xp-popup{
  position:fixed;z-index:9998;
  font-family:'Nunito',sans-serif;
  font-size:1rem;font-weight:700;
  color:var(--amber);
  pointer-events:none;
  animation:xpFloat 1.3s ease forwards;
  text-shadow:0 2px 8px rgba(240,180,41,.4);
}

/* ── RESULT VIEW ── */
.result-wrap{text-align:center;padding:40px 0}
.result-score{
  font-family:'Nunito',sans-serif;
  font-size:3.5rem;font-weight:700;margin-bottom:8px;
}
.result-score.perfect{color:var(--green)}
.result-score.good{color:var(--blue-light)}
.result-score.ok{color:var(--amber)}
.result-score.low{color:var(--red)}
.result-label{
  font-family:'Nunito',sans-serif;
  font-size:1.1rem;color:var(--muted);margin-bottom:12px;
}

/* XP gained on result */
.result-xp-gained{
  display:inline-flex;align-items:center;gap:8px;
  background:rgba(240,180,41,.1);border:1px solid rgba(240,180,41,.35);
  border-radius:20px;padding:6px 18px;
  font-family:'Nunito',sans-serif;font-size:.9rem;font-weight:600;
  color:var(--amber);margin-bottom:24px;
}

/* Level-up banner */
@keyframes levelUpIn{
  from{opacity:0;transform:scale(.85) translateY(10px)}
  to{opacity:1;transform:scale(1) translateY(0)}
}
.level-up-banner{
  background:linear-gradient(135deg,#1a1f3a,#2d1a3e);
  border:2px solid var(--purple);border-radius:var(--radius);
  padding:16px 24px;max-width:400px;margin:0 auto 20px;
  text-align:center;
  animation:levelUpIn .5s cubic-bezier(.22,.61,.36,1) forwards;
  box-shadow:0 0 32px rgba(183,148,255,.2);
}
.level-up-label{
  font-family:'Nunito',sans-serif;
  font-size:.72rem;font-weight:700;letter-spacing:.8px;
  text-transform:uppercase;color:var(--purple);margin-bottom:4px;
}
.level-up-name{
  font-family:'Nunito',sans-serif;
  font-size:1.2rem;font-weight:700;color:var(--text);
}

.result-msg{
  background:var(--card);border:1px solid var(--border);
  border-radius:var(--radius);padding:20px 28px;
  max-width:480px;margin:0 auto 28px;
  font-size:.95rem;line-height:1.7;
}
.result-actions{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}
.btn-primary{
  background:var(--blue);color:#fff;
  font-family:'Nunito',sans-serif;font-weight:600;
  border:none;border-radius:var(--radius-sm);
  padding:11px 28px;cursor:pointer;font-size:.95rem;
  transition:background .2s;
}
.btn-primary:hover{background:var(--blue-light)}
.btn-sec{
  background:none;border:1px solid var(--border);
  color:var(--muted);font-family:'Nunito',sans-serif;
  font-weight:500;font-size:.95rem;
  padding:11px 24px;border-radius:var(--radius-sm);
  cursor:pointer;transition:all .2s;
}
.btn-sec:hover{border-color:var(--blue);color:var(--blue-light)}

/* ── DUIDING ── */
.duiding-toggle{
  display:inline-flex;align-items:center;gap:6px;
  background:none;border:1px solid var(--blue-border);
  color:var(--blue-light);font-family:'DM Sans',sans-serif;
  font-size:.8rem;padding:4px 12px;border-radius:20px;
  cursor:pointer;margin-top:8px;transition:all .2s;
}
.duiding-toggle:hover{background:var(--blue-bg)}
.duiding-box{
  background:var(--blue-bg);border:1px solid var(--blue-border);
  border-radius:var(--radius-sm);padding:10px 14px;
  font-size:.84rem;color:#93c5fd;line-height:1.7;
  margin-top:8px;display:none;
}
.duiding-box.visible{display:block}

/* ── TAALSTEUN ── */
/* ── WOORDENLIJST (altijd zichtbaar onder de brontekst) ── */
.vocab-panel{
  margin-top:14px;
  border-top:1px solid var(--border);
  padding-top:12px;
}
.vocab-panel-title{
  font-family:'Nunito',sans-serif;font-size:.72rem;font-weight:700;
  text-transform:uppercase;letter-spacing:.5px;
  color:var(--purple);margin-bottom:10px;
  display:flex;align-items:center;gap:6px;
}
.vocab-grid{
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(200px,1fr));
  gap:8px;
}
.vocab-item{
  background:var(--card2);border:1px solid var(--border);
  border-radius:var(--radius-sm);padding:9px 12px;
  border-left:3px solid var(--purple);
}
.vocab-term-label{
  font-family:'Nunito',sans-serif;font-size:.8rem;font-weight:700;
  color:#c4b5fd;margin-bottom:3px;
}
.vocab-uitleg{
  font-size:.78rem;color:var(--muted);line-height:1.5;
}

/* ── DOMEIN BADGE ── */
.domein-badge{
  font-size:.7rem;font-weight:600;
  padding:2px 8px;border-radius:12px;
  border:1px solid;font-family:'Nunito',sans-serif;
  letter-spacing:.2px;
}
.domein-pol{background:#1e293b;border-color:#3b82f6;color:#60a5fa}
.domein-eco{background:#1a2e1a;border-color:#22c55e;color:#86efac}
.domein-soc{background:#2d1f00;border-color:#f59e0b;color:#fcd34d}
.domein-cul{background:#2d1a2e;border-color:#a855f7;color:#d8b4fe}

/* ── VRAAGTYPE LABEL ── */
.vtag{
  display:inline-block;
  font-size:.68rem;font-weight:600;
  padding:2px 8px;border-radius:10px;
  background:var(--card2);border:1px solid var(--border);
  color:var(--muted);font-family:'Nunito',sans-serif;
  margin-bottom:8px;letter-spacing:.3px;text-transform:uppercase;
}

@media(max-width:600px){
  .home-hero h1{font-size:1.8rem}
  .view{padding:20px 16px}
  #header{padding:0 12px}
  .chapters-grid{grid-template-columns:1fr}
  .xp-bar-wrap{display:none}
  .xp-count{display:none}
  .home-stats{gap:10px}
  .stat-card{min-width:80px;padding:12px 14px}
  .stat-num{font-size:1.5rem}
}

/* ── GROTE OEFENING (lijstkaart in hoofdstuk) ── */
.bron-item-go{
  background:linear-gradient(135deg,#1a1f3a,#1c2333);
  border:1px solid var(--blue-border);
  border-radius:var(--radius);padding:16px 20px;
  cursor:pointer;transition:all .2s;
  display:flex;align-items:center;justify-content:space-between;
  gap:16px;position:relative;overflow:hidden;
}
.bron-item-go::before{
  content:'';position:absolute;top:0;left:0;right:0;height:3px;
  background:linear-gradient(90deg,var(--blue),var(--purple));
}
.bron-item-go:hover{
  border-color:var(--purple);
  transform:translateY(-2px);box-shadow:0 8px 24px rgba(167,139,250,.15);
}
.go-badge-list{
  font-family:'Nunito',sans-serif;
  font-size:.7rem;font-weight:700;letter-spacing:.5px;text-transform:uppercase;
  background:#2d1a3e;border:1px solid var(--purple);color:var(--purple);
  padding:3px 10px;border-radius:20px;white-space:nowrap;
}

/* ══════════════════════════════════════
   ── STAP 1: VIEW-ANIMATIES & TRANSITIES
   ══════════════════════════════════════ */

/* View entrance */
@keyframes viewEnter{
  from{opacity:0;transform:translateY(20px)}
  to{opacity:1;transform:translateY(0)}
}
.view.active{
  animation:viewEnter .35s cubic-bezier(.22,.61,.36,1) forwards;
}

/* Correct answer pop */
@keyframes correctPop{
  0%{transform:scale(1)}
  35%{transform:scale(1.03)}
  60%{transform:scale(.98)}
  100%{transform:scale(1)}
}
.opt-btn.correct{
  animation:correctPop .45s ease forwards;
}

/* Wrong answer shake */
@keyframes wrongShake{
  0%,100%{transform:translateX(0)}
  20%{transform:translateX(-6px)}
  40%{transform:translateX(6px)}
  60%{transform:translateX(-4px)}
  80%{transform:translateX(4px)}
}
.opt-btn.wrong{
  animation:wrongShake .4s ease forwards;
}

/* Staggered card entrance */
@keyframes cardSlideUp{
  from{opacity:0;transform:translateY(24px)}
  to{opacity:1;transform:translateY(0)}
}
.chapter-card{
  animation:cardSlideUp .4s cubic-bezier(.22,.61,.36,1) both;
}
.chapter-card:nth-child(1){animation-delay:.05s}
.chapter-card:nth-child(2){animation-delay:.10s}
.chapter-card:nth-child(3){animation-delay:.15s}
.chapter-card:nth-child(4){animation-delay:.20s}
.chapter-card:nth-child(5){animation-delay:.25s}
.chapter-card:nth-child(6){animation-delay:.30s}
.chapter-card:nth-child(7){animation-delay:.35s}

/* Feedback box slide-in */
@keyframes feedbackSlide{
  from{opacity:0;transform:translateY(-8px)}
  to{opacity:1;transform:translateY(0)}
}
.feedback-box.visible{
  animation:feedbackSlide .28s ease forwards;
}

/* Source card entrance */
@keyframes sourceIn{
  from{opacity:0;transform:scale(.98)}
  to{opacity:1;transform:scale(1)}
}
.source-card{
  animation:sourceIn .3s ease forwards;
}

/* Bron-item hover lift */
.bron-item{
  transition:all .22s cubic-bezier(.22,.61,.36,1);
}
.bron-item:hover{
  transform:translateX(4px);
  border-color:var(--blue-border);
  background:var(--card2);
}

/* Progress fill smooth */
.ex-progress-fill{
  transition:width .4s cubic-bezier(.22,.61,.36,1);
}
.ch-progress-bar{
  transition:width .6s cubic-bezier(.22,.61,.36,1);
}

/* Hint & feedback pulse glow */
.hint-box.visible{
  box-shadow:0 0 14px rgba(240,180,41,.18);
}
.feedback-box.ok{
  box-shadow:0 0 16px rgba(62,207,122,.15);
}
.feedback-box.nok{
  box-shadow:0 0 16px rgba(240,101,101,.15);
}

/* ── GROTE OEFENING (oefenview) ── */
.go-titel{
  font-family:'Nunito',sans-serif;
  font-size:1.6rem;font-weight:700;
  background:linear-gradient(135deg,var(--blue-light),var(--purple));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
  margin-bottom:6px;line-height:1.3;
}
.go-meta{font-size:.85rem;color:var(--muted);margin-bottom:24px}
.go-vraag-card{
  background:linear-gradient(135deg,#1a2d4a,#2d1a3e);
  border:2px solid var(--blue-border);border-radius:var(--radius);
  padding:22px 26px;margin-bottom:28px;
}
.go-vraag-label{
  font-family:'Nunito',sans-serif;
  font-size:.72rem;font-weight:700;letter-spacing:.8px;
  text-transform:uppercase;color:var(--purple);margin-bottom:8px;
}
.go-vraag-tekst{
  font-family:'Nunito',sans-serif;
  font-size:1.2rem;font-weight:700;color:var(--text);line-height:1.45;
}
.go-bronnen-grid{
  display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));
  gap:12px;margin-bottom:28px;
}
.go-bron-card{
  background:var(--card);border:1px solid var(--border);
  border-radius:var(--radius-sm);padding:14px;
}
.go-bron-letter{
  font-family:'Nunito',sans-serif;
  font-size:.72rem;font-weight:700;letter-spacing:.5px;text-transform:uppercase;
  color:var(--blue);margin-bottom:4px;
}
.go-bron-titel{
  font-family:'Nunito',sans-serif;
  font-size:.88rem;font-weight:600;margin-bottom:3px;
}
.go-bron-meta{font-size:.78rem;color:var(--muted);margin-bottom:8px}
.go-bron-citaat{
  font-family:'Playfair Display',serif;font-style:italic;
  font-size:.82rem;color:#93c5fd;line-height:1.6;
  border-left:2px solid var(--blue-border);padding-left:10px;
}
.go-stappen{display:flex;flex-direction:column;gap:12px;margin-bottom:28px}
.go-stap{
  background:var(--card);border:1px solid var(--border);
  border-radius:var(--radius);overflow:hidden;
}
.go-stap-head{
  display:flex;align-items:center;gap:14px;padding:16px 20px;
  cursor:pointer;transition:background .2s;user-select:none;
}
.go-stap-head:hover{background:var(--card2)}
.go-stap-nr{
  width:32px;height:32px;border-radius:50%;
  background:var(--blue-bg);border:2px solid var(--blue-border);
  color:var(--blue-light);
  font-family:'Nunito',sans-serif;font-size:.9rem;font-weight:700;
  display:flex;align-items:center;justify-content:center;flex-shrink:0;
}
.go-stap-label{
  font-family:'Nunito',sans-serif;
  font-size:1rem;font-weight:600;flex:1;
}
.go-stap-chevron{color:var(--muted);font-size:1.2rem;transition:transform .25s;line-height:1}
.go-stap-chevron.open{transform:rotate(90deg)}
.go-stap-body{padding:0 20px;max-height:0;overflow:hidden;transition:max-height .35s ease,padding .35s}
.go-stap-body.open{max-height:5000px;padding:0 20px 20px}
.go-taak{font-size:.93rem;line-height:1.75;margin-bottom:12px;color:var(--text)}
.go-tip{
  background:var(--amber-bg);border:1px solid var(--amber);
  border-radius:var(--radius-sm);padding:10px 14px;
  font-size:.83rem;color:var(--amber);margin-bottom:12px;line-height:1.6;
}
.go-tip strong{display:block;font-family:'Nunito',sans-serif;font-size:.73rem;letter-spacing:.4px;text-transform:uppercase;margin-bottom:4px}
.go-model-btn{
  background:none;border:1px solid var(--border);
  color:var(--muted);font-family:'DM Sans',sans-serif;
  font-size:.82rem;padding:5px 14px;border-radius:20px;
  cursor:pointer;transition:all .2s;
}
.go-model-btn:hover{border-color:var(--green);color:var(--green)}
.go-model-box{
  background:var(--green-bg);border:1px solid var(--green);
  border-radius:var(--radius-sm);padding:12px 16px;
  font-size:.88rem;line-height:1.75;color:#7ee787;
  margin-top:10px;display:none;
}
.go-model-box.visible{display:block}
/* ── Retrieval-input (Wijze Lessen: ophalen vóór feedback) ── */
.go-input-area{margin:14px 0 10px}
.go-input-label{
  font-family:'Nunito',sans-serif;font-size:.73rem;font-weight:700;
  letter-spacing:.4px;text-transform:uppercase;
  color:var(--blue-light);margin-bottom:6px;
  display:flex;align-items:center;gap:6px;
}
.go-textarea{
  width:100%;min-height:110px;background:var(--bg);
  border:1px solid var(--border);border-radius:var(--radius-sm);
  padding:12px 14px;color:var(--text);
  font-family:'DM Sans',sans-serif;font-size:.9rem;line-height:1.65;
  resize:vertical;box-sizing:border-box;transition:border-color .2s;
}
.go-textarea:focus{outline:none;border-color:var(--blue);box-shadow:0 0 0 2px var(--blue-bg)}
.go-input-footer{
  display:flex;align-items:center;gap:8px;
  margin-top:5px;margin-bottom:12px;flex-wrap:wrap;
}
.go-wordcount{
  font-size:.78rem;font-weight:700;
  color:var(--blue-light);font-family:'Nunito',sans-serif;
  min-width:70px;
}
.go-wc-bar-wrap{
  flex:1;height:4px;background:var(--border);
  border-radius:2px;max-width:140px;overflow:hidden;
}
.go-wc-bar{height:4px;width:0%;background:var(--blue);border-radius:2px;transition:width .3s,background .3s}
.go-wc-hint{font-size:.75rem;color:var(--muted);font-style:italic}
.go-model-btn.locked{opacity:.38;cursor:not-allowed;pointer-events:none}
/* ── Zelfbeoordeling (metacognitie) ── */
.go-selfassess{
  margin-top:16px;padding-top:14px;
  border-top:1px solid rgba(255,255,255,.08);
}
.go-sa-label{
  font-family:'Nunito',sans-serif;font-size:.72rem;font-weight:700;
  letter-spacing:.4px;text-transform:uppercase;
  color:var(--muted);margin-bottom:10px;
}
.go-sa-btns{display:flex;gap:8px;flex-wrap:wrap}
.go-sa-btn{
  border:1px solid var(--border);background:none;color:var(--text);
  font-family:'DM Sans',sans-serif;font-size:.82rem;
  padding:6px 14px;border-radius:20px;cursor:pointer;transition:all .2s;
}
.go-sa-btn:hover{background:var(--card2)}
.go-sa-btn.sel-rood{background:#3d1515;border-color:#f87171;color:#f87171}
.go-sa-btn.sel-oranje{background:#3d2a0a;border-color:#fb923c;color:#fb923c}
.go-sa-btn.sel-groen{background:var(--green-bg);border-color:var(--green);color:#7ee787}
.go-stap-nr.ass-rood{background:#3d1515!important;border-color:#f87171!important;color:#f87171!important}
.go-stap-nr.ass-oranje{background:#3d2a0a!important;border-color:#fb923c!important;color:#fb923c!important}
.go-stap-nr.ass-groen{background:var(--green-bg)!important;border-color:var(--green)!important;color:#7ee787!important}

/* ═══════════════════════════════════════════════
   WATERLOO GAME — knop & basis
═══════════════════════════════════════════════ */
#btn-waterloo{
  background:linear-gradient(135deg,#7c2d12,#b91c1c);
  border:none; color:#fef2f2; font-family:'Nunito',sans-serif;
  font-weight:800; font-size:.78rem; letter-spacing:.03em;
  padding:7px 14px; border-radius:8px; cursor:pointer;
  transition:transform .15s,box-shadow .15s,opacity .2s;
  box-shadow:0 2px 8px rgba(185,28,28,.4);
  opacity:.45; pointer-events:none;
}
#btn-waterloo.wt-ready{
  opacity:1; pointer-events:auto;
  animation:wt-pulse 2.5s ease-in-out infinite;
}
#btn-waterloo.wt-ready:hover{transform:scale(1.06);box-shadow:0 4px 16px rgba(185,28,28,.6)}
@keyframes wt-pulse{
  0%,100%{box-shadow:0 2px 8px rgba(185,28,28,.4)}
  50%{box-shadow:0 2px 20px rgba(239,68,68,.7)}
}

/* VIEW WATERLOO */
#view-waterloo{ max-width:860px; margin:0 auto; padding:24px 16px 60px; }

/* Phase containers */
.wt-phase{ display:none }
.wt-phase.wt-active{ display:block }

/* Back bar */
.wt-back-bar{
  display:flex; align-items:center; gap:12px; margin-bottom:28px;
  padding-bottom:14px; border-bottom:1px solid var(--border);
}
.wt-back-title{
  font-family:'Press Start 2P',monospace; font-size:.7rem;
  color:var(--amber); flex:1; letter-spacing:.03em;
}
.wt-back-budget{
  font-family:'Nunito',sans-serif; font-size:.85rem; color:var(--muted);
}
.wt-budget-val{ color:var(--amber); font-weight:800; }

/* Phase header */
.wt-phase-title{
  font-family:'Press Start 2P',monospace; font-size:.8rem;
  color:var(--text); margin-bottom:8px; letter-spacing:.02em;
}
.wt-phase-sub{
  font-size:.84rem; color:var(--muted); margin-bottom:24px; line-height:1.6;
}

/* ── SHOP ── */
.wt-shop-grid{
  display:grid; grid-template-columns:repeat(auto-fill,minmax(200px,1fr));
  gap:14px; margin-bottom:24px;
}
.wt-unit-card{
  background:var(--card); border:2px solid var(--border);
  border-radius:10px; padding:14px 14px 12px;
  display:flex; flex-direction:column; gap:6px;
  transition:border-color .2s, transform .15s;
  position:relative; overflow:hidden;
}
.wt-unit-card:hover{ border-color:var(--accent); transform:translateY(-2px); }
.wt-unit-card.wt-owned{ border-color:var(--amber)!important; }
.wt-unit-icon{ font-size:1.8rem; line-height:1; }
.wt-unit-name{ font-family:'Nunito',sans-serif; font-weight:800; font-size:.88rem; color:var(--text); }
.wt-unit-cost{ font-size:.78rem; color:var(--amber); font-weight:700; }
.wt-unit-stats{ display:flex; gap:8px; font-size:.72rem; color:var(--muted); }
.wt-unit-stat{ background:var(--bg); border-radius:4px; padding:2px 6px; }
.wt-unit-tip{ font-size:.72rem; color:var(--muted); line-height:1.4; font-style:italic; margin-top:2px; }
.wt-unit-type{
  font-size:.62rem; font-weight:700; letter-spacing:.05em; text-transform:uppercase;
  border-radius:4px; padding:2px 7px; display:inline-block; width:fit-content;
}
.wt-type-inf{ background:rgba(74,222,128,.12); color:#4ade80; border:1px solid rgba(74,222,128,.3); }
.wt-type-cav{ background:rgba(96,165,250,.12); color:#60a5fa; border:1px solid rgba(96,165,250,.3); }
.wt-type-art{ background:rgba(251,146,60,.12); color:#fb923c; border:1px solid rgba(251,146,60,.3); }
.wt-type-elit{ background:rgba(250,204,21,.12); color:#fbbf24; border:1px solid rgba(250,204,21,.3); }
.wt-unit-controls{
  display:flex; align-items:center; gap:8px; margin-top:4px;
}
.wt-qty-btn{
  width:28px; height:28px; border-radius:6px; border:1px solid var(--border);
  background:var(--bg); color:var(--text); font-size:1rem; font-weight:700;
  cursor:pointer; display:flex; align-items:center; justify-content:center;
  transition:background .15s;
}
.wt-qty-btn:hover{ background:var(--accent); color:#fff; border-color:var(--accent); }
.wt-qty-btn:disabled{ opacity:.3; cursor:not-allowed; }
.wt-qty-display{
  font-family:'Nunito',sans-serif; font-weight:800; font-size:1rem;
  min-width:20px; text-align:center; color:var(--text);
}
.wt-shop-footer{
  background:var(--card); border:1px solid var(--border); border-radius:10px;
  padding:16px 20px; display:flex; align-items:center; justify-content:space-between; gap:16px;
  flex-wrap:wrap;
}
.wt-spend-info{ font-size:.85rem; color:var(--muted); }
.wt-spend-info strong{ color:var(--text); font-weight:700; }
.wt-btn-primary{
  background:linear-gradient(135deg,#7c2d12,#b91c1c);
  color:#fff; border:none; border-radius:8px; padding:10px 22px;
  font-family:'Nunito',sans-serif; font-weight:800; font-size:.88rem;
  cursor:pointer; transition:transform .15s, box-shadow .15s;
  box-shadow:0 2px 10px rgba(185,28,28,.4);
}
.wt-btn-primary:hover:not(:disabled){ transform:scale(1.04); }
.wt-btn-primary:disabled{ opacity:.35; cursor:not-allowed; }
.wt-btn-secondary{
  background:var(--card); color:var(--muted); border:1px solid var(--border);
  border-radius:8px; padding:10px 18px;
  font-family:'Nunito',sans-serif; font-weight:700; font-size:.85rem;
  cursor:pointer; transition:border-color .15s, color .15s;
}
.wt-btn-secondary:hover{ border-color:var(--accent); color:var(--text); }

/* ── STEPPER ── */
.wt-stepper{
  display:flex; align-items:center; justify-content:center;
  gap:0; margin-bottom:28px; flex-wrap:wrap;
}
.wt-step{ display:flex; flex-direction:column; align-items:center; gap:4px; }
.wt-step-dot{
  width:32px; height:32px; border-radius:50%; border:2px solid var(--border);
  display:flex; align-items:center; justify-content:center;
  font-family:'Press Start 2P',monospace; font-size:.55rem;
  color:var(--muted); background:var(--card); transition:all .3s;
}
.wt-step-lbl{ font-size:.62rem; color:var(--muted); font-family:'Nunito',sans-serif; font-weight:700; white-space:nowrap; }
.wt-step-active .wt-step-dot{ border-color:var(--amber); color:var(--amber); background:rgba(251,191,36,.12); box-shadow:0 0 12px rgba(251,191,36,.3); }
.wt-step-active .wt-step-lbl{ color:var(--amber); }
.wt-step-done .wt-step-dot{ border-color:#4ade80; color:#4ade80; background:rgba(74,222,128,.1); }
.wt-step-done .wt-step-lbl{ color:#4ade80; }
.wt-step-line{ width:40px; height:2px; background:var(--border); margin:0 4px; margin-bottom:20px; transition:background .3s; }
.wt-step-line-done{ background:#4ade80; }

/* ── INTRO ── */
.wt-intro-hero{
  text-align:center; padding:32px 16px 24px;
  background:radial-gradient(ellipse at 50% 0%, rgba(185,28,28,.18) 0%, transparent 70%);
  border-radius:16px; margin-bottom:28px; position:relative; overflow:hidden;
}
.wt-intro-hero::before{
  content:''; position:absolute; inset:0;
  background:repeating-linear-gradient(0deg,transparent,transparent 3px,rgba(0,0,0,.06) 3px,rgba(0,0,0,.06) 4px);
  pointer-events:none;
}
.wt-intro-subtitle{ font-size:.75rem; color:var(--muted); margin-bottom:12px; font-family:'Nunito',sans-serif; }
.wt-intro-title{
  font-family:'Press Start 2P',monospace; font-size:1.1rem;
  background:linear-gradient(135deg,#fbbf24,#ef4444,#fbbf24);
  -webkit-background-clip:text; -webkit-text-fill-color:transparent;
  background-clip:text; margin-bottom:8px; line-height:1.4;
  animation:wt-title-glow 3s ease-in-out infinite;
}
@keyframes wt-title-glow{
  0%,100%{filter:drop-shadow(0 0 8px rgba(251,191,36,.4))}
  50%{filter:drop-shadow(0 0 20px rgba(239,68,68,.6))}
}
.wt-intro-date{ font-family:'Press Start 2P',monospace; font-size:.6rem; color:var(--muted); margin-bottom:24px; }
.wt-intro-story{
  font-size:.88rem; color:var(--text); line-height:1.8; max-width:600px;
  margin:0 auto 28px; font-style:italic; opacity:.9;
}
.wt-intro-warning{
  display:inline-block; background:rgba(248,113,113,.1); border:1px solid rgba(248,113,113,.35);
  color:#fca5a5; font-size:.8rem; font-weight:700; padding:8px 20px; border-radius:8px;
  font-family:'Nunito',sans-serif; margin-bottom:28px;
  animation:wt-warn-pulse 2s ease-in-out infinite;
}
@keyframes wt-warn-pulse{ 0%,100%{opacity:1} 50%{opacity:.7} }

/* Fase-kaarten */
.wt-intro-phases{ display:grid; grid-template-columns:repeat(4,1fr); gap:10px; margin-bottom:28px; }
@media(max-width:600px){ .wt-intro-phases{ grid-template-columns:repeat(2,1fr); } }
.wt-intro-phase-card{
  background:var(--card); border:1px solid var(--border); border-radius:10px;
  padding:14px 10px; text-align:center; transition:border-color .2s, transform .15s;
}
.wt-intro-phase-card:hover{ border-color:var(--accent); transform:translateY(-2px); }
.wt-ipc-num{ font-family:'Press Start 2P',monospace; font-size:.55rem; color:var(--muted); margin-bottom:6px; }
.wt-ipc-icon{ font-size:1.6rem; margin-bottom:6px; }
.wt-ipc-title{ font-family:'Nunito',sans-serif; font-weight:800; font-size:.8rem; color:var(--text); margin-bottom:4px; }
.wt-ipc-desc{ font-size:.7rem; color:var(--muted); line-height:1.5; }

/* Type-voordelen tabel */
.wt-matchup-title{
  font-family:'Press Start 2P',monospace; font-size:.65rem; color:var(--amber);
  margin-bottom:12px; text-align:center; letter-spacing:.04em;
}
.wt-matchup-grid{
  display:grid; grid-template-columns:repeat(2,1fr); gap:8px; margin-bottom:28px;
}
@media(max-width:500px){ .wt-matchup-grid{ grid-template-columns:1fr; } }
.wt-matchup-row{
  display:flex; align-items:center; gap:10px;
  background:var(--card); border:1px solid var(--border); border-radius:8px;
  padding:10px 12px;
}
.wt-matchup-icons{ font-size:1rem; white-space:nowrap; }
.wt-matchup-text{ font-size:.74rem; color:var(--text); flex:1; line-height:1.4; }
.wt-matchup-mod{ font-weight:800; font-size:.78rem; white-space:nowrap; }
.wt-mod-pos{ color:#4ade80; }
.wt-mod-neg{ color:#f87171; }

/* Tips */
.wt-tips-title{
  font-family:'Press Start 2P',monospace; font-size:.65rem; color:var(--amber);
  margin-bottom:12px; text-align:center; letter-spacing:.04em;
}
.wt-tips-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:8px; margin-bottom:32px; }
@media(max-width:500px){ .wt-tips-grid{ grid-template-columns:1fr; } }
.wt-tip-card{
  background:var(--card); border:1px solid rgba(251,191,36,.2); border-radius:8px;
  padding:10px 12px; font-size:.74rem; color:var(--muted); line-height:1.5;
}
.wt-tip-card strong{ color:var(--amber); display:block; margin-bottom:3px; font-family:'Nunito',sans-serif; }

/* Start-knop */
.wt-start-btn{
  display:block; width:100%; max-width:320px; margin:0 auto;
  background:linear-gradient(135deg,#7c2d12,#b91c1c,#7c2d12);
  background-size:200% 100%; color:#fff; border:none; border-radius:10px;
  padding:16px 32px; font-family:'Press Start 2P',monospace; font-size:.75rem;
  cursor:pointer; letter-spacing:.04em;
  box-shadow:0 4px 20px rgba(185,28,28,.5), 0 2px 0 rgba(0,0,0,.4);
  transition:transform .15s, box-shadow .15s;
  animation:wt-btn-shimmer 3s linear infinite;
}
@keyframes wt-btn-shimmer{ 0%{background-position:200% 0} 100%{background-position:-200% 0} }
.wt-start-btn:hover{ transform:scale(1.04) translateY(-2px); box-shadow:0 8px 28px rgba(185,28,28,.6), 0 2px 0 rgba(0,0,0,.4); }

/* ── COMBAT (tactische slag) ── */
.wt-combat-wrap{ display:flex; flex-direction:column; gap:0; }
.wt-combat-header{
  display:flex; align-items:center; justify-content:space-between;
  background:var(--card); border:1px solid var(--border); border-radius:10px;
  padding:12px 18px; margin-bottom:16px; gap:12px; flex-wrap:wrap;
}
.wt-round-badge{
  font-family:'Press Start 2P',monospace; font-size:.65rem;
  color:var(--amber); letter-spacing:.04em;
}
.wt-turn-badge{
  font-size:.78rem; font-weight:700; padding:4px 12px;
  border-radius:20px; font-family:'Nunito',sans-serif;
}
.wt-turn-napoleon{ background:rgba(185,28,28,.2); color:#fca5a5; border:1px solid rgba(185,28,28,.4); }
.wt-turn-wellington{ background:rgba(59,130,246,.2); color:#93c5fd; border:1px solid rgba(59,130,246,.4); }
.wt-attacks-left{ font-size:.8rem; color:var(--muted); font-family:'Nunito',sans-serif; }
.wt-attacks-left strong{ color:var(--amber); }
/* Slagveld grid */
.wt-combat-grid{
  display:grid; grid-template-columns:repeat(3,1fr); gap:10px;
}
.wt-combat-lane{
  background:rgba(20,30,15,.5); border:1px solid rgba(80,120,60,.25);
  border-radius:10px; overflow:hidden;
}
.wt-lane-header{
  background:rgba(30,45,20,.8); padding:7px 10px; text-align:center;
  border-bottom:1px solid rgba(80,120,60,.2);
}
.wt-lane-header-name{
  font-family:'Press Start 2P',monospace; font-size:.52rem;
  color:var(--amber); letter-spacing:.03em;
}
.wt-lane-header-sub{ font-size:.65rem; color:var(--muted); font-style:italic; margin-top:2px; }
/* Unit camps */
.wt-camp{ padding:8px; display:flex; flex-direction:column; gap:6px; min-height:90px; }
.wt-camp-napoleon{ background:linear-gradient(180deg,rgba(140,10,10,.18) 0%,rgba(100,10,10,.08) 100%); border-bottom:1px solid rgba(239,68,68,.2); }
.wt-camp-label{
  font-family:'Press Start 2P',monospace; font-size:.45rem; letter-spacing:.08em;
  padding:4px 8px; text-align:center; font-weight:700;
}
.wt-camp-label-napoleon{ color:rgba(252,165,165,.7); }
.wt-camp-label-wellington{ color:rgba(147,197,253,.7); }
.wt-camp-divider{
  display:flex; align-items:center; justify-content:center;
  font-size:.55rem; color:#f87171; font-family:'Press Start 2P',monospace;
  padding:5px 0; background:rgba(248,113,113,.06); letter-spacing:.05em;
  border-top:1px solid rgba(248,113,113,.1); border-bottom:1px solid rgba(248,113,113,.1);
}
.wt-camp-wellington{ background:linear-gradient(180deg,rgba(20,40,120,.08) 0%,rgba(10,20,100,.18) 100%); }
/* Unit tokens — redesigned */
.wt-token{
  background:var(--card); border:2px solid var(--border);
  border-radius:8px; padding:8px 10px; cursor:pointer;
  transition:border-color .15s, transform .12s, background .15s, box-shadow .15s;
  position:relative; overflow:visible;
}
.wt-token-napoleon{ background:rgba(60,10,10,.35); border-color:rgba(220,80,80,.4); }
.wt-token-wellington{ background:rgba(10,20,60,.35); border-color:rgba(80,130,220,.4); }
.wt-token-selectable{ border-color:rgba(252,165,165,.6)!important; }
.wt-token-selectable:hover{ border-color:var(--amber)!important; background:rgba(251,191,36,.1)!important; transform:translateY(-2px); box-shadow:0 4px 12px rgba(251,191,36,.2); }
.wt-token-selected{
  border-color:var(--amber)!important; background:rgba(251,191,36,.12)!important;
  box-shadow:0 0 16px rgba(251,191,36,.5)!important;
  animation:wt-sel-pulse .9s ease-in-out infinite alternate;
}
@keyframes wt-sel-pulse{
  from{box-shadow:0 0 8px rgba(251,191,36,.3)} to{box-shadow:0 0 22px rgba(251,191,36,.7)}
}
.wt-token-targetable{
  border-color:#f87171!important; background:rgba(248,113,113,.1)!important;
  cursor:crosshair; animation:wt-tgt-pulse .75s ease-in-out infinite alternate;
}
@keyframes wt-tgt-pulse{
  from{box-shadow:0 0 6px rgba(248,113,113,.25)} to{box-shadow:0 0 18px rgba(248,113,113,.6)}
}
.wt-token-dead{ opacity:.25; filter:grayscale(1); cursor:not-allowed; }
.wt-token-passive{ cursor:default; }
/* Hit + strike animations */
@keyframes wt-hit-flash{
  0%{background:rgba(248,113,113,.6)!important;transform:translateX(-3px)}
  25%{transform:translateX(3px)}
  50%{transform:translateX(-2px)}
  75%{transform:translateX(2px)}
  100%{background:inherit;transform:translateX(0)}
}
@keyframes wt-strike-flash{
  0%{box-shadow:0 0 0 rgba(251,191,36,0)} 30%{box-shadow:0 0 20px rgba(251,191,36,.9);transform:scale(1.04)} 100%{transform:scale(1)}
}
.wt-token-hit{ animation:wt-hit-flash .45s ease forwards!important; }
.wt-token-striking{ animation:wt-strike-flash .4s ease forwards!important; }
/* Token content */
.wt-token-row1{ display:flex; align-items:center; gap:6px; margin-bottom:4px; }
.wt-token-icon{ font-size:1.2rem; line-height:1; flex-shrink:0; }
.wt-token-name{ font-size:.7rem; font-weight:700; color:var(--text); flex:1; line-height:1.2; }
.wt-token-atk{ font-size:.68rem; font-weight:800; font-family:'Nunito',sans-serif; flex-shrink:0; }
.wt-token-atk-napoleon{ color:#fca5a5; }
.wt-token-atk-wellington{ color:#93c5fd; }
.wt-token-row2{ display:flex; align-items:center; gap:5px; margin-bottom:5px; flex-wrap:wrap; }
.wt-token-type-badge{
  font-size:.55rem; font-weight:700; text-transform:uppercase; letter-spacing:.05em;
  padding:1px 5px; border-radius:3px;
}
.wt-dmg-preview{
  font-size:.62rem; font-weight:800; padding:1px 5px; border-radius:3px;
  font-family:'Nunito',sans-serif; white-space:nowrap;
}
.wt-dmg-preview-pos{ background:rgba(74,222,128,.15); color:#4ade80; border:1px solid rgba(74,222,128,.3); }
.wt-dmg-preview-neg{ background:rgba(248,113,113,.15); color:#f87171; border:1px solid rgba(248,113,113,.3); }
.wt-dmg-preview-neu{ background:rgba(251,191,36,.12); color:#fbbf24; border:1px solid rgba(251,191,36,.3); }
/* HP display */
.wt-hp-bar-wrap{ background:rgba(0,0,0,.4); border-radius:4px; height:6px; overflow:hidden; }
.wt-hp-bar{ height:100%; border-radius:4px; transition:width .4s ease; }
.wt-token-hp-row{ display:flex; align-items:baseline; gap:3px; margin-top:4px; }
.wt-token-hp-num{ font-size:.85rem; font-weight:800; font-family:'Nunito',sans-serif; }
.wt-token-hp-max{ font-size:.6rem; color:var(--muted); }
/* Damage float */
.wt-dmg-float{
  position:absolute; top:-12px; left:50%; transform:translateX(-50%);
  font-size:1rem; font-weight:800; color:#f87171;
  font-family:'Nunito',sans-serif; pointer-events:none;
  animation:wt-float-up 1s ease forwards; z-index:20; white-space:nowrap;
  text-shadow:0 2px 4px rgba(0,0,0,.6);
}
@keyframes wt-float-up{
  0%{opacity:1;transform:translateX(-50%) translateY(0)}
  100%{opacity:0;transform:translateX(-50%) translateY(-36px)}
}
/* Advantage tag */
.wt-adv-tag{ font-size:.58rem; padding:1px 6px; border-radius:3px; font-weight:700; display:inline-block; margin-left:4px; }
.wt-adv-pos{ background:rgba(74,222,128,.15); color:#4ade80; }
.wt-adv-neg{ background:rgba(248,113,113,.15); color:#f87171; }
/* Combat log */
.wt-log{
  background:var(--card); border:1px solid var(--border); border-radius:8px;
  padding:10px 14px; font-size:.75rem; color:var(--muted); line-height:1.8;
  max-height:120px; overflow-y:auto; margin-top:12px; font-family:'DM Sans',sans-serif;
}
.wt-log-entry-napoleon{ color:#fca5a5; }
.wt-log-entry-wellington{ color:#93c5fd; }
.wt-log-entry-event{ color:var(--amber); font-weight:600; }
/* Wellington turn overlay banner */
.wt-turn-overlay{
  position:fixed; top:50%; left:50%; transform:translate(-50%,-50%);
  z-index:9999; pointer-events:none;
  animation:wt-overlay-pop .35s cubic-bezier(.175,.885,.32,1.275) forwards;
}
@keyframes wt-overlay-pop{
  from{opacity:0;transform:translate(-50%,-50%) scale(.7)}
  to{opacity:1;transform:translate(-50%,-50%) scale(1)}
}
.wt-turn-overlay-inner{
  font-family:'Press Start 2P',monospace; font-size:.9rem; padding:18px 32px;
  border-radius:14px; letter-spacing:.05em; text-align:center;
  box-shadow:0 12px 40px rgba(0,0,0,.7);
}
.wt-turn-overlay-napoleon{
  background:linear-gradient(135deg,#3d0a0a,#1a0505); border:2px solid #ef4444; color:#fca5a5;
  box-shadow:0 12px 40px rgba(239,68,68,.5);
}
.wt-turn-overlay-wellington{
  background:linear-gradient(135deg,#0a1a3d,#050a1a); border:2px solid #3b82f6; color:#93c5fd;
  box-shadow:0 12px 40px rgba(59,130,246,.5);
}
/* Footer */
.wt-combat-footer{
  display:flex; align-items:center; justify-content:space-between;
  gap:12px; flex-wrap:wrap; margin-top:12px;
  background:var(--card); border:1px solid var(--border);
  border-radius:10px; padding:12px 16px;
}
.wt-hint-box{ font-size:.78rem; color:var(--muted); flex:1; line-height:1.5; }
.wt-hint-box strong{ color:var(--text); }
/* Wellington turn active state */
.wt-wellington-active-hint{
  background:rgba(59,130,246,.08); border:1px solid rgba(59,130,246,.25);
  border-radius:8px; padding:8px 14px; font-size:.78rem; color:#93c5fd;
  text-align:center; font-weight:600; animation:wt-banner-in .3s ease;
  display:flex; align-items:center; justify-content:center; gap:8px;
}
.wt-ai-thinking{ display:inline-block; animation:wt-blink .7s step-end infinite; }
@keyframes wt-blink{ 50%{opacity:0} }
/* Prussian arrival banner */
.wt-prussian-banner{
  background:rgba(59,130,246,.1); border:1px solid rgba(59,130,246,.3);
  border-radius:8px; padding:10px 14px; font-size:.8rem; color:#93c5fd;
  font-weight:600; text-align:center; margin-bottom:10px;
  animation:wt-banner-in .4s ease;
}
@keyframes wt-banner-in{ from{opacity:0;transform:translateY(-8px)} to{opacity:1;transform:none} }

/* ── BATTLE + RESULT ── */
.wt-battle-wrap{ max-width:620px; margin:0 auto; }
.wt-events-stream{ display:flex; flex-direction:column; gap:10px; margin-bottom:24px; }
.wt-event-card{
  background:var(--card); border:1px solid var(--border); border-radius:10px;
  padding:14px 16px; opacity:0; transform:translateY(12px);
  transition:opacity .4s ease, transform .4s ease;
}
.wt-event-card.wt-show{ opacity:1; transform:none; }
.wt-event-card-top{ display:flex; gap:10px; align-items:flex-start; margin-bottom:6px; }
.wt-event-icon{ font-size:1.4rem; line-height:1; }
.wt-event-text{ font-size:.86rem; color:var(--text); font-weight:600; flex:1; line-height:1.4; }
.wt-event-hist{ font-size:.75rem; color:var(--muted); font-style:italic; line-height:1.4; }
.wt-event-effect{ font-size:.72rem; font-weight:700; padding:2px 8px; border-radius:4px; display:inline-block; margin-top:6px; }
.wt-effect-pos{ background:rgba(74,222,128,.15); color:#4ade80; border:1px solid rgba(74,222,128,.3); }
.wt-effect-neg{ background:rgba(248,113,113,.15); color:#f87171; border:1px solid rgba(248,113,113,.3); }
.wt-lane-results{ display:grid; grid-template-columns:repeat(3,1fr); gap:12px; margin-bottom:24px; }
.wt-lane-res{
  background:var(--card); border:2px solid var(--border); border-radius:10px;
  padding:14px 12px; text-align:center; opacity:0; transform:scale(.9);
  transition:opacity .4s ease, transform .4s ease;
}
.wt-lane-res.wt-show{ opacity:1; transform:scale(1); }
.wt-lane-res.wt-lane-win{ border-color:#4ade80; background:rgba(74,222,128,.08); }
.wt-lane-res.wt-lane-loss{ border-color:#f87171; background:rgba(248,113,113,.08); }
.wt-lane-res-name{ font-family:'Press Start 2P',monospace; font-size:.55rem; color:var(--muted); margin-bottom:6px; }
.wt-lane-res-verdict{ font-size:1.5rem; margin:4px 0; }
.wt-lane-res-score{ font-size:.75rem; color:var(--muted); }
.wt-final-banner{
  text-align:center; padding:28px; background:var(--card);
  border-radius:16px; margin-bottom:24px; opacity:0;
  transition:opacity .5s ease; border:2px solid var(--border);
}
.wt-final-banner.wt-show{ opacity:1; }
.wt-final-title{
  font-family:'Press Start 2P',monospace; font-size:1rem;
  margin-bottom:8px; letter-spacing:.04em;
}
.wt-final-sub{ font-size:.88rem; color:var(--muted); margin-bottom:20px; }
/* Result */
.wt-result-box{
  max-width:580px; margin:0 auto; text-align:center;
}
.wt-result-icon{ font-size:3.5rem; margin-bottom:12px; }
.wt-result-title{
  font-family:'Press Start 2P',monospace; font-size:.9rem;
  margin-bottom:12px; letter-spacing:.04em;
}
.wt-result-sub{ font-size:.88rem; color:var(--muted); line-height:1.6; margin-bottom:20px; }
.wt-result-xp{
  display:inline-block; background:rgba(251,191,36,.12); border:1px solid rgba(251,191,36,.4);
  color:var(--amber); font-weight:800; font-size:1rem;
  padding:10px 24px; border-radius:10px; margin-bottom:24px;
}
.wt-result-hist{
  background:var(--card); border:1px solid var(--border); border-radius:10px;
  padding:16px 20px; font-size:.82rem; color:var(--muted); line-height:1.7;
  text-align:left; margin-bottom:24px;
}
.wt-result-hist strong{ color:var(--text); }
.wt-result-actions{ display:flex; gap:12px; justify-content:center; flex-wrap:wrap; }

/* ── DEPLOY ── */
.wt-deploy-wrap{
  display:grid; grid-template-columns:180px 1fr; gap:16px; margin-bottom:20px;
}
@media(max-width:640px){.wt-deploy-wrap{grid-template-columns:1fr}}
.wt-army-panel{
  background:var(--card); border:1px solid var(--border); border-radius:10px;
  padding:12px; display:flex; flex-direction:column; gap:6px;
}
.wt-army-title{
  font-family:'Nunito',sans-serif; font-weight:800; font-size:.75rem;
  color:var(--muted); text-transform:uppercase; letter-spacing:.08em;
  margin-bottom:4px;
}
.wt-army-unit{
  display:flex; align-items:center; gap:8px; padding:7px 10px;
  border-radius:8px; border:2px solid transparent; cursor:pointer;
  transition:background .15s, border-color .15s;
  background:var(--bg);
}
.wt-army-unit:hover{ background:rgba(255,255,255,.06); }
.wt-army-unit.wt-sel{ border-color:var(--amber)!important; background:rgba(251,191,36,.08); }
.wt-army-unit.wt-exhausted{ opacity:.4; cursor:not-allowed; }
.wt-army-unit-icon{ font-size:1.2rem; }
.wt-army-unit-info{ flex:1; }
.wt-army-unit-name{ font-size:.72rem; font-weight:700; color:var(--text); }
.wt-army-unit-qty{
  font-size:.68rem; color:var(--muted);
}
/* battlefield */
.wt-bf-outer{ display:flex; flex-direction:column; gap:0; }
.wt-bf-lane-labels{
  display:grid; grid-template-columns:repeat(3,1fr); gap:8px;
  margin-bottom:4px;
}
.wt-bf-lane-label{
  text-align:center; font-family:'Press Start 2P',monospace;
  font-size:.55rem; color:var(--amber); letter-spacing:.03em; line-height:1.5;
}
.wt-bf-lane-label small{ display:block; font-family:'DM Sans',sans-serif;
  font-size:.7rem; color:var(--muted); font-style:italic; margin-top:2px; }
.wt-napoleon-grid{
  display:grid; grid-template-columns:repeat(3,1fr); gap:8px; margin-bottom:6px;
}
.wt-lane-col{ display:flex; flex-direction:column; gap:6px; }
.wt-slot{
  background:rgba(30,50,20,.5); border:2px dashed rgba(100,130,80,.4);
  border-radius:8px; min-height:64px; display:flex; flex-direction:column;
  align-items:center; justify-content:center; gap:3px;
  cursor:pointer; transition:border-color .15s, background .15s;
  position:relative;
}
.wt-slot:hover{ border-color:var(--amber); background:rgba(251,191,36,.08); }
.wt-slot.wt-slot-occupied{ border-style:solid; border-color:rgba(100,200,100,.5); background:rgba(30,80,30,.4); }
.wt-slot.wt-slot-highlight{ border-color:var(--amber); animation:wt-glow .8s ease-in-out infinite alternate; }
@keyframes wt-glow{ from{box-shadow:0 0 4px rgba(251,191,36,.3)} to{box-shadow:0 0 14px rgba(251,191,36,.7)} }
.wt-slot-row-label{
  font-size:.6rem; color:rgba(255,255,255,.3); text-transform:uppercase;
  letter-spacing:.08em; font-family:'Nunito',sans-serif;
}
.wt-slot-unit{ font-size:1.4rem; }
.wt-slot-unit-name{ font-size:.58rem; color:var(--text); font-weight:700; font-family:'Nunito',sans-serif; }
.wt-slot-remove{
  position:absolute; top:3px; right:5px; font-size:.65rem; color:var(--muted);
  cursor:pointer; padding:1px 4px; border-radius:3px;
}
.wt-slot-remove:hover{ color:#f87171; background:rgba(248,113,113,.15); }
/* divider */
.wt-bf-divider{
  text-align:center; padding:10px 0; font-family:'Press Start 2P',monospace;
  font-size:.55rem; color:#f87171; letter-spacing:.05em;
  border-top:1px dashed rgba(248,113,113,.3); border-bottom:1px dashed rgba(248,113,113,.3);
  margin:4px 0;
}
/* wellington row */
.wt-wellington-row{
  display:grid; grid-template-columns:repeat(3,1fr); gap:8px; margin-top:6px;
}
.wt-wel-card{
  background:rgba(30,40,80,.6); border:1px solid rgba(96,130,200,.3);
  border-radius:8px; padding:12px 10px; text-align:center;
}
.wt-wel-icon{ font-size:1.5rem; }
.wt-wel-name{ font-size:.72rem; font-weight:700; color:#93c5fd; font-family:'Nunito',sans-serif; margin:4px 0 2px; }
.wt-wel-def{ font-size:.68rem; color:var(--muted); }
.wt-wel-desc{ font-size:.63rem; color:var(--muted); font-style:italic; margin-top:4px; line-height:1.4; }
/* footer */
.wt-deploy-footer{
  display:flex; justify-content:space-between; align-items:center;
  gap:12px; flex-wrap:wrap; margin-top:4px;
}

/* ═══ EASTER EGG ═══ */
.egg-spark{
  position:absolute; font-size:1.6rem;
  cursor:pointer; z-index:50; user-select:none;
  animation:egg-blink 3s ease-in-out infinite;
  transition:transform .2s;
  pointer-events:all;
  filter:drop-shadow(0 0 4px rgba(251,191,36,.6));
}
.egg-spark:hover{ transform:scale(1.4) rotate(-10deg); }
@keyframes egg-blink{
  0%,100%{opacity:.35} 50%{opacity:1}
}
/* Gauntlet full-screen overlay */
.egg-gauntlet-wrap{
  position:fixed; inset:0; z-index:99999;
  background:rgba(0,0,0,.97);
  display:flex; align-items:center; justify-content:center;
  animation:egg-overlay-in .4s ease;
}
@keyframes egg-overlay-in{ from{opacity:0} to{opacity:1} }
.egg-gauntlet-inner{
  width:min(640px,96vw); padding:28px 32px;
  background:linear-gradient(160deg,#0d0d0d,#1a0808);
  border:2px solid rgba(239,68,68,.5); border-radius:16px;
  box-shadow:0 0 60px rgba(239,68,68,.25);
}
.egg-gauntlet-header{
  display:flex; align-items:center; gap:14px; margin-bottom:22px; flex-wrap:wrap;
}
.egg-gauntlet-title{
  font-family:'Press Start 2P',monospace; font-size:.7rem;
  color:#ef4444; letter-spacing:.08em; flex:1;
}
.egg-q-counter{
  font-family:'Press Start 2P',monospace; font-size:.55rem; color:var(--muted);
}
/* Timer ring */
.egg-timer-wrap{ position:relative; width:52px; height:52px; flex-shrink:0; }
.egg-timer-svg{ width:52px; height:52px; }
.egg-timer-num{
  position:absolute; inset:0; display:flex; align-items:center; justify-content:center;
  font-family:'Press Start 2P',monospace; font-size:.75rem; color:#fff;
  transition:color .3s;
}
.egg-source-label{ font-size:.72rem; color:var(--muted); margin-bottom:8px; font-style:italic; }
.egg-question-text{
  font-size:1rem; font-weight:700; color:var(--text); line-height:1.5;
  margin-bottom:20px; padding:14px 16px;
  background:rgba(255,255,255,.04); border-radius:8px; border:1px solid rgba(255,255,255,.08);
}
.egg-options{ display:flex; flex-direction:column; gap:8px; }
.egg-option{
  background:rgba(255,255,255,.04); border:1px solid rgba(255,255,255,.12);
  border-radius:8px; padding:12px 16px; color:var(--text);
  font-size:.88rem; text-align:left; cursor:pointer;
  transition:background .15s, border-color .15s, transform .1s;
}
.egg-option:hover{ background:rgba(239,68,68,.12); border-color:rgba(239,68,68,.4); transform:translateX(4px); }
/* Fail screen */
.egg-fail-inner{
  text-align:center; padding:20px;
  animation:egg-fail-shake .5s ease;
}
@keyframes egg-fail-shake{
  0%,100%{transform:translateX(0)} 20%{transform:translateX(-12px)} 40%{transform:translateX(12px)}
  60%{transform:translateX(-8px)} 80%{transform:translateX(8px)}
}
.egg-fail-icon{ font-size:3.5rem; margin-bottom:12px; }
.egg-fail-title{
  font-family:'Press Start 2P',monospace; font-size:1.1rem;
  color:#ef4444; margin-bottom:10px; letter-spacing:.06em;
}
.egg-fail-sub{
  font-family:'Press Start 2P',monospace; font-size:.65rem;
  color:#fca5a5; margin-bottom:8px;
}
.egg-fail-msg{ font-size:.85rem; color:var(--muted); }
/* Success screen */
.egg-success-inner{ text-align:center; padding:20px; }
.egg-success-icon{ font-size:3rem; margin-bottom:10px; }
.egg-success-title{
  font-family:'Press Start 2P',monospace; font-size:.85rem;
  color:#4ade80; margin-bottom:6px;
}
.egg-success-sub{ font-size:.9rem; color:var(--muted); margin-bottom:22px; }
.egg-exam-box{
  background:linear-gradient(135deg,rgba(251,191,36,.1),rgba(251,191,36,.05));
  border:2px solid rgba(251,191,36,.5); border-radius:12px; padding:20px 24px;
  margin-bottom:20px; box-shadow:0 0 30px rgba(251,191,36,.15);
}
.egg-exam-label{
  font-family:'Press Start 2P',monospace; font-size:.5rem; color:var(--amber);
  letter-spacing:.1em; margin-bottom:12px;
}
.egg-exam-text{
  font-size:1.1rem; font-weight:700; color:#fef3c7; line-height:1.5;
}
.egg-close-btn{
  background:linear-gradient(135deg,var(--amber),#d97706); color:#000;
  border:none; border-radius:8px; padding:12px 24px;
  font-weight:700; font-size:.9rem; cursor:pointer;
}
.egg-close-btn:hover{ opacity:.9; transform:scale(1.03); }

/* ── LOGIN SCHERM ── */
#view-login{
  position:fixed; inset:0;
  display:none; align-items:center; justify-content:center;
  padding:24px; z-index:1000;
  background:var(--bg);
}
#view-login.active{
  display:flex;
}
.login-box{
  background:var(--surface); border:1px solid var(--border);
  border-radius:16px; padding:40px 44px; width:100%; max-width:420px;
  box-shadow:0 8px 40px rgba(0,0,0,.4);
}
.login-logo{ font-size:1.5rem; font-weight:800; color:var(--text); margin-bottom:4px; }
.login-logo span{ color:var(--accent); }
.login-sub{ color:var(--muted); font-size:.9rem; margin-bottom:28px; }
.login-tabs{ display:flex; gap:4px; margin-bottom:24px; background:var(--card); border-radius:8px; padding:4px; }
.login-tab{ flex:1; padding:8px; border:none; border-radius:6px; cursor:pointer;
  background:transparent; color:var(--muted); font-size:.9rem; font-weight:600; transition:.2s; }
.login-tab.active{ background:var(--accent); color:#fff; }
.login-field{ margin-bottom:16px; }
.login-field label{ display:block; font-size:.85rem; color:var(--muted); margin-bottom:6px; }
.login-field input{
  width:100%; padding:10px 14px; background:var(--card); border:1px solid var(--border);
  border-radius:8px; color:var(--text); font-size:.95rem; outline:none;
  transition:border-color .2s;
}
.login-field input:focus{ border-color:var(--accent); }
.login-btn{
  width:100%; padding:12px; background:var(--accent); color:#fff; border:none;
  border-radius:8px; font-size:1rem; font-weight:700; cursor:pointer; margin-top:8px;
  transition:opacity .2s;
}
.login-btn:hover{ opacity:.88; }
.login-msg{ margin-top:12px; font-size:.85rem; text-align:center; min-height:20px; }
.login-msg.error{ color:#ef4444; }
.login-msg.ok{ color:#22c55e; }
#header-user{ font-size:.8rem; color:var(--muted); margin-right:4px; }
#btn-logout{
  background:transparent; border:1px solid var(--border); color:var(--muted);
  padding:5px 12px; border-radius:6px; cursor:pointer; font-size:.8rem;
}
#btn-logout:hover{ border-color:var(--accent); color:var(--accent); }

/* ── v2: afbeeldingen bij visuele bronnen ── */
.bron-fig{margin:18px 0 6px;position:relative;border-radius:var(--radius-sm);overflow:hidden;border:1px solid var(--border);background:#0b0a09}
.bron-fig img{display:block;width:100%;height:auto;max-height:70vh;object-fit:contain;background:#0b0a09}
.bron-fig-fail{display:none;padding:16px;color:var(--muted);font-size:.85rem}
.bron-fig.img-failed img{display:none}
.bron-fig.img-failed .bron-fig-fail{display:block}
.bron-fig.img-failed .bron-fig-veil{display:none}
.bron-fig.img-failed.sensitive{min-height:0;cursor:default}
.bron-fig.sensitive{cursor:pointer;min-height:180px}
.bron-fig.sensitive img{filter:blur(28px) grayscale(1);opacity:.35;transition:filter .4s,opacity .4s}
.bron-fig-veil{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;text-align:center;padding:20px;z-index:2;color:var(--text);font-size:.9rem}
.bron-fig-veil span{color:var(--muted);font-size:.82rem;max-width:340px}
.bron-fig.sensitive.revealed{cursor:default}
.bron-fig.sensitive.revealed img{filter:none;opacity:1}
.bron-fig.sensitive.revealed .bron-fig-veil{display:none}
/* ── v2: open vraag ── */
.ov-footer{display:flex;align-items:center;gap:10px;margin:8px 0 14px;flex-wrap:wrap}
.ov-footer .go-wc-bar-wrap{flex:1;min-width:80px}
.open-vraag-area.locked,.go-textarea.locked{opacity:.8;border-style:dashed;cursor:default}
.model-toggle-btn.locked{opacity:.55;cursor:not-allowed}
.ov-model-label{font-family:'Nunito',sans-serif;font-weight:800;font-size:.72rem;text-transform:uppercase;letter-spacing:.06em;color:var(--purple);margin-bottom:6px}
.ov-sa{margin-top:14px}
.ov-actions{display:flex;gap:10px;align-items:center;justify-content:flex-end;flex-wrap:wrap;margin-top:12px}
.ov-rewrite{background:none;border:1px solid var(--border);color:var(--muted);padding:8px 14px;border-radius:var(--radius-sm);cursor:pointer;font-family:'Nunito',sans-serif;font-size:.82rem}
.ov-rewrite:hover{border-color:var(--accent);color:var(--accent)}
/* ── v2: poster op het loginscherm ── */
.login-poster{display:block;width:150px;height:auto;margin:0 auto 18px;border-radius:10px;border:1px solid var(--border);box-shadow:0 12px 32px rgba(0,0,0,.5)}
/* ── v2: gsm ── */
@media(max-width:600px){
  .home-hero{padding:28px 0 28px}
  .home-hero::before{width:100%}
  .home-hero-img{max-width:260px;margin-bottom:24px}
  .source-card{padding:18px 16px}
  .q-card{padding:18px 16px}
  .opt-btn{font-size:.92rem;padding:12px 14px}
  .login-box{padding:28px 20px}
  .login-poster{width:110px}
  .go-bronnen-grid{grid-template-columns:1fr}
  #header{padding:0 10px}
  .logo{font-size:.9rem}
  .logo span{display:none}
  #header-right{gap:6px;min-width:0}
  #btn-waterloo,#btn-home,#btn-logout{font-size:0;padding:6px 9px;line-height:1}
  #btn-waterloo::before{content:'⚔️';font-size:1rem}
  #btn-home::before{content:'⌂';font-size:1.05rem}
  #btn-logout::before{content:'↪';font-size:1rem}
  #header-user{display:none}
}
/* ══ v3: leerpaden · opdrachten · berichten ══ */
.lp-intro{color:var(--muted);font-size:.9rem;margin:-8px 0 16px}
.lp-dots{display:flex;gap:5px;margin:10px 0 2px;flex-wrap:wrap}
.lp-dot{width:12px;height:12px;border-radius:50%;background:var(--border);display:inline-block}
.lp-dot.busy{background:var(--amber)}
.lp-dot.ok{background:var(--green)}
.lp-kicker{font-family:'Nunito',sans-serif;font-size:.74rem;font-weight:800;letter-spacing:.07em;text-transform:uppercase;color:var(--ch-c1,var(--blue-light));margin-bottom:6px}
.lp-hq-small{font-size:.84rem;color:var(--muted);font-style:italic;margin:4px 0 8px;line-height:1.45}
.lp-chips{display:flex;gap:6px;flex-wrap:wrap}
.lp-chip{font-size:.72rem;border:1px solid var(--border);border-radius:12px;padding:2px 9px;color:var(--muted);font-family:'Nunito',sans-serif;white-space:nowrap}
.lp-les .bron-nr{color:var(--purple)}

.les-hero{background:linear-gradient(135deg,var(--card) 0%,var(--card2) 100%);border:1px solid var(--ch-border,var(--border));border-radius:var(--radius);padding:24px 24px 18px;margin-bottom:22px;position:relative;overflow:hidden}
.les-hero::before{content:'';position:absolute;inset:0 auto 0 0;width:4px;background:linear-gradient(var(--ch-c1),var(--ch-c2))}
.les-title{font-family:'Nunito',sans-serif;font-size:1.6rem;font-weight:800;line-height:1.25;margin-bottom:14px}
.les-hq{background:var(--bg);border:1px solid var(--border);border-radius:var(--radius-sm);padding:12px 16px;margin-bottom:16px}
.les-hq-lbl{font-family:'Nunito',sans-serif;font-size:.72rem;font-weight:800;text-transform:uppercase;letter-spacing:.06em;color:var(--amber);margin-bottom:4px}
.les-hq-q{font-size:1.05rem;font-weight:500;line-height:1.5}
.les-progress{height:6px;background:var(--border);border-radius:3px;overflow:hidden}
.les-progress-bar{height:100%;background:linear-gradient(90deg,var(--ch-c1),var(--ch-c2));border-radius:3px;transition:width .4s}
.les-progress-lbl{font-size:.8rem;color:var(--muted);margin-top:6px;font-family:'Nunito',sans-serif}
.les-progress-lbl b{color:var(--green)}

.les-sec{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:20px 22px;margin-bottom:16px}
.les-sec h2{font-family:'Nunito',sans-serif;font-size:1.08rem;font-weight:800;margin-bottom:12px;display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.sec-n{font-size:.74rem;font-weight:700;color:var(--green);border:1px solid #1f5a3a;background:var(--green-bg);border-radius:10px;padding:1px 9px}
.les-tip{font-size:.88rem;color:var(--muted);margin-bottom:14px;line-height:1.55}
.les-kunnen{list-style:none;display:flex;flex-direction:column;gap:8px}
.les-kunnen li{display:flex;gap:10px;align-items:flex-start;justify-content:space-between;padding:10px 12px;background:var(--surface);border-radius:var(--radius-sm);font-size:.93rem;line-height:1.5}
.doel-chip{font-family:'Nunito',sans-serif;font-size:.68rem;font-weight:800;color:var(--purple);border:1px solid #3c2f5c;border-radius:8px;padding:1px 7px;white-space:nowrap;cursor:help;flex-shrink:0}
.les-doelen{margin-top:12px;font-size:.78rem;color:var(--muted);display:flex;gap:6px;flex-wrap:wrap;align-items:center}

.sw-list{list-style:none;counter-reset:sw;display:flex;flex-direction:column;gap:6px}
.sw-item{display:flex;align-items:center;gap:10px;padding:9px 12px;border:1px solid var(--border);border-radius:var(--radius-sm);font-size:.92rem;background:var(--surface)}
.sw-item.done{border-color:#1f5a3a;background:var(--green-bg)}
.sw-item label{display:flex;gap:10px;align-items:center;cursor:pointer;width:100%}
.sw-item input{width:18px;height:18px;accent-color:var(--green);flex-shrink:0}
.sw-item a{color:var(--text);text-decoration:none;flex:1}
.sw-item a:hover{color:var(--blue-light)}
.sw-auto{width:18px;text-align:center;color:var(--muted);font-weight:800;flex-shrink:0}
.sw-item.done .sw-auto{color:var(--green)}
.sw-n{font-size:.76rem;color:var(--muted);margin-left:4px}
.sw-extra{font-size:.82rem;color:var(--muted);margin-top:10px}

.begrip-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:8px;margin-bottom:10px}
.begrip{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-sm);padding:9px 12px;font-size:.88rem}
.begrip summary{cursor:pointer;font-family:'Nunito',sans-serif;font-weight:800;color:var(--blue-light);list-style:none}
.begrip summary::-webkit-details-marker{display:none}
.begrip summary::before{content:'＋ ';color:var(--muted)}
.begrip[open] summary::before{content:'－ '}
.begrip div{margin-top:6px;color:var(--text);line-height:1.5}
.begrip-grid + .les-tip{margin-bottom:0}

.cue{border:1px solid var(--border);border-radius:var(--radius-sm);padding:14px 14px 12px;margin-bottom:10px;background:var(--surface)}
.cue-q{display:flex;gap:10px;font-weight:600;margin-bottom:10px;line-height:1.5}
.cue-nr{flex-shrink:0;width:24px;height:24px;border-radius:50%;background:var(--blue-bg);border:1px solid var(--blue-border);color:var(--blue-light);font-family:'Nunito',sans-serif;font-size:.78rem;font-weight:800;display:flex;align-items:center;justify-content:center}
.cue-ta{width:100%;background:var(--bg);border:1px solid var(--border);color:var(--text);border-radius:var(--radius-sm);padding:10px 12px;font-family:'DM Sans',sans-serif;font-size:.92rem;resize:vertical;min-height:58px;outline:none}
.cue-ta:focus{border-color:var(--blue)}
.cue-ta.locked{opacity:.8;border-style:dashed}
.cue-row{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-top:8px}
.cue-st{font-size:.78rem;color:var(--muted)}
.cue-btn{background:var(--blue-bg);border:1px solid var(--blue-border);color:var(--blue-light);border-radius:var(--radius-sm);padding:7px 14px;cursor:pointer;font-family:'Nunito',sans-serif;font-weight:700;font-size:.84rem}
.cue-btn.locked{opacity:.5;cursor:not-allowed}
.cue-ans{display:none;margin-top:10px;border-top:1px dashed var(--border);padding-top:10px}
.cue-ans.visible{display:block}
.cue-ans-lbl{font-family:'Nunito',sans-serif;font-size:.7rem;font-weight:800;text-transform:uppercase;letter-spacing:.06em;color:var(--purple);margin-bottom:4px}
.cue-ans-t{font-size:.9rem;line-height:1.55;margin-bottom:10px}
.cue-judge{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.cue-judge span{font-size:.8rem;color:var(--muted);margin-right:4px}
.cue-judge .go-sa-btn{padding:6px 12px;font-size:.82rem}
.cue-retry{margin-top:10px;font-size:.78rem;padding:5px 12px}
.les-fb{margin-top:8px;font-size:.84rem;color:var(--amber)}
.les-fb a{color:var(--amber)}

.zc-item{padding:12px 0;border-bottom:1px solid var(--border)}
.zc-item:last-of-type{border-bottom:none}
.zc-t{font-size:.93rem;margin-bottom:8px;line-height:1.5}
.zc-tip,.zc-ok{margin-top:14px;padding:12px 14px;border-radius:var(--radius-sm);font-size:.9rem;line-height:1.55}
.zc-tip{background:var(--amber-bg);border:1px solid #5a4410}
.zc-tip ul{margin:6px 0 8px 18px}
.zc-ok{background:var(--green-bg);border:1px solid #1f5a3a}
.les-nav{display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;margin:22px 0 10px}
.bron-item-go.done{border-color:var(--green)}

.opd-box{background:var(--card);border:1px solid #5a4410;border-radius:var(--radius);padding:16px 18px;margin-bottom:28px}
.opd-head{font-family:'Nunito',sans-serif;font-weight:800;font-size:1rem;margin-bottom:10px;color:var(--amber)}
.opd-card{border-top:1px solid var(--border);padding:12px 0 4px}
.opd-card:first-of-type{border-top:none;padding-top:0}
.opd-meta{display:flex;justify-content:space-between;font-size:.78rem;color:var(--muted);margin-bottom:6px}
.opd-count{font-weight:700;color:var(--amber)}
.opd-card.done .opd-count{color:var(--green)}
.opd-msg{background:var(--surface);border-left:3px solid var(--amber);padding:8px 12px;border-radius:0 var(--radius-sm) var(--radius-sm) 0;font-size:.9rem;margin-bottom:8px;white-space:pre-wrap}
.opd-items{display:flex;flex-direction:column;gap:6px}
.opd-item{display:flex;gap:10px;align-items:center;flex-wrap:wrap;text-align:left;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-sm);padding:9px 12px;cursor:pointer;color:var(--text);font-family:'DM Sans',sans-serif;font-size:.9rem}
.opd-item:hover{border-color:var(--amber)}
.opd-item.ok{border-color:#1f5a3a;background:var(--green-bg)}
.opd-check{font-weight:800;color:var(--muted);width:16px}
.opd-item.ok .opd-check{color:var(--green)}
.opd-lbl{flex:1;min-width:180px}
.opd-hint{font-size:.74rem;color:var(--amber)}

#btn-inbox{position:relative;background:var(--card);border:1px solid var(--border);color:var(--text);padding:6px 12px;border-radius:var(--radius-sm);cursor:pointer;font-family:'Nunito',sans-serif;font-size:.85rem}
#btn-inbox:hover{border-color:var(--amber)}
#inbox-badge{position:absolute;top:-7px;right:-7px;background:var(--accent);color:#fff;font-size:.68rem;font-weight:800;border-radius:10px;padding:1px 6px;line-height:1.4}
.ib-card{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:16px 18px;margin-bottom:14px}
.ib-card.unread{border-color:var(--amber)}
.ib-lbl{font-family:'Nunito',sans-serif;font-weight:800;margin-bottom:4px;display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.ib-new{font-size:.68rem;background:var(--accent);color:#fff;border-radius:8px;padding:1px 7px;text-transform:uppercase;letter-spacing:.05em}
.ib-q{font-size:.84rem;color:var(--muted);font-style:italic;margin-bottom:10px}
.ib-mine{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-sm);padding:10px 12px;font-size:.9rem;white-space:pre-wrap;margin-bottom:10px}
.ib-who{font-size:.72rem;color:var(--muted);font-family:'Nunito',sans-serif;font-weight:700;margin-bottom:3px;white-space:normal}
.ib-thread{display:flex;flex-direction:column;gap:8px;margin-bottom:12px}
.ib-msg{padding:10px 12px;border-radius:var(--radius-sm);font-size:.92rem;white-space:pre-wrap;max-width:92%}
.ib-msg.lk{background:var(--amber-bg);border:1px solid #5a4410;align-self:flex-start}
.ib-msg.ll{background:var(--blue-bg);border:1px solid var(--blue-border);align-self:flex-end}
.ib-actions{display:flex;gap:8px;flex-wrap:wrap;align-items:flex-end}
.ib-ta{flex:1;min-width:200px;background:var(--bg);border:1px solid var(--border);color:var(--text);border-radius:var(--radius-sm);padding:9px 12px;font-family:'DM Sans',sans-serif;font-size:.9rem;outline:none}
.empty-note{color:var(--muted);padding:24px;text-align:center;border:1px dashed var(--border);border-radius:var(--radius)}

@media(max-width:600px){
  .les-hero{padding:18px 16px 14px}
  .les-title{font-size:1.3rem}
  .les-sec{padding:16px 14px}
  .les-kunnen li{flex-direction:column;gap:6px}
  .cue-judge .go-sa-btn{flex:1}
  #btn-inbox{font-size:0;padding:6px 9px;line-height:1}
  #btn-inbox::before{content:'💬';font-size:1rem}
  #inbox-badge{font-size:.62rem}
  .les-nav button{flex:1}
}
/* ══ v4: criteria · schrijfkaders · herhaalstapel ══ */
.crit .crit-list{display:flex;flex-direction:column;gap:6px;margin:8px 0 10px}
.crit-row{color:var(--text);display:flex;gap:10px;align-items:flex-start;padding:8px 10px;border:1px solid var(--border);border-radius:var(--radius-sm);background:var(--surface);cursor:pointer;font-size:.9rem;line-height:1.45}
.crit-row:hover{border-color:var(--blue-border)}
.crit-row input{width:18px;height:18px;margin-top:2px;accent-color:var(--green);flex-shrink:0}
.crit-row:has(input:checked){border-color:#1f5a3a;background:var(--green-bg)}
.crit-foot{display:flex;gap:12px;align-items:center;flex-wrap:wrap}
.crit-btn{background:var(--blue-bg);border:1px solid var(--blue-border);color:var(--blue-light);border-radius:var(--radius-sm);padding:8px 14px;cursor:pointer;font-family:'Nunito',sans-serif;font-weight:700;font-size:.86rem}
.crit-btn:hover{border-color:var(--blue-light)}
.crit-res{font-size:.88rem}
.crit-groen{color:#7ee787}.crit-oranje{color:#fb923c}.crit-rood{color:#f87171}
.crit-old{font-size:.75rem;color:var(--muted)}
.crit-note{font-size:.76rem;color:var(--muted);margin-top:8px}
#lp-sam-crit{margin-top:14px}
.kader{margin-bottom:10px}
.kader-btn{background:none;border:1px dashed var(--border);color:var(--muted);border-radius:var(--radius-sm);padding:6px 12px;cursor:pointer;font-family:'Nunito',sans-serif;font-size:.82rem}
.kader-btn:hover{border-color:var(--amber);color:var(--amber)}
.kader-box{display:none;margin-top:8px;background:var(--surface);border:1px solid #5a4410;border-radius:var(--radius-sm);padding:12px 14px}
.kader-box.visible{display:block}
.kader-grp{margin-bottom:8px;font-size:.86rem}
.kader-grp b{display:block;font-family:'Nunito',sans-serif;font-size:.72rem;text-transform:uppercase;letter-spacing:.06em;color:var(--amber);margin-bottom:2px}
.kader-z{color:var(--text);padding:2px 0 2px 10px;border-left:2px solid var(--border);margin:2px 0;font-style:italic}
.rev-box{display:flex;gap:14px;align-items:center;background:linear-gradient(135deg,var(--blue-bg),var(--card));border:1px solid var(--blue-border);border-radius:var(--radius);padding:14px 18px;margin-bottom:20px;cursor:pointer;transition:transform .2s}
.rev-box:hover{transform:translateY(-2px)}
.rev-ic{font-size:1.6rem}
.rev-t{flex:1;display:flex;flex-direction:column}
.rev-t b{font-family:'Nunito',sans-serif;font-size:1rem}
.rev-t span{font-size:.82rem;color:var(--muted)}
.rev-card{padding:20px}
.rev-done{text-align:center;padding:40px 20px;display:flex;flex-direction:column;gap:12px;align-items:center}
.rev-done h2{font-family:'Nunito',sans-serif}
.rev-done p{color:var(--muted)}
/* ══ v5: oefeningen ══ */
.oef{background:var(--surface);border:1px solid var(--border);border-left:4px solid var(--oc,var(--accent));border-radius:var(--radius-sm);padding:16px 16px 12px;margin:12px 0}
.oef.is-s{--oc:var(--blue)}
.oef.is-x{--oc:#e0507e}
.oef.done{border-color:#1f5a3a;border-left-color:var(--green)}
.oef-kop{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.oef-chip{font-family:'Nunito',sans-serif;font-size:.72rem;font-weight:800;text-transform:uppercase;letter-spacing:.06em;color:var(--oc);border:1px solid var(--oc);border-radius:6px;padding:1px 8px}
.oef-ster{font-size:.72rem;color:var(--muted);text-transform:uppercase;letter-spacing:.05em}
.oef-nu{font-size:.74rem;font-weight:800;color:#fff;background:var(--accent);border-radius:6px;padding:2px 8px}
.oef-later{font-size:.74rem;color:var(--muted)}
.oef-st{margin-left:auto;font-size:.76rem;font-weight:700;color:var(--muted);font-family:'Nunito',sans-serif}
.oef.done .oef-st{color:var(--green)}
.oef-titel{font-family:'Nunito',sans-serif;font-size:1.05rem;font-weight:800;margin:8px 0 2px}
.oef-meta{font-size:.8rem;color:var(--muted);margin-bottom:8px}
.oef-info{display:grid;gap:3px;font-size:.86rem;margin:0 0 10px}
.oef-info div{display:grid;grid-template-columns:86px minmax(0,1fr);gap:8px}
.oef-info dt{font-size:.7rem;font-weight:800;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);padding-top:3px}
.oef-info dd{margin:0}
.oef-taak{font-size:.92rem;margin-bottom:8px}
.oef-tl{font-size:.8rem;font-weight:700;color:var(--muted);margin:6px 0}
.oef-vkop{font-family:'Nunito',sans-serif;font-weight:800;color:var(--oc);margin:10px 0 2px;font-size:.88rem}
.oef-fields{display:flex;flex-direction:column;gap:10px;margin:6px 0 10px}
.oef-f{display:flex;flex-direction:column;gap:4px;cursor:text}
.oef-q{font-size:.9rem;line-height:1.45}
.oef-sub{font-size:.74rem;color:var(--muted)}
.oef-hulp,.oef-opl-d{margin-top:6px;font-size:.88rem}
.oef-hulp summary{cursor:pointer;color:var(--muted);font-weight:700}
.oef-opl-d summary{cursor:pointer;color:var(--green);font-weight:700}
.oef-hulp ul,.oef-opl-d ul{margin:6px 0 0 18px;display:flex;flex-direction:column;gap:4px}
.oef-opl-d ul{background:var(--green-bg);border-radius:var(--radius-sm);padding:10px 12px 10px 28px;margin-left:0}
.oef-opl-lock{font-size:.8rem;color:var(--muted);margin-top:6px}
.oef-later-box{margin-top:14px}
.oef-later-box > summary{cursor:pointer;font-family:'Nunito',sans-serif;font-weight:700;color:var(--muted);padding:6px 0}
.hvmodel{display:grid;gap:6px;margin:8px 0}
.hvmodel div{display:grid;grid-template-columns:150px minmax(0,1fr);border-radius:var(--radius-sm);overflow:hidden}
.hvmodel dt{background:var(--card2);font-weight:700;font-size:.82rem;padding:8px 10px}
.hvmodel dd{margin:0;background:var(--green-bg);padding:8px 10px;font-size:.88rem}
#lp-sam-model{margin-top:10px}
@media(max-width:600px){ .oef-info div{grid-template-columns:1fr;gap:0} .hvmodel div{grid-template-columns:1fr} .oef{padding:14px 12px 10px} }

/* v6: hulp op het inlogscherm */
.login-help{margin-top:16px;padding:10px 12px;border:1px dashed var(--border);border-radius:var(--radius-sm);font-size:.8rem;line-height:1.5;color:var(--muted);text-align:left}
.login-help b{color:var(--text)}

/* v7: klas kiezen */
.login-select{width:100%;background:var(--surface);border:1px solid var(--border);color:var(--text);border-radius:var(--radius-sm);padding:12px 14px;font-family:'DM Sans',sans-serif;font-size:1rem;outline:none}
.login-select:focus{border-color:var(--accent)}

/* v8: bronteksten bij de oefeningen */
.oef-bronnen{display:flex;flex-direction:column;gap:10px;margin:10px 0 14px}
.oef-bron{background:var(--bg);border:1px solid var(--border);border-left:3px solid var(--amber);border-radius:var(--radius-sm);padding:12px 14px}
.oef-bron-t{font-family:'Nunito',sans-serif;font-weight:800;font-size:.92rem;margin-bottom:6px}
.oef-bron-t span{font-weight:400;color:var(--muted);font-size:.8rem}
.oef-bron-p{font-size:.93rem;line-height:1.6;margin:0 0 8px;font-style:italic}
.oef-bron-img{display:block;max-width:100%;border-radius:6px;margin:4px 0 8px}
.oef-bron-w,.oef-bron-d{font-size:.82rem;line-height:1.5;margin-top:4px}
.oef-bron-d{color:var(--muted)}
.oef-bron-r{font-size:.72rem;color:var(--muted);margin-top:6px}
.oef-pre{font-size:.8rem;color:var(--amber);background:var(--amber-bg);border-radius:6px;padding:4px 8px}

/* ══════════════════════════════════════════════════════════════
   v9 — MAKE-OVER in de stijl van de Bronbox-poster en GO! atheneum
   Donkere 'nachtposter' (inkt-paars) · GO!-karmijn + turkoois · regenboogstrepen van de Bronbox
   ══════════════════════════════════════════════════════════════ */
:root{
  --bg:#130f1b; --surface:#1a1524; --card:#211a2e; --card2:#2a2238; --border:#3a2f4c; --text:#f7f1e6; --muted:#a99cb8;
  --accent:#e8196a; --accent-bg:#3a0f25; --accent-border:#7d1d4a; --accent-light:#ff5c96;
  --teal:#5fcac0; --teal-bg:#10302e; --plum:#6b3fa0; --sun:#ffc940;
  --rainbow:linear-gradient(90deg,#e53935 0 16.6%,#fb8c00 16.6% 33.3%,#fdd835 33.3% 50%,#43a047 50% 66.6%,#1e88e5 66.6% 83.3%,#8e24aa 83.3%);
  --rainbow-soft:linear-gradient(90deg,#e53935,#fb8c00,#fdd835,#43a047,#1e88e5,#8e24aa);
  --f-disp:'Bungee','Rubik',sans-serif; --f-head:'Rubik','Nunito',sans-serif; --f-mono:'IBM Plex Mono',ui-monospace,monospace;
  --radius:16px; --radius-sm:10px;
}
body{background:
  radial-gradient(1200px 600px at 110% -10%,rgba(232,25,106,.13),transparent 60%),
  radial-gradient(900px 500px at -10% 30%,rgba(95,202,192,.09),transparent 60%),
  var(--bg); background-attachment:fixed}
h1,h2,h3,.chapter-title,.les-title,.section-title{font-family:var(--f-head)}

/* regenboogbalk bij schermwissel */
#v9-bar{position:fixed;top:0;left:0;height:4px;width:100%;z-index:1000;background:var(--rainbow);transform-origin:left;transform:scaleX(0);pointer-events:none}
#v9-bar.go{animation:v9bar .7s cubic-bezier(.2,.8,.2,1) forwards}
@keyframes v9bar{0%{transform:scaleX(0);opacity:1}70%{transform:scaleX(1);opacity:1}100%{transform:scaleX(1);opacity:0}}
.view.v-in{animation:v9in .38s cubic-bezier(.2,.8,.2,1)}
@keyframes v9in{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
.rv{opacity:0;transform:translateY(18px);transition:opacity .5s ease,transform .5s cubic-bezier(.2,.8,.2,1)}
.rv.in{opacity:1;transform:none}

/* kop */
#header{background:rgba(19,15,27,.86);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border-bottom:0;position:sticky;top:0}
#header::after{content:'';position:absolute;left:0;right:0;bottom:0;height:3px;background:var(--rainbow);opacity:.9}
#header .logo{font-family:var(--f-disp);letter-spacing:.02em;font-size:1.15rem}
#header .logo .logo-b{color:var(--text)} #header .logo .logo-l{color:var(--accent-light)}
#btn-voortgang{background:var(--teal-bg);border:1px solid rgba(95,202,192,.45);color:var(--teal);border-radius:10px;padding:6px 12px;font-weight:700;cursor:pointer;font-family:var(--f-head)}
#btn-voortgang:hover{background:rgba(95,202,192,.2)}
.xp-level-badge{background:var(--accent-bg)!important;border-color:var(--accent-border)!important;color:var(--accent-light)!important}
.xp-bar-fill{background:var(--rainbow-soft)!important}
@media (max-width:760px){ .hb-l{display:none} #header-user{display:none} }

/* knoppen */
.btn-primary,.login-btn{background:linear-gradient(135deg,var(--accent),#b8124f)!important;color:#fff!important;border:0!important;border-radius:12px!important;font-family:var(--f-head);font-weight:700;box-shadow:0 6px 18px rgba(232,25,106,.28);transition:transform .15s,box-shadow .15s}
.btn-primary:hover,.login-btn:hover{transform:translateY(-1px);box-shadow:0 10px 24px rgba(232,25,106,.38)}
.btn-sec{border-radius:12px!important}
.back-btn{font-family:var(--f-head);font-weight:600}

/* ── LOGIN ── */
#view-login,.login-wrap{background:transparent}
.login-card,.login-box{border:1px solid var(--border)!important;border-radius:22px!important;background:linear-gradient(180deg,rgba(42,34,56,.92),rgba(26,21,36,.95))!important;position:relative;overflow:hidden}
.login-card::before,.login-box::before{content:'';position:absolute;left:0;right:0;top:0;height:6px;background:var(--rainbow)}
.login-select,#login-naam,#login-code,#login-pin{border-radius:12px!important}

/* ── HOME HERO ── */
.hm-hero{position:relative;display:grid;grid-template-columns:minmax(150px,230px) 1fr;gap:34px;align-items:center;padding:34px 30px;margin:6px 0 18px;
  border-radius:26px;background:linear-gradient(135deg,#2a1838 0%,#1a1424 55%,#14202a 100%);border:1px solid var(--border);overflow:hidden}
.hm-hero::after{content:'';position:absolute;left:0;right:0;bottom:0;height:8px;background:var(--rainbow)}
.hm-shapes{position:absolute;inset:0;pointer-events:none;z-index:0}
.hm-shapes i{position:absolute;display:block;pointer-events:none;opacity:.9}
.hm-shapes .s1{right:-40px;top:-40px;width:150px;height:150px;border-radius:0 0 0 150px;background:var(--accent);opacity:.85}
.hm-shapes .s2{right:110px;top:-20px;width:60px;height:60px;background:radial-gradient(circle,var(--teal) 0 30%,transparent 31%) 0 0/20px 20px;opacity:.55}
.hm-shapes .s3{right:30px;bottom:30px;width:70px;height:70px;background:var(--plum);clip-path:polygon(50% 0,62% 38%,100% 50%,62% 62%,50% 100%,38% 62%,0 50%,38% 38%);animation:v9spin 18s linear infinite}
.hm-shapes .s4{right:150px;bottom:-30px;width:90px;height:90px;border-radius:50%;border:14px solid var(--teal);opacity:.4}
@keyframes v9spin{to{transform:rotate(360deg)}}
.hm-poster{width:100%;height:auto;border-radius:14px;box-shadow:0 18px 40px rgba(0,0,0,.5),0 0 0 6px #f4ead6;transform:rotate(-3deg);transition:transform .4s;position:relative;z-index:1}
.hm-poster:hover{transform:rotate(0) scale(1.02)}
.hm-main{position:relative;z-index:1;min-width:0}
.hm-kicker{font-family:var(--f-mono);font-size:.74rem;letter-spacing:.06em;text-transform:uppercase;color:var(--teal)}
.hm-title{font-family:var(--f-disp);font-size:clamp(2.4rem,7vw,4.4rem);line-height:.95;margin:8px 0 10px;letter-spacing:.01em;
  color:#fff;text-shadow:3px 3px 0 #e53935,6px 6px 0 #1e88e5}
.hm-title span{display:inline-block}
.hm-title span+span{color:var(--sun)}
.hm-hello{font-family:var(--f-head);font-weight:700;font-size:1.25rem;margin-bottom:14px}
.hm-mission{display:flex;flex-wrap:wrap;gap:12px;align-items:stretch}
.hm-opd{display:flex;gap:12px;align-items:center;background:rgba(0,0,0,.28);border:1px solid var(--border);border-radius:16px;padding:10px 16px 10px 10px;cursor:pointer}
.hm-opd b{display:block;font-family:var(--f-head)} .hm-opd small{color:var(--muted)}
.hm-next{flex:1;min-width:220px;text-align:left;background:linear-gradient(135deg,var(--accent),#a10f48);border:0;color:#fff;border-radius:16px;padding:12px 18px;font-family:var(--f-head);font-weight:700;font-size:1rem;cursor:pointer;box-shadow:0 10px 26px rgba(232,25,106,.35);transition:transform .15s}
.hm-next small{display:block;font-family:var(--f-mono);font-weight:500;font-size:.7rem;letter-spacing:.06em;text-transform:uppercase;opacity:.85;margin-bottom:2px}
.hm-next:hover{transform:translateY(-2px)}
@media (max-width:640px){ .hm-hero{grid-template-columns:1fr;padding:22px 18px 28px;gap:16px;text-align:left} .hm-poster{max-width:150px;transform:rotate(-3deg)} .hm-shapes .s1{width:100px;height:100px} }

/* ring */
.opd-ring{--p:0;width:56px;height:56px;flex:none;border-radius:50%;display:grid;place-items:center;
  background:conic-gradient(var(--teal) calc(var(--p)*1%),rgba(255,255,255,.1) 0);position:relative}
.opd-ring::before{content:'';position:absolute;inset:6px;border-radius:50%;background:var(--card)}
.opd-ring span{position:relative;font-family:var(--f-head);font-weight:800;font-size:.85rem}
.opd-ring.big{width:84px;height:84px}.opd-ring.big span{font-size:1.15rem}

/* tegels */
.hm-tiles{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin-bottom:18px}
.hm-tile{border:1px solid var(--border);background:var(--card);color:var(--text);border-radius:18px;padding:16px 10px 14px;cursor:pointer;font-family:var(--f-head);font-weight:700;font-size:.98rem;
  display:flex;flex-direction:column;align-items:center;gap:4px;position:relative;overflow:hidden;transition:transform .18s,border-color .18s,box-shadow .18s}
.hm-tile b{font-size:1.7rem;line-height:1;transition:transform .25s}
.hm-tile small{font-family:var(--f-mono);font-weight:500;font-size:.68rem;color:var(--muted)}
.hm-tile::after{content:'';position:absolute;left:0;right:0;bottom:0;height:4px;background:var(--c)}
.hm-tile:hover{transform:translateY(-3px);border-color:var(--c);box-shadow:0 12px 26px rgba(0,0,0,.35)} .hm-tile:hover b{transform:scale(1.15) rotate(-6deg)}
.hm-tile.t1{--c:#fb8c00}.hm-tile.t2{--c:#43a047}.hm-tile.t3{--c:#1e88e5}.hm-tile.t4{--c:var(--teal)}.hm-tile.t5{--c:var(--accent)}
@media (max-width:640px){ .hm-tiles{grid-template-columns:repeat(3,1fr)} .hm-tile{padding:12px 6px} .hm-tile b{font-size:1.4rem} }

/* Waterloo-uitleg */
.wt-promo{display:flex;gap:16px;align-items:center;margin:0 0 22px;padding:16px 18px;border-radius:20px;background:
  linear-gradient(120deg,rgba(185,28,28,.25),rgba(30,58,138,.25)),repeating-linear-gradient(135deg,rgba(255,255,255,.03) 0 12px,transparent 12px 24px),var(--card);border:1px solid #5a2a2a}
.wt-promo-ic{font-size:2.4rem;filter:drop-shadow(0 4px 8px rgba(0,0,0,.4))}
.wt-promo-b{flex:1;min-width:0}
.wt-promo-t{font-family:var(--f-disp);font-size:1.05rem;letter-spacing:.02em}
.wt-promo-t span{font-family:var(--f-mono);font-size:.7rem;background:rgba(0,0,0,.35);border-radius:20px;padding:2px 9px;margin-left:6px;vertical-align:middle;color:var(--sun)}
.wt-promo p{margin:6px 0 8px;font-size:.88rem;color:#e6dcef;line-height:1.5}
.wt-promo-bar{height:8px;border-radius:8px;background:rgba(255,255,255,.1);overflow:hidden}.wt-promo-bar i{display:block;height:100%;background:linear-gradient(90deg,#f0b429,#e53935)}
.wt-promo-go{flex:none;border:0;border-radius:14px;padding:12px 16px;font-family:var(--f-head);font-weight:800;background:linear-gradient(135deg,#e53935,#8b1d1d);color:#fff;cursor:pointer}
.wt-promo-go:disabled{background:rgba(255,255,255,.08);color:var(--muted);cursor:not-allowed}
@media (max-width:640px){ .wt-promo{flex-wrap:wrap} .wt-promo-go{width:100%} }

.hm-about{margin:0 0 20px;border:1px solid var(--border);border-radius:16px;background:var(--surface)}
.hm-about>summary{cursor:pointer;padding:14px 18px;font-family:var(--f-head);font-weight:700;list-style:none}
.hm-about>summary::-webkit-details-marker{display:none}
.hm-about[open]>summary{border-bottom:1px solid var(--border)}
.hm-about .home-intro-card,.hm-about .home-steps{margin:14px}

/* sectiekoppen */
.section-title{font-family:var(--f-disp)!important;letter-spacing:.02em;font-size:1rem!important}
.section-line{background:var(--rainbow)!important;opacity:.6;height:3px!important;border-radius:3px}
.chapter-card{border-radius:20px!important;transition:transform .2s,box-shadow .2s,border-color .2s}
.chapter-card:hover{transform:translateY(-4px) rotate(-.4deg);box-shadow:0 16px 34px rgba(0,0,0,.4)}

/* opdrachtkaart */
.opd-box{border-radius:20px!important;border:1px solid var(--accent-border)!important;background:linear-gradient(180deg,rgba(232,25,106,.10),rgba(33,26,46,.9))!important}
.opd-top{display:flex;gap:14px;align-items:center}
.opd-titel{font-family:var(--f-head);font-weight:800;font-size:1.1rem}
.opd-meta{display:flex;flex-wrap:wrap;gap:6px 14px;font-size:.82rem;color:var(--muted);margin-top:3px}
.opd-dl.warn{color:var(--sun);font-weight:700}
.opd-det{margin-top:10px}.opd-det>summary{cursor:pointer;font-size:.86rem;color:var(--teal);font-weight:600}
.opd-pt{margin-left:auto;font-family:var(--f-mono);font-size:.74rem;background:var(--teal-bg);color:var(--teal);border-radius:8px;padding:1px 7px}
.opd-pt.off{background:rgba(255,255,255,.06);color:var(--muted)}

/* les */
.les-hero{border-radius:22px!important;position:relative;overflow:hidden}
.les-hero::after{content:'';position:absolute;left:0;right:0;bottom:0;height:5px;background:var(--rainbow);opacity:.85}
.lp-kicker{font-family:var(--f-mono)!important;letter-spacing:.06em}
.les-title{font-family:var(--f-head)!important;font-weight:800!important}
.les-tools{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}
.les-cu-btn{background:rgba(255,255,255,.06);border:1px solid var(--border);color:var(--text);border-radius:12px;padding:8px 13px;font-family:var(--f-head);font-weight:700;font-size:.88rem;cursor:pointer;transition:background .15s,transform .15s}
.les-cu-btn span{font-family:var(--f-mono);font-weight:500;font-size:.72rem;color:var(--teal);margin-left:4px}
.les-cu-btn:hover{background:rgba(95,202,192,.14);transform:translateY(-1px)}
.les-sec{border-radius:20px!important}
.les-sec h2{font-family:var(--f-head);font-weight:800}
.progress-bar,.les-progress-bar{background:var(--rainbow-soft)!important}

/* oefening: punten + vraag */
.oef-score{display:flex;gap:12px;align-items:center;margin-top:12px;padding:10px 14px;border-radius:14px;border:1px solid var(--border);background:rgba(255,255,255,.04)}
.oef-score-n{font-family:var(--f-head);font-weight:800;font-size:1.25rem}.oef-score-n small{font-size:.8rem;color:var(--muted)}
.oef-score.hi{border-color:rgba(67,160,71,.6)}.oef-score.mid{border-color:rgba(253,216,53,.5)}.oef-score.lo{border-color:rgba(229,57,53,.5)}
.oef-score-o{font-size:.88rem;color:#e6dcef}
.oef-ask{margin-top:10px}
.oef-ask-btn{background:none;border:1px dashed var(--border);color:var(--muted);border-radius:10px;padding:6px 12px;font-size:.82rem;cursor:pointer}
.oef-ask-btn:hover{color:var(--text);border-color:var(--teal)}
.vq{display:none}.vq.open{display:block;margin-top:8px}
.vq-ta{width:100%;background:var(--surface);border:1px solid var(--border);border-radius:12px;color:var(--text);padding:10px 12px;font:inherit;resize:vertical}
.vq-ta:focus{outline:none;border-color:var(--teal)}
.vq-row{display:flex;gap:10px;align-items:center;margin-top:8px;flex-wrap:wrap}.vq-st{font-size:.84rem;color:var(--teal)}
.ib-ask{border:1px solid rgba(95,202,192,.4);background:var(--teal-bg);border-radius:18px;padding:14px 16px;margin-bottom:18px}
.ib-ask-t{font-family:var(--f-head);font-weight:800}

/* ── CURSUS ── */
.view-wide{max-width:1180px!important}
.cu-wrap{display:grid;grid-template-columns:290px 1fr;gap:22px;align-items:start}
.cu-toc{position:sticky;top:76px;max-height:calc(100vh - 96px);overflow:auto;background:var(--surface);border:1px solid var(--border);border-radius:18px;padding:12px}
.cu-search input{width:100%;background:var(--card);border:1px solid var(--border);border-radius:12px;color:var(--text);padding:9px 12px;font:inherit}
.cu-tocd>summary{cursor:pointer;font-family:var(--f-head);font-weight:800;padding:10px 4px 2px;list-style:none}
.cu-tocd:not([open])>summary::after{content:' ▾';color:var(--muted)}
.cu-deel{margin-top:10px}.cu-deel>summary{cursor:pointer;font-family:var(--f-head);font-weight:800;padding:6px 4px;list-style:none}
.cu-deel>summary small{display:block;font-family:var(--f-mono);font-weight:500;font-size:.68rem;color:var(--muted)}
.cu-deel a,.cu-reslist a{display:block;padding:6px 8px;border-radius:9px;color:var(--text);text-decoration:none;font-size:.86rem;line-height:1.3}
.cu-deel a span,.cu-reslist a span{display:block;font-family:var(--f-mono);font-size:.66rem;color:var(--teal)}
.cu-deel a:hover,.cu-reslist a:hover,.cu-deel a.on{background:rgba(95,202,192,.12)}
.cu-reslist{margin-top:8px;padding-bottom:8px;border-bottom:1px solid var(--border)}
.cu-bg{font-size:.82rem;padding:6px 8px;background:var(--teal-bg);border-radius:9px;margin-bottom:6px}
.cu-bg-link{display:block;margin-top:12px;padding:9px 10px;border-radius:12px;background:rgba(30,136,229,.14);color:#9fd0ff;text-decoration:none;font-weight:700;font-size:.86rem}
/* papieren pagina, zoals de cursus */
.cu-paper{background:#fbf7ef;color:#1d1a22;border-radius:6px 22px 22px 6px;padding:34px 42px 50px;box-shadow:0 20px 50px rgba(0,0,0,.45);font-size:1rem;line-height:1.65;position:relative;min-width:0;overflow-wrap:anywhere}
.cu-paper::before{content:'';position:absolute;left:0;top:0;bottom:0;width:8px;background:linear-gradient(180deg,#C50751,#5fcac0,#6b3fa0);border-radius:6px 0 0 6px}
.cu-deelkop{border-bottom:3px solid #C50751;margin-bottom:18px;padding-bottom:10px}
.cu-kicker{font-family:var(--f-mono);font-size:.72rem;color:#8a7f92;text-transform:uppercase;letter-spacing:.06em}
.cu-paper h1{font-family:var(--f-head);color:#C50751;font-size:1.8rem;margin:4px 0 0}
.cu-paper h2{font-family:var(--f-head);color:#C50751;font-size:1.35rem;margin:6px 0 10px}
.cu-paper h3{font-family:var(--f-head);color:#8E0037;font-size:1.1rem;margin:20px 0 6px}
.cu-paper h4{font-family:var(--f-head);color:#2a8a83;font-size:1rem;margin:16px 0 4px}
.cu-paper p{margin:0 0 10px}.cu-paper ul{margin:0 0 12px 20px}.cu-paper li{margin:3px 0}
.cu-paper b{color:#111}
.cu-paper img{max-width:100%;height:auto;border-radius:8px;margin:8px 0;display:block}
.cu-sec{padding-top:18px;margin-top:18px;border-top:1px dashed #d9cfc2;position:relative}
.cu-sec:first-of-type{border-top:0;margin-top:0}
.cu-pg{position:absolute;right:0;top:18px;font-family:var(--f-mono);font-size:.7rem;color:#9a8fa5}
.cu-tw{overflow-x:auto;margin:10px 0 14px}
.cu-paper table{border-collapse:collapse;width:100%;font-size:.88rem}
.cu-paper th{background:#C50751;color:#fff;text-align:left;padding:7px 9px;font-family:var(--f-head)}
.cu-paper th b{color:#fff}
.cu-paper td{border:1px solid #e3d8ca;padding:7px 9px;vertical-align:top;background:#fff}
.cu-kader{border:2px solid #5fcac0;border-radius:14px;padding:12px 16px;margin:12px 0;background:#f0fbf9}
.cu-doel{background:#fde9f1;border-left:4px solid #C50751;padding:6px 10px;border-radius:0 8px 8px 0}
.cu-oef{background:#eef6ff;border-left:4px solid #1e88e5;padding:6px 10px;border-radius:0 8px 8px 0}
.cu-flash{animation:cuflash 1.6s ease}
@keyframes cuflash{0%{background:rgba(253,216,53,.55)}100%{background:transparent}}
@media (max-width:860px){ .cu-wrap{grid-template-columns:1fr} .cu-toc{position:static;max-height:none} .cu-paper{padding:22px 18px 34px;border-radius:14px} }

/* ── BEGRIPPEN ── */
.bg-hero,.vg-hero{border-radius:22px;padding:22px 24px;margin:8px 0 16px;background:linear-gradient(135deg,#1b2a44,#211a2e);border:1px solid var(--border);position:relative;overflow:hidden}
.vg-hero{background:linear-gradient(135deg,#14302e,#211a2e)}
.bg-hero::after,.vg-hero::after{content:'';position:absolute;left:0;right:0;bottom:0;height:5px;background:var(--rainbow)}
.bg-kicker{font-family:var(--f-mono);font-size:.72rem;letter-spacing:.06em;text-transform:uppercase;color:var(--teal)}
.bg-hero h1,.vg-hero h1{font-family:var(--f-disp);font-size:clamp(1.6rem,5vw,2.3rem);margin:4px 0 6px;letter-spacing:.02em}
.bg-hero p,.vg-hero p{color:#ddd3e8;margin:0 0 10px}
.bg-meter{height:10px;border-radius:10px;background:rgba(255,255,255,.1);overflow:hidden}.bg-meter i{display:block;height:100%;background:var(--rainbow-soft)}
.bg-bar{display:flex;flex-wrap:wrap;gap:10px;justify-content:space-between;margin-bottom:14px}
.seg{display:inline-flex;background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:3px;gap:2px;flex-wrap:wrap}
.seg button{border:0;background:none;color:var(--muted);padding:8px 13px;border-radius:11px;font-family:var(--f-head);font-weight:700;cursor:pointer}
.seg button.on{background:var(--card2);color:var(--text);box-shadow:inset 0 -3px 0 var(--accent)}
.seg.sm button{padding:6px 10px;font-size:.84rem}
.bg-q{width:100%;background:var(--surface);border:1px solid var(--border);border-radius:12px;color:var(--text);padding:10px 14px;font:inherit;margin-bottom:12px}
.bg-grp{margin-bottom:16px}.bg-grp-t{font-family:var(--f-mono);font-size:.74rem;color:var(--teal);text-transform:uppercase;letter-spacing:.05em;margin-bottom:6px}
.bg-item{display:flex;gap:12px;align-items:flex-start;padding:10px 12px;border-radius:12px;background:var(--card);border:1px solid var(--border);margin-bottom:6px}
.bg-u{color:#d7cde2;font-size:.9rem;margin-top:2px}
.bg-box{width:12px;height:12px;border-radius:4px;flex:none;margin-top:5px;background:rgba(255,255,255,.15)}
.bg-box.b1{background:#e53935}.bg-box.b2{background:#fb8c00}.bg-box.b3{background:#fdd835}.bg-box.b4{background:#43a047}
.bg-count{font-family:var(--f-mono);font-size:.78rem;color:var(--muted);text-align:center;margin-bottom:10px}
.flip{perspective:1200px;max-width:560px;margin:0 auto 16px;height:250px;cursor:pointer}
.flip-in{position:relative;width:100%;height:100%;transition:transform .55s cubic-bezier(.2,.8,.2,1);transform-style:preserve-3d}
.flip.on .flip-in{transform:rotateY(180deg)}
.flip-f,.flip-b{position:absolute;inset:0;backface-visibility:hidden;-webkit-backface-visibility:hidden;border-radius:22px;padding:24px;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;border:1px solid var(--border)}
.flip-f{background:linear-gradient(135deg,#2a1838,#1a2440)}
.flip-f::after{content:'';position:absolute;left:24px;right:24px;bottom:16px;height:5px;border-radius:5px;background:var(--rainbow)}
.flip-b{background:#fbf7ef;color:#1d1a22;transform:rotateY(180deg)}
.flip-k{font-family:var(--f-mono);font-size:.72rem;letter-spacing:.06em;text-transform:uppercase;color:var(--teal);margin-bottom:8px}
.flip-b .flip-k{color:#C50751;font-size:.9rem;font-family:var(--f-head);font-weight:800;text-transform:none;letter-spacing:0}
.flip-t{font-family:var(--f-disp);font-size:clamp(1.4rem,5vw,2rem);line-height:1.15}
.flip-h{font-size:.8rem;color:var(--muted);margin-top:14px}
.flip-u{font-size:1.08rem;line-height:1.5}
.bg-acts{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}
.bg-yes,.bg-no{border:0;border-radius:14px;padding:12px 22px;font-family:var(--f-head);font-weight:800;font-size:1rem;cursor:pointer;transition:transform .12s}
.bg-yes{background:#2e7d32;color:#fff}.bg-no{background:#3a2430;color:#ffb3c7;border:1px solid #6b2a44}
.bg-yes:hover,.bg-no:hover{transform:translateY(-2px)}
.bg-done{text-align:center;padding:30px 10px}.bg-done .big{font-size:3rem}.bg-done h3{font-family:var(--f-head);margin:6px 0}
.bg-qcard{max-width:640px;margin:0 auto;background:var(--card);border:1px solid var(--border);border-radius:22px;padding:22px}
.bg-qu{font-size:1.08rem;line-height:1.5;margin:6px 0 16px}
.bg-opts{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.bg-opts button{background:var(--surface);border:1px solid var(--border);color:var(--text);border-radius:14px;padding:12px;font-family:var(--f-head);font-weight:700;cursor:pointer;transition:transform .12s,border-color .12s}
.bg-opts button:hover:not(:disabled){transform:translateY(-2px);border-color:var(--teal)}
.bg-opts button.ok{background:#1f4d2a;border-color:#43a047}.bg-opts button.bad{background:#4d1f2a;border-color:#e53935;animation:shake .35s}
@keyframes shake{25%{transform:translateX(-5px)}75%{transform:translateX(5px)}}
@media (max-width:520px){ .bg-opts{grid-template-columns:1fr} .flip{height:230px} }

/* ── VOORTGANG ── */
.vg-kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:14px}
.vg-kpi{background:var(--card);border:1px solid var(--border);border-radius:16px;padding:12px 14px}
.vg-kpi b{display:block;font-family:var(--f-head);font-size:1.6rem;font-weight:800}.vg-kpi b small{font-size:.9rem;color:var(--muted)}
.vg-kpi span{font-size:.78rem;color:var(--muted)}
@media (max-width:640px){ .vg-kpis{grid-template-columns:repeat(2,1fr)} }
.vg-opd{display:flex;gap:16px;align-items:center;background:linear-gradient(180deg,rgba(232,25,106,.10),var(--card));border:1px solid var(--accent-border);border-radius:20px;padding:16px;margin-bottom:12px}
.vg-opd-t{font-family:var(--f-head);font-weight:800;font-size:1.15rem}
.vg-chips{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}
.vg-chip{border:1px solid var(--border);background:var(--surface);color:var(--muted);border-radius:20px;padding:3px 10px;font-size:.76rem;cursor:pointer;font-family:var(--f-mono)}
.vg-chip.ok{background:var(--teal-bg);border-color:rgba(95,202,192,.5);color:var(--teal)}
.vg-h{font-family:var(--f-disp);font-size:1.05rem;letter-spacing:.02em;margin:22px 0 6px}
.vg-legend{display:flex;flex-wrap:wrap;gap:12px;font-size:.8rem;color:var(--muted);margin-bottom:10px}
.vg-doelen{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:12px}
.dl-card{background:var(--card);border:1px solid var(--border);border-radius:18px;padding:14px 16px;position:relative;overflow:hidden}
.dl-card::before{content:'';position:absolute;left:0;top:0;bottom:0;width:5px;background:var(--lc,rgba(255,255,255,.15))}
.dl-card.lvl1{--lc:#e53935}.dl-card.lvl2{--lc:#fb8c00}.dl-card.lvl3{--lc:#fdd835}.dl-card.lvl4{--lc:#43a047}
.dl-top{display:flex;flex-wrap:wrap;gap:6px 10px;align-items:baseline}
.dl-code{font-family:var(--f-mono);font-size:.74rem;background:rgba(255,255,255,.07);border-radius:6px;padding:1px 6px;color:var(--teal)}
.dl-n{font-family:var(--f-head);font-weight:700;flex:1;min-width:150px}
.dl-lvl{font-size:.8rem;font-weight:700}
.dl-bar{display:grid;grid-template-columns:repeat(4,1fr);gap:4px;margin:10px 0 8px}
.dl-bar i{height:9px;border-radius:5px;background:rgba(255,255,255,.08)}
.dl-bar i.on:nth-child(1){background:#e53935}.dl-bar i.on:nth-child(2){background:#fb8c00}.dl-bar i.on:nth-child(3){background:#fdd835}.dl-bar i.on:nth-child(4){background:#43a047}
.dl-parts{display:flex;flex-wrap:wrap;gap:4px 12px;font-size:.78rem;color:var(--muted)}
.dl-next{margin-top:10px;width:100%;text-align:left;background:rgba(255,255,255,.05);border:1px solid var(--border);color:var(--text);border-radius:11px;padding:8px 10px;font-size:.84rem;cursor:pointer}
.dl-next:hover{border-color:var(--teal)}

@media (prefers-reduced-motion:reduce){
  .view.v-in,#v9-bar.go,.hm-shapes .s3,.cu-flash{animation:none!important}
  .rv{opacity:1!important;transform:none!important;transition:none!important}
  .flip-in{transition:none}
}

/* ══ SCÈNES: bewegende hoofdstukbeelden ══ */
.has-scn{position:relative;overflow:hidden;isolation:isolate}
.has-scn>*:not(.scn){position:relative;z-index:2}
.scn,.scn-intro{pointer-events:none}
.scn{position:absolute;inset:0;z-index:0;border-radius:inherit;overflow:hidden}
.scn-img{position:absolute;inset:-6%;background-size:cover;background-position:center 30%;animation:kenburns 26s ease-in-out infinite alternate;filter:saturate(1.1)}
@keyframes kenburns{0%{transform:scale(1.02) translate(0,0)}100%{transform:scale(1.16) translate(-3%,-2%)}}
.scn-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(19,15,27,.94) 0%,rgba(19,15,27,.78) 45%,rgba(19,15,27,.35) 100%),linear-gradient(0deg,rgba(19,15,27,.85),transparent 55%)}
.scn-fx{position:absolute;inset:0;overflow:hidden}
.chapter-header.has-scn{padding:26px 24px!important;border-radius:22px;border:1px solid var(--border);margin-bottom:16px;min-height:150px}
.les-hero.has-scn .scn-shade{background:linear-gradient(90deg,rgba(26,21,36,.96) 0%,rgba(26,21,36,.86) 55%,rgba(26,21,36,.55) 100%)}
.p{position:absolute;left:var(--x);will-change:transform,opacity}
.p-lis{top:-30px;color:#e6c35c;font-size:calc(18px*var(--s));opacity:.0;animation:fall var(--t) linear var(--d) infinite;text-shadow:0 0 8px rgba(230,195,92,.6)}
@keyframes fall{0%{transform:translateY(0) rotate(0);opacity:0}10%{opacity:.85}100%{transform:translateY(420px) rotate(var(--r));opacity:0}}
.p-smoke{bottom:-60px;width:calc(90px*var(--s));height:calc(90px*var(--s));border-radius:50%;background:radial-gradient(circle,rgba(220,220,230,.35),rgba(220,220,230,0) 70%);animation:rise var(--t) ease-out var(--d) infinite;opacity:0}
@keyframes rise{0%{transform:translate(0,0) scale(.5);opacity:0}15%{opacity:.8}100%{transform:translate(-60px,-360px) scale(2.4);opacity:0}}
.p-conf{top:-20px;width:8px;height:14px;border-radius:2px;animation:fall var(--t) linear var(--d) infinite;opacity:0}
.p-conf.c0{background:#1e4fd8}.p-conf.c1{background:#f4f1ea}.p-conf.c2{background:#e53935}
.p-poppy{top:-30px;width:calc(16px*var(--s));height:calc(16px*var(--s));border-radius:50% 50% 50% 0;background:radial-gradient(circle at 50% 50%,#1a1a1a 0 18%,#d62828 20%);animation:fall var(--t) linear var(--d) infinite,sway 3s ease-in-out infinite alternate;opacity:0}
@keyframes sway{to{margin-left:40px}}
.p-gear{font-size:80px;color:rgba(255,200,120,.32);animation:spin 14s linear infinite}
.p-gear.g0{right:6%;top:8%;left:auto}.p-gear.g1{right:16%;top:38%;left:auto;font-size:56px;animation-direction:reverse;animation-duration:10s}.p-gear.g2{right:2%;bottom:-12%;left:auto;top:auto;font-size:110px;animation-duration:20s}
@keyframes spin{to{transform:rotate(360deg)}}
.fx-flag{position:absolute;right:6%;top:14%;width:150px;height:96px;display:flex;transform-origin:left center;animation:wave 2.6s ease-in-out infinite;filter:drop-shadow(0 6px 12px rgba(0,0,0,.4));opacity:.9}
.fx-flag i{flex:1}.fx-flag i:nth-child(1){background:#111}.fx-flag i:nth-child(2){background:#fdd835}.fx-flag i:nth-child(3){background:#e53935}
.fx-flag::before{content:'';position:absolute;left:-6px;top:-10px;bottom:-60px;width:6px;background:#8a6a3a;border-radius:3px}
.fx-flag::after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,rgba(0,0,0,.25),rgba(255,255,255,.18),rgba(0,0,0,.25),rgba(255,255,255,.15),rgba(0,0,0,.2));background-size:200% 100%;animation:shine 2.6s linear infinite}
@keyframes wave{0%,100%{transform:perspective(400px) rotateY(-12deg) skewY(-2deg)}50%{transform:perspective(400px) rotateY(14deg) skewY(3deg)}}
@keyframes shine{to{background-position:-200% 0}}
.fx-globe{position:absolute;right:7%;top:12%;font-size:96px;animation:spin 40s linear infinite;opacity:.55}
.fx-ship{position:absolute;bottom:10%;left:-10%;font-size:40px;animation:sail 16s linear infinite;opacity:.8}
@keyframes sail{0%{transform:translateX(0)}100%{transform:translateX(1400px)}}
.fx-rain{position:absolute;inset:-40%;background:repeating-linear-gradient(135deg,rgba(229,57,53,.12) 0 30px,rgba(251,140,0,.12) 30px 60px,rgba(253,216,53,.12) 60px 90px,rgba(67,160,71,.12) 90px 120px,rgba(30,136,229,.12) 120px 150px,rgba(142,36,170,.12) 150px 180px);animation:slide 18s linear infinite}
@keyframes slide{to{transform:translate(180px,0)}}
/* titelkaart */
.scn-intro{position:fixed;inset:0;z-index:2000;pointer-events:auto;cursor:pointer;background:#0d0a12;animation:scnIn .45s ease both;display:flex;align-items:flex-end}
.scn-intro .scn-img{inset:-4%;animation:kenburns 3s ease-out forwards}
.scn-intro .scn-shade{background:linear-gradient(0deg,rgba(13,10,18,.95) 0%,rgba(13,10,18,.35) 60%,rgba(13,10,18,.55) 100%)}
.scn-intro.out{animation:scnOut .5s ease forwards}
@keyframes scnIn{from{opacity:0;clip-path:circle(0% at 50% 50%)}to{opacity:1;clip-path:circle(150% at 50% 50%)}}
@keyframes scnOut{to{opacity:0;transform:scale(1.04)}}
.scn-txt{position:relative;z-index:3;padding:0 6vw 9vh;max-width:900px}
.scn-k{font-family:var(--f-mono);color:var(--teal);letter-spacing:.08em;text-transform:uppercase;font-size:.85rem;animation:up .6s .15s both}
.scn-t{font-family:var(--f-disp);font-size:clamp(2rem,7vw,4.4rem);line-height:1;color:#fff;text-shadow:3px 3px 0 #e53935,6px 6px 0 #1e88e5;animation:up .7s .25s both}
.scn-skip{margin-top:14px;font-size:.8rem;color:var(--muted);animation:up .6s .6s both}
@keyframes up{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:none}}
.scn-intro::after{content:'';position:absolute;left:0;right:0;bottom:0;height:8px;background:var(--rainbow);z-index:3;transform-origin:left;animation:v9bar 1.8s ease forwards}
/* kaarten met beeld */
.chapter-card.imgcard{position:relative;overflow:hidden;isolation:isolate}
.chapter-card.imgcard::before{content:'';position:absolute;inset:0;z-index:-2;background:var(--card-img) center 30%/cover;transition:transform .8s ease;opacity:.55}
.chapter-card.imgcard::after{content:'';position:absolute;inset:0;z-index:-1;background:linear-gradient(180deg,rgba(26,21,36,.55),rgba(26,21,36,.95) 70%)}
.chapter-card.imgcard:hover::before{transform:scale(1.08)}
@media (prefers-reduced-motion:reduce){ .scn-img,.p,.fx-flag,.fx-globe,.fx-ship,.fx-rain,.p-gear{animation:none!important} .p{display:none} }

.oef-crit{margin-top:10px;border:1px dashed var(--border);border-radius:12px;padding:6px 12px}
.oef-crit summary{cursor:pointer;font-size:.86rem;color:var(--teal);font-weight:600}
.oef-crit ul,.oef-critres{list-style:none;margin:6px 0 2px;padding:0}
.oef-crit li{display:flex;gap:10px;justify-content:space-between;font-size:.86rem;padding:3px 0;border-bottom:1px solid rgba(255,255,255,.05)}
.oef-crit li b{font-family:var(--f-mono);font-size:.74rem;color:var(--muted);white-space:nowrap}
.oef-critres li{font-size:.86rem;padding:2px 0}.oef-critres li.ok{color:#8ee09a}.oef-critres li.no{color:#ffb3a7}

/* ══ LEERPAD als route ══ */
.rt-sum{display:flex;gap:12px;align-items:center;margin-top:12px;font-size:.86rem;color:#e6dcef}
.rt-sumbar{flex:1;max-width:320px;height:8px;border-radius:8px;background:rgba(255,255,255,.12);overflow:hidden}.rt-sumbar i{display:block;height:100%;background:var(--rainbow-soft)}
.route{position:relative;padding:6px 0 10px 0;margin-left:6px}
.route::before{content:'';position:absolute;left:23px;top:10px;bottom:40px;width:4px;border-radius:4px;background:repeating-linear-gradient(180deg,rgba(255,255,255,.18) 0 10px,transparent 10px 18px)}
.rt-stop{position:relative;display:flex;gap:16px;align-items:stretch;margin:0 0 14px;cursor:pointer;animation:v9in .5s cubic-bezier(.2,.8,.2,1) both;animation-delay:var(--d)}
.rt-pin{flex:none;width:50px;display:flex;justify-content:center;padding-top:18px;position:relative;z-index:1}
.rt-pin span{width:44px;height:44px;border-radius:50%;display:grid;place-items:center;font-family:var(--f-head);font-weight:800;font-size:.9rem;background:var(--card2);border:3px solid var(--border);color:var(--muted);transition:transform .2s}
.rt-stop.busy .rt-pin span{border-color:var(--sun);color:var(--sun)}
.rt-stop.done .rt-pin span{background:#2e7d32;border-color:#66bb6a;color:#fff}
.rt-stop.cur .rt-pin span{background:var(--accent);border-color:#ff8ab3;color:#fff;box-shadow:0 0 0 6px rgba(232,25,106,.18);animation:rtPulse 1.8s ease-in-out infinite}
@keyframes rtPulse{50%{box-shadow:0 0 0 12px rgba(232,25,106,.05)}}
.rt-card{flex:1;min-width:0;display:flex;align-items:stretch;background:var(--card);border:1px solid var(--border);border-radius:20px;overflow:hidden;transition:transform .2s,box-shadow .2s,border-color .2s}
.rt-stop:hover .rt-card{transform:translateX(4px);box-shadow:0 14px 30px rgba(0,0,0,.35);border-color:var(--teal)}
.rt-stop:hover .rt-pin span{transform:scale(1.1)}
.rt-stop.cur .rt-card{border-color:var(--accent-border);box-shadow:0 0 0 1px var(--accent-border),0 12px 28px rgba(232,25,106,.15)}
.rt-img{flex:none;width:170px;background:linear-gradient(135deg,#3a2450,#1b2a44) center 30%/cover;position:relative;transition:transform .6s;display:grid;place-items:center}
.rt-img b{font-size:2.4rem;opacity:.55;transition:opacity .3s}.rt-img.ok b{opacity:0}
.rt-img::after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,transparent 55%,var(--card))}
.rt-stop:hover .rt-img{transform:scale(1.06)}
.rt-stop.done .rt-img{filter:saturate(.7)}
.rt-body{flex:1;min-width:0;padding:14px 16px}
.rt-here{display:inline-block;font-family:var(--f-mono);font-size:.68rem;letter-spacing:.05em;text-transform:uppercase;background:var(--accent);color:#fff;border-radius:20px;padding:2px 9px;margin-bottom:6px}
.rt-nr{font-family:var(--f-mono);font-size:.72rem;color:var(--teal);text-transform:uppercase;letter-spacing:.05em}
.rt-t{font-family:var(--f-head);font-weight:800;font-size:1.08rem;margin:2px 0 4px}
.rt-q{font-size:.86rem;color:#cfc3dc;font-style:italic;margin-bottom:8px}
.rt-go{align-self:center;font-size:1.6rem;color:var(--muted);padding:0 14px}
.rt-end{display:flex;gap:16px;align-items:center;margin-left:4px;font-family:var(--f-head);font-weight:700;color:var(--muted)}
.rt-end span{width:46px;height:46px;border-radius:50%;display:grid;place-items:center;background:var(--card2);border:3px dashed var(--border);font-size:1.3rem}
.rt-end.done{color:#8ee09a}.rt-end.done span{border-style:solid;border-color:#66bb6a;animation:rtPulse 1.8s infinite}
@media (max-width:640px){ .rt-img{width:96px} .rt-body{padding:10px 12px} .rt-t{font-size:.98rem} .rt-q{display:none} .rt-pin{width:40px} .rt-pin span{width:36px;height:36px} .route::before{left:18px} }

/* ══ bewaren & inloggen ══ */
.save-st{font-family:var(--f-mono);font-size:.72rem;padding:3px 8px;border-radius:8px;white-space:nowrap}
.save-st.busy{color:var(--sun)}.save-st.ok{color:#8ee09a}.save-st.err{color:#fff;background:#b71c1c;cursor:help}
.sec-note{position:fixed;left:50%;bottom:22px;transform:translateX(-50%);z-index:4000;max-width:560px;width:calc(100% - 32px);background:#2a1c2e;border:1px solid var(--accent-border);border-radius:16px;padding:14px 16px;box-shadow:0 18px 40px rgba(0,0,0,.5);font-size:.92rem}
.sec-note button{margin-left:8px;background:var(--accent);color:#fff;border:0;border-radius:10px;padding:5px 12px;cursor:pointer}
.login-choice{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}
.login-choice button{background:var(--card2);border:1px solid var(--border);color:var(--text);border-radius:10px;padding:8px 12px;cursor:pointer;font-weight:700}
.login-choice button:first-child{background:var(--accent);border-color:var(--accent);color:#fff}
.oef-lock{background:rgba(67,160,71,.12);border:1px solid rgba(67,160,71,.45);color:#b9f0c0;border-radius:12px;padding:8px 12px;margin:8px 0;font-size:.88rem}
.oef.is-locked .oef-ta{opacity:.85;cursor:not-allowed}
/* iPhone/iPad: invoervelden kleiner dan 16px laten Safari inzoomen bij het tikken */
@supports (-webkit-touch-callout: none){
  input:not([type=checkbox]):not([type=radio]):not([type=range]), textarea, select{ font-size:16px !important; }
}
/* smalle gsm: de kop paste niet (de 🏠-knop viel buiten beeld) */
@media (max-width:440px){
  #header-right{gap:5px}
  .xp-widget{min-width:0;flex-shrink:1}
  #hdr-level{max-width:100px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;display:inline-block}
  #header-right > button{padding-left:8px!important;padding-right:8px!important}
}
/* plakmoment en fruitval */
.aiw-back{position:fixed;inset:0;z-index:5000;background:rgba(8,6,14,.72);backdrop-filter:blur(4px);-webkit-backdrop-filter:blur(4px);display:flex;align-items:center;justify-content:center;padding:16px;animation:aiw-in .2s ease}
.aiw-box{background:var(--card,#1c1726);color:var(--text,#f3f0f7);border:2px solid #f5b400;border-radius:18px;max-width:480px;width:100%;max-height:calc(100vh - 32px);overflow:auto;padding:22px 20px;box-shadow:0 20px 60px rgba(0,0,0,.5);text-align:center;animation:aiw-pop .35s cubic-bezier(.2,1.4,.4,1)}
.aiw-box.aiw-val{border-color:#facc15;background:linear-gradient(180deg,#2a2410,var(--card,#1c1726) 45%)}
.aiw-big{font-size:3rem;line-height:1;margin-bottom:6px}
.aiw-val .aiw-big{animation:aiw-wobble 1s ease-in-out 2}
.aiw-box h3{font-family:'Rubik',sans-serif;font-size:1.2rem;margin:4px 0 10px}
.aiw-box p{font-size:.92rem;line-height:1.55;margin:0 0 12px;color:var(--muted,#c9c2d6)}
.aiw-why{text-align:left;font-size:.88rem;line-height:1.55;background:rgba(74,222,128,.08);border:1px solid rgba(74,222,128,.35);border-radius:12px;padding:10px 12px;margin-bottom:14px}
.aiw-q{font-size:.8rem;color:var(--muted,#c9c2d6);margin:14px 0 8px}
.aiw-btns{display:flex;flex-wrap:wrap;gap:8px;justify-content:center}
.aiw-own{display:block;width:100%;padding:12px;border:0;border-radius:12px;background:#16a34a;color:#fff;font-weight:800;font-size:1rem;cursor:pointer}
.aiw-btns .aiw-own{width:auto;flex:1 1 200px}
.aiw-alt{flex:1 1 130px;padding:9px 10px;border-radius:10px;border:1px solid var(--border,#3a3247);background:transparent;color:var(--text,#f3f0f7);font-size:.85rem;cursor:pointer}
.aiw-alt:hover,.aiw-alt:focus{border-color:#f5b400}
.aiw-toast{position:fixed;left:50%;bottom:24px;transform:translateX(-50%);z-index:5001;background:#16a34a;color:#fff;padding:10px 16px;border-radius:12px;font-size:.9rem;max-width:calc(100vw - 32px);box-shadow:0 8px 24px rgba(0,0,0,.35);animation:aiw-in .25s ease}
@keyframes aiw-in{from{opacity:0}to{opacity:1}}
@keyframes aiw-pop{from{transform:scale(.85);opacity:0}to{transform:none;opacity:1}}
@keyframes aiw-wobble{0%,100%{transform:rotate(0)}25%{transform:rotate(-18deg)}75%{transform:rotate(18deg)}}
@media (prefers-reduced-motion:reduce){.aiw-box,.aiw-big,.aiw-back{animation:none!important}}
.aiw-box p.aiw-how{font-size:.82rem;opacity:.9}
.aiw-lvl{text-align:left;font-size:.85rem;line-height:1.5;border-radius:12px;padding:9px 12px;margin:-4px 0 14px}
.aiw-lvl.l1{background:rgba(148,163,184,.1);border:1px solid rgba(148,163,184,.3)}
.aiw-lvl.l2{background:rgba(245,158,11,.12);border:1px solid rgba(245,158,11,.5)}
.aiw-lvl.l3{background:rgba(232,25,106,.14);border:1px solid rgba(232,25,106,.6)}
.bl-versie{font-size:.7rem;color:var(--muted);text-align:center;margin:10px 0 -4px;opacity:.7}
.bl-versie-in{font-size:.75em;opacity:.6;font-weight:400}

/* ══ WATERLOO als kaartspel ══ */
#view-waterloo{--wt-bg:none}
#view-waterloo .wt-combat-grid{position:relative;padding:12px;border-radius:20px;background:linear-gradient(180deg,rgba(19,15,27,.82),rgba(19,15,27,.9)),var(--wt-bg) center/cover;border:1px solid #4a3a2a;box-shadow:inset 0 0 80px rgba(0,0,0,.6)}
.wt-combat-lane{background:linear-gradient(180deg,rgba(40,24,18,.72),rgba(18,26,40,.72))!important;border:1px solid rgba(201,162,92,.35)!important;border-radius:16px!important;display:flex;flex-direction:column}
.wt-combat-lane .wt-camp-label-wellington{order:1}.wt-combat-lane .wt-camp-wellington{order:2}.wt-combat-lane .wt-camp-divider{order:3}
.wt-combat-lane .wt-camp-napoleon{order:4}.wt-combat-lane .wt-camp-label-napoleon{order:5}
.wt-camp{flex-direction:row!important;flex-wrap:wrap;justify-content:center;gap:8px!important;min-height:132px!important}
.wt-camp-divider{position:relative;text-align:center;font-family:var(--f-mono);font-size:.62rem;letter-spacing:.2em;color:#c9a25c;padding:4px 0;background:linear-gradient(90deg,transparent,rgba(201,162,92,.25),transparent)}
.wt-camp-divider::before{content:'⚔️';display:block;font-size:1rem;letter-spacing:0}
/* de kaart */
.wt-card{width:86px;height:120px;padding:0!important;border-radius:12px!important;border:0!important;background:none!important;position:relative;transition:transform .18s cubic-bezier(.3,.7,.2,1),filter .2s!important;cursor:pointer}
.wt-card .wc-frame{position:absolute;inset:0;border-radius:12px;padding:5px;display:flex;flex-direction:column;overflow:hidden;
  background:linear-gradient(160deg,#3a2c1a,#1f1710);border:3px solid #a8844a;box-shadow:0 6px 14px rgba(0,0,0,.5),inset 0 0 0 1px rgba(255,230,170,.25)}
.wt-token-napoleon.wt-card .wc-frame{border-color:#3d6fd1;background:linear-gradient(160deg,#1d2f63,#141a33)}
.wt-token-wellington.wt-card .wc-frame{border-color:#c43b3b;background:linear-gradient(160deg,#5a1a1a,#2a1010)}
.wt-card.t-elit .wc-frame{border-color:#e6c35c;box-shadow:0 0 14px rgba(230,195,92,.55),0 6px 14px rgba(0,0,0,.5)}
.wc-art{position:relative;flex:1;border-radius:8px;display:grid;place-items:center;background:radial-gradient(circle at 50% 40%,rgba(255,255,255,.25),rgba(255,255,255,0) 60%),linear-gradient(180deg,#6b8a5a,#3a4a2a);overflow:hidden}
.t-cav .wc-art{background:radial-gradient(circle at 50% 40%,rgba(255,255,255,.25),transparent 60%),linear-gradient(180deg,#7a92b8,#34486e)}
.t-art .wc-art{background:radial-gradient(circle at 50% 40%,rgba(255,255,255,.25),transparent 60%),linear-gradient(180deg,#b8865a,#5e3a1e)}
.t-elit .wc-art{background:radial-gradient(circle at 50% 40%,rgba(255,255,255,.35),transparent 60%),linear-gradient(180deg,#c9a25c,#6e5223)}
.wc-ico{font-size:2rem;filter:drop-shadow(0 3px 4px rgba(0,0,0,.5));transition:transform .3s}
.wc-flag{position:absolute;top:2px;right:3px;font-size:.62rem}
.wc-name{font-family:var(--f-head);font-weight:800;font-size:.6rem;line-height:1.1;text-align:center;color:#fff;margin-top:4px;min-height:1.3em;text-shadow:0 1px 2px #000}
.wc-type{font-size:.5rem;text-align:center;color:#d8c9a8;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.wc-bar{height:4px;border-radius:3px;background:rgba(0,0,0,.5);margin:3px 6px 10px;overflow:hidden}.wc-bar i{display:block;height:100%;background:linear-gradient(90deg,#e53935,#fdd835 60%,#43a047);transition:width .45s ease}
.wc-atk,.wc-hp{position:absolute;bottom:-8px;width:28px;height:28px;display:grid;place-items:center;font-family:var(--f-disp),'Rubik',sans-serif;font-size:.95rem;color:#fff;text-shadow:0 2px 0 rgba(0,0,0,.6);z-index:2}
.wc-atk{left:-8px;background:radial-gradient(circle at 35% 30%,#ffe082,#e0a400 60%,#8a6000);border-radius:50%;border:2px solid #4a3500}
.wc-hp{right:-8px;background:radial-gradient(circle at 35% 30%,#ff8a80,#d32f2f 60%,#7a0f0f);border-radius:50% 50% 50% 50%/60% 60% 40% 40%;border:2px solid #4a0000}
.wc-hp.low{animation:wc-pulse .8s ease-in-out infinite}
@keyframes wc-pulse{50%{transform:scale(1.18)}}
.wc-prev{position:absolute;top:-10px;left:50%;transform:translateX(-50%);background:#e53935;color:#fff;font-family:var(--f-head);font-weight:800;font-size:.75rem;border-radius:20px;padding:1px 8px;box-shadow:0 3px 8px rgba(0,0,0,.5);z-index:3;white-space:nowrap}
.wc-prev.good,.wc-prev.bonus{background:#2e7d32}.wc-prev.bad,.wc-prev.malus{background:#6d4c41}
/* toestanden */
.wt-card.wt-token-selectable:hover{transform:translateY(-8px) scale(1.04)}
.wt-card.wt-token-selectable .wc-frame{box-shadow:0 0 0 2px rgba(95,202,192,.6),0 8px 18px rgba(0,0,0,.5)}
.wt-card.wt-token-selected{transform:translateY(-14px) scale(1.1);z-index:5}
.wt-card.wt-token-selected .wc-frame{border-color:#5fcac0;box-shadow:0 0 22px rgba(95,202,192,.9),0 10px 20px rgba(0,0,0,.6)}
.wt-card.wt-token-selected .wc-ico{transform:scale(1.15) rotate(-8deg)}
.wt-card.wt-token-targetable{animation:wc-target 1.1s ease-in-out infinite}
.wt-card.wt-token-targetable .wc-frame{box-shadow:0 0 18px rgba(229,57,53,.85),0 6px 14px rgba(0,0,0,.5)}
.wt-card.wt-token-targetable:hover{transform:scale(1.08)}
@keyframes wc-target{50%{transform:translateY(-3px)}}
.wt-card.wt-token-dead{opacity:.35;filter:grayscale(1) brightness(.7);cursor:default;transform:rotate(-4deg) scale(.92)}
.wt-card.wt-dying{animation:wc-die .9s ease forwards}
@keyframes wc-die{0%{filter:none;transform:none;opacity:1}30%{filter:brightness(2) saturate(0);transform:scale(1.08) rotate(3deg)}100%{filter:grayscale(1) brightness(.7);transform:rotate(-4deg) scale(.92);opacity:.35}}
.wt-card.is-square .wc-frame{outline:3px dashed rgba(229,57,53,.7);outline-offset:2px}
.wt-card.wt-token-hit{animation:wc-hit .45s ease!important}
@keyframes wc-hit{0%,100%{transform:none}20%{transform:translateX(-7px) rotate(-3deg);filter:brightness(2.2)}40%{transform:translateX(6px) rotate(2deg)}60%{transform:translateX(-4px)}80%{transform:translateX(2px)}}
.wc-flying{pointer-events:none;filter:drop-shadow(0 18px 24px rgba(0,0,0,.6))}
.wt-shake{animation:wt-shake9 .35s ease}
@keyframes wt-shake9{20%{transform:translate(-5px,2px)}40%{transform:translate(4px,-3px)}60%{transform:translate(-3px,2px)}80%{transform:translate(2px,-1px)}}
.wc-burst{position:fixed;z-index:3100;pointer-events:none;transform:translate(-50%,-50%)}
.wc-burst span{display:block;font-size:2.6rem;animation:wc-pop .55s ease-out forwards}
.wc-burst i{position:absolute;left:50%;top:50%;width:8px;height:8px;border-radius:50%;background:#ffcf40;box-shadow:0 0 8px #ff8f00;animation:wc-spark .6s ease-out forwards}
@keyframes wc-pop{0%{transform:scale(.2);opacity:1}60%{transform:scale(1.4);opacity:1}100%{transform:scale(1.7);opacity:0}}
@keyframes wc-spark{from{transform:translate(-50%,-50%) rotate(var(--a)) translateX(0);opacity:1}to{transform:translate(-50%,-50%) rotate(var(--a)) translateX(var(--d));opacity:0}}
.wc-dmg{position:fixed;z-index:3200;pointer-events:none;transform:translate(-50%,-50%);font-family:var(--f-disp),'Rubik',sans-serif;font-size:2.2rem;color:#ff3d3d;-webkit-text-stroke:2px #2a0000;text-shadow:0 4px 0 #2a0000,0 0 18px rgba(255,61,61,.6);animation:wc-dmg 1.1s ease-out forwards}
@keyframes wc-dmg{0%{transform:translate(-50%,-50%) scale(.3)}20%{transform:translate(-50%,-70%) scale(1.35)}100%{transform:translate(-50%,-160%) scale(1);opacity:0}}
/* beurtbanner */
.wt-turn-overlay-inner{font-family:var(--f-disp),'Rubik',sans-serif!important;letter-spacing:.04em;padding:18px 40px!important;border-radius:0!important;transform:skewX(-10deg);animation:wc-sweep 1.5s cubic-bezier(.2,.8,.2,1) forwards!important;box-shadow:0 20px 60px rgba(0,0,0,.6)!important}
.wt-turn-overlay-napoleon{background:linear-gradient(90deg,#1d3b8c,#f4f1ea 50%,#c62828)!important;color:#111!important;text-shadow:0 1px 0 #fff}
.wt-turn-overlay-wellington{background:linear-gradient(90deg,#8b0000,#c62828 50%,#1a237e)!important;color:#fff!important}
@keyframes wc-sweep{0%{transform:skewX(-10deg) translateX(-120vw)}25%,75%{transform:skewX(-10deg) translateX(0)}100%{transform:skewX(-10deg) translateX(120vw)}}
.wt-sfx{margin-left:auto;background:rgba(0,0,0,.35);border:1px solid var(--border);color:#fff;border-radius:10px;padding:4px 9px;cursor:pointer}
@media (max-width:760px){
  .wt-turn-overlay-inner{font-size:1.1rem!important;padding:12px 22px!important}
  #view-waterloo .wt-combat-grid{grid-template-columns:1fr!important;padding:8px}
  .wt-camp{min-height:128px!important}
}
@media (prefers-reduced-motion:reduce){ .wt-card,.wc-burst,.wc-dmg,.wt-turn-overlay-inner{animation:none!important;transition:none!important} }
</style>
</head>
<body>

<!-- LOGIN VIEW -->
<div id="view-login" class="view active">
  <div class="login-box">
    <img src="data:image/jpeg;base64," alt="" class="login-poster" width="600" height="901">
    <div class="login-logo">!BronnenLab <span>Geschiedenis</span></div>
    <div class="login-sub">Van Napoleon tot WO I — vul je !naam en de !klascode in</div>
    <div class="login-field">
      <label>Jouw naam</label>
      <input type="text" id="login-naam" placeholder="Voornaam Achternaam" autocomplete="name" autocapitalize="words" autocorrect="off" spellcheck="false">
    </div>
    <div class="login-field">
      <label>Jouw klas</label>
      <select id="login-klas" class="login-select"><option value="">Kies je klas…</option><option value="5APDA">5APDA</option><option value="5BEOR">5BEOR</option><option value="5GEZO">5GEZO</option><option value="5HOTE">5HOTE</option><option value="5IICT">5IICT</option><option value="5OPBE">5OPBE</option><option value="5TOER">5TOER</option></select>
    </div>
    <div class="login-field">
      <label>Klascode</label>
      <input type="text" id="login-code" placeholder="Gekregen van je leerkracht" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false">
    </div>
    <div class="login-field">
      <label>Jouw PIN <span style="color:var(--muted);font-size:.8rem">(kies zelf, 4–6 cijfers)</span></label>
      <input type="password" id="login-pin" placeholder="••••" maxlength="6" inputmode="numeric" pattern="[0-9]*" autocomplete="current-password"
        onkeydown="if(event.key==='Enter')loginSubmit()">
    </div>
    <button class="login-btn" id="login-btn" onclick="loginSubmit()">Starten</button>
    <div class="login-msg" id="login-msg"></div>
    <div class="bl-versie">!BronnenLab v9.4 · 16 okt 2026</div>
    <div class="login-help">🔑 <b>PIN of naam vergeten?</b> Stuur meneer Kestelyn een bericht via Smartschool. Hij kan je PIN opzoeken of resetten.<br>Typ je naam altijd op dezelfde manier: voornaam en achternaam.</div>
  </div>
</div>

<div id="v9-bar" aria-hidden="true"></div>
<!-- HEADER -->
<div id="header">
  <div class="logo" onclick="showHome()" style="cursor:pointer"><span class="logo-b">!BRONNEN</span><span class="logo-l">LAB</span></div>
  <div id="header-right">
    <div class="xp-widget" id="xp-widget" title="Jouw voortgang">
      <span class="xp-level-badge" id="hdr-level">Niveau 1</span>
      <div class="xp-bar-wrap"><div class="xp-bar-fill" id="hdr-xp-fill" style="width:0%"></div></div>
      <span class="xp-count" id="hdr-xp-count">0 XP</span>
    </div>
    <span id="save-st" class="save-st" aria-live="polite"></span>
    <span id="header-user"></span>
    <button id="btn-logout" onclick="sbLogout()" style="display:none">↪ Afmelden</button>
    <button id="btn-inbox" onclick="showInbox()" style="display:none" title="Berichten en opdrachten van je leerkracht">💬 Berichten<span id="inbox-badge" style="display:none"></span></button>
    <button id="btn-voortgang" onclick="ST.backTo={type:'home'};showVoortgang()" title="Mijn voortgang">📈<span class="hb-l"> Voortgang</span></button>
    <button id="btn-waterloo" onclick="showWaterloo()" title="Herspeel de Slag van Waterloo met je XP!">⚔️ Waterloo</button>
    <button id="btn-home" onclick="showHome()">↩ Home</button>
  </div>
</div>

<!-- VIEW: HOME -->
<div id="view-home" class="view">

  <!-- ── HERO (v9) ── -->
  <div class="hm-hero">
    <div class="hm-shapes" aria-hidden="true"><i class="s1"></i><i class="s2"></i><i class="s3"></i><i class="s4"></i></div>
    <img src="data:image/jpeg;base64," alt="Poster BronBox: Napoleon, een Belgische vlag, een stoomlocomotief en soldaten in een loopgraaf" class="hm-poster" width="600" height="901">
    <div class="hm-main">
      <div class="hm-kicker">5de jaar · Geschiedenis-Burgerschap · GO! atheneum Oudenaarde</div>
      <h1 class="hm-title"><span>BRONNEN</span><span>LAB</span></h1>
      <div class="hm-hello" id="hm-hello">Dag 👋</div>
      <div class="hm-mission" id="hm-mission"></div>
    </div>
  </div>
  <div class="hm-tiles">
    <button class="hm-tile t1" onclick="document.getElementById('lp-section').scrollIntoView({behavior:'smooth'})"><b>🧭</b>Leerpaden<small>volg de les</small></button>
    <button class="hm-tile t2" onclick="ST.backTo={type:'home'};showCursus()"><b>📖</b>Cursus<small>lees & zoek</small></button>
    <button class="hm-tile t3" id="hm-tile-bg" onclick="ST.backTo={type:'home'};showBegrippen('kaart','')"><b>🔤</b>Begrippen<small>oefenkaarten</small></button>
    <button class="hm-tile t4" onclick="ST.backTo={type:'home'};showVoortgang()"><b>📈</b>Voortgang<small>waar sta je?</small></button>
    <button class="hm-tile t5" id="hm-tile-ib" onclick="showInbox()"><b>💬</b>Berichten<small>vragen & reacties</small></button>
  </div>
  <div class="wt-promo" id="hm-wt"></div>

  <div id="v4-rev-home"></div>
  <div id="v3-opd-home"></div>

  <!-- ── INTRO VOOR LEERLINGEN ── -->
  <details class="hm-about"><summary>ℹ️ Wat ga je hier doen? Zo werkt !BronnenLab <span class="bl-versie-in">· v9.4 · 16 okt 2026</span></summary>
  <div class="home-intro-card">
    <div class="home-intro-title">Wat ga je hier doen?</div>
    <p class="home-intro-tekst">
      In dit !bronnenlab oefen je de vaardigheden die je nodig hebt om historische bronnen te analyseren: bronnen situeren in tijd en ruimte, de auteur en het perspectief bepalen, betrouwbaarheid beoordelen, en verbanden leggen met de bredere historische context. Dat zijn exact de vaardigheden die in jouw geschiedenistoets en -examen worden gevraagd.
    </p>
    <p class="home-intro-tekst">
      Per hoofdstuk vind je een reeks primaire bronnen — toespraken, pamfletten, wetten, gedichten, foto's, verdragen. Bij elke bron werk je drie gerichte vragen door. Moeilijke woorden vind je in de woordenlijst onder elke bron. Bij de open vraag schrijf je eerst zelf een antwoord; pas daarna zie je het modelantwoord. Aan het einde van elk hoofdstuk is er een grote oefening waarbij je meerdere bronnen met elkaar vergelijkt en een zelfstandig antwoord formuleert.
    </p>
    <div class="home-intro-skills">
      <div class="home-skill-chip">📍 Situeren in tijd &amp; ruimte</div>
      <div class="home-skill-chip">🔍 Bronnenkritiek</div>
      <div class="home-skill-chip">👁️ Multiperspectiviteit</div>
      <div class="home-skill-chip">🔗 Continuïteit &amp; verandering</div>
      <div class="home-skill-chip">✍️ Argumenteren</div>
    </div>
  </div>

  <!-- ── ZO WERKT HET ── -->
  <div class="home-steps">
    <div class="home-step">
      <div class="home-step-nr">1</div>
      <div class="home-step-body">
        <div class="home-step-title">Volg het leerpad of kies een hoofdstuk</div>
        <div class="home-step-desc">Volg per les het leerpad met studiewijzer, Cornell-herhaling en zelfcheck. Of oefen vrij met de bronnen per hoofdstuk (zeven hoofdstukken, 6 tot 12 bronnen per hoofdstuk).</div>
      </div>
    </div>
    <div class="home-step">
      <div class="home-step-nr">2</div>
      <div class="home-step-body">
        <div class="home-step-title">Lees de bron, beantwoord de vragen</div>
        <div class="home-step-desc">Lees de brontekst aandachtig. Kijk in de woordenlijst als een woord moeilijk is. Beantwoord de drie vragen — gebruik de hint als je vastloopt.</div>
      </div>
    </div>
    <div class="home-step">
      <div class="home-step-nr">3</div>
      <div class="home-step-body">
        <div class="home-step-title">Doe de grote oefening</div>
        <div class="home-step-desc">Vergelijk meerdere bronnen en schrijf een zelfstandig antwoord. Pas toe wat je in de losse vragen geleerd hebt.</div>
      </div>
    </div>
  </div>

  </details>

  <!-- ── STATS ── -->
  <div class="home-stats">
    <div class="stat-card" style="--sc-c1:#7ab8ff;--sc-c2:#4f9cf9">
      <div class="stat-num" id="stat-bronnen">58</div>
      <div class="stat-lbl">Bronnen</div>
    </div>
    <div class="stat-card" style="--sc-c1:#b794ff;--sc-c2:#a78bfa">
      <div class="stat-num" id="stat-vragen">174</div>
      <div class="stat-lbl">Vragen</div>
    </div>
    <div class="stat-card" style="--sc-c1:#3ecf7a;--sc-c2:#10b981">
      <div class="stat-num" id="stat-done">0</div>
      <div class="stat-lbl">Voltooid</div>
    </div>
    <div class="stat-card" style="--sc-c1:#f0b429;--sc-c2:#fb923c">
      <div class="stat-num" id="stat-xp">0</div>
      <div class="stat-lbl">XP</div>
    </div>
  </div>

  <!-- ── LEERPADEN (v3) ── -->
  <div id="lp-section">
  <div class="section-header">
    <span class="section-title">Leerpaden — volg de les</span>
    <div class="section-line"></div>
  </div>
  <p class="lp-intro">Per les: wat je moet kunnen, je studiewijzer, een Cornell-herhaling, oefenbronnen en een zelfcheck.</p>
  <div class="chapters-grid" id="lp-grid" style="margin-bottom:36px"></div>
  </div>

  <!-- ── HOOFDSTUKKEN ── -->
  <div class="section-header">
    <span class="section-title">Bronnen per hoofdstuk</span>
    <div class="section-line"></div>
  </div>
  <div class="chapters-grid" id="chapters-grid"></div>

  <!-- ── RESET + CODE ── -->
  <div style="text-align:center;margin-top:36px;padding-bottom:8px;display:flex;flex-direction:column;align-items:center;gap:10px">
    <button onclick="resetProgress()" style="background:none;border:1px solid var(--border);color:var(--muted);font-size:.75rem;padding:6px 16px;border-radius:20px;cursor:pointer;font-family:'Nunito',sans-serif;opacity:.7;transition:opacity .2s" onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='.7'">🗑 Voortgang wissen</button>
    <button onclick="wtToggleCode()" style="background:none;border:none;color:var(--border);font-size:.68rem;cursor:pointer;font-family:'Nunito',sans-serif;padding:2px 8px;letter-spacing:.04em" title="Code invoeren">🔑</button>
    <button onclick="_NEO_SetForceXPx(9999)" style="background:#f5f5f5;border: 5px solid var(--border);font-size:.68rem;cursor:pointer;font-family:'Nunito',sans-serif;padding:2px 8px;letter-spacing:.04em" title="Code invoeren">HACK: FORCE 9999xp</button>
    <button onclick="_NEO_SetForceXPx(10)" style="background:#f5f5f5;border: 5px solid var(--border);font-size:.68rem;cursor:pointer;font-family:'Nunito',sans-serif;padding:2px 8px;letter-spacing:.04em" title="Code invoeren">HACK: FORCE 10xp</button>
    <div id="wt-code-wrap" style="display:none;align-items:center;gap:8px">
      <input id="wt-code-input" type="text" placeholder="Voer code in…"
        onkeydown="if(event.key==='Enter')wtCheckCode()"
        style="background:var(--card);border:1px solid var(--border);color:var(--text);font-family:'Nunito',sans-serif;font-size:.82rem;padding:7px 12px;border-radius:8px;outline:none;width:180px;transition:border-color .2s">
      <button onclick="wtCheckCode()" style="background:var(--card);border:1px solid var(--border);color:var(--muted);font-size:.8rem;padding:7px 12px;border-radius:8px;cursor:pointer;font-family:'Nunito',sans-serif">OK</button>
    </div>
  </div>
</div>

<!-- VIEW: LEERPAD (v3) -->
<div id="view-reeks" class="view"><div id="reeks-content"></div></div>
<!-- VIEW: LES (v3) -->
<div id="view-les" class="view"><div id="les-content"></div></div>
<!-- VIEW: BERICHTEN (v3) -->
<div id="view-inbox" class="view"><div id="inbox-content"></div></div>
<!-- VIEW: HERHAALSTAPEL (v4) -->
<div id="view-herhaal" class="view"><div id="herhaal-content"></div></div>

<!-- VIEW: CURSUS (v9) -->
<div id="view-cursus" class="view view-wide"><div id="cursus-content"></div></div>
<!-- VIEW: BEGRIPPEN (v9) -->
<div id="view-begrippen" class="view"><div id="begrippen-content"></div></div>
<!-- VIEW: VOORTGANG (v9) -->
<div id="view-voortgang" class="view"><div id="voortgang-content"></div></div>

<!-- VIEW: CHAPTER -->
<div id="view-chapter" class="view">
  <div class="chapter-header">
    <button class="back-btn" onclick="showHome()">← Terug naar overzicht</button>
    <div class="chapter-title" id="ch-title"></div>
    <div class="chapter-subtitle" id="ch-subtitle"></div>
  </div>
  <div class="bronnen-list" id="bronnen-list"></div>
</div>

<!-- VIEW: EXERCISE -->
<div id="view-exercise" class="view">
  <button class="back-btn" id="ex-back-btn">← Terug naar hoofdstuk</button>
  <div class="ex-header">
    <div class="ex-progress-wrap">
      <div class="ex-progress-track"><div class="ex-progress-fill" id="ex-prog-fill"></div></div>
      <span class="ex-step" id="ex-step-label"></span>
    </div>
  </div>
  <div id="source-block"></div>
  <div class="streak-bar" id="streak-bar">
    <span class="streak-fire">🔥</span>
    <span class="streak-msg" id="streak-msg"></span>
  </div>
  <div class="q-card" id="q-card"></div>
</div>

<!-- VIEW: GROTE OEFENING -->
<div id="view-go" class="view">
  <button class="back-btn" id="go-back-btn">← Terug naar hoofdstuk</button>
  <div id="go-content"></div>
</div>

<!-- VIEW: RESULT -->
<div id="view-result" class="view">
  <div class="result-wrap">
    <div class="result-score" id="res-score"></div>
    <div class="result-label" id="res-label"></div>
    <div class="result-msg" id="res-msg"></div>
    <div class="result-actions">
      <button class="btn-primary" id="res-retry">Opnieuw oefenen</button>
      <button class="btn-sec" id="res-chapter">Terug naar hoofdstuk</button>
    </div>
  </div>
</div>

<!-- VIEW: WATERLOO GAME -->
<div id="view-waterloo" class="view">
  <!-- Back bar -->
  <div class="wt-back-bar">
    <button class="back-btn" onclick="showHome()">← Terug</button>
    <div class="wt-back-title">⚔️ Slag van Waterloo — 18 juni 1815</div>
    <div class="wt-back-budget">Budget: <span class="wt-budget-val" id="wt-budget-display">0</span> XP</div>
  </div>
  <!-- Stepper -->
  <div id="wt-stepper" class="wt-stepper"></div>
  <!-- Phases rendered by JS -->
  <div id="wt-content"></div>
</div>

<script>
// ═══════════════════════════════════════
// GOOGLE SHEETS BACKEND
// ═══════════════════════════════════════
const _GS_URL  = 'https://script.google.com/macros/s/AKfycbwmJnPLvUNl1I55qloWXyvZ3GCHhRb_P-ZweHxpJfhFGKVjQ7T-qx_m-eUK-wVjFXD-/exec';
//const _GS_URL = "null"
const _TEACHER_NAME = 'tarskestelyn';
const _GS_STUDENT_KEY = 'bronnenlab_student';
const _GS_CODE_KEY    = 'bronnenlab_code';
const _GS_PIN_KEY     = 'bronnenlab_pin';

function _gsStudent(){ return localStorage.getItem(_GS_STUDENT_KEY)||''; }
function _gsCode()   { return localStorage.getItem(_GS_CODE_KEY)||''; }
function _gsPin()    { return localStorage.getItem(_GS_PIN_KEY)||''; }



async function _gsPost(data){
// NEO: logging input traffic ID: PLATON
  console.log("---------------------------------NEW_PAYLOAD-------------------------------------");
  console.log("_wDATA_input: ", data);
  const r = await Promise.race([
    fetch(_GS_URL,{method:'POST',body:JSON.stringify(data)}),
    new Promise((_,rej)=>setTimeout(()=>rej(new Error('Time-out')),20000))
  ]);
// NEO: logging traffic ID: PLATON
  const rClone = r.clone();
  const responseData = await rClone.json();
  console.log("_rwDATA_response:", responseData);
  const output = await r.clone().json()
  console.log("_rwDATA_output__:", output);
  return output;
}

// Sessie ophalen uit localStorage


















async function loginSubmit(){
  const naam = document.getElementById('login-naam').value.trim();
  const code = document.getElementById('login-code').value.trim();
  const pin  = document.getElementById('login-pin').value.trim();
  const klas = document.getElementById('login-klas').value;
  const msg  = document.getElementById('login-msg');
  const btn  = document.getElementById('login-btn');
  if(!naam){ msg.className='login-msg error'; msg.textContent='Vul je naam in.'; return; }
  if(!code){ msg.className='login-msg error'; msg.textContent='Vul de klascode in.'; return; }
  if(!pin||pin.length<4){ msg.className='login-msg error'; msg.textContent='Kies een PIN van minstens 4 cijfers.'; return; }
  if(!klas){ msg.className='login-msg error'; msg.textContent='Kies je klas.'; return; }
  btn.disabled=true; btn.textContent='Bezig…'; msg.textContent='';
  try{
    // Één serveraanroep: inloggen of registreren
    const res = await _gsPost({action:'loginOrRegister', student:naam, code, pin, klas});
    if(res.error){
      msg.className='login-msg error';
      msg.textContent = res.error + (/PIN/i.test(res.error) ? ' PIN vergeten? Stuur meneer Kestelyn een bericht via Smartschool.' : '');
      btn.disabled=false; btn.textContent='Starten'; return;
    }
    if(res.ok && res.data){
      _xpForce(res.data.xp||0); ST.totalStreak=res.data.total_streak||0;
      if(res.data.scores) _scoresLoad(res.data.scores);
      if(res.data.go) Object.assign(ST.goAssessments, res.data.go);
      if(res.data.answers) ST.answers = res.data.answers;
      if(res.data.open) ST.open = Object.assign({}, res.data.open, ST.open);
      _v3Load(res.data);
    }
    if(res.isNew) { msg.className='login-msg ok'; msg.textContent='Account aangemaakt!'; }
    localStorage.setItem(_GS_STUDENT_KEY, naam);
    localStorage.setItem(_GS_CODE_KEY, code);
    localStorage.setItem(_GS_PIN_KEY, pin);
    try{ localStorage.setItem('bronnenlab_klas', klas); }catch(e){}
    setTimeout(()=>_afterLogin(naam), res.isNew?800:0);
  }catch(e){
    msg.className='login-msg error'; msg.textContent=e.message||'Verbindingsfout.';
    btn.disabled=false; btn.textContent='Starten';
  }
}

function sbLogout(){
  localStorage.removeItem(_GS_STUDENT_KEY);
  localStorage.removeItem(_GS_CODE_KEY);
  localStorage.removeItem(_GS_PIN_KEY);
  try{ localStorage.removeItem('bronnenlab_klas'); }catch(e){}
  document.getElementById('login-naam').value='';
  document.getElementById('login-code').value='';
  document.getElementById('login-pin').value='';
  document.getElementById('login-btn').textContent='Starten';
  document.getElementById('login-btn').disabled=false;
  document.getElementById('login-msg').textContent='';
  _scoresClear(); _xpForce(0); ST.totalStreak=0; ST.goAssessments={};
  ST.open={}; ST.openDirty={}; ST.answers={}; V3.opd=[]; V3.fb=[]; V3.fbReadQ={}; V3.fbReplyQ={}; V3.lastSync=0;
  try{ localStorage.removeItem(LS_KEY); }catch(e){}
  _inboxBadge();
  updateXPHeader();
  document.getElementById('header-user').textContent='';
  document.getElementById('btn-logout').style.display='none';
  document.getElementById('header').style.display='none';
  const db=document.getElementById('btn-dashboard'); if(db) db.remove();
  document.querySelectorAll('.view').forEach(v=>v.classList.remove('active'));
  document.getElementById('view-login').classList.add('active');
}

function _afterLogin(naam){
// NEO: added ! to name ID: PLATON
  naam = "!" + naam;
  document.getElementById('header').style.display='';
  updateXPHeader();
  document.getElementById('header-user').textContent = naam;
  document.getElementById('btn-logout').style.display='inline-block';
  document.querySelectorAll('.view').forEach(v=>v.classList.remove('active'));
  showHome();
}

function _openDelta(){
  const d = {};
  Object.keys(ST.openDirty||{}).forEach(k=>{ if(ST.open[k]) d[k] = ST.open[k]; });
  return d;
}
function _openSet(key, patch){
  ST.open[key] = Object.assign({}, ST.open[key]||{}, patch, {ts: Date.now()});
  ST.openDirty[key] = 1;
}
async function sbSaveProgress(){
  const student = _gsStudent(); if(!student) return;
  const code = _gsCode(); if(!code) return;
  const pin = _gsPin();
  try{
    const res = await _gsPost({
      action:'save', student, code, pin,
      xp: ST.xp,
      streak: ST.totalStreak,
      scores: ST.scores,
      answers: ST.answers,
      go: ST.goAssessments,
      open: _openDelta(),
      ..._v3SavePayload(),
    });
    // Server geeft gecorrigeerde scores terug — update lokaal
    if(res?.ok && res.scores) _scoresLoad(res.scores);
    if(res?.ok){ ST.openDirty = {}; _v3AfterSave(res); }
  }catch(e){}
}

// ═══════════════════════════════════════
// STATE
// ═══════════════════════════════════════
const ST = {
  scores: {},        // {bronId: {correct,total,stars}}
  answers: {},       // {bronId: ['antwoordtekst0','antwoordtekst1','antwoordtekst2']}
  curChapter: null,
  curBron: null,
  curQIdx: 0,
  curAnswers: [],
  streak: 0,         // opeenvolgende juiste antwoorden
  totalStreak: 0,    // hoogste streak in sessie
  xp: 0,             // XP-punten
  prevLevel: 1,      // niveau vóór de laatste oefening
  goAssessments: {}, // {goId_stapIndex: 'rood'|'oranje'|'groen'}
  open: {},          // {bronId | goId#stap: {t, w, a, p, ts}} — eigen geschreven antwoorden
  openDirty: {},     // keys die nog naar de server moeten
};

// ═══════════════════════════════════════
// LOCAL STORAGE — VOORTGANG
// ═══════════════════════════════════════
const LS_KEY = 'bronnenlab_progress_v1';

// FNV-1a hash (integriteitscheck localStorage)
function _fnv(s){let h=0x811c9dc5;for(let i=0;i<s.length;i++){h^=s.charCodeAt(i);h=Math.imul(h,0x01000193)>>>0;}return h.toString(36);}
// Salt gesplitst zodat hij niet als één string zichtbaar is in de source
const _p=['62','6c','5f','73','61','76','65','5f','32','30','32','35'].map(x=>String.fromCharCode(parseInt(x,16))).join('');

function saveProgress(){
  try {
    const payload={scores:ST.scores,xp:ST.xp,totalStreak:ST.totalStreak,goAssessments:ST.goAssessments,open:ST.open};
    const sig=_fnv(JSON.stringify(payload)+_p);
    localStorage.setItem(LS_KEY,JSON.stringify({...payload,_s:sig}));
  } catch(e){}
  // Cloud opslag (async, niet-blokkerend)
  sbSaveProgress().catch(()=>{});
}

function loadProgress(){
  // Als gauntlet actief was bij afsluiten → alles wissen
  try{
    if(localStorage.getItem(_EGG_KEY)){
      localStorage.removeItem(_EGG_KEY);
      localStorage.removeItem(LS_KEY);
      return;
    }
  }catch(e){}
  try {
    const raw=localStorage.getItem(LS_KEY);
    if(!raw) return;
    const full=JSON.parse(raw);
    const {_s,...payload}=full;
// NEO: diabled
    // Integriteitscheck: als data gemanipuleerd is, wis alles
    // if(_fnv(JSON.stringify(payload)+_p)!==_s){
    //   localStorage.removeItem(LS_KEY);
    //   return;
    // }
    if(payload.scores)        _scoresLoad(payload.scores);
    if(payload.xp)            _xpForce(payload.xp);
    if(payload.totalStreak)   ST.totalStreak   = payload.totalStreak;
    if(payload.goAssessments) ST.goAssessments = payload.goAssessments;
    if(payload.open)          ST.open = payload.open;
  } catch(e){ try{localStorage.removeItem(LS_KEY);}catch(_){} }
}

function resetProgress(){
  if(!confirm('Weet je zeker dat je alle voortgang wil wissen?\nXP, scores en grote oefeningen worden gewist.')) return;
  localStorage.removeItem(LS_KEY);
  _scoresClear(); _xpForce(0); ST.totalStreak = 0; ST.goAssessments = {}; ST.open = {}; ST.openDirty = {};
  EGG.target = null; EGG.announced = false;
  sbSaveProgress().catch(()=>{}); // ook cloud wissen
  updateXPHeader();
  showHome();
}

// ═══════════════════════════════════════
// XP-SYSTEEM
// ═══════════════════════════════════════
const XP_PER_CORRECT   = 10;  // eerste keer een bron
const XP_REPLAY        = 1;   // herspelen van al voltooide bron
const XP_STREAK_BONUS  = 5;   // extra bij streak ≥ 3
const XP_STREAK_BONUS2 = 8;   // extra bij streak ≥ 5
const XP_STREAK_BONUS3 = 12;  // extra bij streak ≥ 8
// GO zelf-evaluatie
const XP_GO_GROEN  = 40;
const XP_GO_ORANJE = 20;
const XP_GO_ROOD   = 8;

const XP_LEVELS = [
  {level:1, naam:'Beginner',      min:0,   max:100},
  {level:2, naam:'Historicus',    min:100, max:250},
  {level:3, naam:'Analist',       min:250, max:500},
  {level:4, naam:'Criticus',      min:500, max:800},
  {level:5, naam:'BronnenMaster', min:800, max:Infinity},
];

function getLevelInfo(xp){
  return XP_LEVELS.find(l=>xp>=l.min && xp<l.max) || XP_LEVELS[XP_LEVELS.length-1];
}

function getLevelPct(xp){
  const l = getLevelInfo(xp);
  if(l.max===Infinity) return 100;
  return Math.min(100, Math.round((xp-l.min)/(l.max-l.min)*100));
}

function addXP(amount, x, y){
  if(!amount) return;
  ST.xp += amount;
  updateXPHeader();
  saveProgress();
  // float popup
  const pop = document.createElement('div');
  pop.className = 'xp-popup';
  pop.textContent = '+'+amount+' XP';
  pop.style.left = (x||window.innerWidth/2)+'px';
  pop.style.top  = (y||200)+'px';
  document.body.appendChild(pop);
  pop.addEventListener('animationend', ()=>pop.remove());
}

function updateXPHeader(){
  const info = getLevelInfo(ST.xp);
  const pct  = getLevelPct(ST.xp);
  if($('hdr-level'))     $('hdr-level').textContent = 'Niveau '+info.level+' · '+info.naam;
  if($('hdr-xp-fill'))   $('hdr-xp-fill').style.width = pct+'%';
  if($('hdr-xp-count'))  $('hdr-xp-count').textContent = ST.xp+' XP';
  if($('stat-xp'))       $('stat-xp').textContent = ST.xp;
  // Waterloo-knop: actief vanaf 50 XP
  const btnW = $('btn-waterloo');
  if(btnW){
    if(ST.xp >= 50) btnW.classList.add('wt-ready');
    else            btnW.classList.remove('wt-ready');
    btnW.title = ST.xp >= WT_MIN_XP
      ? `Jij hebt ${ST.xp} XP — koop eenheden en strijd bij Waterloo!`
      : `Je hebt minstens ${WT_MIN_XP} XP nodig. Nu: ${ST.xp} XP. Maak meer bronnen!`;
  }
}

