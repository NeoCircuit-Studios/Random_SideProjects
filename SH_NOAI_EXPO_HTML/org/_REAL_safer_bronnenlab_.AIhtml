// ═══════════════════════════════════════
// CHEAT CODE  (leerkracht-modus)
// ═══════════════════════════════════════
// SHA-256 hash van de code (nooit de plaintext in de source)
const _CH = 'b6535baa6cf2346d7b9facfe077b5322407df3ae1554fb754afb76e9b626b023';
async function _sha256(str){
  const buf=await crypto.subtle.digest('SHA-256',new TextEncoder().encode(str));
  return Array.from(new Uint8Array(buf)).map(b=>b.toString(16).padStart(2,'0')).join('');
}
async function wtCheckCode(){
  const input=$('wt-code-input');
  if(!input) return;
  const val=input.value.trim().toUpperCase();
  const hash=await _sha256(val);
// NEO: disabled
  // if(hash===_CH){
  if (true){
    _xpForce(9999); updateXPHeader(); saveProgress();
    input.value=''; $('wt-code-wrap').style.display='none';
    const t=document.createElement('div');
    t.textContent='🎖️ Leerkracht-modus: 9999 XP ontgrendeld!';
    Object.assign(t.style,{position:'fixed',bottom:'28px',left:'50%',transform:'translateX(-50%)',
      background:'#1a2e1a',border:'2px solid #4ade80',color:'#4ade80',
      fontFamily:"'Nunito',sans-serif",fontWeight:'700',fontSize:'.9rem',
      padding:'12px 28px',borderRadius:'10px',zIndex:'9999',
      boxShadow:'0 4px 20px rgba(74,222,128,.4)',transition:'opacity .4s ease'});
    document.body.appendChild(t);
    setTimeout(()=>{t.style.opacity='0';setTimeout(()=>t.remove(),500);},3000);
  } else {
    input.style.borderColor='#f87171';
    setTimeout(()=>{input.style.borderColor='';},1000);
  }
}
function _NEO_SetForceXPx(input) {
  spawnConfetti();
  spawnConfetti();
  if (!input) input = 10;
  _xpForce(input); updateXPHeader(); saveProgress();
  _secNotice('HACK: added ', input, " XP!");
}
function _NEO_Telluser(text) {
    const t=document.createElement('div');
    t.textContent=text;
    Object.assign(t.style,{position:'fixed',bottom:'28px',left:'50%',transform:'translateX(-50%)',
      background:'#1a2e1a',border:'2px solid #4ade80',color:'#4ade80',
      fontFamily:"'Nunito',sans-serif",fontWeight:'700',fontSize:'.9rem',
      padding:'12px 28px',borderRadius:'10px',zIndex:'9999',
      boxShadow:'0 4px 20px rgba(74,222,128,.4)',transition:'opacity .4s ease'});
    document.body.appendChild(t);
    setTimeout(()=>{t.style.opacity='0';setTimeout(()=>t.remove(),500);},3000);
}
function wtToggleCode(){
  const wrap = $('wt-code-wrap');
  if(!wrap) return;
  const visible = wrap.style.display !== 'none';
  wrap.style.display = visible ? 'none' : 'flex';
  if(!visible) setTimeout(()=>{ const inp=$('wt-code-input'); if(inp) inp.focus(); }, 50);
}
