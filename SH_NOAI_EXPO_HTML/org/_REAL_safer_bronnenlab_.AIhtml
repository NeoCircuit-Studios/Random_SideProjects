 }
];

function showGroteOefening(id){
  const go = GROTE_OEFENINGEN.find(x=>x.id===id);
  if(!go) return;
  ST.curChapter = go.hId;
  ST.curGO = go.id;
  renderGroteOefening(go);
  $('go-back-btn').textContent = _backLabel(); $('go-back-btn').onclick = ()=>_backTarget();
  showView('view-go');
}

function renderGroteOefening(go){
  const bronCardsHTML = go.bronIds.map((bid,i)=>{
    const b = getBron(bid);
    return `<div class="go-bron-card">
      <div class="go-bron-letter">Bron ${go.bronLetters[i]}</div>
      <div class="go-bron-titel">${b.titel}</div>
      <div class="go-bron-meta">${b.auteur} · ${b.datum}</div>
      <div class="go-bron-citaat">${go.bronCitaten[i]}</div>
    </div>`;
  }).join('');

  const stappenHTML = go.stappen.map((s,i)=>{
    const minW = s.nr === 4 ? 50 : 20;
    const isOpen = s.nr === 4;
    const ph = s.nr === 4
      ? 'Schrijf hier je volledige antwoord (minstens 50 woorden). Gebruik de bronnen expliciet: Bron A, Bron B, Bron C...'
      : 'Schrijf hier je antwoord op deze stap...';
    return `
    <div class="go-stap" id="go-stap-${i}">
      <div class="go-stap-head" onclick="toggleGoStap(${i})">
        <div class="go-stap-nr" id="go-nr-${i}">${s.nr}</div>
        <div class="go-stap-label">Stap ${s.nr}: ${s.label}</div>
        <span class="go-stap-chevron${isOpen?' open':''}" id="go-chev-${i}">›</span>
      </div>
      <div class="go-stap-body${isOpen?' open':''}" id="go-stap-body-${i}">
        <p class="go-taak">${s.taak}</p>
        <div class="go-tip"><strong>💡 Scaffolding</strong>${s.tip}</div>

        <div class="go-input-area">
          <div class="go-input-label">✏️ Jouw antwoord</div>
          <textarea class="go-textarea" id="go-ta-${i}"
            placeholder="${ph}"
            oninput="goWC(${i},this,${minW})"></textarea>
          <div class="go-input-footer">
            <span class="go-wordcount" id="go-wc-${i}">0 woorden</span>
            <div class="go-wc-bar-wrap"><div class="go-wc-bar" id="go-bar-${i}"></div></div>
            <span class="go-wc-hint" id="go-wc-hint-${i}">schrijf minstens ${minW} woorden om het modelantwoord te ontgrendelen</span>
          </div>
        </div>

        <button class="go-model-btn locked" id="go-mbtn-${i}" onclick="toggleGoModel(${i})">
          🔒 Toon modelantwoord
        </button>
        <div class="go-model-box" id="go-model-${i}">
          <div id="go-model-text-${i}">${s.model}</div>
          <div class="go-selfassess" id="go-sa-${i}">
            <div class="go-sa-label">📊 Vergelijk met jouw antwoord — hoe goed was jij?</div>
            <div class="go-sa-btns">
              <button class="go-sa-btn" onclick="goAssess(${i},'rood')">🔴 Nog te leren</button>
              <button class="go-sa-btn" onclick="goAssess(${i},'oranje')">🟡 Grotendeels correct</button>
              <button class="go-sa-btn" onclick="goAssess(${i},'groen')">🟢 Volledig correct</button>
            </div>
          </div>
        </div>
      </div>
    </div>`}).join('');

  $('go-content').innerHTML = `
    <div class="go-titel">${go.titel}</div>
    <div class="go-meta">Grote oefening · ${go.meta || ''} · Gebruik de ${go.bronIds.length} bronnen hieronder</div>
    <div class="go-vraag-card">
      <div class="go-vraag-label">★ Historische onderzoeksvraag</div>
      <div class="go-vraag-tekst">${go.titel}</div>
    </div>
    <div class="go-bronnen-grid">${bronCardsHTML}</div>
    <p style="font-size:.82rem;color:var(--muted);margin-bottom:18px;font-style:italic">
      ✏️ Schrijf bij elke stap eerst je eigen antwoord voordat je het modelantwoord ontgrendelt.
    </p>
    <div class="go-stappen">${stappenHTML}</div>`;
  // Herstel eerder geschreven antwoorden (vastgezet) + plak-detectie
  go.stappen.forEach((s,i)=>{
    const ta = $('go-ta-'+i); if(!ta) return;
    ta.addEventListener('paste', e=>{ const t=(e.clipboardData||window.clipboardData)?.getData('text')||''; if(t.length>40) ta.dataset.pasted='1'; });
    const prev = ST.open[(ST.curGO||'')+'#'+i];
    if(prev && prev.t){
      ta.value = prev.t;
      goWC(i, ta, s.nr===4?50:20);
      ta.readOnly = true; ta.classList.add('locked');
      const h = $('go-wc-hint-'+i); if(h){ h.textContent='✓ Ingediend — je antwoord is vastgezet'; h.style.color='var(--green)'; }
    }
  });
  // Herstel opgeslagen GO-beoordelingen
  const prefix = (ST.curGO || '') + '_';
  Object.entries(ST.goAssessments).forEach(([key, kleur])=>{
    if(!key.startsWith(prefix)) return;
    const i = parseInt(key.slice(prefix.length));
    if(isNaN(i)) return;
    const nr = $('go-nr-'+i);
    const sa = $('go-sa-'+i);
    if(!sa) return;
    const clicked = sa.querySelector(`.go-sa-btn:nth-child(${kleur==='rood'?1:kleur==='oranje'?2:3})`);
    if(clicked) clicked.classList.add('sel-'+kleur);
    if(nr){ nr.classList.remove('ass-rood','ass-oranje','ass-groen'); nr.classList.add('ass-'+kleur); }
  });
}

function toggleGoStap(i){
  const body = $('go-stap-body-'+i);
  const chev = $('go-chev-'+i);
  const open = body.classList.toggle('open');
  chev.classList.toggle('open', open);
}

function goWC(i, el, minW){
  const words = el.value.trim().split(/\s+/).filter(w=>w.length>0).length;
  if(el.readOnly) return;
  const wc = $('go-wc-'+i);
  const bar = $('go-bar-'+i);
  const hint = $('go-wc-hint-'+i);
  const btn = $('go-mbtn-'+i);
  if(wc) wc.textContent = words + ' woorden';
  const pct = Math.min(100, Math.round(words/minW*100));
  if(bar){
    bar.style.width = pct+'%';
    bar.style.background = words >= minW ? 'var(--green)' : 'var(--blue)';
  }
  if(words >= minW){
    btn.classList.remove('locked');
    if(hint){ hint.textContent = '✓ Klaar! Je kunt het modelantwoord bekijken.'; hint.style.color='var(--green)'; }
  } else {
    btn.classList.add('locked');
    if(hint){ hint.textContent = `schrijf minstens ${minW} woorden om het modelantwoord te ontgrendelen`; hint.style.color=''; }
  }
}

function toggleGoModel(i){
  const btn = $('go-mbtn-'+i);
  if(btn.classList.contains('locked')) return;
  const ta = $('go-ta-'+i);
  if(ta && !ta.readOnly){
    const key = (ST.curGO||'')+'#'+i;
    _openSet(key, {t: ta.value.trim().slice(0,3000), w: _wordCount(ta.value), p: ta.dataset.pasted?1:0});
    ta.readOnly = true; ta.classList.add('locked');
    const h = $('go-wc-hint-'+i); if(h){ h.textContent='✓ Ingediend — je antwoord is vastgezet'; h.style.color='var(--green)'; }
    saveProgress();
  }
  const box = $('go-model-'+i);
  const vis = box.classList.toggle('visible');
  btn.textContent = vis ? '▲ Verberg modelantwoord' : '▼ Toon modelantwoord';
}

function goAssess(i, kleur){
  const nr = $('go-nr-'+i);
  const sa = $('go-sa-'+i);
  if(!sa) return;
  sa.querySelectorAll('.go-sa-btn').forEach(b=>{
    b.classList.remove('sel-rood','sel-oranje','sel-groen');
  });
  const clicked = sa.querySelector(`.go-sa-btn:nth-child(${kleur==='rood'?1:kleur==='oranje'?2:3})`);
  if(clicked) clicked.classList.add('sel-'+kleur);
  if(nr){ nr.classList.remove('ass-rood','ass-oranje','ass-groen'); nr.classList.add('ass-'+kleur); }
  // opslaan
  const goId = ST.curGO || '';
  const key = goId+'_'+i;
  const wasAlreadySet = !!ST.goAssessments[key];
  ST.goAssessments[key] = kleur;
  _openSet(goId+'#'+i, {a: kleur});
  if(_goDone(goId)) _opdMark('go', goId, '');
  saveProgress();
  // XP toekennen — alleen de eerste keer dat deze stap beoordeeld wordt
  if(!wasAlreadySet){
    const goXP = XP_GO_STAP;
    const btn = $('go-nr-'+i);
    const rect = btn ? btn.getBoundingClientRect() : null;
    const px = rect ? rect.left + rect.width/2 : window.innerWidth/2;
    const py = rect ? rect.top : 200;
    addXP(goXP, px, py);
  }
}

// ═══════════════════════════════════════
// EASTER EGG — geheime uitdaging
// ═══════════════════════════════════════
const _EGG_KEY = '_egg_g';
// Examenvraag XOR-geobfusceerd (key=0x5E)
// Examenvraag staat server-side in Apps Script — niet in de broncode

const EGG = {
  gauntletActive: false,
  questions: [],
  idx: 0,
  timerInterval: null,
  timeLeft: 25,
  unlocked: false,
  target: null,     // {v, s, i, top, left} — vaste locatie per student
  announced: false, // "Happy Easter" al getoond?
  // teacherMode: false, // via #eggtest — gauntlet zonder progressieverlies
// NEO: made true
  teacherMode: true, // via #eggtest — gauntlet zonder progressieverlies
};

// Minimum XP om alle bronnen legitiem te halen (aantal bronnen × 10 XP)
const _EGG_MIN_XP = HOOFDSTUKKEN.reduce((a,h)=>a+h.bronnen.length,0) * 10;

function eggAllDone(){
  // Cross-check XP: XP is al beschermd door Object.defineProperty,
  // dus dit kan niet nep zijn via de console
  if(ST.xp < _EGG_MIN_XP) return false;
  return HOOFDSTUKKEN.every(h=>h.bronnen.every(b=>(ST.scores[b.id]?.stars||0)===3));
}

// Alle mogelijke ei-spots per view (selector + view-id)
const _EGG_SPOTS = [
  {v:'view-home',     s:'.chapter-card'},
  {v:'view-home',     s:'.chapter-card'},   // dubbel = hogere kans op homepage
  {v:'view-chapter',  s:'.bron-item'},
  {v:'view-exercise', s:'.source-card'},
  {v:'view-exercise', s:'#q-card'},
  {v:'view-go',       s:'.go-stap'},
  {v:'view-waterloo', s:'.wt-intro-phase-card'},
  {v:'view-waterloo', s:'.wt-combat-lane'},
];

function _eggPickTarget(){
  // Kies één vaste willekeurige spot voor deze student
  const spot = _EGG_SPOTS[Math.floor(Math.random()*_EGG_SPOTS.length)];
  EGG.target = {
    v:    spot.v,
    s:    spot.s,
    i:    Math.floor(Math.random()*5), // index (wordt afgekapt als te groot)
    top:  (15 + Math.floor(Math.random()*65))+'%',
    left: (10 + Math.floor(Math.random()*80))+'%',
  };
}

function _eggAnnounce(){
  // "Happy Easter" overlay — verschijnt één keer wanneer alle bronnen klaar zijn
  const ov = document.createElement('div');
  ov.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.82);z-index:99990;'+
    'display:flex;align-items:center;justify-content:center;animation:fadeIn .4s ease';
  ov.innerHTML = `
    <div style="background:var(--surface);border:2px solid var(--amber);border-radius:16px;
      padding:40px 48px;max-width:480px;text-align:center;box-shadow:0 0 60px rgba(245,197,24,.25)">
      <div style="font-size:3.5rem;margin-bottom:12px">🥚</div>
      <div style="font-size:1.5rem;font-weight:700;color:var(--amber);margin-bottom:10px">
        Happy Easter!
      </div>
      <div style="font-size:1rem;color:var(--text-secondary);line-height:1.6;margin-bottom:24px">
        Je hebt alle bronnen 100% afgerond.<br>
        Ergens op dit platform verstopt zich een paasei.<br>
        <strong style="color:var(--text)">Vind het — en de uitdaging begint.</strong>
      </div>
      <button onclick="this.closest('div[style]').remove()"
        style="background:var(--amber);color:#000;border:none;padding:10px 28px;
        border-radius:8px;font-weight:700;cursor:pointer;font-size:1rem">
        De jacht is open 🐣
      </button>
    </div>`;
  document.body.appendChild(ov);
  ov.addEventListener('click', e=>{ if(e.target===ov) ov.remove(); });
}

function _eggToast(msg){
  // Korte zichtbare toast voor leerkrachtbevestiging
  let t = document.getElementById('_egg_toast');
  if(!t){
    t = document.createElement('div');
    t.id = '_egg_toast';
    t.style.cssText = 'position:fixed;bottom:30px;left:50%;transform:translateX(-50%);'+
      'background:#f5c518;color:#000;font-weight:bold;padding:10px 22px;border-radius:8px;'+
      'z-index:99999;font-size:15px;box-shadow:0 4px 16px rgba(0,0,0,.5);pointer-events:none;'+
      'transition:opacity .4s;';
    document.body.appendChild(t);
  }
  t.textContent = msg;
  t.style.opacity = '1';
  clearTimeout(t._to);
  t._to = setTimeout(()=>{ t.style.opacity='0'; }, 2500);
}

function eggMaybePlace(_force){
  document.querySelectorAll('.egg-spark').forEach(e=>e.remove());

  // NEO: removed check
  // if(_force){
    // LEERKRACHTMODUS: kies altijd nieuw random doel + toon meteen op actieve view
    _eggPickTarget();
    _eggPlaceSpark(_force);
    return;
  // }

  if(EGG.unlocked) return;
  if(!eggAllDone()) return;

  // Eerste keer dat alle bronnen klaar zijn: aankondiging + doelkeuze
  if(!EGG.announced){
    EGG.announced = true;
    _eggPickTarget();
    _eggAnnounce();
  }

  // Toon ei alleen als de leerling op de juiste view zit
  _eggPlaceSpark(false);
}

function _eggPlaceSpark(_force){
  if(!EGG.target) return;
  const t = EGG.target;

  // Controleer of de juiste view actief is
  const activeView = document.querySelector('.view.active');
  const onRightView = activeView && activeView.id === t.v;
  if(!onRightView && !_force) return;

  // Zoek het element (op index, of het laatste als index te groot)
  const scope = onRightView ? activeView : document;
  const matches = Array.from(scope.querySelectorAll(t.s)).filter(el=>el.offsetParent!==null);
  if(!matches.length){
// NEO: removed check

    // if(_force){
      // Fallback op body voor leerkrachttest
      _eggPlaceOnBody(_force);
    // }
    return;
  }
  const host = matches[Math.min(t.i, matches.length-1)];
  host.style.position = 'relative';

  const spark = document.createElement('span');
  spark.className = 'egg-spark';
  spark.textContent = '🥚';
  spark.title = '';
  spark.style.top  = t.top;
  spark.style.left = t.left;
  spark.onclick = e=>{ e.stopPropagation(); eggWarnAndStart(); };
  host.appendChild(spark);

// NEO: removed check
  // if(_force) _eggDebugFeedback(host, t);
  _eggDebugFeedback(host, t);
}

function _eggPlaceOnBody(_force){
  const spark = document.createElement('span');
  spark.className = 'egg-spark';
  spark.textContent = '🥚';
  spark.title = '';
  spark.style.position = 'fixed';
  spark.style.top  = (15+Math.floor(Math.random()*65))+'vh';
  spark.style.left = (10+Math.floor(Math.random()*75))+'vw';
  spark.onclick = e=>{ e.stopPropagation(); eggWarnAndStart(); };
  document.body.appendChild(spark);
  if(_force) _eggToast('📍 Ei staat op: 📄 Pagina (body-fallback) — juiste view: #'+(EGG.target?.v||'?'));
}

function _eggDebugFeedback(host, t){
  const _LOC = {
    'chapter-card':        '🏠 Homepage — hoofdstukkaart',
    'bron-item':           '📚 Hoofdstuk — bronnenitem',
    'source-card':         '🖼️ Oefening — brontekst',
    'q-card':              '❓ Oefening — vraagkaart',
    'go-stap':             '📋 Grote oefening — stap',
    'wt-intro-phase-card': '⚔️ Waterloo — introkaart',
    'wt-combat-lane':      '⚔️ Waterloo — gevechtsbaan',
  };
  const cls = (host.className||'').split(' ')[0];
  const lbl = _LOC[cls] || cls || host.id;
  _eggToast('📍 Ei staat op: '+lbl+' (view: #'+t.v+')');
  // Geel knipperend kader
  let n=0; const prev=host.style.outline;
  const iv=setInterval(()=>{
    host.style.outline=(n++%2===0)?'3px solid #f5c518':'none';
    if(n>6){clearInterval(iv);host.style.outline=prev;}
  },220);
}

// LEERKRACHTCODE — URL-hash #eggtest plaatst het ei onmiddellijk (teacher only)
// #eggtest trigger uitgeschakeld voor productie

function eggWarnAndStart(){
  if(!confirm('⚠️ Je hebt alle bronnen 100% voltooid!\n\nEr wacht je een geheime uitdaging:\n\n• 10 vragen uit de volledige cursus\n• Tijdslimiet: 25 seconden per vraag\n• Eén fout = ALLES kwijt\n\nBen je zeker dat je wilt starten?')) return;
  if(!confirm('LAATSTE WAARSCHUWING ⚠️\n\nBij één fout OF verlopen tijd verlies je AL je XP, scores en voortgang — permanent.\n\nDruk op OK om de uitdaging te starten.')) return;
  startGauntlet();
}

function startGauntlet(){
  try{ localStorage.setItem(_EGG_KEY,'1'); }catch(e){}
  EGG.gauntletActive = true;
  EGG.unlocked = false;
  EGG.idx = 0;
  // Bouw pool van alle vragen
  const pool = [];
  HOOFDSTUKKEN.forEach(h=>h.bronnen.forEach(b=>{
    b.vragen.forEach((q,qi)=>pool.push({b, q, qi}));
  }));
  // Fisher-Yates shuffle
  for(let i=pool.length-1;i>0;i--){
    const j=Math.floor(Math.random()*(i+1));
    [pool[i],pool[j]]=[pool[j],pool[i]];
  }
  EGG.questions = pool.slice(0,10);
  renderGauntletQ();
}

function renderGauntletQ(){
  const {b, q} = EGG.questions[EGG.idx];
  const num = EGG.idx + 1;
  const shuffled = shuffleOptions(q); // hergebruik bestaande functie
  const circumference = 2*Math.PI*44;

  // Verwijder bestaande overlay
  const old = document.getElementById('egg-overlay');
  if(old) old.remove();

  const overlay = document.createElement('div');
  overlay.id = 'egg-overlay';
  overlay.className = 'egg-gauntlet-wrap';
  overlay.innerHTML = `
    <div class="egg-gauntlet-inner">
      <div class="egg-gauntlet-header">
        <div class="egg-gauntlet-title">⚡ GEHEIME UITDAGING</div>
        <div class="egg-q-counter">Vraag ${num} / 10</div>
        <div class="egg-timer-wrap">
          <svg class="egg-timer-svg" viewBox="0 0 100 100">
            <circle cx="50" cy="50" r="44" fill="none" stroke="rgba(255,255,255,.08)" stroke-width="7"/>
            <circle id="egg-timer-ring" cx="50" cy="50" r="44" fill="none" stroke="#ef4444" stroke-width="7"
              stroke-dasharray="${circumference.toFixed(1)}" stroke-dashoffset="0"
              stroke-linecap="round" transform="rotate(-90 50 50)" style="transition:stroke-dashoffset .9s linear"/>
          </svg>
          <div id="egg-timer-num" class="egg-timer-num">25</div>
        </div>
      </div>
      <div class="egg-source-label">📜 ${b.titel} · ${b.datum}</div>
      <div class="egg-question-text">${q.q}</div>
      <div class="egg-options">
        ${shuffled.opts.map((opt,i)=>`<button class="egg-option" onclick="handleGauntletAnswer(${i},${shuffled.correct})">${opt}</button>`).join('')}
      </div>
      ${EGG.teacherMode ? `<div style="text-align:center;margin-top:18px;display:flex;gap:10px;justify-content:center">
        <button onclick="gauntletTeacherNext()" style="background:rgba(80,200,80,.15);color:rgba(150,255,150,.7);
          border:1px dashed rgba(100,200,100,.3);padding:6px 18px;border-radius:6px;cursor:pointer;font-size:.8rem">
          ⚙️ Vraag goed rekenen →
        </button>
        <button onclick="gauntletTeacherSkip()" style="background:rgba(255,255,255,.06);color:rgba(255,255,255,.3);
          border:1px dashed rgba(255,255,255,.15);padding:6px 14px;border-radius:6px;cursor:pointer;font-size:.8rem">
          ✕ Sluiten
        </button></div>` : ''}
    </div>`;
  document.body.appendChild(overlay);
  startGauntletTimer(circumference);
}

function startGauntletTimer(circumference){
  if(EGG.timerInterval) clearInterval(EGG.timerInterval);
  EGG.timeLeft = 25;
  const ring = ()=>document.getElementById('egg-timer-ring');
  const num  = ()=>document.getElementById('egg-timer-num');
  // Zet dashoffset onmiddellijk op 0
  setTimeout(()=>{
    const r = ring();
    if(r) r.style.strokeDashoffset = circumference * (1 - EGG.timeLeft/25);
  }, 50);
  EGG.timerInterval = setInterval(()=>{
    EGG.timeLeft--;
    const r=ring(), n=num();
    if(n) n.textContent = EGG.timeLeft;
    if(r) r.style.strokeDashoffset = (circumference*(1-EGG.timeLeft/25)).toFixed(1);
    if(EGG.timeLeft<=7){ if(n){n.style.color='#ef4444'; n.style.animation='egg-blink .4s step-end infinite';} if(r) r.style.stroke='#dc2626'; }
    if(EGG.timeLeft<=0){ clearInterval(EGG.timerInterval); gauntletFail('⏱️ TIJD OP!'); }
  }, 1000);
}

function handleGauntletAnswer(chosen, correctIdx){
  if(!EGG.gauntletActive) return;
  clearInterval(EGG.timerInterval);
  if(chosen !== correctIdx){ gauntletFail('✗ FOUT ANTWOORD'); return; }
  EGG.idx++;
  if(EGG.idx >= 10) gauntletSuccess();
  else renderGauntletQ();
}

function gauntletTeacherNext(){
  // NEO: disabled
