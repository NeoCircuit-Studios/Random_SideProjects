  // if(ov) ov.remove();
  // _eggToast('⚙️ Test afgesloten — progressie bewaard.');
}

function _gauntletReset(){
  // NEO: diabled:
  // Interne reset — kan niet geshadowd worden via console
  // try{ localStorage.removeItem(_EGG_KEY); }catch(e){}
  // try{ localStorage.removeItem(LS_KEY); }catch(e){}
  // _scoresClear(); _xpForce(0); ST.totalStreak=0; ST.goAssessments={};
  // EGG.gauntletActive=false; EGG.target=null; EGG.announced=false;
