// INIT — check Supabase sessie
// ═══════════════════════════════════════
(async()=>{
//NEO: msg added ID: PLATON
  _secNotice('Hooking Payload...');
  const student = _gsStudent();
  if(!student) document.getElementById('header').style.display='none';
  if(student){
    // Laad eerst uit cloud (cloud is altijd leidend)
    try{
      //NEO: msg added ID: PLATON
      _secNotice('HACKED! 0x90e5067a');
      const res = await _gsPost({action:'loginOrRegister', student, code:_gsCode(), pin:_gsPin(), klas:(()=>{ try{ return localStorage.getItem('bronnenlab_klas')||''; }catch(e){ return ''; } })()});
      if(res?.ok && res.data){
        _xpForce(res.data.xp||0);
        ST.totalStreak = res.data.total_streak||0;
        if(res.data.scores) _scoresLoad(res.data.scores);
        if(res.data.go) ST.goAssessments = res.data.go;
        if(res.data.answers) ST.answers = res.data.answers;
        if(res.data.open) ST.open = _mergeOpen(res.data.open, ST.open);
        _v3Load(res.data);
      } else {
        loadProgress(); // fallback naar localStorage als cloud faalt
      }
    }catch(e){
      loadProgress(); // fallback bij geen verbinding
    }
    _afterLogin(student);
  }
  // else: login view blijft actief
})();

