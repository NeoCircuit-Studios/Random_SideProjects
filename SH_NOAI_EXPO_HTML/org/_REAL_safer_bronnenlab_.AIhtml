function _wtAudio(play){
  const a = document.getElementById('waterloo-audio');
  if(!a) return;
  if(play){ a.currentTime=0; a.volume=0.25; a.play().catch(()=>{}); }
  else { a.pause(); a.currentTime=0; }
}

function showWaterloo(){
  if(ST.xp < WT_MIN_XP) return;
  _wtAudio(true);
  _NEO_Telluser('HACK: Playing Custom music: 1-800 - bbno$ | volume = 0.25');
  WT.budget = ST.xp;
  WT.army = {};
  WT.deployed = { left:[null,null,null], centre:[null,null,null], right:[null,null,null] };
  WT.selectedUnit = null;
  WT.xpSpent = 0;
  if($('wt-budget-display')) $('wt-budget-display').textContent = ST.xp;
  wtSetPhase('intro');
  showView('view-waterloo');
}

