 {
  "id": "h2b1",
  "titel": "De Code Civil — kernartikelen",
  "auteur": "Commissie o.l.v. Napoleon Bonaparte",
  "type": "Juridisch document (wetboek)",
  "datum": "21 maart 1804",
  "domein": [
