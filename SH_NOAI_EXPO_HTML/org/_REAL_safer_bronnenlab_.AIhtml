function gauntletFail(reason){
  EGG.gauntletActive = false;
  clearInterval(EGG.timerInterval);

  // NEO: diabled:
  // Leerkrachtmodus: geen progressieverlies, gewoon sluiten
  // if(EGG.teacherMode){
  //   EGG.teacherMode = false;
    try{ localStorage.removeItem(_EGG_KEY); }catch(e){}
    const ov = document.getElementById('egg-overlay');
    if(ov) ov.remove();
    _eggToast('⚙️ Test: '+reason+' — progressie bewaard (leerkrachtmodus).');
    return;
  // }

  const overlay = document.getElementById('egg-overlay');
  if(overlay){
    overlay.innerHTML=`
      <div class="egg-fail-inner">
        <div class="egg-fail-icon">💀</div>
        <div class="egg-fail-title">${reason}</div>
        <div class="egg-fail-sub">AL JE VOORTGANG IS GEWIST</div>
        <div class="egg-fail-msg">Scores, XP, alles — verdwenen.<br>Begin opnieuw.</div>
      </div>`;
  }
  setTimeout(()=>{
    _gauntletReset();
    updateXPHeader();
    const ov = document.getElementById('egg-overlay');
    if(ov) ov.remove();
    showHome();
  }, 2800);
}

async function gauntletSuccess(){
  EGG.gauntletActive = false;
  EGG.unlocked = true;
  clearInterval(EGG.timerInterval);
  try{ localStorage.removeItem(_EGG_KEY); }catch(e){}
  document.querySelectorAll('.egg-spark').forEach(e=>e.remove());

  // Toon eerst laadscherm
  const overlay = document.getElementById('egg-overlay');
  if(overlay) overlay.innerHTML=`
    <div class="egg-success-inner">
      <div class="egg-success-icon">🏆</div>
      <div class="egg-success-title">UITDAGING VOLTOOID!</div>
      <div class="egg-success-sub">Examenvraag wordt geladen…</div>
    </div>`;

  // Markeer gauntlet als voltooid op server, haal dan examenvraag op
  let examText = '— Neem contact op met je leerkracht voor de examenvraag —';
  try{
    await _gsPost({action:'gauntletComplete', student:_gsStudent(), code:_gsCode(), pin:_gsPin()});
    const res = await _gsPost({action:'examvraag', student:_gsStudent(), code:_gsCode(), pin:_gsPin()});
    if(res?.ok && res?.data?.examvraag) examText = res.data.examvraag;
  }catch(e){}

  if(overlay){
    overlay.innerHTML=`
      <div class="egg-success-inner">
        <div class="egg-success-icon">🏆</div>
        <div class="egg-success-title">UITDAGING VOLTOOID!</div>
        <div class="egg-success-sub">Jij bent de beste historicus van de klas. Onthoud deze vraag goed.</div>
        <div class="egg-exam-box">
          <div class="egg-exam-label">📋 JOUW EXAMENVRAAG</div>
          <div class="egg-exam-text">${examText}</div>
        </div>
        <button class="egg-close-btn" onclick="document.getElementById('egg-overlay').remove();showHome()">✓ Bewaard!</button>
      </div>`;
  }
}

