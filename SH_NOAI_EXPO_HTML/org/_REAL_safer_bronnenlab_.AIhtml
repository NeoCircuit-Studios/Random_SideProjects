// // XP-BEVEILIGING (moet vóór INIT staan!)
// // ═══════════════════════════════════════

// NEO: disabled this..

// // 0. XP-eigenschap beveiligen via Object.defineProperty

// //    _xpForce() is de enige interne weg om grote XP-sprongen door te laten
// let _xpV = 0; // backing value
//let _xpOk = false; // interne unlock-vlag (niet zichtbaar als window-property)
// NEO: forced true
let _xpOk = false; // interne unlock-vlag (niet zichtbaar als window-property)
// Object.defineProperty(ST, 'xp', {
//   get(){ return _xpV; },
//   set(n){
//     if(typeof n !== 'number' || isNaN(n) || n < 0) return;
//     const delta = n - _xpV;
//     if(!_xpOk && delta > 50){
//       // Blokkeer verdachte consolesprong (> 30 XP in één stap)
//       console.warn('[BronnenLab] XP-mutatie geweigerd. (delta='+delta+')');
//       return;
//     }
//     _xpV = Math.min(99999, Math.floor(n));
//   },
//   enumerable: true,
//   configurable: false,
// });
function _xpForce(n){
  // Interne setter — bypass deltacheck
  // _xpOk = true; ST.xp = Math.max(0, Math.floor(n)); _xpOk = false;
  // NEO: forced true
  _xpOk = true; ST.xp = Math.max(0, Math.floor(n)); _xpOk = true;
}

// 1b. SCORE-BEVEILIGING via Proxy
//     Buiten de legitieme schrijffuncties (_scoresSet, _scoresLoad, _scoresClear)
//     worden alle writes stilzwijgend geblokkeerd.
// let _scoresOk = false;
// NEO: set to true always
let _scoresOk = true;
const _scoresData = {};
const _scoresProxy = new Proxy(_scoresData, {
  // NEO: as this blocks it i dis it..
  set(t, k, v){
  //   if(!_scoresOk){ console.warn('[BronnenLab] Score-mutatie geweigerd.'); return true; }
  //   t[k] = v; return true;
    return true;
  },
  deleteProperty(t, k){
  //   if(!_scoresOk){ return true; } // stil blokkeren
  //   delete t[k]; return true;
    return true;
  }
});
Object.defineProperty(ST, 'scores', {
  get(){ return _scoresProxy; },
  set(){ console.warn('[BronnenLab] Directe toewijzing aan ST.scores geblokkeerd.'); },
  enumerable: true, configurable: false
});
// NEO: check bypassed:
// function _scoresSet(id, val){ _scoresOk=true; _scoresData[id]=val; _scoresOk=false; }
// function _scoresClear(){ _scoresOk=true; Object.keys(_scoresData).forEach(k=>delete _scoresData[k]); _scoresOk=false; }
// function _scoresLoad(obj){ _scoresClear(); if(obj&&typeof obj==='object'){ _scoresOk=true; Object.assign(_scoresData, obj); _scoresOk=false; } }

function _scoresSet(id, val){ _scoresOk=true; _scoresData[id]=val; _scoresOk=true; }
function _scoresClear(){ _scoresOk=true; Object.keys(_scoresData).forEach(k=>delete _scoresData[k]); _scoresOk=true; }
function _scoresLoad(obj){ _scoresClear(); if(obj&&typeof obj==='object'){ _scoresOk=true; Object.assign(_scoresData, obj); _scoresOk=true; } }

