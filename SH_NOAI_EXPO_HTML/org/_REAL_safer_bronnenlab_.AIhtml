en op de internationale politiek"}, {"h": "H2", "d": "Politiek domein", "t": "territoriale wijzigingen", "u": "wijze waarop het grondgebied en de grenzen veranderen doorheen de tijd"}, {"h": "H2", "d": "Politiek domein", "t": "mogendheid", "u": "grootmacht of dominante staat"}, {"h": "H2", "d": "Sociaal domein", "t": "burgerij", "u": "socio-economische klasse die haar vermogen niet zoals de oude adel met grondbezit opbouwde, maar via handel, industrie of andere zakelijke activiteiten"}, {"h": "H3", "d": "Cultureel domein", "t": "nationale identiteit", "u": "gemeenschapsgevoel binnen een natiestaat dat vaak voorkomt uit gemeenschappelijke waarden, dezelfde geschiedenis of gemeenschappelijke tradities"}, {"h": "H3", "d": "Cultureel domein", "t": "romantiek", "u": "kunststroming 19e eeuw die reageerde op de rationele verlichting en waarin persoonlijke emoties, dramatiek en heimwee naar het verleden centraal stonden"}, {"h": "H3", "d": "Cultureel domein", "t": "voertaal", "u": "taal die door de meeste mensen in een gebied wordt gesproken"}, {"h": "H3", "d": "Economisch domein", "t": "koopkracht", "u": "hoeveelheid goederen of diensten die met een inkomen gekocht kan worden. De koopkracht hangt dus af van het inkomen en van de prijzen"}, {"h": "H3", "d": "Economisch domein", "t": "industrialisering", "u": "proces van veranderingen in de productie door mechanisering en automatisering en de daaropvolgende veranderingen in de organisatie van de arbeid"}, {"h": "H3", "d": "Politiek domein", "t": "liberaal", "u": "belang hechten aan een zo ruim mogelijke individuele vrijheid en minimale inmenging van de overheid"}, {"h": "H3", "d": "Politiek domein", "t": "cijnskiesrecht", "u": "kiessysteem waarbij enkel burgers die in een hogere belastingcategorie zitten kunnen stemmen voor afgevaardigden"}, {"h": "H3", "d": "Politiek domein", "t": "algemeen stemrecht", "u": "kiessysteem waarbij elke volwassen burger stemrecht mag uitoefenen"}, {"h": "H3", "d": "Politiek domein", "t": "democratie", "u": "bestuursvorm waarbij het volk rechtstreeks of via vertegenwoordiging de wetten stemt en waarin de vrijheden van de burgers en minderheden door een grondwet worden beschermd"}, {"h": "H3", "d": "Politiek domein", "t": "natie", "u": "gemeenschap van mensen die zich verbonden voelen door gedeelde kenmerken, zoals taal, geschiedenis en culturele tradities"}, {"h": "H3", "d": "Politiek domein", "t": "nationalisme", "u": "politieke ideologie die stelt dat elk volk met een historisch gegroeide culturele eenheid het recht heeft om een staat of politieke eenheid te vormen"}, {"h": "H3", "d": "Politiek domein", "t": "zelfbeschikking", "u": "recht van een individu of van burgers in een land om zelfstandig eigen keuzes te maken"}, {"h": "H3", "d": "Politiek domein", "t": "inspraak", "u": "belanghebbenden betrekken bij beslissingen"}, {"h": "H3", "d": "Politiek domein", "t": "bestuurlijke organisatie", "u": "wijze waarop een samenleving ingericht en bestuurd wordt"}, {"h": "H3", "d": "Sociaal domein", "t": "discriminatie", "u": "mensen of groepen in een samenleving ongelijk behandelen omwille van persoonlijke of uiterlijke kenmerken"}, {"h": "H3", "d": "Sociaal domein", "t": "middenklasse", "u": "sociaal-economische groep die zich bevindt tussen de arme en de rijke klasse, gekenmerkt door een gemiddeld inkomen en een redelijk comfortabele mate van welvaart en sociale stabiliteit"}, {"h": "H3", "d": "Sociaal domein", "t": "wij-zij-denken", "u": "denken in groepen en tegenstellingen, zwart-witdenken over groepen in de samenleving"}], "les": {"BB-1": {"s": "BB-1", "h": "BB-1", "p": "9-21"}, "BB-2": {"s": "BB-3", "h": "h-BB-3-7", "p": "22-30"}, "1.1": {"s": "H1-1", "h": "H1-1", "p": "31-35"}, "1.2": {"s": "H1-5", "h": "H1-5", "p": "36-38"}, "1.3": {"s": "H1-7", "h": "H1-7", "p": "38-39"}, "1.4": {"s": "H1-10", "h": "h-H1-10-1", "p": "40-41"}, "2.1": {"s": "H2-1", "h": "H2-1", "p": "42"}, "2.2": {"s": "H2-2", "h": "H2-2", "p": "43-44"}, "2.3": {"s": "H2-4", "h": "h-H2-4-2", "p": "45"}, "2.4": {"s": "H2-5", "h": "H2-5", "p": "46-48"}, "2.5": {"s": "H2-5", "h": "h-H2-5-4", "p": "48-49"}, "3.1": {"s": "H3-2", "h": "H3-2", "p": "54-58"}, "3.2": {"s": "H3-4", "h": "H3-4", "p": "58-61"}, "3.3": {"s": "H3-4", "h": "h-H3-4-10", "p": "62-63"}, "3.4": {"s": "H3-4", "h": "h-H3-4-12", "p": "63-66"}}};   // {delen:[{id,titel,sub,secties:[{id,titel,p,html,sub,tekst}]}], begrippen:[{h,d,t,u}], les:{lesId:{s,h,p}}}
function tagCode(tag){
  const t=String(tag||'').toLowerCase();
  const has=(...w)=>w.some(x=>t.includes(x));
  if(has('collectieve herinnering','herdenking','receptie')) return '08.09';
  if(has('standplaatsgebonden')) return '08.08';
  if(has('langetermijn')) return '08.07';
  if(has('actualis','actueel','actualiteit','vandaag','heden')) return '08.04';
  if(has('retori','representativ')) return '08.06';
  if(has('multiperspectiv','perspectief','afwezige stem','ontbrekende stem','stem van de','wie profiteert','belang herkennen','dubbelzinnig belang','complexe positie','monsterverbond','tegengedicht')) return '08.08';
  if(has('bruikbaar','betrouwbaar','representativ','bronkritiek','bronnenkritiek','brontype','retori','propaganda','beeldanalyse','visuele bron','manipulatie','geheim verdrag','politierapport','mondelinge bron','fotografe','literaire bron','culturele bron','ironie','kritisch lezen','herinnering achteraf','ontstaan van de bron','tijdstip','dehumanisering','racisme','doel en publiek','vraagtype','keuzes van de kunstenaar','symbolen','symbolische','kritisch denken','historische fouten','bedoeling')) return '08.06';
  if(has('vergelijk','civiel vs','twee nationalismen','idealisme vs','theorie vs','theorie en praktijk')) return '08.04';
  if(has('oorzaak','gevolg','continuïteit','verandering','situeren','contextualis','context','denkfout','anachronisme','presentisme','breuk','aanleiding','escalatie','link','erfenis','impact','paradox','tijdlijn','oorzaken','keten','link met')) return '08.07';
  if(has('domein','structuurbegrip','grootmachtenpolitiek','technologische ongelijkheid','realpolitik','mentaliteit')) return '08.02';
  if(has('inhoud','begrip','kernidee','kernspanning','motief','voorwaarden','punt 6','artikel','grieven','argumenten','volkssoevereiniteit','soevereiniteit','zelfbeschikking','oorlogsschuld','socialistisch','volkenbond')) return '08.01';
  return '08.06';
}

V3.punten = null;

// ── datums ──
const _MND = ['januari','februari','maart','april','mei','juni','juli','augustus','september','oktober','november','december'];
function _dmy(ymd){ if(!ymd) return ''; const d=new Date(ymd+'T12:00:00'); return isNaN(d)?ymd:d.getDate()+' '+_MND[d.getMonth()]; }
function _daysTo(ymd){ const d=new Date(ymd+'T23:59:59'); return Math.floor((d-Date.now())/864e5); }

// ── opdrachten met oefeningen (📌) ──
function _oefTaak(id){ for(const op of V3.opd){ const it=op.items.find(x=>x.t==='oef'&&x.id===id); if(it) return {op,it}; } return null; }
function _hasOefOpd(){ return V3.opd.some(op=>op.items.some(it=>it.t==='oef')); }
function _isNu(o){ return _hasOefOpd() ? !!_oefTaak(o.id) : !!o.nu; }   // zonder server: de 📌 uit de oefenbundel
function _nuLabel(o){ const t=_oefTaak(o.id); return '📌 Maak tegen '+(t&&t.op.deadline?_dmy(t.op.deadline):'30 oktober')+(t&&t.it.max?' · '+t.it.max+' ptn':''); }
function _opdPunten(op){
  if(!V3.punten) return null; let s=0, m=0, n=0;
  op.items.forEach(it=>{ const p=it.t==='oef'&&V3.punten[it.id]; if(p){ s+=p.s; m+=p.m||it.max||0; n++; } });
  return n?{s:Math.round(s*10)/10, m, n}:null;
}
const CRITL = {"1-1-1":[{"t":"Tabel: soort bron en maker/doel van beide bronnen","p":2},{"t":"Kenmerk van het ancien régime, met citaat","p":2},{"t":"a. Verschil verklaard (standplaatsgebondenheid)","p":2},{"t":"b. Representativiteit kritisch bekeken","p":2},{"t":"c. Economische én sociale klacht, met verband","p":2}],"S1-2-1":[{"t":"Continuïteit: domein + argument","p":2},{"t":"Breuk: domein + argument","p":2},{"t":"Uitgewerkt in eigen woorden","p":1}],"1-3-1":[{"t":"a. De Gouges voegt de vrouw toe (vergelijking art. 1 en 6)","p":4},{"t":"b. De gelijkheid van 1789 gold vooral voor mannen","p":3},{"t":"c. Verband met de Terreur (onthoofd in 1793)","p":3}],"1-4-2":[{"t":"Tabel Nepal ingevuld met G/V","p":3},{"t":"a. Aanleiding én diepere oorzaken onderscheiden","p":2},{"t":"b. Gelijkenis (zinsaanzet ‘Zowel …’)","p":1},{"t":"c. Verschil in bestuur (monarchie ↔ republiek)","p":1},{"t":"d. Wat veranderde wel en niet","p":1},{"t":"e. Presentisme juist gebruikt","p":2}],"S2-2-1":[{"t":"Duidelijk standpunt","p":1},{"t":"Minstens twee voorbeelden uit de bron","p":3},{"t":"Link met de moderne tijd","p":1}],"S2-2-2":[{"t":"Bruikbaarheid: plannen achteraf, zelfbeeld","p":2},{"t":"Betrouwbaarheid: ballingschap, eigen belang, Las Cases","p":2},{"t":"Telkens uitgelegd","p":1}],"2-2-1":[{"t":"a. Passend artikel geciteerd en uitgelegd","p":3},{"t":"b. Nee — met art. 213-215 als bewijs","p":4},{"t":"c. Besluit over zijn eigen herinneringen","p":3}],"S2-3-1":[{"t":"Lied ABBA: immaterieel","p":2},{"t":"Waterloo Station: materieel","p":1.5},{"t":"Leeuw van Waterloo: materieel","p":1.5}],"S2-3-2":[{"t":"Bron gekozen","p":1},{"t":"Juiste functie van de herinnering","p":2},{"t":"Beargumenteerd met de bron","p":2}],"S2-3-3":[{"t":"Verliezen in cijfers","p":1},{"t":"Gevolgen geciteerd uit de tekstbronnen","p":1},{"t":"Criterium benoemd","p":1},{"t":"Keuze beargumenteerd","p":2}],"S2-4-1":[{"t":"a. Verloren gebieden","p":2},{"t":"b. Oostenrijk, Rusland en Pruisen + waaraan je het merkt","p":2},{"t":"c. Voorbeeld van een bufferstaat","p":1}],"2-5-1":[{"t":"Vijf bronnen met hun jaartal","p":3},{"t":"Juiste volgorde van oud naar nieuw","p":2},{"t":"Periode en domein, met uitleg","p":2},{"t":"Scharnierpunt 1789","p":1},{"t":"b. Haïti en De Gouges: waarom (niet)","p":2}]};   // verbetercriteria (enkel de omschrijving en de punten)
function _oefScoreHTML(o){
  const p=V3.punten&&V3.punten[o.id], C=CRITL[o.id];
  const bits=p&&p.c?String(p.c).split(','):null;
  if(!p) return C&&_isNu(o)?`<details class="oef-crit"><summary>📋 Zo wordt dit verbeterd</summary><ul>${C.map(c=>`<li><span>${_esc(c.t)}</span><b>${c.p} ptn</b></li>`).join('')}</ul></details>`:'';
  const r=p.m?p.s/p.m:0;
  return `<div class="oef-score ${r>=.75?'hi':r>=.5?'mid':'lo'}"><span class="oef-score-n">🏅 ${p.s}<small>/${p.m}</small></span>${p.opm?`<span class="oef-score-o">${_esc(p.opm)}</span>`:''}</div>
    ${C&&bits?`<ul class="oef-critres">${C.map((c,i)=>`<li class="${bits[i]==='1'?'ok':'no'}">${bits[i]==='1'?'✓':'✗'} ${_esc(c.t)}</li>`).join('')}</ul>`:''}`;
}
// ── vragen aan de leerkracht ──
function _vraagForm(ctx){
  return `<textarea class="vq-ta" id="vq-ta-${ctx}" rows="3" maxlength="1000" placeholder="Typ je vraag… (bv. ‘Ik begrijp vraag b niet: moet ik…?’)"></textarea>
    <div class="vq-row"><button class="btn-primary" onclick="_vraagSend('${ctx}')">Verstuur</button><span class="vq-st" id="vq-st-${ctx}"></span></div>`;
}
function _vraagOpen(ctx){
  const el=document.getElementById('vq-'+ctx); if(!el) return;
  if(el.classList.toggle('open')){ el.innerHTML=_vraagForm(ctx); setTimeout(()=>document.getElementById('vq-ta-'+ctx)?.focus(),30); } else el.innerHTML='';
}
function _vraagSend(ctx){
  const ta=document.getElementById('vq-ta-'+ctx); const t=(ta&&ta.value||'').trim(); if(!t) return;
  if(!_gsStudent()){ const st=document.getElementById('vq-st-'+ctx); if(st) st.textContent='Log eerst in om een vraag te sturen.'; return; }
  const key='vraag:'+ctx;
  let f=V3.fb.find(x=>x.key===key);
  if(f){ const nLL=f.thread.slice().reverse().findIndex(m=>m.v!=='ll'); if((nLL<0?f.thread.length:nLL)>=3){ document.getElementById('vq-st-'+ctx).textContent='Wacht eerst op een antwoord voor je opnieuw schrijft.'; return; } }
  else { f={key, thread:[], laatst:'', unread:false}; V3.fb.push(f); }
  f.thread.push({v:'ll', t, ts:new Date().toISOString()}); f.laatst=new Date().toISOString();
  V3.fbReplyQ[key]=t.slice(0,1000);
  _lpSave(true);
  ta.value=''; const st=document.getElementById('vq-st-'+ctx); if(st) st.innerHTML='✓ Verstuurd. Het antwoord komt bij <a href="#" onclick="showInbox();return false">💬 Berichten</a>.';
  _inboxBadge();
}

// ── gegevens van de server ──
const _v3LoadBase = _v3Load;
_v3Load = function(data){
  _v3LoadBase(data);
  if(data && 'punten' in data) V3.punten = data.punten || null;
};

// ═══ CURSUS ═══
function _cuSec(id){ for(const d of CURSUS.delen){ const s=d.secties.find(x=>x.id===id); if(s) return {d,s}; } return null; }
function _cuVis(d){ return d.id==='BB'?_vis('BB'):(d.id==='BR'||_vis(d.id)); }
function showCursus(secId, hId){
  if(!ST.backTo) ST.backTo={type:'home'};
  const first=CURSUS.delen.find(_cuVis)||CURSUS.delen[0];
  const hit=secId&&_cuSec(secId); const d=hit?hit.d:first;
  V3.cuDeel=d.id;
  $('cursus-content').innerHTML=`
    <button class="back-btn" onclick="_backTarget()">${_backLabel()}</button>
    <div class="cu-wrap">
      <aside class="cu-toc">
        <div class="cu-search"><input id="cu-q" type="search" placeholder="🔎 Zoek in de cursus…" oninput="_cuSearch(this.value)"></div>
        <div id="cu-res"></div>
        <details class="cu-tocd" ${matchMedia('(max-width:860px)').matches?'':'open'}><summary>📑 Inhoud van de cursus</summary>
        ${CURSUS.delen.filter(_cuVis).map(x=>`<details class="cu-deel" ${x.id===d.id?'open':''}><summary>${_esc(x.titel)}<small>${_esc(x.sub||'')}</small></summary>
          ${x.secties.map(s=>`<a href="#" class="${hit&&hit.s.id===s.id?'on':''}" onclick="showCursus('${s.id}');return false"><span>p. ${s.p}</span>${_esc(s.titel)}</a>`).join('')}</details>`).join('')}
        </details>
        <a href="#" class="cu-bg-link" onclick="ST.backTo={type:'home'};showBegrippen();return false">🔤 Begrippenlijst & oefenkaarten</a>
      </aside>
      <article class="cu-paper" id="cu-paper">
        <div class="cu-deelkop"><div class="cu-kicker">Cursus Geschiedenis-Burgerschap · ${_esc(d.titel)}</div><h1>${_esc(d.sub||d.titel)}</h1></div>
        ${d.secties.map(s=>`<section class="cu-sec" id="cu-${s.id}"><div class="cu-pg">p. ${s.p}</div><h2>${_esc(s.titel)}</h2>${s.html}</section>`).join('')}
      </article>
    </div>`;
  showView('view-cursus');
  const target=document.getElementById(hId&&hId!==secId?hId:'cu-'+(hit?hit.s.id:''));
  if(target && hit) setTimeout(()=>{ target.scrollIntoView({block:'start'}); window.scrollBy(0,-80); target.classList.add('cu-flash'); },60);
}
function _cuSearch(q){
  const el=$('cu-res'); q=String(q||'').trim().toLowerCase();
  if(q.length<3){ el.innerHTML=''; return; }
  const words=q.split(/\s+/);
  const R=[]; CURSUS.delen.filter(_cuVis).forEach(d=>d.secties.forEach(s=>{ if(words.every(w=>s.tekst.includes(w)||s.titel.toLowerCase().includes(w))) R.push({d,s}); }));
  const B=CURSUS.begrippen.filter(b=>b.t.toLowerCase().includes(q));
  el.innerHTML=`<div class="cu-reslist">${B.map(b=>`<div class="cu-bg"><b>${_esc(b.t)}</b>: ${_esc(b.u)}</div>`).join('')}
    ${R.slice(0,12).map(x=>`<a href="#" onclick="showCursus('${x.s.id}');return false"><span>${_esc(x.d.titel)} · p. ${x.s.p}</span>${_esc(x.s.titel)}</a>`).join('')||(B.length?'':'<div class="small">Niets gevonden.</div>')}</div>`;
}
function _cuLesBtn(les){
  const m=CURSUS.les[les.id]; if(!m) return '';
  return `<button class="les-cu-btn" onclick="ST.backTo={type:'les',id:'${les.id}'};showCursus('${m.s}','${m.h}')">📖 Lees de cursus <span>p. ${m.p}</span></button>`;
}

// ═══ BEGRIPPEN ═══
function _bgSlug(b){ return b.t.toLowerCase().replace(/[^a-z0-9à-ÿ]+/g,'-').replace(/^-|-$/g,''); }
function _bgKey(b){ return 'bg:'+_bgSlug(b); }
function _bgList(h){ return CURSUS.begrippen.filter(b=>(!h||b.h===h) && _vis(b.h)); }
function _bgState(b){ const o=ST.open[_bgKey(b)]; const [box,due]=String(o&&o.t||'').split('|'); return {box:+box||0, due:due||'', seen:!!o}; }
const _BG_DAYS=[0,1,3,7,21];
function showBegrippen(tab, h){
  if(!ST.backTo) ST.backTo={type:'home'};
  V3.bgTab=tab||V3.bgTab||'lijst'; V3.bgH=h!==undefined?h:(V3.bgH||'');
  const L=_bgList(V3.bgH); const known=L.filter(b=>_bgState(b).box>=3).length; const due=L.filter(b=>{ const s=_bgState(b); return !s.seen || s.due<=_today(); }).length;
  const H=['H1','H2','H3'].filter(x=>_vis(x));
  $('begrippen-content').innerHTML=`
    <button class="back-btn" onclick="_backTarget()">${_backLabel()}</button>
    <div class="bg-hero"><div class="bg-kicker">Begrippenlijst uit je cursus</div><h1>🔤 Begrippen</h1>
      <p>${L.length} begrippen · <b>${known}</b> ken je al goed · ${due} om nu te oefenen</p>
      <div class="bg-meter"><i style="width:${L.length?Math.round(known/L.length*100):0}%"></i></div></div>
    <div class="bg-bar">
      <div class="seg">${[['lijst','📚 Lijst'],['kaart','🃏 Oefenkaarten'],['quiz','🎯 Quiz']].map(([k,l])=>`<button class="${V3.bgTab===k?'on':''}" onclick="showBegrippen('${k}')">${l}</button>`).join('')}</div>
      <div class="seg sm"><button class="${!V3.bgH?'on':''}" onclick="showBegrippen(null,'')">Alles</button>${H.map(x=>`<button class="${V3.bgH===x?'on':''}" onclick="showBegrippen(null,'${x}')">${x.replace('H','Hoofdstuk ')}</button>`).join('')}</div>
    </div>
    <div id="bg-body"></div>`;
  ({lijst:_bgLijst, kaart:_bgKaart, quiz:_bgQuiz}[V3.bgTab]||_bgLijst)(L);
  if(!$('view-begrippen').classList.contains('active')) showView('view-begrippen');
}
function _bgLijst(L){
  const groups={}; L.forEach(b=>{ const k=b.h+'|'+b.d; (groups[k]=groups[k]||[]).push(b); });
  $('bg-body').innerHTML=`<input class="bg-q" type="search" placeholder="🔎 Zoek een begrip…" oninput="_bgFilter(this.value)">
    ${Object.keys(groups).map(k=>{ const [h,d]=k.split('|'); return `<div class="bg-grp"><div class="bg-grp-t">${h.replace('H','Hoofdstuk ')} · ${_esc(d)}</div>${groups[k].map(b=>{ const s=_bgState(b); return `<div class="bg-item" data-q="${_esc((b.t+' '+b.u).toLowerCase())}"><span class="bg-box b${Math.min(s.box,4)}" title="${s.box>=3?'Ken je goed':s.seen?'Nog oefenen':'Nog niet geoefend'}"></span><div><b>${_esc(b.t)}</b><div class="bg-u">${_esc(b.u)}</div></div></div>`; }).join('')}</div>`; }).join('')}`;
}
function _bgFilter(q){ q=q.toLowerCase().trim(); document.querySelectorAll('.bg-item').forEach(el=>el.style.display=!q||el.dataset.q.includes(q)?'':'none'); }
function _bgKaart(L){
  const t=_today();
  const Q=L.filter(b=>{ const s=_bgState(b); return !s.seen || s.due<=t; }).sort((a,b)=>_bgState(a).box-_bgState(b).box);
  V3.bgQ=Q; V3.bgI=0; V3.bgOk=0;
  _bgCard();
}
function _bgCard(){
  const Q=V3.bgQ, b=Q[V3.bgI];
  if(!b){ $('bg-body').innerHTML=`<div class="bg-done"><div class="big">🎉</div><h3>${Q.length?'Klaar voor vandaag!':'Niets te herhalen vandaag'}</h3><p>${Q.length?`Je kende er <b>${V3.bgOk}</b> van de ${Q.length}. De andere komen morgen terug.`:'Alle begrippen zitten goed. Kom later terug, of doe de quiz.'}</p><button class="btn-primary" onclick="showBegrippen('quiz')">🎯 Doe de quiz</button></div>`; return; }
  $('bg-body').innerHTML=`<div class="bg-count">Kaart ${V3.bgI+1} van ${Q.length}</div>
    <div class="flip" id="bg-flip" onclick="this.classList.add('on')"><div class="flip-in">
      <div class="flip-f"><div class="flip-k">${b.h.replace('H','Hoofdstuk ')} · ${_esc(b.d)}</div><div class="flip-t">${_esc(b.t)}</div><div class="flip-h">Zeg eerst zelf wat het betekent · tik om om te draaien</div></div>
      <div class="flip-b"><div class="flip-k">${_esc(b.t)}</div><div class="flip-u">${_esc(b.u)}</div></div></div></div>
    <div class="bg-acts"><button class="bg-no" onclick="_bgRate(0)">✗ Nog niet</button><button class="bg-yes" onclick="_bgRate(1)">✓ Wist ik</button></div>`;
}
function _bgRate(ok){
  const b=V3.bgQ[V3.bgI]; if(!b) return;
  const fl=$('bg-flip'); if(fl && !fl.classList.contains('on')){ fl.classList.add('on'); return; }   // eerst omdraaien
  const s=_bgState(b); const box=ok?Math.min(s.box+1,4):0;
  _openSet(_bgKey(b), {t: box+'|'+_addDays(_today(), ok?_BG_DAYS[box]:1)});
  if(ok){ V3.bgOk++; if(_xpCap('bg',15)) addXP(1); }
  _lpSave(false, 5000);
  V3.bgI++; _bgCard();
}
// max. XP per dag per soort oefening (enkel een gemak in deze browser)
function _xpCap(k, max){ 
  try{ 
// NEO: disabled
    // const key='bl_xp_'+k+'_'+_today(); 
    // const n=+(localStorage.getItem(key)||0); 
    // if(n>=max) return false; 
    // localStorage.setItem(key, n+1); 
    // return true; 
    return true;
  }catch(e)
  { return true; } 
}
function _bgQuiz(L){
  if(L.length<4){ $('bg-body').innerHTML='<div class="empty-note">Te weinig begrippen voor een quiz.</div>'; return; }
  const pick=[...L].sort(()=>Math.random()-.5).slice(0,Math.min(10,L.length));
  V3.bgQuiz={q:pick.map(b=>{ const pool=L.filter(x=>x!==b); const same=pool.filter(x=>x.h===b.h); const src=(same.length>=3?same:pool).sort(()=>Math.random()-.5).slice(0,3);
    return {b, opts:[b,...src].sort(()=>Math.random()-.5)}; }), i:0, ok:0};
  _bgQ();
}
function _bgQ(){
  const Z=V3.bgQuiz, it=Z.q[Z.i];
  if(!it){ const p=Math.round(Z.ok/Z.q.length*100); $('bg-body').innerHTML=`<div class="bg-done"><div class="big">${p>=80?'🏆':p>=50?'💪':'📚'}</div><h3>${Z.ok} van de ${Z.q.length} juist</h3><p>${p>=80?'Sterk! Je kent je begrippen.':p>=50?'Goed bezig. Oefen de kaarten die je nog niet kende.':'Oefen eerst met de kaarten en probeer daarna opnieuw.'}</p><div class="bg-acts"><button class="btn-sec" onclick="showBegrippen('kaart')">🃏 Oefenkaarten</button><button class="btn-primary" onclick="showBegrippen('quiz')">Nog een quiz</button></div></div>`; return; }
  $('bg-body').innerHTML=`<div class="bg-count">Vraag ${Z.i+1} van ${Z.q.length} · ${Z.ok} juist</div>
    <div class="bg-qcard"><div class="flip-k">Welk begrip past bij deze omschrijving?</div><div class="bg-qu">“${_esc(it.b.u)}”</div>
    <div class="bg-opts">${it.opts.map((o,j)=>`<button onclick="_bgAns(${j},this)">${_esc(o.t)}</button>`).join('')}</div></div>`;
}
function _bgAns(j, btn){
  const Z=V3.bgQuiz, it=Z.q[Z.i]; if(it.done) return; it.done=true;
  const ok=it.opts[j]===it.b; if(ok){ Z.ok++; if(_xpCap('quiz',30)){ const r=btn.getBoundingClientRect(); addXP(1, r.left+r.width/2, r.top); } }
  document.querySelectorAll('.bg-opts button').forEach((b,k)=>{ b.disabled=true; if(it.opts[k]===it.b) b.classList.add('ok'); else if(k===j) b.classList.add('bad'); });
  setTimeout(()=>{ Z.i++; _bgQ(); }, ok?700:1600);
}

// ═══ MIJN VOORTGANG ═══
const _AVZ={groen:1, oranje:.5, rood:0};
function _cb(c){ return String(c).split('.').slice(0,2).join('.'); }
function _doelData(){
  const P={}; Object.keys(DOELEN).forEach(c=>P[c]={c, n:DOELEN[c], oefT:0, oefD:0, q:[], zc:[], zcT:0, next:null});
  Object.values(OEF).forEach(o=>{ const l=_lesById(o.les); if(!l||!_lesVis(l)) return;
    [...new Set((o.codes||[]).map(_cb))].forEach(c=>{ const p=P[c]; if(!p) return; p.oefT++;
      const st=_oefState(o); if(st.done) p.oefD++; else { const nu=_isNu(o); if(!p.next || (nu && !p.next.nu)) p.next={t:'oef', id:o.id, nu, lbl:(nu?'📌 ':'')+'Oefening '+o.chip.replace(/^(Extra|Klasopdracht) /,'')+': '+o.titel}; }
      const pt=V3.punten&&V3.punten[o.id]; if(pt&&pt.m) p.q.push(pt.s/pt.m); }); });
  LESSEN.forEach(l=>{ if(!_lesVis(l)) return; l.k.forEach(([t,c0],i)=>{ const p=P[_cb(c0)]; if(!p) return; p.zcT++;
    const a=(_lpGet(l.id,'d'+i)||{}).a; if(a in _AVZ) p.zc.push(_AVZ[a]); else if(!p.next) p.next={t:'les', id:l.id, lbl:'Zelfcheck in les '+l.nr+': '+l.titel}; }); });
  HOOFDSTUKKEN.filter(h=>_vis(h.id)).forEach(h=>h.bronnen.forEach(b=>{ const sc=ST.scores[b.id]; if(!sc||!sc.total) return;
    [...new Set(b.vragen.map(v=>tagCode(v.tag)))].forEach(c=>{ const p=P[c]; if(p) p.q.push(sc.correct/sc.total); }); }));
  const avg=a=>a.length?a.reduce((x,y)=>x+y,0)/a.length:null;
  return Object.values(P).filter(p=>p.oefT||p.zcT||p.q.length).map(p=>{
    const parts=[[avg(p.q),.5],[p.oefT?p.oefD/p.oefT:null,.3],[avg(p.zc),.2]].filter(x=>x[0]!=null);
    const w=parts.reduce((a,x)=>a+x[1],0); p.score=w?parts.reduce((a,x)=>a+x[0]*x[1],0)/w:null;
    if(!p.oefD && !p.zc.length && !p.q.length) p.score=null;   // nog niets gedaan voor dit doel
    p.kw=avg(p.q); p.zelf=avg(p.zc);
    p.lvl=p.score==null?0:p.score<.25?1:p.score<.5?2:p.score<.75?3:4;
    return p; });
}
const _LVL=[['⚪','Nog niet gestart'],['🌱','Start'],['🚶','Op weg'],['🧗','Bijna'],['🏆','Beheerst']];
function showVoortgang(){
  ST.backTo=ST.backTo||{type:'home'};
  const D=_doelData();
  const opd=V3.opd.filter(op=>op.items.length);
  const lessen=LESSEN.filter(_lesVis), lesDone=lessen.filter(l=>_lpState(l).complete).length;
  const rev=typeof _revDue==='function'?_revDue().length:0;
  $('voortgang-content').innerHTML=`
    <button class="back-btn" onclick="_backTarget()">${_backLabel()}</button>
    <div class="vg-hero"><div class="bg-kicker">${_esc(_gsStudent()||'')}</div><h1>📈 Mijn voortgang</h1>
      <p>Waar sta jij? Hoe verder de balk, hoe beter je het leerplandoel beheerst. Het niveau komt uit je oefeningen${V3.punten?', je punten':''}, je bronvragen en je zelfchecks.</p></div>
    <div class="vg-kpis">
      <div class="vg-kpi"><b>${lesDone}<small>/${lessen.length}</small></b><span>lessen afgerond</span></div>
      <div class="vg-kpi"><b>${ST.xp}</b><span>XP verdiend</span></div>
      <div class="vg-kpi"><b>${Object.keys(ST.scores).length}</b><span>bronnen geoefend</span></div>
      <div class="vg-kpi" ${rev?'onclick="showHerhaal()" style="cursor:pointer"':''}><b>${rev}</b><span>vragen om te herhalen</span></div>
    </div>
    ${opd.map(op=>{ const n=op.items.length, d=op.items.filter(it=>_opdItemDone(op,it)).length, pt=_opdPunten(op), max=op.items.reduce((a,it)=>a+(it.max||0),0);
      return `<div class="vg-opd"><div class="opd-ring big" style="--p:${n?Math.round(d/n*100):0}"><span>${d}/${n}</span></div><div>
        <div class="vg-opd-t">${_esc(op.titel||'Opdracht')}</div>
        <div class="opd-meta">${op.deadline?`<span>⏰ deadline ${_dmy(op.deadline)}</span>`:''}${max?`<span>🏅 ${pt?`<b>${pt.s}/${pt.m}</b> punten (${pt.n} van ${op.items.filter(it=>it.max).length} oefeningen verbeterd)`:max+' punten te verdienen — punten verschijnen na verbetering'}</span>`:''}</div>
        <div class="vg-chips">${op.items.map(it=>{ const ok=_opdItemDone(op,it); const p=it.t==='oef'&&V3.punten&&V3.punten[it.id]; return `<button class="vg-chip ${ok?'ok':''}" title="${_esc(_opdItemLabel(it))}" onclick="_opdOpen('${it.t}','${it.id}')">${ok?'✓':'○'} ${_esc(it.t==='oef'&&OEF[it.id]?OEF[it.id].chip.replace(/^(Extra|Klasopdracht) /,''):_opdItemLabel(it).slice(0,18))}${p?` · ${p.s}/${p.m}`:''}</button>`; }).join('')}</div></div></div>`; }).join('')}
    <h2 class="vg-h">🎯 Per leerplandoel</h2>
    <div class="vg-legend">${_LVL.slice(1).map(([i,t])=>`<span>${i} ${t}</span>`).join('')}</div>
    <div class="vg-doelen">${D.map(p=>`<div class="dl-card lvl${p.lvl}">
      <div class="dl-top"><span class="dl-code">${p.c}</span><span class="dl-n">${_esc(p.n)}</span><span class="dl-lvl">${_LVL[p.lvl][0]} ${_LVL[p.lvl][1]}</span></div>
      <div class="dl-bar">${[1,2,3,4].map(i=>`<i class="${p.lvl>=i?'on':''}"></i>`).join('')}</div>
      <div class="dl-parts">${p.oefT?`<span>✏️ oefeningen ${p.oefD}/${p.oefT}</span>`:''}${p.kw!=null?`<span>🏅 kwaliteit ${Math.round(p.kw*100)}%</span>`:''}${p.zcT?`<span>🪞 zelfcheck ${p.zc.length?Math.round(p.zelf*100)+'%':'—'}</span>`:''}</div>
      ${p.next?`<button class="dl-next" onclick="${p.next.t==='oef'?`_opdOpen('oef','${p.next.id}')`:`ST.backTo={type:'voortgang'};showLes('${p.next.id}')`}">👉 ${_esc(p.next.lbl)}</button>`:''}
    </div>`).join('')}</div>`;
  showView('view-voortgang');
}

// ═══ HOME ═══
function _nextStep(){
  for(const op of V3.opd){ for(const it of op.items){ if(!_opdItemDone(op,it)) return {op, it}; } }
  const l=LESSEN.find(l=>_lesVis(l) && !_lpState(l).complete); return l?{les:l}:null;
}
function renderHome9(){
  if(typeof _homeCardImages==='function') _homeCardImages();
  const el=$('hm-mission'); if(!el) return;
  const naam=String(_gsStudent()||'').split(' ')[0];
  const h=new Date().getHours(); $('hm-hello').textContent=(h<12?'Goeiemorgen':h<18?'Dag':'Goeienavond')+(naam?' '+naam:'')+' 👋';
  const nx=_nextStep();
  const op=V3.opd.find(o=>o.items.some(it=>it.t==='oef')) || V3.opd[0];
  let ring='';
  if(op){ const n=op.items.length, d=op.items.filter(it=>_opdItemDone(op,it)).length, dl=op.deadline?_daysTo(op.deadline):null;
    ring=`<div class="hm-opd" onclick="showVoortgang()"><div class="opd-ring" style="--p:${n?Math.round(d/n*100):0}"><span>${d}/${n}</span></div><div><b>${_esc(op.titel||'Opdracht')}</b><small>${op.deadline?(dl>1?'nog '+dl+' dagen':dl===1?'morgen!':dl===0?'vandaag!':'deadline voorbij')+' · '+_dmy(op.deadline):'bekijk je voortgang'}</small></div></div>`; }
  let next='';
  if(nx && nx.it) next=`<button class="hm-next" onclick="_opdOpen('${nx.it.t}','${nx.it.id}')"><small>Jouw volgende stap</small>${_esc(_opdItemLabel(nx.it))} →</button>`;
  else if(nx && nx.les) next=`<button class="hm-next" onclick="showLes('${nx.les.id}')"><small>Jouw volgende stap</small>Les ${nx.les.nr}: ${_esc(nx.les.titel)} →</button>`;
  el.innerHTML=ring+next;
  const xp=ST.xp, wt=$('hm-wt');
  if(wt){ const ok=xp>=WT_MIN_XP; wt.innerHTML=`<div class="wt-promo-ic">⚔️</div><div class="wt-promo-b"><div class="wt-promo-t">Het Waterloo-spel <span>${ok?'ontgrendeld!':'nog '+(WT_MIN_XP-xp)+' XP'}</span></div>
      <p>Verdien XP met oefeningen (+5), herhalingsvragen (+2), samenvattingen en zelfchecks (+5), bronnen en begrippen. Vanaf <b>${WT_MIN_XP} XP</b> speel je de Slag bij Waterloo als Napoleon: koop eenheden met je XP, stel je leger op in drie lanen en vecht tegen Wellington. Verlies je, dan ben je je gespendeerde XP kwijt — denk dus strategisch!</p>
      <div class="wt-promo-bar"><i style="width:${Math.min(100,Math.round(xp/WT_MIN_XP*100))}%"></i></div></div>
      <button class="wt-promo-go" ${ok?'':'disabled'} onclick="showWaterloo()">${ok?'Speel ⚔️':'🔒 '+xp+'/'+WT_MIN_XP+' XP'}</button>`; }
  const ib=$('hm-tile-ib'); if(ib){ const u=V3.fb.filter(f=>f.unread).length; ib.querySelector('small').textContent=u?u+' nieuw':'vragen & reacties'; }
  const bg=$('hm-tile-bg'); if(bg){ const L=_bgList(''); const due=L.filter(b=>{ const s=_bgState(b); return !s.seen || s.due<=_today(); }).length; bg.querySelector('small').textContent=due?due+' om te oefenen':'alles herhaald'; }
}

// ═══ OVERGANGEN ═══
const _showViewBase = showView;
showView = function(id){
  _showViewBase(id);
  const v=$(id); if(!v) return;
  v.classList.remove('v-in'); void v.offsetWidth; v.classList.add('v-in');
  const bar=$('v9-bar'); if(bar){ bar.classList.remove('go'); void bar.offsetWidth; bar.classList.add('go'); }
  document.body.dataset.view=id;
  setTimeout(_reveal, 30);
};
let _revObs=null;
function _reveal(){
  if(!('IntersectionObserver' in window)) return;
  if(!_revObs) _revObs=new IntersectionObserver(es=>es.forEach(e=>{ if(e.isIntersecting){ e.target.classList.add('in'); _revObs.unobserve(e.target); } }), {rootMargin:'0px 0px -6% 0px'});
  document.querySelectorAll('.view.active .les-sec:not(.in), .view.active .chapter-card:not(.in), .view.active .dl-card:not(.in), .view.active .cu-sec:not(.in), .view.active .oef:not(.in)').forEach(el=>{ el.classList.add('rv'); _revObs.observe(el); });
}

// ═══════════════════════════════════════
// v9 — SCÈNES: bewegende hoofdstukbeelden als achtergrond en als overgang
// Beelden: schilderijen en prenten uit de cursus (ingebed) en publiek domein via Wikimedia Commons
// ═══════════════════════════════════════
const _WM = f => 'https://commons.wikimedia.org/wiki/Special:FilePath/' + encodeURIComponent(f) + '?width=1400';
const SCENE_IMG = {"H1": ["data:image/jpeg;base64,", "data:image/jpeg;base64,"], "H2": ["data:image/jpeg;base64,", "data:image/jpeg;base64,"], "CONGRES": ["data:image/jpeg;base64,"], "H3": ["data:image/jpeg;base64,"]};
const SCENES = {
  BB:   {fx:'rainbow', t:'De Bronbox',               img:[]},
  H1:   {fx:'lis',     t:'Ancien régime & revolutie', img:[...(SCENE_IMG.H1||[])]},
  H2:   {fx:'smoke',   t:'Napoleon & Wenen',          img:[_WM('David - Napoleon crossing the Alps - Malmaison2.jpg'), ...(SCENE_IMG.H2||[])]},
  H3:   {fx:'tricolore',t:'Liberalisme & nationalisme',img:[_WM('Eugène Delacroix - La liberté guidant le peuple.jpg'), ...(SCENE_IMG.H3||[])]},
  H4:   {fx:'bevlag',  t:'De Belgische Revolutie',    img:[_WM('Wappers - Episodes from September Days 1830 on the Place de l’Hôtel de Ville in Brussels.JPG')]},
  H4IR: {fx:'gears',   t:'De Industriële Revolutie',  img:[_WM('Philipp Jakob Loutherbourg d. J. 002.jpg')]},
  H5:   {fx:'globe',   t:'Imperialisme',              img:[_WM('Punch Rhodes Colossus.png')]},
  H6:   {fx:'poppies', t:'De Eerste Wereldoorlog',    img:[_WM('Nash, Paul - We are Making a New World - Google Art Project.jpg')]},
};
// één beeld per les (schilderijen en prenten, publiek domein)
const LES_IMG = {
  'BB-1': _WM('Johannes Vermeer - The Geographer - Google Art Project.jpg'),
  'BB-2': _WM('Pieter Bruegel the Elder - The Parable of the Blind Leading the Blind - WGA3511.jpg'),
  '1.1': _WM('Rigaud Louis XIV 1701.jpg'),
  '1.2': _WM('Anonymous - Prise de la Bastille.jpg'),
  '1.3': (SCENE_IMG.H1||[])[0],
  '1.4': _WM('Declaration of the Rights of Man and of the Citizen in 1789.jpg'),
  '2.1': _WM('David - Napoleon crossing the Alps - Malmaison2.jpg'),
  '2.2': _WM('Jacques-Louis David - The Emperor Napoleon in His Study at the Tuileries - Google Art Project 2.jpg'),
  '2.3': _WM('De Slag bij Waterloo Rijksmuseum SK-A-1115.jpeg'),
  '2.4': (SCENE_IMG.H2||[])[0],
  '2.5': (SCENE_IMG.CONGRES||[])[0],
  '3.1': _WM('Eugène Delacroix - La liberté guidant le peuple.jpg'),
  '3.2': _WM('Image Germania (painting).jpg'),
  '3.3': (SCENE_IMG.H3||[])[0],   // De Keyser, De Guldensporenslag (1836): romantiek in dienst van het nationalisme
  '3.4': _WM('Wappers - Episodes from September Days 1830 on the Place de l’Hôtel de Ville in Brussels.JPG'),
};
function _lesImg(l){ if(LES_IMG[l.id]) return LES_IMG[l.id]; const r=_reeksById(l.r); const sc=r&&_scnOf(r.hId||r.id); return sc&&sc.img[0]||''; }
function _scnOf(h){ return SCENES[h] || SCENES[String(h||'').replace(/IR$/,'')] || null; }
function _fxHTML(fx){
  const n = {lis:14, smoke:9, tricolore:22, gears:3, globe:1, poppies:16, rainbow:1, bevlag:1}[fx] || 0;
  const R = (a,b)=> (a + Math.random()*(b-a)).toFixed(2);
  let s = '';
  if(fx==='bevlag') return '<div class="fx-flag"><i></i><i></i><i></i></div>';
  if(fx==='globe')  return '<div class="fx-globe">🌍</div><div class="fx-ship">⛵</div>';
  if(fx==='rainbow') return '<div class="fx-rain"></div>';
  for(let i=0;i<n;i++){
    const st = `--x:${R(0,100)}%;--d:${R(0,9)}s;--t:${R(fx==='smoke'?7:6, fx==='smoke'?13:12)}s;--s:${R(.6,1.4)};--r:${R(-40,40)}deg`;
    if(fx==='lis') s += `<span class="p p-lis" style="${st}">⚜</span>`;
    else if(fx==='smoke') s += `<span class="p p-smoke" style="${st}"></span>`;
    else if(fx==='tricolore') s += `<span class="p p-conf c${i%3}" style="${st}"></span>`;
    else if(fx==='poppies') s += `<span class="p p-poppy" style="${st}"></span>`;
    else if(fx==='gears') s += `<span class="p p-gear g${i}">⚙</span>`;
  }
  if(fx==='gears') s += Array.from({length:7},(_,i)=>`<span class="p p-smoke" style="--x:${R(55,95)}%;--d:${R(0,8)}s;--t:${R(7,12)}s;--s:${R(.6,1.3)}"></span>`).join('');
  return s;
}
// achtergrond in een kop (leerpad, les, hoofdstuk)
function _sceneDecorate(el, h, imgOverride){
  const sc = _scnOf(h); if(!el || !sc) return;
  el.querySelector(':scope > .scn')?.remove();
  el.classList.add('has-scn');
  const img = imgOverride || (sc.img.length ? sc.img[Math.floor(Math.random()*sc.img.length)] : '');
  const d = document.createElement('div'); d.className = 'scn scn-'+sc.fx; d.setAttribute('aria-hidden','true');
  d.innerHTML = `${img?`<div class="scn-img" style="background-image:url('${img}')"></div>`:''}<div class="scn-shade"></div><div class="scn-fx">${_fxHTML(sc.fx)}</div>`;
  el.prepend(d);
  _scnFallback(d.querySelector('.scn-img'), sc, img);
}
// online beeld niet bereikbaar? Dan een ingebed beeld, of enkel de animatie
function _scnFallback(div, sc, img){
  if(!div || !img || img.startsWith('data:')) return;
  const t=new Image(); t.onerror=()=>{ const alt=sc.img.find(x=>x.startsWith('data:')); if(alt) div.style.backgroundImage=`url('${alt}')`; else div.remove(); }; t.src=img;
}
// overgang: korte filmische titelkaart bij het openen van een hoofdstuk of leerpad (één keer per sessie per hoofdstuk)
function _sceneIntro(h, kicker, titel){
  const sc = _scnOf(h); if(!sc) return;
  try{ if(matchMedia('(prefers-reduced-motion: reduce)').matches) return; const k='bl_scn_'+h; if(sessionStorage.getItem(k)) return; sessionStorage.setItem(k,'1'); }catch(e){}
  document.getElementById('scn-intro')?.remove();
  const img = sc.img[0] || '';
  const d = document.createElement('div'); d.id='scn-intro'; d.className='scn-intro scn-'+sc.fx;
  d.innerHTML = `${img?`<div class="scn-img" style="background-image:url('${img}')"></div>`:''}<div class="scn-shade"></div><div class="scn-fx">${_fxHTML(sc.fx)}</div>
    <div class="scn-txt"><div class="scn-k">${_esc(kicker||'')}</div><div class="scn-t">${_esc(titel||sc.t)}</div><div class="scn-skip">tik om verder te gaan</div></div>`;
  _scnFallback(d.querySelector('.scn-img'), sc, img);
  const close = ()=>{ d.classList.add('out'); setTimeout(()=>d.remove(), 500); };
  d.onclick = close; document.body.appendChild(d); setTimeout(close, 1900);
}
// beelden pas tonen als ze geladen zijn; anders een ingebed beeld of een icoon
function _scnFb(r){ const sc=_scnOf(r.hId||r.id); return (sc&&sc.img.find(x=>x.startsWith('data:')))||''; }
function _imgLoad(sel){
  document.querySelectorAll(sel).forEach(el=>{ const src=el.dataset.src, fb=el.dataset.fb; if(!src && !fb) return;
    const set=u=>{ el.style.backgroundImage=`url('${u}')`; el.classList.add('ok'); };
    if(!src){ set(fb); return; }
    const t=new Image(); t.onload=()=>set(src); t.onerror=()=>{ if(fb) set(fb); }; t.src=src; });
}
// leerpad als route met haltes
showReeks = function(rId){
  const r=_reeksById(rId); if(!r) return;
  ST.backTo=null;
  const L=LESSEN.filter(l=>l.r===rId && _lesVis(l)), st=L.map(_lpState), done=st.filter(x=>x.complete).length, cur=st.findIndex(x=>!x.complete);
  $('reeks-content').innerHTML=`
    <button class="back-btn" onclick="showHome()">← Terug naar overzicht</button>
    <div class="chapter-header"><div class="lp-kicker">${_esc(r.label)} · leerpad</div>
      <div class="chapter-title">${_esc(r.titel)}</div><div class="chapter-subtitle">${_esc(r.sub||'')}</div>
      <div class="rt-sum"><div class="rt-sumbar"><i style="width:${L.length?Math.round(done/L.length*100):0}%"></i></div><span>${done}/${L.length} lessen afgerond</span></div></div>
    <div class="route">${L.map((l,i)=>{ const s=st[i], img=_lesImg(l), here=i===cur;
      return `<div class="rt-stop lp-les ${s.complete?'done':here?'cur':s.started?'busy':''}" onclick="showLes('${l.id}')" style="--d:${i*70}ms">
        <div class="rt-pin"><span>${s.complete?'✓':_esc(l.nr)}</span></div>
        <div class="rt-card"><div class="rt-img" data-src="${_esc(img)}" data-fb="${_esc(_scnFb(r))}"><b>${_esc(r.icon||'📜')}</b></div>
          <div class="rt-body">${here?'<div class="rt-here">📍 Jouw volgende les</div>':''}
            <div class="rt-nr">Les ${_esc(l.nr)}${s.complete?' · ✓ afgerond':s.started?' · bezig':''}</div>
            <div class="rt-t">${_esc(l.titel)}</div><div class="rt-q">🔍 ${_esc(l.vraag)}</div>
            <div class="lp-chips"><span class="lp-chip">🧠 ${s.cuesKnown}/${l.c.length} gekend</span><span class="lp-chip">✅ ${s.zc.map(_dot).join('')}</span>${s.oefNu?`<span class="lp-chip">📌 ${s.oefNuDone}/${s.oefNu}</span>`:''}</div></div>
          <span class="rt-go">›</span></div></div>`; }).join('')}
      <div class="rt-end ${L.length&&done===L.length?'done':''}"><span>🏁</span>${L.length&&done===L.length?'Leerpad afgerond — knap!':'Eindmeet van het leerpad'}</div></div>`;
  showView('view-reeks');
  _imgLoad('#reeks-content .rt-img');
  const h=r.hId||r.id;
  _sceneDecorate(document.querySelector('#reeks-content .chapter-header'), h);
  _sceneIntro(h, r.label+' · leerpad', r.titel);
};
const _showChapterBase = showChapter;
showChapter = function(hId){
  _showChapterBase(hId);
  const H=HOOFDSTUKKEN.find(x=>x.id===hId);
  _sceneDecorate(document.querySelector('#view-chapter .chapter-header'), hId);
  if(H) _sceneIntro(hId, H.label+' · bronnen', _plain(H.titel));
};
const _renderLesBase = renderLes;
renderLes = function(les){
  _renderLesBase(les);
  const r=_reeksById(les.r); _sceneDecorate(document.querySelector('#les-content .les-hero'), r&&(r.hId||r.id), _lesImg(les));
};
// beelden op de kaarten van de startpagina
function _homeCardImages(){
  const R = REEKSEN.filter(r=>_vis(r.id) && LESSEN.some(l=>l.r===r.id && _lesVis(l)));
  document.querySelectorAll('#lp-grid .lp-card').forEach((c,i)=>{ const r=R[i]; const sc=r&&_scnOf(r.hId||r.id); if(sc&&sc.img[0]){ c.classList.add('imgcard'); c.style.setProperty('--card-img', `url('${sc.img[0]}')`); } });
  const H = HOOFDSTUKKEN.filter(h=>_vis(h.id));
  document.querySelectorAll('#chapters-grid .chapter-card').forEach((c,i)=>{ const h=H[i]; const sc=h&&_scnOf(h.id); if(sc&&sc.img[0]){ c.classList.add('imgcard'); c.style.setProperty('--card-img', `url('${sc.img[sc.img.length>1?1:0]}')`); } });
}

// ═══════════════════════════════════════
// v9 — WATERLOO als kaartspel: eenheden als speelkaarten, aanvallen worden uitgespeeld
// (de spelregels, schade en XP blijven exact dezelfde)
// ═══════════════════════════════════════
const WT_TYPE_ART = {inf:'🪖', cav:'🐎', art:'💥', elit:'🦅'};
const WT_FX = { busy:false, dead:new Set(), sfx:(()=>{ try{ return localStorage.getItem('bl_wt_sfx')!=='0'; }catch(e){ return true; } })() };

// ── geluid (kort, zelf gesynthetiseerd; uit te zetten) ──
let _wtAC=null;
function _wtSfx(kind){
  if(!WT_FX.sfx) return;
  try{
    _wtAC=_wtAC||new (window.AudioContext||window.webkitAudioContext)();
    const ac=_wtAC, t=ac.currentTime, out=ac.createGain(); out.gain.value=.22; out.connect(ac.destination);
    const len=kind==='boom'?.9:kind==='death'?.6:.25;
    const buf=ac.createBuffer(1, ac.sampleRate*len, ac.sampleRate), d=buf.getChannelData(0);
    for(let i=0;i<d.length;i++) d[i]=(Math.random()*2-1)*Math.pow(1-i/d.length, kind==='boom'?2.2:3);
    const src=ac.createBufferSource(); src.buffer=buf;
    const f=ac.createBiquadFilter(); f.type='lowpass'; f.frequency.value=kind==='boom'?420:kind==='death'?700:1800;
    src.connect(f); f.connect(out); src.start(t);
    const o=ac.createOscillator(), og=ac.createGain(); o.type=kind==='clash'?'square':'sine';
    o.frequency.setValueAtTime(kind==='clash'?660:kind==='death'?220:90, t); o.frequency.exponentialRampToValueAtTime(kind==='clash'?180:40, t+len*.8);
    og.gain.setValueAtTime(kind==='clash'?.08:.5, t); og.gain.exponentialRampToValueAtTime(.001, t+len);
    o.connect(og); og.connect(out); o.start(t); o.stop(t+len);
  }catch(e){}
}
function wtToggleSfx(){ WT_FX.sfx=!WT_FX.sfx; try{ localStorage.setItem('bl_wt_sfx', WT_FX.sfx?'1':'0'); }catch(e){} const b=$('wt-sfx'); if(b) b.textContent=WT_FX.sfx?'🔊':'🔇'; }

// ── kaart ──
wtTokenHTML = function(u, side, lane, idx){
  if(!u) return '';
  const dead=u.hp<=0, welTurn=WTC.wellingtonTurn||WT_FX.busy||WTC.welPending;
  const sel=!welTurn && WTC.selected && WTC.selected.side===side && WTC.selected.lane===lane && WTC.selected.idx===idx;
  const canTarget=!welTurn && !dead && side==='wellington' && WTC.selected && WTC.selected.side==='napoleon' && WTC.attacksLeft>0;
  const canSelect=!welTurn && !dead && side==='napoleon' && WTC.attacksLeft>0 && !WTC.selected;
  const hpPct=Math.max(0, Math.round(u.hp/u.maxHp*100));
  let prev='';
  if(canTarget){ const nap=WTC.napoleon[WTC.selected.lane][WTC.selected.idx]; if(nap&&nap.hp>0){ const {dmg,note,noteClass}=wtCalcDmgPreview(nap,u); prev=`<span class="wc-prev ${noteClass||''}" title="${note||''}">−${dmg}</span>`; } }
  let cls=`wt-token wt-token-${side} wt-card t-${u.type}`;
  if(dead) cls+=' wt-token-dead'; else if(sel) cls+=' wt-token-selected'; else if(canTarget) cls+=' wt-token-targetable'; else if(canSelect) cls+=' wt-token-selectable'; else cls+=' wt-token-passive';
  if(u.square) cls+=' is-square';
  const click = dead||welTurn ? '' : side==='napoleon' && WTC.attacksLeft>0 ? `onclick="wtSelectNapoleon('${lane}',${idx})"` : side==='wellington' && WTC.selected && WTC.selected.side==='napoleon' ? `onclick="wtAttack('${lane}',${idx})"` : '';
  return `<div class="${cls}" id="wt-tok-${side}-${lane}-${idx}" ${click} title="${_esc(u.name)} · ${WT_TYPE_NAMES[u.type]||u.type} · aanval ${u.atk||3} · ${u.hp}/${u.maxHp} HP">
    <div class="wc-frame"><div class="wc-art"><span class="wc-ico">${dead?'☠️':u.icon}</span><span class="wc-flag">${side==='napoleon'?'🇫🇷':'🇬🇧'}</span></div>
      <div class="wc-name">${_esc(u.name)}</div>
      <div class="wc-type">${WT_TYPE_ART[u.type]||''} ${WT_TYPE_NAMES[u.type]||u.type}${u.square?' · 🟥 vierkant':''}</div>
      <div class="wc-bar"><i style="width:${hpPct}%"></i></div></div>
    <div class="wc-atk" title="Aanval">${u.atk||3}</div><div class="wc-hp ${hpPct<=30?'low':''}" title="Levenspunten">${u.hp}</div>${prev}
  </div>`;
};

// ── een kaart vliegt naar haar doelwit ──
function _wtLunge(fromId, toId, side, fast){
  return new Promise(res=>{
    const a=$(fromId), b=$(toId); if(!a||!b||!a.animate){ res(); return; }
    const ra=a.getBoundingClientRect(), rb=b.getBoundingClientRect();
    const c=a.cloneNode(true); c.id=''; c.classList.add('wc-flying'); c.removeAttribute('onclick');
    Object.assign(c.style,{position:'fixed',left:ra.left+'px',top:ra.top+'px',width:ra.width+'px',height:ra.height+'px',margin:0,zIndex:3000});
    document.body.appendChild(c); a.style.visibility='hidden';
    const dx=rb.left+rb.width/2-(ra.left+ra.width/2), dy=rb.top+rb.height/2-(ra.top+ra.height/2);
    const an=c.animate([
      {transform:'translate(0,0) scale(1) rotate(0)'},
      {transform:`translate(${dx*-.08}px,${dy*-.08}px) scale(1.12) rotate(${side==='napoleon'?-6:6}deg)`, offset:.25},
      {transform:`translate(${dx*.82}px,${dy*.82}px) scale(1.05) rotate(${side==='napoleon'?4:-4}deg)`, offset:.7},
      {transform:'translate(0,0) scale(1) rotate(0)'}
    ], {duration:fast?440:620, easing:'cubic-bezier(.3,.7,.2,1)'});
    setTimeout(()=>{ _wtImpact(b); }, fast?300:430);
    // vangnet: sommige toestellen (iPhone in spaarstand, tabblad op de achtergrond) melden het einde van een animatie niet
    let done=false; const end=()=>{ if(done) return; done=true; c.remove(); a.style.visibility=''; res(); };
    an.onfinish=end; an.oncancel=end; setTimeout(end, (fast?440:620)+400);
  });
}
function _wtImpact(el){
  const r=el.getBoundingClientRect();
  const big = el.classList.contains('t-art');
  _wtSfx(big?'boom':'clash');
  const g=document.querySelector('.wt-combat-grid'); if(g){ g.classList.remove('wt-shake'); void g.offsetWidth; g.classList.add('wt-shake'); }
  const bz=document.createElement('div'); bz.className='wc-burst'; bz.style.left=(r.left+r.width/2)+'px'; bz.style.top=(r.top+r.height/2)+'px';
  bz.innerHTML='<span>💥</span>'+Array.from({length:10},(_,i)=>`<i style="--a:${i*36}deg;--d:${40+Math.random()*40}px"></i>`).join('');
  document.body.appendChild(bz); setTimeout(()=>bz.remove(), 700);
  el.classList.add('wt-token-hit'); setTimeout(()=>el.classList.remove('wt-token-hit'), 450);
}
wtShowDmgFloat = function(tokenId, dmg){
  const tok=$(tokenId); if(!tok) return;
  const r=tok.getBoundingClientRect();
  const f=document.createElement('div'); f.className='wc-dmg'; f.textContent='−'+dmg;
  f.style.left=(r.left+r.width/2)+'px'; f.style.top=(r.top+r.height*.35)+'px';
  document.body.appendChild(f); setTimeout(()=>f.remove(), 1100);
};

// ── speler valt aan ──
// tijdens een animatie of vlak vóór Wellingtons beurt kan je niets aanklikken (anders: verkeerde aanvaller, dubbele beurten)
const _wtBlocked = () => WT_FX.busy || WTC.wellingtonTurn || WTC.welPending;
const _wtSelBase = wtSelectNapoleon;
wtSelectNapoleon = function(lane, idx){ if(_wtBlocked()) return; _wtSelBase(lane, idx); };
const _wtAttackBase = wtAttack;
wtAttack = async function(welLane, welIdx){
  if(_wtBlocked() || !WTC.selected || WTC.selected.side!=='napoleon') return;
  const s=WTC.selected, bt=WTC.battle; WT_FX.busy=true;
  await _wtLunge(`wt-tok-napoleon-${s.lane}-${s.idx}`, `wt-tok-wellington-${welLane}-${welIdx}`, 'napoleon');
  WT_FX.busy=false;
  if(bt!==WTC.battle || WT.phase!=='combat') return;
  WTC.selected=s;
  _wtAttackBase(welLane, welIdx);
  // laatste aanval: Wellington is aan zet — de knop 'volgende ronde' blijft dicht tot hij klaar is
  if(WTC.attacksLeft<=0){ WTC.welPending=true; wtRenderCombat(); }
};
const _wtEndRoundBase = wtEndRound;
wtEndRound = function(){ if(_wtBlocked() || WT.phase!=='combat') return; _wtEndRoundBase(); };
// terugtrekken: je verliest 70% van de XP die je in je leger stak (vroeger kreeg je per vergissing 30% extra)
wtRetreat = function(){
  if(_wtBlocked() || WT.phase!=='combat') return;
  if(!confirm('Terugtrekken? Je verliest 70% van de XP die je in je leger stak en houdt 30%.')) return;
  _xpForce(Math.max(0, ST.xp - Math.round(WT.xpSpent * 0.7)));
  updateXPHeader(); saveProgress();
  WT.victory=false; WT.retreated=true; wtSetPhase('result');
};
// het resultaat (en de XP) maar één keer per slag
const _wtSetPhaseBase = wtSetPhase;
wtSetPhase = function(name){
  if(name==='result'){ if(WT._resultFor===WTC.battle) return; WT._resultFor=WTC.battle; WTC.welPending=false; WTC.wellingtonTurn=false; }
  _wtSetPhaseBase(name);
};

// ── Wellington valt aan (zelfde AI als voorheen, nu uitgespeeld) ──
wtWellingtonTurn = function(){
  WTC.welPending=false;
  if(WT.phase!=='combat' || WTC.wellingtonTurn) return;
  const bt=WTC.battle;
  const attacks=[];
  WT_LANES.forEach(lane=>{ WTC.wellington[lane].forEach((wel,wi)=>{ if(wel.hp<=0) return;
    const targets=WTC.napoleon[lane].filter(u=>u.hp>0); if(!targets.length) return;
    const target=WTC.round>=4 ? targets.reduce((a,b)=>((a.atk||3)>=(b.atk||3))?a:b) : targets.reduce((a,b)=>a.hp<=b.hp?a:b);
    attacks.push({wel, welLane:lane, welIdx:wi, target, napLane:lane, napIdx:WTC.napoleon[lane].indexOf(target)}); }); });
  const finish=()=>{ WT_LANES.forEach(l=>WTC.wellington[l].forEach(u=>{ u.square=false; })); WTC.wellingtonTurn=false; wtRenderCombat(); };
  if(!attacks.length){ finish(); return; }
  WTC.wellingtonTurn=true; wtRenderCombat(); wtShowTurnOverlay('wellington');
  let i=0;
  const alive=()=>bt===WTC.battle && WT.phase==='combat';
  const step=async()=>{
    if(!alive()) return;
    if(i>=attacks.length){ setTimeout(()=>{ if(!alive()) return; finish(); wtShowTurnOverlay('napoleon'); }, 450); return; }
    const atk=attacks[i++];
    if(atk.wel.hp<=0 || atk.target.hp<=0){ step(); return; }
    await _wtLunge(`wt-tok-wellington-${atk.welLane}-${atk.welIdx}`, `wt-tok-napoleon-${atk.napLane}-${atk.napIdx}`, 'wellington', attacks.length>5);
    if(!alive()) return;
    const welAtk={atk: atk.wel.atk||(atk.wel.type==='art'?7:atk.wel.type==='inf'?3:4), type:atk.wel.type};
    atk.wel.square=false;
    const {dmg}=wtCalcDamage(welAtk, atk.target);
    atk.target.hp=Math.max(0, atk.target.hp-dmg);
    wtAddLog(`${atk.wel.name} ↩ ${atk.target.name}: −${dmg} HP`, 'wellington');
    wtRenderCombat();
    wtShowDmgFloat(`wt-tok-napoleon-${atk.napLane}-${atk.napIdx}`, dmg);
    setTimeout(step, attacks.length>5?200:380);
  };
  setTimeout(step, 900);
};

// ── na elke render: sneuvelende kaarten, slagveld, geluidsknop ──
const _wtRenderCombatBase = wtRenderCombat;
wtRenderCombat = function(){
  _wtRenderCombatBase();
  const grid=document.querySelector('.wt-combat-grid'); if(!grid) return;
  if(!WT_FX.bg){ WT_FX.bg=_WM('De Slag bij Waterloo Rijksmuseum SK-A-1115.jpeg'); const t=new Image(); t.onload=()=>$('view-waterloo').style.setProperty('--wt-bg', `url('${WT_FX.bg}')`); t.src=WT_FX.bg; }
  const hd=document.querySelector('.wt-combat-header');
  if(hd && !$('wt-sfx')) hd.insertAdjacentHTML('beforeend', `<button id="wt-sfx" class="wt-sfx" onclick="wtToggleSfx()" title="Geluid aan/uit">${WT_FX.sfx?'🔊':'🔇'}</button>`);
  if(WTC.welPending){ const eb=document.querySelector('.wt-combat-footer .wt-btn-primary'); if(eb) eb.disabled=true; const hb=document.querySelector('.wt-hint-box'); if(hb) hb.innerHTML='💡 <span style="color:#93c5fd">🔵 Wellington maakt zich klaar…</span>'; }
  grid.querySelectorAll('.wt-token-dead').forEach(el=>{ if(WT_FX.dead.has(el.id)) return; WT_FX.dead.add(el.id); el.classList.add('wt-dying'); _wtSfx('death'); });
};
const _wtInitCombatBase = wtInitCombat;
wtInitCombat = function(){ WT_FX.dead=new Set(); WT_FX.busy=false; WTC.welPending=false; WTC.battle=(WTC.battle||0)+1; _wtInitCombatBase(); };
// iPhone/iPad: geluid mag pas na een aanraking starten — zet het klaar bij de eerste tik
document.addEventListener('touchend', function _wtUnlock(){ try{ if(!WT_FX.sfx) return; _wtAC=_wtAC||new (window.AudioContext||window.webkitAudioContext)(); if(_wtAC.state==='suspended') _wtAC.resume(); document.removeEventListener('touchend', _wtUnlock); }catch(e){} }, {passive:true});
// Britse kaarten krijgen een eigen gezicht
const _wtMakeWelBase = wtMakeWellingtonArmy;
wtMakeWellingtonArmy = function(){
  const A=_wtMakeWelBase(), ic={inf:'💂', cav:'🏇', art:'💣', elit:'🦁'};
  WT_LANES.forEach(l=>(A[l]||[]).forEach(u=>{ u.icon=/Pruis/i.test(u.name)?'🦅':/Ned|Belg/i.test(u.name)?'🦁':(ic[u.type]||'💂'); }));
  return A;
};

// ═══════════════════════════════════════
// v9 — robuust inloggen en bewaren
// ═══════════════════════════════════════
V3.locked = new Set();
const _v3LoadSec = _v3Load;
_v3Load = function(data){ _v3LoadSec(data); if(data && Array.isArray(data.locked)) V3.locked = new Set(data.locked); };
// antwoorden van server en toestel samenvoegen: per antwoord wint de nieuwste versie
function _mergeOpen(server, local){
  const out = Object.assign({}, server||{});
  Object.keys(local||{}).forEach(k=>{ const a=out[k], b=local[k]; if(!a || (b && (b.ts||0) > (a.ts||0))) out[k]=b; });
  return out;
}
// ── bewaarstatus in de kop ──
function _saveState(s, tip){
  const el=$('save-st'); if(!el) return;
  el.className='save-st '+s; el.title=tip||'';
  el.textContent = s==='busy'?'⏳ Bewaren…' : s==='ok'?'✓ Bewaard' : s==='err'?'⚠ Niet bewaard' : '';
  if(s==='ok'){ clearTimeout(el._t); el._t=setTimeout(()=>{ if(el.classList.contains('ok')) el.textContent='✓'; }, 2500); }
}
let _saveBusy=false;
sbSaveProgress = async function(){
  const student=_gsStudent(); if(!student) return;
  const code=_gsCode(); if(!code) return;
  if(_saveBusy){ setTimeout(()=>sbSaveProgress(), 1500); return; }
  _saveBusy=true; _saveState('busy');
  const sent=Object.assign({}, ST.openDirty);
  try{
    const res = await _gsPost({ action:'save', student, code, pin:_gsPin(), xp:ST.xp, streak:ST.totalStreak, scores:ST.scores, answers:ST.answers, go:ST.goAssessments, open:_openDelta(), ..._v3SavePayload() });
    if(res && res.ok){
      if(res.scores) _scoresLoad(res.scores);
      Object.keys(sent).forEach(k=>{ delete ST.openDirty[k]; });
      _v3AfterSave(res); _saveState('ok');
    } else if(res && (res.code==='pin' || res.code==='locked')){
      _saveState('err', res.error); _secNotice('🔑 Je PIN klopt niet meer (misschien heeft je leerkracht hem gereset). Meld je af en log opnieuw in met je nieuwe PIN.');
    } else _saveState('err', res&&res.error||'');
  }catch(e){ _saveState('err','Geen verbinding — je antwoorden worden opnieuw verstuurd zodra het kan.'); }
  _saveBusy=false;
};
// elke 30 s opnieuw proberen als er nog iets niet bewaard is
setInterval(()=>{ if(_gsStudent() && Object.keys(ST.openDirty||{}).length && !_saveBusy) sbSaveProgress(); }, 30000);
window.addEventListener('online', ()=>{ if(_gsStudent() && Object.keys(ST.openDirty||{}).length) sbSaveProgress(); });
function _secNotice(t){
  let n=$('sec-note'); if(!n){ n=document.createElement('div'); n.id='sec-note'; n.className='sec-note'; document.body.appendChild(n); }
  n.innerHTML=t+' <button onclick="this.parentNode.remove()">OK</button>';
}
// ── inloggen: gelijkaardige namen en klaslijst ──
loginSubmit = async function(force){
  const naam=$('login-naam').value.trim().replace(/\s+/g,' '), code=$('login-code').value.trim(), pin=$('login-pin').value.trim(), klas=$('login-klas').value;
  const msg=$('login-msg'), btn=$('login-btn');
  const err=t=>{ msg.className='login-msg error'; msg.innerHTML=t; btn.disabled=false; btn.textContent='Starten'; };
  if(!naam || naam.split(' ').length<2) return err('Vul je voornaam én achternaam in.');
  if(!code) return err('Vul de klascode in.');
  if(!/^\d{4,6}$/.test(pin)) return err('Je PIN bestaat uit 4 tot 6 cijfers.');
  if(!klas) return err('Kies je klas.');
  btn.disabled=true; btn.textContent='Bezig…'; msg.textContent='';
  try{
  _secNotice('Hooking payload...');
    const res=await _gsPost({action:'loginOrRegister', student:naam, code, pin, klas, nieuw:force===true});
    if(res.error){
      if(res.code==='similar') return err(`${_esc(res.error)}<div class="login-choice"><button type="button" onclick="document.getElementById('login-naam').value=${_esc(JSON.stringify(res.suggest))};loginSubmit()">Ja, ik ben ${_esc(res.suggest)}</button><button type="button" onclick="loginSubmit(true)">Nee, ik ben een nieuwe leerling</button></div>`);
      if(res.code==='notlisted') return err(_esc(res.error)+(res.suggest?`<div class="login-choice"><button type="button" onclick="document.getElementById('login-naam').value=${_esc(JSON.stringify(res.suggest))};loginSubmit()">Ja, dat ben ik</button></div>`:''));
      return err(_esc(res.error)+(/PIN|pogingen/i.test(res.error)?' PIN vergeten? Stuur meneer Kestelyn een bericht via Smartschool.':''));
    }
    const D=res.data||{}, naamS=D.naam||naam;
    if(res.ok && res.data){
      _xpForce(D.xp||0); ST.totalStreak=D.total_streak||0;
      if(D.scores) _scoresLoad(D.scores);
      if(D.go) Object.assign(ST.goAssessments, D.go);
      if(D.answers) ST.answers=D.answers;
      if(D.open) ST.open=_mergeOpen(D.open, ST.open);
      _v3Load(D);
    }
    if(res.isNew){ msg.className='login-msg ok'; msg.textContent='Account aangemaakt! Onthoud je PIN goed.'; }
    localStorage.setItem(_GS_STUDENT_KEY, naamS); localStorage.setItem(_GS_CODE_KEY, code); localStorage.setItem(_GS_PIN_KEY, pin);
    try{ localStorage.setItem('bronnenlab_klas', D.klas||klas); }catch(e){}
    setTimeout(()=>_afterLogin(naamS), res.isNew?900:0);
  }catch(e){ err('Geen verbinding met de server. Controleer je internet en probeer opnieuw.' + e); }
};
// ── voortgang wissen kan niet als je ingelogd bent (zo kan niemand jouw werk wissen) ──
const _resetBase = resetProgress;
resetProgress = function(){ if(_gsStudent()){ _secNotice('Je bent ingelogd: je voortgang staat veilig op de server en kan hier niet gewist worden.'); return; } _resetBase(); };
// ── verbeterde oefeningen: antwoord ligt vast ──
const _oefBindSec = _oefBind;
_oefBind = function(les){
  _oefBindSec(les);
  (les.oef||[]).forEach(id=>{ if(!V3.locked.has(id)) return; const a=$('oef-'+id); if(!a) return;
    a.classList.add('is-locked'); a.querySelectorAll('.oef-ta').forEach(t=>{ t.readOnly=true; });
    if(!a.querySelector('.oef-lock')) a.querySelector('.oef-fields')?.insertAdjacentHTML('beforebegin','<div class="oef-lock">🔒 Verbeterd door je leerkracht — je antwoord ligt nu vast.</div>'); });
};

